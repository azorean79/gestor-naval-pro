# ─── AIS / Rastreio Marítimo ──────────────────────────────────────────────────
# Os fornecedores são usados em cascata (fallback automático):
# 1. AISStream (WebSocket tempo real — preferido, apenas com MMSI)
# 2. AISHub (REST — com MMSI ou IMO)
# 3. MyShipTracking (REST — com MMSI)
# 4. VesselFinder (REST — com MMSI)
# 5. MarineTraffic (REST — com MMSI)
# 6. Tracking Backend interno (HTTP — por MMSI, IMO ou nome)
#
# Basta preencher os que tiver acesso. Os restantes são ignorados graciosamente.

# AISStream — registo gratuito em https://aisstream.io
AISSTREAM_API_KEY=

# AISHub — registo em https://www.aishub.net
AISHUB_USERNAME=

# MyShipTracking — plano pago em https://www.myshiptracking.com/developers
MYSHIPTRACKING_API_KEY=

# VesselFinder — plano pago em https://www.vesselfinder.com/api/docs
VESSELFINDER_API_KEY=

# MarineTraffic — plano pago em https://www.marinetraffic.com/en/p/api-services
MARINETRAFFIC_API_KEY=

# Tracking backend interno (opcional — URL do servidor MaritimeBackend próprio)
MARITIME_TRACKING_API_BASE_URL=
MARITIME_TRACKING_API_TOKEN=

# Sentry observability (frontend + backend)
SENTRY_ENABLED=true
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: upload source maps on CI/CD
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
