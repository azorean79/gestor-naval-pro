generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  nome         String
  role         String    @default("operador")
  permissoes   String?
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Jangada {
  id               String      @id @default(cuid())
  numeroReferencia String      @unique
  numero           String      @unique
  nome             String
  proprietario     String
  numeroSerie      String?
  modeloId         String?
  lotacao          Int?
  dataFabricacao   DateTime?
  cilindro         String?
  tipoPack         String?
  tipoPesca        String?
  zonaPesca        String?
  status           String      @default("ativo")
  ilha             String?
  portoEscala      String?
  ultimaInspecao   DateTime?
  proximaInspecao  DateTime?
  observacoes      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  documentos       Documento[]
  modelo           Modelo?     @relation(fields: [modeloId], references: [id])

  @@map("jangadas")
}

model Navio {
  id               String         @id @default(cuid())
  numeroReferencia String         @unique
  nome             String
  imo              String         @unique
  mmsi             String?
  matricula        String?
  bandeira         String?
  ilha             String?
  portoEscala      String?
  tipoNavioId      String?
  comprimento      Float?
  largura          Float?
  calado           Float?
  capacidade       Float?
  proprietario     String?
  proprietarioId   String?
  armador          String?
  status           String         @default("ativo")
  ultimaInspecao   DateTime?
  proximaInspecao  DateTime?
  observacoes      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  certificados     Certificado[]
  equipamentos     Equipamento[]
  cliente          Cliente?       @relation(fields: [proprietarioId], references: [id])
  tipoNavio        TipoNavio?     @relation(fields: [tipoNavioId], references: [id])
  ordensServico    OrdemServico[]

  @@map("navios")
}

model TipoNavio {
  id        String   @id @default(cuid())
  nome      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  navios    Navio[]

  @@map("tipos_navio")
}

model Cliente {
  id                  String         @id @default(cuid())
  numeroReferencia    String         @unique
  nome                String
  tipo                String
  nif                 String         @unique
  email               String
  telefone            String
  morada              String?
  contactosEmergencia String?
  status              String         @default("ativo")
  ilha                String?
  portoEscala         String?
  dataNascimento      DateTime?
  profissao           String?
  empresa             String?
  observacoes         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  documentos          Documento[]
  navios              Navio[]
  ordensServico       OrdemServico[]

  @@map("clientes")
}

model Marca {
  id        String   @id @default(cuid())
  nome      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modelos   Modelo[]

  @@map("marcas")
}

model Modelo {
  id        String    @id @default(cuid())
  nome      String
  marcaId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  jangadas  Jangada[]
  marca     Marca     @relation(fields: [marcaId], references: [id], onDelete: Cascade)

  @@unique([nome, marcaId])
  @@map("modelos")
}

model ItemStock {
  precoCompra       Float?
  precoVenda        Float?
  codigoFabricante  String?
  codigo            String?             @unique
  imagem            String?
  lote              String?
  dataValidade      DateTime?
  stockMinimo       Float?              @default(0)
  quantidade        Float?              @default(0)
  id                String              @id @default(cuid())
  numeroReferencia  String              @unique
  nome              String
  categoria         String
  descricao         String?
  unidade           String              @default("unidade")
  quantidadeAtual   Float               @default(0)
  quantidadeMinima  Float               @default(0)
  quantidadeMaxima  Float?
  precoUnitario     Float?
  fornecedor        String?
  localizacao       String?
  status            String              @default("disponivel")
  dataUltimaEntrada DateTime?
  dataUltimaSaida   DateTime?
  observacoes       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  itensOrdemServico ItemOrdemServico[]
  movimentacoes     MovimentacaoStock[]

  @@map("item_stock")
}

model MovimentacaoStock {
  id            String    @id @default(cuid())
  itemId        String
  tipo          String
  quantidade    Float
  motivo        String
  data          DateTime  @default(now())
  responsavel   String
  valorUnitario Float?
  observacoes   String?
  item          ItemStock @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("movimentacao_stock")
}

model Cilindro {
  id                     String             @id @default(cuid())
  numeroSerie            String             @unique
  pesoBruto              Float?
  tara                   Float?
  quantidadeCO2          Float?
  quantidadeN2           Float?
  testeHidraulico        DateTime?
  proximoTesteHidraulico DateTime?
  tipoSistemaInsuflacao  String?
  status                 String             @default("operacional")
  localizacao            String?
  proprietario           String?
  observacoes            String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  certificados           Certificado[]
  historicoInspecoes     InspecaoCilindro[]

  @@map("cilindros")
}

model InspecaoCilindro {
  id              String    @id @default(cuid())
  cilindroId      String
  data            DateTime  @default(now())
  tipo            String
  resultado       String
  inspector       String
  observacoes     String
  proximaInspecao DateTime?
  cilindro        Cilindro  @relation(fields: [cilindroId], references: [id], onDelete: Cascade)

  @@map("inspecao_cilindro")
}

model Inspecao {
  id                String    @id @default(cuid())
  equipamentoId     String
  equipamentoNome   String
  clienteId         String
  clienteNome       String
  tipoInspecao      String
  tecnico           String
  dataInspecao      DateTime
  status            String    @default("em_andamento")
  checklist         String
  observacoesGerais String?
  dataConclusao     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Agendamento {
  id                  String     @id @default(cuid())
  titulo              String
  descricao           String?
  tipo                String
  dataInicio          DateTime
  dataFim             DateTime
  local               String?
  responsavel         String
  participantes       String?
  status              String     @default("agendado")
  prioridade          String     @default("media")
  entidadeRelacionada String?
  observacoes         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lembretes           Lembrete[]

  @@map("agendamentos")
}

model Lembrete {
  id            String      @id @default(cuid())
  agendamentoId String
  data          DateTime
  tipo          String
  mensagem      String
  enviado       Boolean     @default(false)
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@map("lembretes")
}

model OrdemServico {
  id                  String             @id @default(cuid())
  numero              String             @unique
  clienteId           String?
  clienteNome         String?
  navioId             String?
  navioNome           String?
  tipoServico         String
  status              String             @default("recebido")
  prioridade          String             @default("normal")
  dataRececao         DateTime
  dataPrevistaEntrega DateTime?
  delegacao           String?
  tecnicoResponsavel  String?
  observacoes         String?
  valorEstimado       Float?
  etapas              String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  itens               ItemOrdemServico[]
  navio               Navio?             @relation(fields: [navioId], references: [id])
  cliente             Cliente?           @relation(fields: [clienteId], references: [id])
  relatorios          Relatorio[]

  @@map("ordens_servico")
}

model ItemOrdemServico {
  id             String       @id @default(cuid())
  ordemServicoId String
  itemStockId    String
  quantidade     Float
  valorUnitario  Float?
  observacoes    String?
  itemStock      ItemStock    @relation(fields: [itemStockId], references: [id], onDelete: Cascade)
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@map("itens_ordem_servico")
}

model Relatorio {
  id             String        @id @default(cuid())
  titulo         String
  tipo           String
  periodo        String
  dados          String
  geradoPor      String
  dataGeracao    DateTime      @default(now())
  formato        String        @default("pdf")
  arquivo        String?
  ordemServicoId String?
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id])

  @@map("relatorios")
}

model Backup {
  id          String   @id @default(cuid())
  nome        String
  tipo        String   @default("manual")
  data        DateTime @default(now())
  tamanho     Int
  status      String   @default("concluido")
  localizacao String
  criadoPor   String
  observacoes String?

  @@map("backups")
}

model Configuracao {
  id        String  @id @default(cuid())
  chave     String  @unique
  valor     String
  tipo      String  @default("string")
  descricao String
  categoria String
  editavel  Boolean @default(true)

  @@map("configuracoes")
}

model Documento {
  id           String   @id @default(cuid())
  tipo         String
  numero       String
  emissor      String
  dataEmissao  DateTime
  dataValidade DateTime
  arquivo      String?
  jangadaId    String?
  clienteId    String?
  cliente      Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  jangada      Jangada? @relation(fields: [jangadaId], references: [id], onDelete: Cascade)

  @@map("documentos")
}

model Certificado {
  id              String    @id @default(cuid())
  tipo            String
  numero          String
  emissor         String
  dataEmissao     DateTime?
  dataValidade    DateTime?
  status          String    @default("valido")
  navioId         String?
  cilindroId      String?
  arquivoUrl      String?
  tipoEquipamento String?
  marca           String?
  modelos         String?
  observacoes     String?
  cilindro        Cilindro? @relation(fields: [cilindroId], references: [id], onDelete: Cascade)
  navio           Navio?    @relation(fields: [navioId], references: [id], onDelete: Cascade)

  @@map("certificados")
}

model Equipamento {
  id                String    @id @default(cuid())
  nome              String
  tipo              String
  fabricante        String
  modelo            String
  numeroSerie       String
  dataInstalacao    DateTime?
  status            String    @default("operacional")
  ultimaManutencao  DateTime?
  proximaManutencao DateTime?
  navioId           String
  navio             Navio     @relation(fields: [navioId], references: [id], onDelete: Cascade)

  @@map("equipamentos")
}
