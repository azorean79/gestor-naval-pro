model ArtigoJangada {
  id               Int       @id @default(autoincrement())
  name             String
  quantidade       Int
  validade         DateTime?
  referencia       String?
  codigoFabricante String?
  jangadaId        Int
  Jangada          Jangada   @relation(fields: [jangadaId], references: [id])
  inspecaoId       Int?
  inspecao         Inspecao? @relation(fields: [inspecaoId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Artigo {
  id         Int      @id @default(autoincrement())
  name       String
  descricao  String?
  referencia String?
  unit       String?  @default("un")
  stock      Int      @default(0)
  minStock   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Colete {
  id               Int      @id @default(autoincrement())
  shipId           Int?
  serial           String   @unique
  marca            String?
  modelo           String?
  tamanho          String?
  estado           String   @default("Ativo")
  dataFabrico      String?
  dataInspecao     String?
  dataProxInspecao String?
  observacoes      String?
  
  // Testes recentes (atualizados pela Inspeção Wizard)
  testePressao     String?
  testeInsuflacao  String?
  testeVazamento   String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  verificacoes     VerificacaoColete[]
  certificado      CertificadoColete?

  @@index([shipId])
  @@index([estado])
}

model Epirb {
  id                   Int      @id @default(autoincrement())
  shipId               Int?
  serial               String   @unique
  marca                String?
  modelo               String?
  tipo                 String?
  hexId                String?
  estado               String   @default("Ativo")
  dataInspecao         String?
  dataProxInspecao     String?
  dataValidadeBateria  String?
  ownerName            String?
  ownerAddress         String?
  ownerPhone           String?
  emergencyContact1Name String?
  emergencyContact1Phone String?
  emergencyContact2Name String?
  emergencyContact2Phone String?
  observacoes          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([shipId])
  @@index([estado])
  @@index([tipo])
}

model VerificacaoColete {
  id                    Int      @id @default(autoincrement())
  coleteId              Int
  colete                Colete   @relation(fields: [coleteId], references: [id], onDelete: Cascade)
  
  // Inspecção Visual Fields
  tecidoExterior        String?  // OK, F, S, R
  colagens              String?  // OK, F, S, R
  zataosVelcro          String?  // OK, F, S, R, or specific type
  fitasReflectoras      String?  // OK, F, S, R
  sistemaInflacao       String?  // OK, F, S, R
  mecanismoInflacao     String?  // HR, HM, SEC, LZ, UML, CREW, PL
  camaras               String?  // OK, F, S, R
  garrafaCO2            String?  // OK, F, S, R
  tuboInflador          String?  // OK, F, S, R
  
  // Additional inspection fields
  dataVerificacao       DateTime @default(now())
  inspectorNome         String?
  observacoes           String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([coleteId])
  @@index([dataVerificacao])
}

model CertificadoColete {
  id                    Int      @id @default(autoincrement())
  coleteId              Int      @unique
  colete                Colete   @relation(fields: [coleteId], references: [id], onDelete: Cascade)
  
  // Certificate Info
  numeroCertificado     String   @unique
  dataCertificado       DateTime @default(now())
  dataValidade          DateTime?
  
  // Approval Info
  resultado             String   @default("Aprovado") // Aprovado, Reprovado, Condicional
  emitidoPor            String?
  observacoes           String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([coleteId])
  @@index([dataCertificado])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceStationTerritoryType {
  AZORES
  MAINLAND
  MADEIRA
}

enum MainlandRegion {
  NORTE
  CENTRO
  SUL
  MADEIRA
}

model Cliente {
  id            Int            @id @default(autoincrement())
  serviceStationId Int?
  nome          String
  numeroCliente String?        @unique
  nif           String?        @unique
  email         String?
  telefone      String?
  telmovel      String?
  morada        String?
  modoPagamento String?
  moradaNumero  String?
  codigoPostal  String?
  localidade    String?
  ilha          String?
  tipoCliente   String? // "armador", "operador", etc
  agendas       Agenda[]       @relation("ClienteAgenda")
  navios        Navio[]        @relation("ClienteNavios")
  ordensServico OrdemServico[]
  serviceStation ServiceStation? @relation(fields: [serviceStationId], references: [id])

  @@index([serviceStationId])
  @@index([ilha])
  @@index([nome])
  @@index([nif])
  @@index([codigoPostal])
}

model ContactoInterno {
  id               Int      @id @default(autoincrement())
  categoria        String   @default("Colaborador")
  empresa          String?
  localizacao      String?
  nome             String
  email            String?
  telemovel        String?
  telefoneFixo     String?
  extensaoNos      String?
  extensaoVodafone String?
  observacoes      String?
  ativo            Boolean  @default(true)
  fonte            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([categoria])
  @@index([empresa])
  @@index([localizacao])
  @@index([nome])
  @@index([ativo])
  @@index([fonte])
}

model ServiceStation {
  id                   Int                         @id @default(autoincrement())
  codigo               String                      @unique
  nome                 String
  empresa              String?
  localizacao          String?
  territorioTipo       ServiceStationTerritoryType @default(MAINLAND)
  regiaoOperacional    MainlandRegion?
  ativo                Boolean                     @default(true)
  observacoes          String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  clientes             Cliente[]
  navios               Navio[]
  jangadas             Jangada[]
  tecnicos             Tecnico[]
  ordensServico        OrdemServico[]
  serviceStationQueues ServiceStationQueue[]

  @@index([ativo])
  @@index([territorioTipo])
  @@index([regiaoOperacional])
  @@index([nome])
}

model Navio {
  id                     Int      @id @default(autoincrement())
  serviceStationId       Int?
  nome                   String
  matricula              String
  ilha                   String
  tipoPesca              String
  tipoNavio              String? // "pesca", "turistico", etc
  comprimentoMetros      Float?
  zonaNavegacao          String?
  proprietario           String?
  bandeira               String?
  mmsi                   String?
  imo                    String?
  callSignal             String?
  lat                    Float?
  lng                    Float?
  hruReferencia          String?
  hruValidade            String?
  pirotecnicosBordoJson  String?
  radarReflector         String?
  radarReflectorValidade String?
  portoRegisto           String?
  territorioGrupo        String?
  ativo                  Boolean  @default(true)
  clienteId              Int?
  cliente                Cliente? @relation("ClienteNavios", fields: [clienteId], references: [id])
  serviceStation         ServiceStation? @relation(fields: [serviceStationId], references: [id])

  @@index([serviceStationId])
  @@index([clienteId])
  @@index([ilha])
  @@index([territorioGrupo])
  @@index([tipoPesca])
  @@index([matricula])
  @@index([portoRegisto])
  @@index([mmsi])
  @@index([imo])
  @@index([lat])
  @@index([lng])
}

model Agenda {
  id                 Int      @id @default(autoincrement())
  nome               String
  matricula          String
  embarcacoesDePesca String
  tipoPesca          String
  lotacao            Int
  bandeira           String
  clienteId          Int?
  cliente            Cliente? @relation("ClienteAgenda", fields: [clienteId], references: [id])
}

model AgendaEvento {
  id                  Int      @id @default(autoincrement())
  title               String
  date                DateTime
  raftSerial          String
  responsavel         String?
  status              String   @default("scheduled")
  type                String   @default("Inspeção")
  inspectionType      String   @default("outro")
  durationMinutes     Int      @default(210)
  bufferBeforeMinutes Int      @default(15)
  bufferAfterMinutes  Int      @default(15)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([raftSerial])
  @@index([date])
  @@index([status])
  @@index([responsavel, date])
}

enum UserRole {
  ADMIN
  USER
}

enum CatalogTipoEquipamento {
  COLETE
  JANGADA
}

model CatalogMarcaModelo {
  id        Int                    @id @default(autoincrement())
  tipo      CatalogTipoEquipamento
  marca     String
  modelo    String
  marcaKey  String
  modeloKey String
  origem    String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([tipo, marcaKey, modeloKey])
  @@index([tipo, marca])
  @@index([tipo, modelo])
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String?
  passwordHash String?
  role         UserRole  @default(USER)
  permissionsOverrideJson String?
  googleId     String?   @unique
  image        String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  posts        Post[]
  customPackTypesCreated CustomPackType[] @relation("CustomPackTypeCreatedBy")
  customPackTypesUpdated CustomPackType[] @relation("CustomPackTypeUpdatedBy")

  @@index([role])
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
}

model Jangada {
  serviceStationQueues                 ServiceStationQueue[]
  ordensServicoPrimarias               OrdemServico[]           @relation("PrimaryOrdemServicoJangada")
  ordemServicoLinks                    OrdemServicoJangada[]
  id                                   Int                   @id @default(autoincrement())
  serviceStationId                     Int?
  brand                                String
  model                                String
  serial                               String                @unique
  launchType                           String?
  painterLength                        String?
  maxStowageHeight                     String?
  dataFabrico                          String
  packType                             String
  containerModel                       String?
  capacity                             Int
  owner                                String
  shipId                               Int?
  shipNameManual                       String?
  dataInspecao                         String?
  dataProxInspecao                     String?
  ultimoCertificadoNumero              String?
  cylinderSerial                       String?
  cylinderTara                         String?
  cylinderPesoBruto                    String?
  cylinderCo2                          String?
  cylinderN2                           String?
  cylinderDataTeste                    String?
  cylinderDataProxTeste                String?
  cylinderSistema                      String?
  cylinderCabecaDisparoRef             String?
  fabricType                           String? // PU, NR, or PVC
  cylinderCabecaDisparoDescricao       String?
  cylinderTuboCamaraSuperiorRef        String?
  cylinderTuboCamaraSuperiorDescricao  String?
  cylinderTuboCamaraInferiorRef        String?
  cylinderTuboCamaraInferiorDescricao  String?
  cylinderAcessoriosCamaraSuperiorJson String?
  cylinderAcessoriosCamaraInferiorJson String?
  valvulasAlivio                       String?
  valvulasAtestar                      String?
  hruReferencia                        String?
  hruDataInstalacao                    String?
  hruValidade                          String?
  radarReflector                       String?
  radarReflectorValidade               String?
  artigos                              ArtigoJangada[]
  tuboIdentificacao                    String?
  numeroObra                           String?
  testeWP                              String?
  testeNAP                             String?
  testeFS                              String?
  testeGI                              String?
  testeDL                              String?
  testeTemperaturaCamaraSuperior       String?
  testeTemperaturaCamaraInferior       String?
  testePressaoCamaraSuperior           String?
  testePressaoCamaraInferior           String?
  testeWPUnidadePressao                String?
  testeWPHoraInicio                    String?
  testeWPHoraFim                       String?
  testeWPTemperaturaInicial            String?
  testeWPTemperaturaFinal              String?
  testeWPPressaoAtmosfericaInicial     String?
  testeWPPressaoAtmosfericaFinal       String?
  testeWPCamaraSuperiorInicio          String?
  testeWPCamaraSuperiorFim             String?
  testeWPCamaraSuperiorQueda           String?
  testeWPCamaraInferiorInicio          String?
  testeWPCamaraInferiorFim             String?
  testeWPCamaraInferiorQueda           String?
  serviceBulletinsAppliedJson          String?
  createdAt                            DateTime              @default(now())
  updatedAt                            DateTime              @updatedAt
  certificadoAtivoId                   Int?
  certificadosExtraidos                CertificadoExtraido[] @relation("JangadaCertificadosExtraidos")
  certificadoAtivo                     CertificadoExtraido?  @relation("JangadaCertificadoAtivo", fields: [certificadoAtivoId], references: [id])
  serviceStation                       ServiceStation?       @relation(fields: [serviceStationId], references: [id])
  signatureBase64                      String?

  @@index([serviceStationId])
  @@index([certificadoAtivoId])
  @@index([shipId])
  @@index([brand])
  @@index([model])
  @@index([owner])
}

model CertificadoExtraido {
  id                Int                   @id @default(autoincrement())
  fileName          String                @unique
  certificadoNumero String?
  sourceYear        Int                   @default(2025)
  raftSerial        String?
  shipName          String?
  dataInspecao      String?
  dataProxInspecao  String?
  emergencyPackType String?
  hasQuadro         Boolean               @default(false)
  validitiesCount   Int                   @default(0)
  isMaisRecente     Boolean               @default(false)
  aplicadoComoAtivo Boolean               @default(false)
  cylinderData      Json?
  shipOwner         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  jangada           Jangada?              @relation("JangadaCertificadosExtraidos", fields: [raftSerial], references: [serial])
  validities        CertificadoValidade[]
  jangadasAtivas    Jangada[]             @relation("JangadaCertificadoAtivo")

  @@index([raftSerial])
  @@index([shipName])
  @@index([dataInspecao])
  @@index([isMaisRecente])
}

model CertificadoValidade {
  id            Int                 @id @default(autoincrement())
  certificadoId Int
  item          String
  validade      String
  rowNumber     Int?
  createdAt     DateTime            @default(now())
  certificado   CertificadoExtraido @relation(fields: [certificadoId], references: [id], onDelete: Cascade)

  @@unique([certificadoId, item, validade, rowNumber])
  @@index([certificadoId])
  @@index([item])
  @@index([validade])
}

model Stock {
  id                     Int                 @id @default(autoincrement())
  referencia             String              @unique
  descricao              String
  estadoArtigo           String              @default("ATIVO")
  referenciaSubstituta   String?
  categoria              String?
  associavelJangada      Boolean             @default(false)
  aplicavelMarcaJangada  String?
  aplicavelModeloJangada String?
  precoCompra            Float?
  codigoFabricante       String?
  inventario             String?
  lote                   String?
  validade               String?
  testeHidraulico        String?
  estadoCargaCilindro    String?
  precoVenda             Float
  quantidade             Int                 @default(0)
  quantidadeMinima       Int?
  foto                   String?
  localizacao            String?
  observacoes            String?
  codigoBarras           String?             @unique
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  movimentacoes          MovimentacaoStock[]
  customPackItems        CustomPackTypeItem[]

  @@index([categoria])
  @@index([associavelJangada])
  @@index([aplicavelMarcaJangada])
  @@index([aplicavelModeloJangada])
  @@index([estadoCargaCilindro])
}

model CustomPackType {
  id              Int                  @id @default(autoincrement())
  name            String               @unique
  description     String?
  isActive        Boolean              @default(true)
  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items           CustomPackTypeItem[]
  createdByUser   User?                @relation("CustomPackTypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?                @relation("CustomPackTypeUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([name])
}

model CustomPackTypeItem {
  id               Int            @id @default(autoincrement())
  customPackTypeId Int
  stockId          Int?
  stockReference   String
  stockDescription String
  stockCategory    String?
  quantity         Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  customPackType   CustomPackType @relation(fields: [customPackTypeId], references: [id], onDelete: Cascade)
  stock            Stock?         @relation(fields: [stockId], references: [id], onDelete: SetNull)

  @@index([customPackTypeId])
  @@index([stockId])
  @@unique([customPackTypeId, stockReference])
}

model MovimentacaoStock {
  id               Int      @id @default(autoincrement())
  stockId          Int
  stock            Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  tipo             String // "entrada" ou "saida"
  quantidade       Int
  quantidadeAntes  Int
  quantidadeDepois Int
  motivo           String?
  usuario          String?
  createdAt        DateTime @default(now())

  @@index([stockId])
  @@index([createdAt])
}

model Inspecao {
  id                Int             @id @default(autoincrement())
  certificadoNumero String          @unique
  navioNome         String
  navioId           Int?
  jangadaId         Int?
  jangadaSerial     String?
  coleteId          Int?
  coleteSerial      String?
  dataInspecao      String
  dataProxInspecao  String?
  status            String          @default("Concluída")
  sourceFile        String?
  signatureBase64   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  artigos           ArtigoJangada[]
  ordensServico     OrdemServico[]

  @@index([navioNome])
  @@index([navioId])
  @@index([jangadaId])
  @@index([jangadaSerial])
  @@index([coleteId])
  @@index([coleteSerial])
  @@index([dataInspecao])
}

model OrdemServico {
  id                   Int                         @id @default(autoincrement())
  numeroOrdem          String                      @unique
  serviceStationId     Int?
  jangadaId            Int
  shipId               Int?
  clienteId            Int?
  tecnicoId            Int?
  inspecaoId           Int?
  tipo                 String                      @default("inspecao")
  prioridade           String                      @default("normal")
  status               String                      @default("pendente")
  descricao            String?
  tecnicoResponsavel   String?
  slaHoras             Int?
  dataPlaneadaInicio   DateTime?
  dataPlaneadaFim      DateTime?
  dataAbertura         DateTime                    @default(now())
  dataPrevista         DateTime?
  dataInicio           DateTime?
  dataConclusao        DateTime?
  durationMinutes      Int                         @default(210)
  
  // Orçamentação e Faturação
  orcamentoStatus      String                      @default("Rascunho")
  isPesca              Boolean                     @default(false)
  isIsentoIva          Boolean                     @default(false)
  valorPecas           Float                       @default(0)
  valorMaoObra         Float                       @default(0)
  valorDesconto        Float                       @default(0)
  valorTotal           Float                       @default(0)

  metadados            String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  jangada              Jangada                     @relation("PrimaryOrdemServicoJangada", fields: [jangadaId], references: [id])
  ordemJangadas        OrdemServicoJangada[]
  cliente              Cliente?                    @relation(fields: [clienteId], references: [id])
  tecnico              Tecnico?                    @relation(fields: [tecnicoId], references: [id])
  inspecao             Inspecao?                   @relation(fields: [inspecaoId], references: [id])
  serviceStation       ServiceStation?             @relation(fields: [serviceStationId], references: [id])
  serviceStationQueues ServiceStationQueue[]
  checklistItems       OrdemServicoChecklistItem[]
  logs                 OrdemServicoLog[]
  ordemServicoTempos   OrdemServicoTempo[]

  @@index([serviceStationId])
  @@index([jangadaId])
  @@index([shipId])
  @@index([clienteId])
  @@index([tecnicoId])
  @@index([inspecaoId])
  @@index([status])
  @@index([tipo])
  @@index([prioridade])
  @@index([dataAbertura])
  @@index([dataPlaneadaInicio])
  @@index([dataPlaneadaFim])
  @@index([dataPrevista])
}

model OrdemServicoJangada {
  id             Int          @id @default(autoincrement())
  ordemServicoId Int
  jangadaId      Int
  addedAt        DateTime     @default(now())
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  jangada        Jangada      @relation(fields: [jangadaId], references: [id], onDelete: Cascade)

  @@unique([ordemServicoId, jangadaId])
  @@index([ordemServicoId])
  @@index([jangadaId])
}

model Tecnico {
  id               Int                         @id @default(autoincrement())
  serviceStationId Int?
  nome             String
  email            String?                     @unique
  ativo            Boolean                     @default(true)
  observacoes      String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  ordensServico    OrdemServico[]
  tempos           OrdemServicoTempo[]
  checklistUpdates OrdemServicoChecklistItem[] @relation("ChecklistUpdatedByTecnico")
  logs             OrdemServicoLog[]
  serviceStation   ServiceStation?             @relation(fields: [serviceStationId], references: [id])
  ausencias        TecnicoAusencia[]

  @@index([serviceStationId])
  @@index([nome])
  @@index([ativo])
}

model TecnicoAusencia {
  id         Int      @id @default(autoincrement())
  /// Key do técnico (ex: 'julio-correia', 'alex-santos'; corresponde ao id em AZORES_TECHNICIANS)
  tecnicoKey String
  tipo       String   // 'ferias' | 'ausencia'
  dataInicio DateTime
  dataFim    DateTime
  motivo     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Relação opcional ao registo Tecnico se existir na BD
  tecnicoId  Int?
  tecnico    Tecnico? @relation(fields: [tecnicoId], references: [id], onDelete: SetNull)

  @@index([tecnicoKey])
  @@index([dataInicio])
  @@index([dataFim])
  @@index([tecnicoId])
}

model OrdemServicoChecklistItem {
  id               Int          @id @default(autoincrement())
  ordemServicoId   Int
  phase            String       @default("pre") // pre, intervencao, fechamento
  category         String?      // e.g., "valves", "tubes", "heads", "equipment"
  label            String
  done             Boolean      @default(false)
  
  // Formato Checklist Digital
  barcode          String?      // Para suporte de scan de código de barras
  scannedAt        DateTime?
  photoUrl         String?      // Imagem tirada ao estado do item (ex: válvulas)
  notes            String?      // Observações do técnico // Em caso de exceção/defeito
  isDefect         Boolean      @default(false) // Se o técnico marcou com defeito ou não-conforme
  originalDiagramRef String?    // Referência do override do manual (ex: diagrama B, P/N)

  updatedAt        DateTime     @default(now())
  updatedBy        String?
  updatedById      Int?
  createdAt        DateTime     @default(now())
  ordemServico     OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  updatedByTecnico Tecnico?     @relation("ChecklistUpdatedByTecnico", fields: [updatedById], references: [id])

  @@index([ordemServicoId])
  @@index([phase])
  @@index([category])
  @@index([updatedById])
}

model OrdemServicoTempo {
  id              Int          @id @default(autoincrement())
  ordemServicoId  Int
  tecnicoId       Int?
  tecnico         String?
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int          @default(0)
  notes           String?
  createdAt       DateTime     @default(now())
  ordemServico    OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tecnicoRef      Tecnico?     @relation(fields: [tecnicoId], references: [id])

  @@index([ordemServicoId])
  @@index([tecnicoId])
  @@index([startedAt])
}

model OrdemServicoLog {
  id             Int          @id @default(autoincrement())
  ordemServicoId Int
  at             DateTime     @default(now())
  type           String       @default("EVENT")
  message        String
  user           String?
  tecnicoId      Int?
  createdAt      DateTime     @default(now())
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tecnico        Tecnico?     @relation(fields: [tecnicoId], references: [id])

  @@index([ordemServicoId])
  @@index([at])
  @@index([type])
  @@index([tecnicoId])
}

model Equipamento {
  id          Int      @id @default(autoincrement())
  nome        String
  tipo        String?
  marca       String?
  modelo      String?
  serial      String?  @unique
  estado      String   @default("Ativo")
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([nome])
  @@index([estado])
}

model ServiceStationQueue {
  id                  Int           @id @default(autoincrement())
  serviceStationId    Int?
  jangadaId           Int
  ordemServicoId      Int?
  dataChegada         DateTime      @default(now())
  dataPrevistaEntrega DateTime?
  status              String        @default("Aguardando") // Aguardando, EmInspecao, Concluida, etc
  observacoes         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  jangada             Jangada       @relation(fields: [jangadaId], references: [id])
  ordemServico        OrdemServico? @relation(fields: [ordemServicoId], references: [id])
  serviceStation      ServiceStation? @relation(fields: [serviceStationId], references: [id])

  @@index([serviceStationId])
  @@index([jangadaId])
  @@index([ordemServicoId])
  @@index([status])
}
model Auditoria {
  id           Int      @id @default(autoincrement())
  tabela       String // Nome da tabela modificada
  tipoOperacao String // CREATE, UPDATE, DELETE
  idRegisto    Int // ID do registo modificado
  descricao    String? // Descrição da mudança
  usuario      String? // Quem fez a alteração
  dadosAntes   String? // JSON dos dados antes
  dadosDepois  String? // JSON dos dados depois
  createdAt    DateTime @default(now())

  @@index([tabela])
  @@index([tipoOperacao])
  @@index([createdAt])
  @@index([usuario])
}
