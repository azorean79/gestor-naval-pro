      title: 'Pack',
      status: missingRequiredPackArticles > 0 ? 'attention' : 'ok',
      summary: missingRequiredPackArticles > 0 ? `${missingRequiredPackArticles} em falta` : 'Obrigatórios alinhados',
      badge: missingRequiredPackArticles > 0 ? 'rever' : 'ok',
    },
    {
      key: 'contentor' as SectionKey,
      title: packagingLabel,
      status: contentorOperationalSummary.pending > 0 ? 'attention' : 'ok',
      summary: contentorOperationalSummary.pending > 0 ? `${contentorOperationalSummary.pending} pendente(s)` : 'Fecho limpo',
      badge: contentorOperationalSummary.pending > 0 ? 'rever' : 'ok',
    },
    {
      key: 'checklist' as SectionKey,
      title: 'Checklist',
      status: inspectionMode && checklistCompletionPercent < 100 ? 'attention' : 'ok',
      summary: inspectionMode ? `${checklistCompletionPercent}% concluído` : 'Modo inativo',
      badge: inspectionMode && checklistCompletionPercent < 100 ? 'aberta' : 'ok',
    },
    {
      key: 'historico' as SectionKey,
      title: 'Histórico',
      status: inspecoesVisiveis.length === 0 ? 'attention' : 'ok',
      summary: inspecoesVisiveis.length > 0 ? `${inspecoesVisiveis.length} inspeções` : 'Sem histórico',
      badge: inspecoesVisiveis.length > 0 ? 'ok' : 'vazio',
    },
  ];

  const priorityAccordionCards = [
    {
      key: 'geral' as const,
      title: 'Dados Gerais',
      subtitle: ownerDisplay,
      detail: `${String(form.ultimoCertificadoNumero || raft?.ultimoCertificadoNumero || certificadoPreferencial?.certificadoNumero || ultimaInspecao?.certificadoNumero || 'Sem certificado').trim() || 'Sem certificado'} · ${inspectionCycleLabel}`,
      badge: expandedPrimarySections.geral ? 'aberto' : 'fechado',
      tone: expandedPrimarySections.geral
        ? 'border-slate-900 bg-slate-900 text-white'
        : 'border-slate-200 bg-white text-slate-900',
    },
    {
      key: 'pack' as const,
      title: 'Pack Obrigatório',
      subtitle: currentPackLabel || 'Sem pack definido',
      detail: missingRequiredPackArticles > 0
        ? `${missingRequiredPackArticles} artigo(s) por fechar`
        : 'Pack obrigatório alinhado e pronto',
      badge: expandedPrimarySections.pack ? 'aberto' : 'fechado',
      tone: expandedPrimarySections.pack
        ? 'border-cyan-700 bg-cyan-700 text-white'
        : missingRequiredPackArticles > 0
          ? 'border-amber-200 bg-amber-50 text-amber-900'
          : 'border-emerald-200 bg-emerald-50 text-emerald-900',
    },
  ];

  useEffect(() => {
    if (inspectionMode) {
      setWorkspaceMode('inspection');
    }
  }, [inspectionMode]);

  useEffect(() => {
    if (!isClient) return;
    if (!id) return;
    if (loading) return;
    if (!raft) return;
    if (edit) return;
    if (smartFocusAutoAppliedRef.current) return;

    const shouldStartInspection = searchParams?.get('startInspection') === '1';
    if (shouldStartInspection) return;

    const target = smartFocusPreferredTarget;
    if (!target) return;

    smartFocusAutoAppliedRef.current = true;
    navigateToSmartFocusTarget(target.target);
  }, [isClient, id, loading, raft, edit, searchParams, smartFocusPreferredTarget]);

  useEffect(() => {
    if (!smartFocusPreferredTarget) {
      persistRememberedSmartFocus(null);
      return;
    }

    const nextPayload: StoredSmartFocus = {
      key: smartFocusPreferredTarget.key,
      section: smartFocusPreferredTarget.target.section,
      blockId: smartFocusPreferredTarget.target.blockId,
      updatedAt: Date.now(),
      userKey: smartFocusUserKey,
    };

    if (
      rememberedSmartFocus?.key === nextPayload.key
      && rememberedSmartFocus?.section === nextPayload.section
      && rememberedSmartFocus?.blockId === nextPayload.blockId
      && rememberedSmartFocus?.userKey === nextPayload.userKey
    ) {
      return;
    }

    persistRememberedSmartFocus(nextPayload);
  }, [smartFocusPreferredTarget, smartFocusUserKey]);

  const resumoUltimaInspecaoRows = useMemo(() => {
    return aggregateInspectionSummaryRows(
      ultimaInspecaoArtigos.map((artigo) => ({
        name: String(artigo.name || '').trim(),
        quantidade: parseArticleQuantity(artigo.quantidade, 1),
        validade: String(artigo.validade || '').trim(),
        referencia: String(artigo.referencia || '').trim(),
        codigoFabricante: String(artigo.codigoFabricante || '').trim(),
      }))
    );
  }, [ultimaInspecaoArtigos]);

  const resumoSubstituicoesRows = useMemo(() => {
    const rows: InspectionSummaryRow[] = [];
    const resolveStockMeta = (reference?: string | null) => {
      const normalizedRef = normalizeReference(String(reference || ''));
      if (!normalizedRef) return null;
      return stockMapByReferencia[normalizedRef] || stockMapByCodigoFabricante[normalizedRef] || null;
    };

    mandatoryPackChecklistItems.forEach((packItem) => {
      const replacementKey = buildExplicitReplacementChecklistKey(packItem.label);
      if (!replacementKey) return;
      const replacementQuantity = parseExplicitReplacementQuantity(inspectionChecklistValues[replacementKey]);
      if (replacementQuantity <= 0) return;

      const artigoAtual = obterArtigoVerificado(packItem.label)?.art;
      const stockMeta = resolveStockMeta(
        artigoAtual?.referencia
        || getPreferredStockReferenceForArticleName(packItem.label)
        || getFixedReferenceForArticleName(packItem.label)
      );

      rows.push({
        name: String(packItem.label || packItem.technicalName || 'Artigo do pack').trim(),
        quantidade: replacementQuantity,
        validade: String(artigoAtual?.validade || stockMeta?.validade || '').trim(),
        referencia: String(artigoAtual?.referencia || stockMeta?.referencia || '').trim(),
        codigoFabricante: String(artigoAtual?.codigoFabricante || stockMeta?.codigoFabricante || '').trim(),
        origem: 'Pack obrigatório',
        notes: 'Qtd. substituída registada no checklist',
      });
    });

    return aggregateInspectionSummaryRows(rows);
  }, [
    mandatoryPackChecklistItems,
    inspectionChecklistValues,
    stockMapByReferencia,
    stockMapByCodigoFabricante,
  ]);

  const resolveInspectionSummaryCost = (row: InspectionSummaryRow) => {
    const referenceCandidates = String(row.referencia || '')
      .split('·')
      .map((entry) => String(entry || '').trim())
      .filter(Boolean);

    const stockMeta = referenceCandidates
      .map((reference) => normalizeReference(reference))
      .map((reference) => stockMapByReferencia[reference] || stockMapByCodigoFabricante[reference])
      .find(Boolean);

    const unitPriceRaw = stockMeta?.precoVenda ?? stockMeta?.precoCompra ?? null;
    const unitPrice = Number(unitPriceRaw);
    if (!Number.isFinite(unitPrice) || unitPrice < 0) {
      return {
        custoUnitario: null,
        custoTotal: null,
        fontePreco: '',
      };
    }

    const quantity = Math.max(1, Number(row.quantidade || 1));
    return {
      custoUnitario: unitPrice,
      custoTotal: unitPrice * quantity,
      fontePreco: stockMeta?.precoVenda != null ? 'Preço de venda' : stockMeta?.precoCompra != null ? 'Preço de compra' : '',
    };
  };

  const resumoUltimaInspecaoRowsWithCost = useMemo(() => {
    return resumoUltimaInspecaoRows.map((row) => ({
      ...row,
      ...resolveInspectionSummaryCost(row),
    }));
  }, [resumoUltimaInspecaoRows, resolveInspectionSummaryCost]);

  const resumoSubstituicoesRowsWithCost = useMemo(() => {
    return resumoSubstituicoesRows.map((row) => ({
      ...row,
      ...resolveInspectionSummaryCost(row),
    }));
  }, [resumoSubstituicoesRows, resolveInspectionSummaryCost]);

  const resumoUltimaInspecaoTotalCost = useMemo(() => {
    const knownRows = resumoUltimaInspecaoRowsWithCost.filter((row) => Number.isFinite(Number(row.custoTotal)));
    if (knownRows.length === 0) return null;
    return knownRows.reduce((total, row) => total + Number(row.custoTotal || 0), 0);
  }, [resumoUltimaInspecaoRowsWithCost]);

  const resumoSubstituicoesTotalCost = useMemo(() => {
    const knownRows = resumoSubstituicoesRowsWithCost.filter((row) => Number.isFinite(Number(row.custoTotal)));
    if (knownRows.length === 0) return null;
    return knownRows.reduce((total, row) => total + Number(row.custoTotal || 0), 0);
  }, [resumoSubstituicoesRowsWithCost]);

  const resumoTestesEfetuados = useMemo(() => {
    const inspectionDate = String(ultimaInspecao?.dataInspecao || form.dataInspecao || raft?.dataInspecao || '').trim();
    const tests = [
      {
        key: 'WP',
        label: 'Working Pressure (WP)',
        result: normalizeTestResult(form.testeWP || raft?.testeWP, derivedTestDefaults.testeWP),
        details: [
          String(form.testeWPHoraInicio || raft?.testeWPHoraInicio || '').trim() ? `Início ${String(form.testeWPHoraInicio || raft?.testeWPHoraInicio || '').trim()}` : '',
          wpDerived.endTime ? `Fim ${wpDerived.endTime}` : String(form.testeWPHoraFim || raft?.testeWPHoraFim || '').trim() ? `Fim ${String(form.testeWPHoraFim || raft?.testeWPHoraFim || '').trim()}` : '',
          wpDerived.upper.dropDisplay ? `Queda sup. ${wpDerived.upper.dropDisplay} ${wpUnitLabel}` : '',
          wpDerived.lower.dropDisplay ? `Queda inf. ${wpDerived.lower.dropDisplay} ${wpUnitLabel}` : '',
        ].filter(Boolean),
      },
      {
        key: 'NAP',
        label: 'NAP',
        result: normalizeTestResult(form.testeNAP || raft?.testeNAP, derivedTestDefaults.testeNAP),
        details: [],
      },
      {
        key: 'FS',
        label: 'FS',
        result: normalizeTestResult(form.testeFS || raft?.testeFS, derivedTestDefaults.testeFS),
        details: [],
      },
      {
        key: 'GI',
        label: 'GI',
        result: normalizeTestResult(form.testeGI || raft?.testeGI, derivedTestDefaults.testeGI),
        details: [String(form.cylinderDataTeste || raft?.cylinderDataTeste || '').trim() ? `TH cilindro ${formatDatePt(String(form.cylinderDataTeste || raft?.cylinderDataTeste || '').trim())}` : ''].filter(Boolean),
      },
      {
        key: 'DL',
        label: 'DL',
        result: normalizeTestResult(form.testeDL || raft?.testeDL, derivedTestDefaults.testeDL),
        details: [],
      },
    ];

    return tests
      .filter((test) => test.result === 'YES')
      .map((test) => ({
        ...test,
        inspectionDate,
      }));
  }, [
    ultimaInspecao?.dataInspecao,
    form.dataInspecao,
    raft?.dataInspecao,
    form.testeWP,
    raft?.testeWP,
    form.testeNAP,
    raft?.testeNAP,
    form.testeFS,
    raft?.testeFS,
    form.testeGI,
    raft?.testeGI,
    form.testeDL,
    raft?.testeDL,
    derivedTestDefaults.testeWP,
    derivedTestDefaults.testeNAP,
    derivedTestDefaults.testeFS,
    derivedTestDefaults.testeGI,
    derivedTestDefaults.testeDL,
    form.testeWPHoraInicio,
    raft?.testeWPHoraInicio,
    form.testeWPHoraFim,
    raft?.testeWPHoraFim,
    form.cylinderDataTeste,
    raft?.cylinderDataTeste,
    wpDerived.endTime,
    wpDerived.upper.dropDisplay,
    wpDerived.lower.dropDisplay,
    wpUnitLabel,
  ]);

  // Only render after all hooks
  if (!isClient) return null;
  if (loading) return <div className="p-8">A carregar...</div>;
  if (!raft) return <div className="p-8 text-red-600">{loadError || "Jangada não encontrada."}</div>;

  const aplicarCabecaDisparoDoStock = (artigoSelecionado: Partial<ArtigoJangada>) => {
    const referencia = String(artigoSelecionado.referencia || artigoSelecionado.codigoFabricante || "").trim();
    const descricao = String(artigoSelecionado.name || "").trim();
    if (!referencia && !descricao) return;

    setForm((prev: FormState) => {
      const next: FormState = {
        ...prev,
        cylinderCabecaDisparoRef: referencia,
        cylinderCabecaDisparoDescricao: descricao,
      };
      scheduleAutosave(next);
      return next;
    });
  };

  const aplicarValvulaAlivioDoStock = (artigoSelecionado: Partial<ArtigoJangada>) => {
    const referencia = String(artigoSelecionado.referencia || artigoSelecionado.codigoFabricante || "").trim();
    if (!referencia) return;

    setForm((prev: FormState) => {
      const next: FormState = {
        ...prev,
        valvulasAlivio: referencia,
      };
      scheduleAutosave(next);
      return next;
    });
  };

  const aplicarValvulaAtestarDoStock = (artigoSelecionado: Partial<ArtigoJangada>) => {
    const referencia = String(artigoSelecionado.referencia || artigoSelecionado.codigoFabricante || "").trim();
    if (!referencia) return;

    setForm((prev: FormState) => {
      const next: FormState = {
        ...prev,
        valvulasAtestar: referencia,
      };
      scheduleAutosave(next);
      return next;
    });
  };

  const aplicarTuboSuperiorDoStock = (artigoSelecionado: Partial<ArtigoJangada>) => {
    const referencia = String(artigoSelecionado.referencia || artigoSelecionado.codigoFabricante || "").trim();
    const descricao = String(artigoSelecionado.name || "").trim();
    if (!referencia && !descricao) return;
    setForm((prev: FormState) => {
      const next: FormState = {
        ...prev,
        cylinderTuboCamaraSuperiorRef: referencia,
        cylinderTuboCamaraSuperiorDescricao: descricao,
      };
      scheduleAutosave(next);
      return next;
    });
  };

  const aplicarTuboInferiorDoStock = (artigoSelecionado: Partial<ArtigoJangada>) => {
    const referencia = String(artigoSelecionado.referencia || artigoSelecionado.codigoFabricante || "").trim();
    const descricao = String(artigoSelecionado.name || "").trim();
    if (!referencia && !descricao) return;
    setForm((prev: FormState) => {
      const next: FormState = {
        ...prev,
        cylinderTuboCamaraInferiorRef: referencia,
        cylinderTuboCamaraInferiorDescricao: descricao,
      };
      scheduleAutosave(next);
      return next;
    });
  };

  const adicionarAcessorioSuperior = (artigoSelecionado: Partial<ArtigoJangada>) => {
    const referencia = String(artigoSelecionado.referencia || artigoSelecionado.codigoFabricante || "").trim();
    if (!referencia) return;
    const descricao = String(artigoSelecionado.name || "").trim();
    const codigoFabricante = String(artigoSelecionado.codigoFabricante || "").trim();
    setForm((prev: FormState) => {
      const existentes = parseStockSelectionList(prev.cylinderAcessoriosCamaraSuperiorJson ?? raft?.cylinderAcessoriosCamaraSuperiorJson);
      const exists = existentes.some((x) => normalizeReference(x.referencia) === normalizeReference(referencia));
      const nextList = exists
        ? existentes
        : [...existentes, { referencia, descricao: descricao || undefined, codigoFabricante: codigoFabricante || undefined }];
      const next: FormState = { ...prev, cylinderAcessoriosCamaraSuperiorJson: JSON.stringify(nextList) };
      scheduleAutosave(next);
      return next;
    });
  };

  const adicionarAcessorioInferior = (artigoSelecionado: Partial<ArtigoJangada>) => {
    const referencia = String(artigoSelecionado.referencia || artigoSelecionado.codigoFabricante || "").trim();
    if (!referencia) return;
    const descricao = String(artigoSelecionado.name || "").trim();
    const codigoFabricante = String(artigoSelecionado.codigoFabricante || "").trim();
    setForm((prev: FormState) => {
      const existentes = parseStockSelectionList(prev.cylinderAcessoriosCamaraInferiorJson ?? raft?.cylinderAcessoriosCamaraInferiorJson);
      const exists = existentes.some((x) => normalizeReference(x.referencia) === normalizeReference(referencia));
      const nextList = exists
        ? existentes
        : [...existentes, { referencia, descricao: descricao || undefined, codigoFabricante: codigoFabricante || undefined }];
      const next: FormState = { ...prev, cylinderAcessoriosCamaraInferiorJson: JSON.stringify(nextList) };
      scheduleAutosave(next);
      return next;
    });
  };

  const removerAcessorioSuperior = (referencia: string) => {
    setForm((prev: FormState) => {
      const existentes = parseStockSelectionList(prev.cylinderAcessoriosCamaraSuperiorJson ?? raft?.cylinderAcessoriosCamaraSuperiorJson);
      const nextList = existentes.filter((x) => normalizeReference(x.referencia) !== normalizeReference(referencia));
      const next: FormState = { ...prev, cylinderAcessoriosCamaraSuperiorJson: JSON.stringify(nextList) };
      scheduleAutosave(next);
      return next;
    });
  };

  const removerAcessorioInferior = (referencia: string) => {
    setForm((prev: FormState) => {
      const existentes = parseStockSelectionList(prev.cylinderAcessoriosCamaraInferiorJson ?? raft?.cylinderAcessoriosCamaraInferiorJson);
      const nextList = existentes.filter((x) => normalizeReference(x.referencia) !== normalizeReference(referencia));
      const next: FormState = { ...prev, cylinderAcessoriosCamaraInferiorJson: JSON.stringify(nextList) };
      scheduleAutosave(next);
      return next;
    });
  };

  // Funções para exportar
  const exportarExcel = async () => {
    setExporting('excel');
    try {
      const res = await fetch('/api/export/excel');
      const data = await res.json();
      if (data.success) alert('Exportação Excel concluída!');
      else alert('Erro ao exportar Excel: ' + (data.error || data.message));
    } finally {
      setExporting(null);
    }
  };
  const exportarPDF = async () => {
    setExporting('pdf');
    try {
      const res = await fetch('/api/export/pdf');
      const data = await res.json();
      if (data.success) alert('Exportação PDF concluída!');
      else alert('Erro ao exportar PDF: ' + (data.error || data.message));
    } finally {
      setExporting(null);
    }
  };

  const dossierFocusButtons = [
    { key: 'overview' as const, label: 'Visão geral', blockId: 'section-dossier-overview' },
    { key: 'timeline' as const, label: 'Timeline', blockId: 'section-dossier-timeline' },
    { key: 'documents' as const, label: 'Documentos', blockId: 'section-dossier-docs' },
    { key: 'observacoes' as const, label: 'Observações', blockId: 'section-dossier-observacoes' },
    { key: 'deadlines' as const, label: 'Prazos', blockId: 'section-dossier-docs' },
    { key: 'all' as const, label: 'Ver tudo', blockId: 'section-dossier-overview' },
  ];

  const getDossierPanelClassName = (panel: 'timeline' | 'documents' | 'observacoes' | 'deadlines') => {
    const isFocused = dossierFocus === panel;
    return isFocused
      ? 'ring-2 ring-offset-2 ring-sky-300 border-sky-300 bg-sky-50/40'
      : 'border-slate-200';
  };

  return (
    <div className="min-h-screen bg-gray-50 py-8">
      <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        {/* Certifique-se de que a função está definida acima deste ponto */}
        {/* Resumo dos certificados 2025, se função existir */}
        {/* Resumo dos certificados 2025 removido pois função não existe */}
        {/* Imagem técnica do contentor */}
        <ContainerImage
          containerModel={String(form.containerModel || raft?.containerModel || "")}
          lotacao={currentCapacity || ""}
        />
        <div className="mb-4 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
          <div className="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
            <div>
              <div className="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                <span>Ficha técnica da jangada</span>
                <span className={`rounded-full border px-2 py-1 normal-case tracking-normal ${raftStatusTone.className}`}>
                  {raftStatusTone.label}
                </span>
              </div>
              <h1 className="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{raftTitle || "Ficha da Jangada"}</h1>
              <p className="mt-2 text-sm text-slate-600">
                Série <b>{raft.serial || "—"}</b> · Armador <b>{ownerDisplay}</b> · Navio <b>{shipDisplay}</b>
              </p>

              <div className="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                {executiveSummaryCards.map((card) => (
                  <div key={card.label} className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <p className="text-xs uppercase tracking-wide text-slate-500">{card.label}</p>
                    <p className={`mt-1 text-xl font-bold ${card.tone}`}>{card.value}</p>
                    <p className="mt-1 text-xs text-slate-600">{card.hint}</p>
                  </div>
                ))}
              </div>
            </div>

            <div className="flex w-full max-w-xl flex-col gap-3 xl:items-end">
              <div className="flex w-full flex-wrap gap-2 xl:justify-end">
                <button
                  type="button"
                  onClick={() => {
                    if (!canEditJangadaPage) return;
                    startProtectedEditSession({ inspectionMode: false, section: "geral" });
                  }}
                  disabled={saving || edit || !canEditJangadaPage}
                  className="rounded-xl bg-yellow-500 px-4 py-2 text-sm font-medium text-white hover:bg-yellow-600 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  {edit ? "Em edição" : "Editar ficha"}
                </button>
                <button
                  type="submit"
                  form="jangada-edit-form"
                  className="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60"
                  disabled={saving || !edit}
                >
                  {saving ? "A guardar..." : (inspectionMode ? "Guardar inspeção" : "Gravar")}
                </button>
                {!edit && canEditJangadaPage ? (
                  <>
                    <button
                      type="button"
                      onClick={abrirModoInspecao}
                      className="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700"
                    >
                      Inspecionar
                    </button>
                    {pausedInspectionDraftInfo ? (
                      <button
                        type="button"
                        onClick={continuarInspecaoPausada}
                        className="rounded-xl bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700"
                        title={`Rascunho guardado em ${pausedInspectionSavedAtLabel}`}
                      >
                        Continuar inspeção
                      </button>
                    ) : null}
                  </>
                ) : (
                  <>
                    {inspectionMode ? (
                      <button
                        type="button"
                        className="rounded-xl bg-sky-100 px-4 py-2 text-sm font-medium text-sky-900 hover:bg-sky-200"
                        onClick={pausarInspecao}
                        disabled={saving}
                      >
                        Pausar inspeção
                      </button>
                    ) : null}
                    <button
                      type="button"
                      className="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60"
                      onClick={reporAlteracoesEmEdicao}
                      disabled={saving}
                    >
                      Repor alterações
                    </button>
                  </>
                )}
              </div>

              <div className="flex w-full flex-wrap gap-2 xl:justify-end">
                <button
                  type="button"
                  onClick={() => scrollToSection('geral')}
                  className="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
                >
                  Focar dados gerais
                </button>
                <button
                  type="button"
                  onClick={() => scrollToSection('pack')}
                  className="rounded-xl border border-cyan-200 bg-cyan-50 px-4 py-2 text-sm font-medium text-cyan-800 transition hover:bg-cyan-100"
                >
                  Focar pack obrigatório
                </button>
                <button
                  type="button"
                  onClick={() => setShowExecutiveOverview((prev) => !prev)}
                  className="rounded-xl border border-slate-300 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
                >
                  {showExecutiveOverview ? "Minimizar cockpit executivo" : "Abrir cockpit executivo"}
                </button>
                {raft.shipId ? (
                  <Link
                    href={`/navios/${raft.shipId}`}
                    className="rounded-xl border border-cyan-200 bg-cyan-50 px-4 py-2 text-sm font-medium text-cyan-800 transition hover:bg-cyan-100"
                  >
                    Ver navio associado
                  </Link>
                ) : null}
              </div>

              <div className="w-full rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
                A ficha abre com leitura executiva, mas a zona de trabalho passa a privilegiar acordeões simples: <b>Dados Gerais</b> e <b>Pack Obrigatório</b> ficam sempre em destaque e o resto entra só quando fizer falta.
              </div>
            </div>
          </div>
        </div>

        {showExecutiveOverview ? (
          <>
        <div className="app-hero-panel mb-4 overflow-hidden rounded-3xl text-white">
          <div className="grid gap-6 p-4 xl:grid-cols-[minmax(0,1.4fr)_minmax(320px,0.9fr)] lg:p-5 xl:p-6">
            <div>
              <div className="mb-3 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-cyan-100/90">
                <span>Ficha técnica da jangada</span>
                <span className={`rounded-full border px-2 py-1 normal-case tracking-normal ${raftStatusTone.className}`}>
                  {raftStatusTone.label}
                </span>
                {pausedInspectionDraftInfo ? (
                  <span className="rounded-full border border-sky-200 bg-sky-100 px-2 py-1 normal-case tracking-normal text-sky-900">
                    Inspeção pausada · {pausedInspectionSavedAtLabel}
                    {pausedInspectionDraftInfo.inspectionWizardStep >= 0 ? ` · passo ${pausedInspectionDraftInfo.inspectionWizardStep + 1}` : ""}
                  </span>
                ) : null}
              </div>

              <h1 className="text-3xl font-bold tracking-tight text-white sm:text-4xl">{raftTitle || "Ficha da Jangada"}</h1>
              <p className="mt-2 max-w-3xl text-sm text-slate-200 sm:text-base">
                Serial <b>{raft.serial || "—"}</b> · Armador <b>{ownerDisplay}</b> · Navio <b>{shipDisplay}</b>
              </p>

              <div className="mt-4 flex flex-wrap gap-2">
                <span className="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold text-white/90">
                  Certificados 2025: {certs2025.length}
                </span>
                <span className="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold text-white/90">
                  Anos inspeção: {testYearsSummary.inspecao.length ? testYearsSummary.inspecao.join(", ") : "—"}
                </span>
                <span className="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold text-white/90">
                  Teste hid.: {testYearsSummary.hidraulico.length ? testYearsSummary.hidraulico.join(", ") : "—"}
                </span>
                {raft.shipId ? (
                  <Link
                    href={`/navios/${raft.shipId}`}
                    className="rounded-full border border-cyan-200 bg-cyan-100 px-3 py-1 text-xs font-semibold text-cyan-900 transition-colors hover:bg-cyan-200"
                  >
                    Ver navio associado
                  </Link>
                ) : null}
              </div>

              <div className="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                {executiveSummaryCards.map((card) => (
                  <div key={card.label} className="app-hero-card-soft rounded-2xl p-4">
                    <p className="text-xs uppercase tracking-wide text-slate-200">{card.label}</p>
                    <p className={`mt-1 text-2xl font-bold ${card.tone}`}>{card.value}</p>
                    <p className="mt-1 text-xs text-slate-200">{card.hint}</p>
                  </div>
                ))}
              </div>
            </div>

            <div className="app-hero-card rounded-3xl p-5">
              <p className="text-sm font-semibold text-white">Ações rápidas</p>
              <div className="mt-4 flex flex-wrap gap-2">
                <button
                  type="button"
                  onClick={() => {
                    if (!canEditJangadaPage) return;
                    startProtectedEditSession({ inspectionMode: false, section: "geral" });
                  }}
                  disabled={saving || edit || !canEditJangadaPage}
                  className="rounded-xl bg-yellow-500 px-4 py-2 text-sm font-medium text-white hover:bg-yellow-600 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  {edit ? "Em edição" : "Editar ficha"}
                </button>
                <button
                  type="submit"
                  form="jangada-edit-form"
                  className="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60"
                  disabled={saving || !edit}
                >
                  {saving ? "A guardar..." : (inspectionMode ? "Guardar inspeção" : "Gravar")}
                </button>
                {!edit && canEditJangadaPage ? (
                  <>
                    <button
                      type="button"
                      onClick={abrirModoInspecao}
                      className="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700"
                    >
                      Inspecionar
                    </button>
                    {pausedInspectionDraftInfo ? (
                      <button
                        type="button"
                        onClick={continuarInspecaoPausada}
                        className="rounded-xl bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700"
                        title={`Rascunho guardado em ${pausedInspectionSavedAtLabel}`}
                      >
                        Continuar inspeção
                      </button>
                    ) : null}
                  </>
                ) : (
                  <>
                    {inspectionMode ? (
                      <button
                        type="button"
                        className="rounded-xl bg-sky-100 px-4 py-2 text-sm font-medium text-sky-900 hover:bg-sky-200"
                        onClick={pausarInspecao}
                        disabled={saving}
                      >
                        Pausar inspeção
                      </button>
                    ) : null}
                    <button
                      type="button"
                      className="rounded-xl bg-white/15 px-4 py-2 text-sm font-medium text-white hover:bg-white/20 disabled:cursor-not-allowed disabled:opacity-60"
                      onClick={reporAlteracoesEmEdicao}
                      disabled={saving}
                    >
                      Repor alterações
                    </button>
                  </>
                )}
              </div>

              <div className="mt-4 grid gap-3 text-sm">
                <div className="app-hero-card-soft rounded-2xl px-4 py-3">
                  <p className="text-slate-200">Certificado ativo</p>
                  <p className="mt-1 font-semibold text-white">{String(form.ultimoCertificadoNumero || raft.ultimoCertificadoNumero || certificadoPreferencial?.certificadoNumero || ultimaInspecao?.certificadoNumero || "—")}</p>
                </div>
                {primarySmartAction ? (
                  <button
                    type="button"
                    onClick={primarySmartAction.onAction}
                    className="app-hero-card-soft rounded-2xl border border-cyan-300/40 px-4 py-3 text-left transition hover:bg-white/20 hover:shadow-sm"
                  >
                    <div className="flex items-center justify-between gap-2">
                      <p className="text-slate-200">Próxima ação recomendada</p>
                      <span className="rounded-full border border-cyan-200/50 bg-cyan-100/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-cyan-100">
                        {primarySmartAction.source}
                      </span>
                    </div>
                    <p className="mt-1 font-semibold text-white">{primarySmartAction.title}</p>
                    <p className="mt-1 text-xs text-slate-200">{primarySmartAction.description}</p>
                    <p className="mt-2 text-[11px] text-cyan-100/90">
                      <span className="font-semibold">Porque agora:</span> {primarySmartAction.whyUrgent}
                    </p>
                    <p className="mt-3 text-[11px] font-semibold uppercase tracking-wide text-cyan-100">
                      {primarySmartAction.urgencyBadge} · {primarySmartAction.actionLabel}
                    </p>
                  </button>
                ) : null}
                <div className="app-hero-card-soft rounded-2xl px-4 py-3">
                  <p className="text-slate-200">{packagingLabel} e sistema</p>
                  <p className="mt-1 font-semibold text-white">{currentContainerLabel || "—"} · {currentInflationSystemLabel || "—"}</p>
                </div>
                <div className="app-hero-card-soft rounded-2xl px-4 py-3">
                  <p className="text-slate-200">Modo de edição</p>
                  <p className="mt-1 font-semibold text-white">
                    {editSessionLockedUntil && editSessionLockedUntil > Date.now()
                      ? "Edição protegida durante 1 minuto"
                      : "A ficha mantém-se em edição até gravares"}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div className="mb-4 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm" id="section-dossier-overview">
          <div className="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Dossiê digital da jangada</p>
              <h2 className="mt-1 text-xl font-bold text-slate-900">Resumo 360º operacional</h2>
              <p className="mt-1 max-w-3xl text-sm text-slate-600">
                Estado da ficha, prazos, documentos e histórico recente — tudo junto no mesmo cockpit, sem caça ao tesouro. 🛟
              </p>
            </div>
            <div className="flex flex-wrap gap-2">
              <span className={`rounded-full border px-3 py-1 text-xs font-semibold ${dossierCounts.overdue > 0 ? 'border-rose-200 bg-rose-50 text-rose-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700'}`}>
                {dossierCounts.overdue > 0 ? `${dossierCounts.overdue} prazo(s) atrasado(s)` : 'Sem atrasos'}
              </span>
              <span className={`rounded-full border px-3 py-1 text-xs font-semibold ${dossierCounts.dueSoon > 0 ? 'border-amber-200 bg-amber-50 text-amber-700' : 'border-slate-200 bg-slate-50 text-slate-700'}`}>
                {dossierCounts.dueSoon > 0 ? `${dossierCounts.dueSoon} a vencer em 30 dias` : 'Sem vencimentos imediatos'}
              </span>
            </div>
          </div>

          <div className="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-3">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p className="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Índice do dossier</p>
                <p className="mt-1 text-xs text-slate-600">Escolhe um foco e a ficha destaca a zona certa do dossier.</p>
              </div>
              <div className="flex flex-wrap gap-2">
                {dossierFocusButtons.map((button) => {
                  const isActive = dossierFocus === button.key;
                  return (
                    <button
                      key={`dossier-focus-${button.key}`}
                      type="button"
                      onClick={() => focusDossierBlock(button.key, button.blockId)}
                      className={`rounded-full border px-3 py-1.5 text-xs font-semibold transition ${isActive ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-100'}`}
                    >
                      {button.label}
                    </button>
                  );
                })}
              </div>
            </div>
          </div>

          <div className="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            {dossierSummaryCards.map((card) => (
              <button
                key={card.label}
                type="button"
                onClick={card.label === 'Prazos vencidos'
                  ? () => focusDossierBlock('deadlines', 'section-dossier-docs')
                  : card.label === 'A vencer em 30 dias'
                    ? () => focusDossierBlock('timeline', 'section-dossier-timeline')
                    : card.label === 'Documentos / evidências'
                      ? () => focusDossierBlock('documents', 'section-dossier-docs')
                      : card.onClick}
                className="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-left transition hover:bg-slate-100 hover:shadow-sm"
              >
                <p className="text-xs uppercase tracking-wide text-slate-500">{card.label}</p>
                <p className={`mt-1 text-2xl font-bold ${card.tone}`}>{card.value}</p>
                <p className="mt-1 text-xs text-slate-600">{card.hint}</p>
                <p className="mt-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500">{card.actionLabel}</p>
              </button>
            ))}
          </div>

          <button
            type="button"
            onClick={() => focusDossierBlock('observacoes', 'section-dossier-observacoes')}
            className={`mt-4 w-full rounded-2xl border px-4 py-4 text-left transition hover:-translate-y-0.5 hover:shadow-sm ${hasObservacoesDossier ? 'border-fuchsia-200 bg-fuchsia-50 text-fuchsia-950' : 'border-slate-200 bg-slate-50 text-slate-800'}`}
          >
            <div className="flex flex-wrap items-start justify-between gap-3">
              <div>
                <div className="flex flex-wrap items-center gap-2">
                  <span className="rounded-full border border-current/15 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] opacity-80">
                    {hasObservacoesDossier ? '📝 Observações em destaque' : '📝 Observações disponíveis'}
                  </span>
                  <span className="rounded-full border border-current/15 bg-white/70 px-2 py-0.5 text-[11px] font-semibold opacity-80">
                    {observacoesMetaLabel}
                  </span>
                </div>
                <p className="mt-3 text-sm font-semibold">{hasObservacoesDossier ? 'Resumo rápido das notas do dossiê' : 'Ainda não há notas nesta ficha'}</p>
                <p className="mt-1 text-sm leading-6 opacity-90">{observacoesPreview}</p>
              </div>
              <span className="inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-[0.18em] opacity-75">
                Abrir observações<span aria-hidden="true">→</span>
              </span>
            </div>
          </button>

          <div className="mt-4 grid gap-4 xl:grid-cols-[0.72fr_1.28fr]">
            <section className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div className="flex items-center justify-between gap-3">
                <div>
                  <h3 className="text-base font-semibold text-slate-900">Health score da jangada</h3>
                  <p className="mt-1 text-xs text-slate-500">Leitura instantânea do equilíbrio técnico, documental e operacional.</p>
                </div>
                <span className={`inline-flex rounded-full border px-3 py-1 text-[11px] font-semibold ${raftHealthTone.badge}`}>
                  {raftHealthTone.label}
                </span>
              </div>

              <div className="mt-5 flex flex-col gap-5 lg:flex-row lg:items-center">
                <div className="relative mx-auto h-36 w-36 lg:mx-0">
                  <svg viewBox="0 0 120 120" className="h-36 w-36 -rotate-90">
                    <circle cx="60" cy="60" r="45" className="fill-none stroke-slate-200" strokeWidth="10" />
                    <circle
                      cx="60"
                      cy="60"
                      r="45"
                      className={`fill-none ${raftHealthTone.ring}`}
                      strokeWidth="10"
                      strokeLinecap="round"
                      strokeDasharray="282.743"
                      strokeDashoffset={raftHealthStrokeOffset}
                    />
                  </svg>
                  <div className="absolute inset-0 flex flex-col items-center justify-center text-center">
                    <span className={`text-4xl font-extrabold ${raftHealthTone.text}`}>{raftHealthScore}</span>
                    <span className="mt-1 text-[11px] font-semibold uppercase tracking-wide text-slate-500">score</span>
                  </div>
                </div>

                <div className="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2">
                  {raftHealthBreakdown.map((item) => (
                    <button
                      key={item.label}
                      type="button"
                      onClick={item.onClick}
                      className={`rounded-2xl border p-3 text-left transition hover:scale-[1.01] hover:shadow-sm ${getPremiumCardTone(item.kind)}`}
                    >
                      <div className="text-[11px] uppercase tracking-wide opacity-70">{item.label}</div>
                      <div className="mt-2 text-2xl font-bold">{item.value}</div>
                      <div className="mt-1 text-xs opacity-90">{item.hint}</div>
                      {item.actionLabel ? (
                        <div className="mt-3 text-[11px] font-semibold uppercase tracking-wide opacity-80">{item.actionLabel}</div>
                      ) : null}
                    </button>
                  ))}
                </div>
              </div>
            </section>

            <section className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div className="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h3 className="text-base font-semibold text-slate-900">Radar premium da ficha</h3>
                  <p className="mt-1 text-xs text-slate-500">Resumo executivo do que merece olhos primeiro.</p>
                </div>
                <span className="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-semibold text-slate-700">
                  cockpit rápido
                </span>
              </div>

              <div className="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-3">
                {raftSpotlightCards.map((card) => (
                  <button
                    key={card.title}
                    type="button"
                    onClick={card.onClick}
                    disabled={!card.onClick}
                    className={`rounded-2xl border p-4 text-left transition ${getPremiumCardTone(card.kind)} ${card.onClick ? 'cursor-pointer hover:scale-[1.01] hover:shadow-sm' : 'cursor-default'}`}
                  >
                    <div className="text-[11px] uppercase tracking-wide opacity-70">{card.title}</div>
                    <div className="mt-2 text-2xl font-bold">{card.value}</div>
                    <div className="mt-2 text-xs opacity-90">{card.description}</div>
                    {card.actionLabel ? (
                      <div className="mt-3 text-[11px] font-semibold uppercase tracking-wide opacity-80">
                        {card.actionLabel}
                      </div>
                    ) : null}
                  </button>
                ))}
              </div>

              <div className="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div className="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Próximos focos</div>
                <div className="mt-3 space-y-3">
                  {raftNextFocusActions.length > 0 ? raftNextFocusActions.map((action, index) => (
                    <div key={`${action.title}-${index}`} className="flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-3 sm:flex-row sm:items-center sm:justify-between">
                      <div>
                        <div className="flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-900">
                          <span>{action.title}</span>
                          <span className="rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-600">{action.urgencyBadge}</span>
                        </div>
                        <div className="mt-1 text-xs text-slate-600">{action.detail}</div>
                        <div className="mt-1 text-[11px] text-slate-500"><span className="font-semibold">Porque agora:</span> {action.whyUrgent}</div>
                      </div>
                      <button
                        type="button"
                        onClick={action.onClick}
                        className="inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100"
                      >
                        {action.cta}
                      </button>
                    </div>
                  )) : (
                    <div className="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-3 text-sm text-emerald-900">
                      Sem focos quentes neste momento — boa altura para manutenção preventiva e arrumação fina do dossiê.
                    </div>
                  )}
                </div>
              </div>
            </section>
          </div>

          <div className="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 className="text-base font-semibold text-slate-900">Scores por categoria</h3>
                <p className="mt-1 text-xs text-slate-500">A ficha repartida em frentes operacionais para perceber onde apertar primeiro.</p>
              </div>
              <span className="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-semibold text-slate-700">leitura tática</span>
            </div>

            <div className="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
              {raftCategoryScores.map((item) => (
                <button
                  key={item.label}
                  type="button"
                  onClick={item.onClick}
                  className={`rounded-2xl border p-4 text-left transition hover:scale-[1.01] hover:shadow-sm ${getPremiumCategoryScoreTone(item.score)}`}
                >
                  <div className="flex items-start justify-between gap-3">
                    <div>
                      <div className="text-[11px] uppercase tracking-wide opacity-70">{item.label}</div>
                      <div className="mt-2 text-3xl font-extrabold">{item.score}</div>
                    </div>
                    <span className="rounded-full border border-current/15 px-2 py-0.5 text-[11px] font-semibold">/100</span>
                  </div>
                  <div className="mt-2 text-xs opacity-90">{item.detail}</div>
                  {item.actionLabel ? (
                    <div className="mt-3 text-[11px] font-semibold uppercase tracking-wide opacity-80">{item.actionLabel}</div>
                  ) : null}
                </button>
              ))}
            </div>
          </div>

          <div className="mt-4 rounded-2xl border border-slate-200 bg-gradient-to-r from-slate-50 via-white to-amber-50/60 p-4 shadow-sm">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 className="text-sm font-semibold text-slate-900">Ações rápidas do dossiê</h3>
                <p className="mt-1 text-xs text-slate-500">Atalhos premium para arrancar trabalho, saltar de secção e abrir a OT sem voltas extra.</p>
              </div>
              <span className="rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-[11px] font-semibold text-amber-800">workflow expresso</span>
            </div>

            <div className="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
              {dossierQuickActions.map((action) => {
                const eyebrow = action.key === 'service-order'
                  ? 'Ordem de serviço'
                  : action.key === 'inspect'
                    ? 'Inspeção'
                    : action.key === 'timeline'
                      ? 'Timeline'
                      : action.key === 'docs'
                        ? 'Documentação'
                        : action.key === 'observacoes'
                          ? 'Observações'
                        : action.key === 'history'
                          ? 'Histórico'
                          : 'Evidências';
                const description = action.key === 'service-order'
                  ? 'Cria uma OT já ligada à jangada para manter o fio à meada da última inspeção.'
                  : action.key === 'inspect'
                    ? 'Entra diretamente no fluxo de inspeção ou retoma o rascunho pausado.'
                    : action.key === 'timeline'
                      ? 'Salta para a timeline unificada com inspeções, certificados e eventos recentes.'
                      : action.key === 'docs'
                        ? 'Vai para a área de documentos e certificados sem andar a pescar separadores.'
                      : action.key === 'observacoes'
                        ? 'Leva-te diretamente ao campo de observações do dossiê para registar contexto técnico e operacional.'
                        : action.key === 'history'
                          ? 'Abre o histórico operacional completo da jangada.'
                          : 'Mostra a zona de evidências com anexos, imagens e ficheiros recentes.';

                return (
                  <button
                    key={action.key}
                    type="button"
                    onClick={action.onClick}
                    className={`group flex h-full flex-col items-start rounded-2xl border px-4 py-4 text-left transition hover:-translate-y-0.5 hover:shadow-sm ${action.className}`}
                  >
                    <div className="flex w-full flex-wrap items-center justify-between gap-2">
                      <span className="rounded-full border border-current/15 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] opacity-75">
                        {action.key === 'observacoes' ? `${hasObservacoesDossier ? '📝 ' : ''}${eyebrow}` : eyebrow}
                      </span>
                      {action.key === 'observacoes' ? (
                        <span className={`rounded-full border px-2 py-0.5 text-[10px] font-semibold ${hasObservacoesDossier ? 'border-current/15 bg-white/70 opacity-90' : 'border-current/10 bg-white/50 opacity-70'}`}>
                          {hasObservacoesDossier ? observacoesMetaLabel : 'vazio'}
                        </span>
                      ) : null}
                    </div>
                    <span className="mt-3 text-sm font-semibold">{action.label}</span>
                    <span className="mt-1 text-xs leading-5 opacity-85">{description}</span>
                    {action.key === 'observacoes' ? (
                      <span className="mt-3 line-clamp-2 text-xs leading-5 opacity-80">
                        {observacoesPreview}
                      </span>
                    ) : null}
                    <span className="mt-4 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-[0.18em] opacity-70">
                      Abrir<span aria-hidden="true">→</span>
                    </span>
                  </button>
                );
              })}
              {raft.shipId ? (
                <Link
                  href={`/navios/${raft.shipId}`}
                  className="group flex h-full flex-col items-start rounded-2xl border border-indigo-200 bg-indigo-50 px-4 py-4 text-left text-indigo-900 transition hover:-translate-y-0.5 hover:bg-indigo-100 hover:shadow-sm"
                >
                  <span className="rounded-full border border-indigo-300/70 bg-white/80 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-indigo-700">
                    Navio
                  </span>
                  <span className="mt-3 text-sm font-semibold">Abrir navio associado</span>
                  <span className="mt-1 text-xs leading-5 text-indigo-800/80">Acede já à ficha do navio para cruzar contexto operacional, cliente e equipamentos ligados.</span>
                  <span className="mt-4 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-indigo-700/80">
                    Abrir<span aria-hidden="true">→</span>
                  </span>
                </Link>
              ) : null}
            </div>
          </div>

          <div className="mt-4 grid gap-4 xl:grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)]">
            <div id="section-dossier-timeline" className={`rounded-2xl border p-4 transition-all ${getDossierPanelClassName('timeline')}`}>
              <div className="flex items-center justify-between gap-2">
                <div>
                  <h3 className="text-sm font-semibold text-slate-900">Timeline / histórico unificado</h3>
                  <p className="mt-1 text-xs text-slate-500">Inspeções, certificados, fila operacional e evidências recentes.</p>
                </div>
                <button
                  type="button"
                  onClick={() => scrollToSection('historico')}
                  className="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-50"
                >
                  Histórico completo
                </button>
              </div>

              <div className="mt-4 space-y-3">
                {dossierTimeline.length > 0 ? dossierTimeline.map((item) => {
                  const kindClasses = item.kind === 'inspecao'
                    ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
                    : item.kind === 'certificado'
                      ? 'border-blue-200 bg-blue-50 text-blue-700'
                      : item.kind === 'evidencia'
                        ? 'border-cyan-200 bg-cyan-50 text-cyan-700'
                        : item.kind === 'operacao'
                          ? 'border-amber-200 bg-amber-50 text-amber-700'
                          : 'border-slate-200 bg-slate-50 text-slate-700';

                  return (
                    <div key={item.id} className="rounded-2xl border border-slate-200 bg-slate-50 p-3">
                      <div className="flex flex-wrap items-start justify-between gap-2">
                        <div>
                          <div className="flex flex-wrap items-center gap-2">
                            <p className="text-sm font-semibold text-slate-900">{item.title}</p>
                            {item.badge ? (
                              <span className={`rounded-full border px-2 py-0.5 text-[11px] font-semibold ${kindClasses}`}>
                                {item.badge}
                              </span>
                            ) : null}
                          </div>
                          <p className="mt-1 text-xs text-slate-600">{item.detail || 'Sem detalhe adicional.'}</p>
                        </div>
                        <div className="text-right text-xs text-slate-500">
                          <p>{item.date ? formatDatePt(item.date) : '—'}</p>
                          {item.href ? (
                            <a href={item.href} target="_blank" rel="noreferrer" className="mt-1 inline-flex font-medium text-cyan-700 hover:text-cyan-800">
                              Abrir
                            </a>
                          ) : null}
                        </div>
                      </div>
                    </div>
                  );
                }) : (
                  <div className="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-500">
                    Ainda não há eventos suficientes para compor a timeline desta jangada.
                  </div>
                )}
              </div>
            </div>

            <div className="space-y-4" id="section-dossier-docs">
              <div className={`rounded-2xl border p-4 transition-all ${getDossierPanelClassName('documents')}`}>
                <div className="flex items-center justify-between gap-2">
                  <div>
                    <h3 className="text-sm font-semibold text-slate-900">Documentos & certificados</h3>
                    <p className="mt-1 text-xs text-slate-500">Certificados associados à ficha e evidências multimédia recentes.</p>
                  </div>
                  <button
                    type="button"
                    onClick={() => scrollToSection('evidencias')}
                    className="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-50"
                  >
                    Ver separador
                  </button>
                </div>

                <div className="mt-4 space-y-3">
                  {certificateDocuments.length > 0 ? certificateDocuments.map((cert) => (
                    <div key={`cert-${String(cert.id)}`} className="rounded-2xl border border-blue-100 bg-blue-50 p-3">
                      <div className="flex flex-wrap items-start justify-between gap-2">
                        <div>
                          <p className="text-sm font-semibold text-slate-900">{String(cert.certificadoNumero || cert.fileName || `Certificado #${String(cert.id)}`)}</p>
                          <p className="mt-1 text-xs text-slate-600">
                            {cert.dataInspecao ? `Inspeção ${formatDatePt(cert.dataInspecao)}` : 'Sem data de inspeção'}
                            {cert.dataProxInspecao ? ` · Próxima ${formatDatePt(cert.dataProxInspecao)}` : ''}
                          </p>
                        </div>
                        <span className={`rounded-full border px-2 py-0.5 text-[11px] font-semibold ${String(cert.id) === String(certificadoPreferencial?.id ?? '') ? 'border-blue-200 bg-white text-blue-700' : 'border-slate-200 bg-white text-slate-600'}`}>
                          {String(cert.id) === String(certificadoPreferencial?.id ?? '') ? 'Ativo' : `Ano ${String(cert.sourceYear || '—')}`}
                        </span>
                      </div>
                    </div>
                  )) : (
                    <div className="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-500">
                      Sem certificados extraídos associados a esta jangada.
                    </div>
                  )}

                  {evidenceDocuments.length > 0 ? evidenceDocuments.map((file) => (
                    <a
                      key={`evidence-${file.name}`}
                      href={file.url}
                      target="_blank"
                      rel="noreferrer"
                      className="block rounded-2xl border border-cyan-100 bg-cyan-50 p-3 transition hover:bg-cyan-100"
                    >
                      <div className="flex flex-wrap items-start justify-between gap-2">
                        <div>
                          <p className="text-sm font-semibold text-slate-900">{file.originalName || file.name}</p>
                          <p className="mt-1 text-xs text-slate-600">
                            {file.uploadedAt ? `Carregado em ${formatDatePt(file.uploadedAt)}` : 'Sem data de upload'} · {formatFileSize(file.size)}
                          </p>
                        </div>
                        <span className="rounded-full border border-cyan-200 bg-white px-2 py-0.5 text-[11px] font-semibold text-cyan-700">Abrir</span>
                      </div>
                    </a>
                  )) : null}
                </div>
              </div>

              <div className={`rounded-2xl border p-4 transition-all ${getDossierPanelClassName('observacoes')}`} id="section-dossier-observacoes">
                <div className="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h3 className="text-sm font-semibold text-slate-900">Observações do dossiê</h3>
                    <p className="mt-1 text-xs text-slate-500">Notas livres para contexto técnico, logística, alertas do cliente ou qualquer detalhe que valha a pena não deixar fugir.</p>
                  </div>
                  {canEditJangadaPage && !edit ? (
                    <button
                      type="button"
                      onClick={() => startProtectedEditSession({ inspectionMode: false, section: 'geral' })}
                      className="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-3 py-1.5 text-xs font-medium text-fuchsia-800 transition hover:bg-fuchsia-100"
                    >
                      Editar observações
                    </button>
                  ) : null}
                </div>

                <div className="mt-4 rounded-2xl border border-fuchsia-100 bg-fuchsia-50/60 p-3">
                  {edit && canEditJangadaPage ? (
                    <>
                      <label htmlFor="raft-dossier-observacoes" className="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-fuchsia-800">
                        Campo livre do dossiê
                      </label>
                      <textarea
                        id="raft-dossier-observacoes"
                        rows={6}
                        value={String(form.observacoes || '')}
                        onChange={(e) => {
                          const value = e.target.value;
                          setForm((prev: FormState) => ({
                            ...prev,
                            observacoes: value,
                          }));
                        }}
                        placeholder="Ex.: observações do cliente, danos visuais, contexto operacional, pendências de entrega ou notas técnicas da última intervenção."
                        className="w-full rounded-xl border border-fuchsia-200 bg-white px-3 py-3 text-sm text-slate-800 shadow-sm outline-none transition focus:border-fuchsia-400 focus:ring-2 focus:ring-fuchsia-200"
                      />
                      <p className="mt-2 text-xs text-slate-500">Estas observações são guardadas na ficha da jangada quando gravares as alterações.</p>
                    </>
                  ) : (
                    <div className="rounded-xl border border-white/80 bg-white px-4 py-3 text-sm leading-6 text-slate-700 shadow-sm">
                      {String(form.observacoes || raft?.observacoes || '').trim() || 'Sem observações registadas nesta jangada.'}
                    </div>
                  )}
                </div>
              </div>

              <div className={`rounded-2xl border p-4 transition-all ${getDossierPanelClassName('deadlines')}`}>
                <h3 className="text-sm font-semibold text-slate-900">Prazos monitorizados</h3>
                <div className="mt-3 space-y-3">
                  {dossierDeadlines.map((item) => {
                    const tone = getDeadlineTone(item.days);
                    return (
                      <div key={item.key} className="rounded-2xl border border-slate-200 bg-slate-50 p-3">
                        <div className="flex flex-wrap items-start justify-between gap-2">
                          <div>
                            <p className="text-sm font-semibold text-slate-900">{item.label}</p>
                            <p className="mt-1 text-xs text-slate-600">{item.description}</p>
                          </div>
                          <span className={`rounded-full border px-2 py-0.5 text-[11px] font-semibold ${tone.className}`}>
                            {tone.badge}
                          </span>
                        </div>
                        <p className="mt-2 text-sm text-slate-700">{item.displayValue}</p>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div className="mb-4 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
          <div className="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Alertas preditivos da jangada</p>
              <h2 className="mt-1 text-xl font-bold text-slate-900">Próximos passos sugeridos antes de virar urgência</h2>
              <p className="mt-1 text-sm text-slate-600">Periodicidade operacional atual: <b>{inspectionCycleLabel}</b> · leitura preditiva do que tende a escalar primeiro.</p>
            </div>
            {recommendedNextInspection ? (
              <div className="rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900">
                <p className="text-xs uppercase tracking-wide text-sky-700">Próxima inspeção recomendada</p>
                <p className="mt-1 text-lg font-bold">{formatDatePt(recommendedNextInspection)}</p>
              </div>
            ) : null}
          </div>

          {phase3Recommendations.length > 0 ? (
            <div className="grid gap-3 xl:grid-cols-2 2xl:grid-cols-4">
              {phase3Recommendations.map((item, index) => (
                <div key={item.key} className={`rounded-2xl border p-4 ${item.tone} ${index === 0 ? 'ring-2 ring-offset-2 ring-current/20 shadow-sm' : ''}`}>
                  <div className="flex flex-wrap items-center gap-2 text-[11px] uppercase tracking-wide opacity-70">
                    <span>Alerta preditivo</span>
                    <span className="rounded-full border border-current/15 bg-white/60 px-2 py-0.5 text-[10px] font-semibold">{item.urgencyBadge}</span>
                  </div>
                  {index === 0 ? (
                    <div className="mt-2 inline-flex rounded-full border border-current/20 bg-white/70 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide">
                      Recomendado agora
                    </div>
                  ) : null}
                  <h3 className="mt-1 text-sm font-semibold">{item.title}</h3>
                  <p className="mt-2 text-xs opacity-90">{item.description}</p>
                  <p className="mt-2 text-[11px] opacity-80"><span className="font-semibold">Porque agora:</span> {item.whyUrgent}</p>
                  <p className="mt-2 text-[10px] font-semibold uppercase tracking-wide opacity-75">Origem: {item.sourceLabel}</p>
                  <button
                    type="button"
                    onClick={item.onAction}
                    className="mt-4 rounded-xl border border-current/20 bg-white/80 px-3 py-2 text-xs font-semibold transition hover:bg-white"
                  >
                    {item.actionLabel}
                  </button>
                </div>
              ))}
            </div>
          ) : (
            <div className="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
              Sem sinais fortes de escalada neste momento — a jangada está alinhada com a regra da próxima inspeção e com boa margem operacional. ✨
            </div>
          )}
        </div>
          </>
        ) : null}

        {edit && (
          <button
            type="submit"
            form="jangada-edit-form"
            className="fixed right-4 bottom-4 z-50 bg-emerald-600 text-white px-4 py-2 rounded-lg shadow-lg hover:bg-emerald-700 text-sm font-medium sm:hidden"
            disabled={saving}
          >
            {saving ? 'A guardar...' : (inspectionMode ? 'Guardar inspeção' : 'Guardar alterações')}
          </button>
        )}

        <div className="sticky top-3 z-20 mb-4 rounded-3xl border border-slate-200 bg-white/95 p-4 shadow-sm backdrop-blur">
          <div className="grid gap-3 xl:grid-cols-2">
            {priorityAccordionCards.map((card) => (
              <button
                key={`priority-${card.key}`}
                type="button"
                onClick={() => togglePrimarySection(card.key)}
                className={`rounded-2xl border p-4 text-left transition hover:shadow-sm ${card.tone}`}
              >
                <div className="flex items-start justify-between gap-3">
                  <div>
                    <div className="text-[11px] uppercase tracking-[0.18em] opacity-70">{card.title}</div>
                    <div className="mt-2 text-lg font-bold">{card.subtitle}</div>
                  </div>
                  <span className="rounded-full border border-current/20 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide">
                    {card.badge}
                  </span>
                </div>
                <div className="mt-2 text-xs opacity-80">{card.detail}</div>
              </button>
            ))}

            <details className="rounded-2xl border border-slate-200 bg-slate-50 p-4 xl:col-span-2">
              <summary className="cursor-pointer list-none text-sm font-semibold text-slate-900">
                Mais secções técnicas
              </summary>
              <p className="mt-2 text-xs text-slate-600">Cilindro, válvulas, contentor, testes, histórico e detalhe técnico ficam recolhidos até serem precisos.</p>
              <div className="mt-3 flex flex-wrap gap-2">
                {sectionButton("cilindro", "Cilindros")}
                {sectionButton("valvulas", "Válvulas")}
                {!isValiseContainer ? sectionButton("contentor", "Contentor") : null}
                {sectionButton("resumo", "Resumo Inspeção")}
                {inspectionMode ? sectionButton("checklist", "Checklist Inspeção") : null}
                {sectionButton("evidencias", "Evidências")}
                {sectionButton("testes", "Testes")}
                {sectionButton("historico", "Histórico de Inspeções")}
                {sectionButton("detalhes", "Detalhes Técnicos")}
              </div>
            </details>
          </div>
                      {activeSection === "historico" && (
                      <div ref={(node) => { sectionRefs.current.historico = node; }} className="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                        <div className="mb-3 flex flex-wrap items-center justify-between gap-3">
                          <div>
                            <h2 className="text-lg font-semibold">Histórico de Inspeções</h2>
                            <p className="text-sm text-gray-600">Podes acrescentar ou corrigir inspeções passadas e registar artigos substituídos com quantidades.</p>
                          </div>
                          {edit && canEditJangadaPage ? (
                            <button
                              type="button"
                              onClick={() => abrirEditorInspecaoHistorica(null)}
                              className="rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-100"
                            >
                              + Adicionar inspeção passada
                            </button>
                          ) : null}
                        </div>
                          {inspecoesVisiveis.length === 0 ? (
                          <div className="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-600">
                            Nenhuma inspeção registrada para esta jangada.
                          </div>
                        ) : (
                          <div className="overflow-x-auto">
                            <table className="min-w-[840px] text-sm">
                              <thead>
                                <tr className="bg-gray-100">
                                  <th className="p-2 text-left">Certificado</th>
                                  <th className="p-2 text-left">Data Inspeção</th>
                                  <th className="p-2 text-left">Próx. Inspeção</th>
                                  <th className="p-2 text-left">Status</th>
                                  <th className="p-2 text-left">Arquivo Origem</th>
                                  {edit && canEditJangadaPage ? <th className="p-2 text-left">Ações</th> : null}
                                </tr>
                              </thead>
                              <tbody>
                                {inspecoesVisiveis.map((insp: Inspecao) => (
                                  <tr key={insp.id} className={`border-t align-top ${historicalInspectionDraft && String(historicalInspectionDraft.id) === String(insp.id) ? 'bg-blue-50' : ''}`}>
                                    <td className="p-2">{insp.certificadoNumero || "—"}</td>
                                    <td className="p-2">{formatDatePt(insp.dataInspecao)}</td>
                                    <td className="p-2">{formatDatePt(insp.dataProxInspecao)}</td>
                                    <td className="p-2">{insp.status || "—"}</td>
                                    <td className="p-2">{insp.sourceFile || "—"}</td>
                                    {edit && canEditJangadaPage ? (
                                      <td className="p-2">
                                        <button
                                          type="button"
                                          disabled={String(insp.id).startsWith('snapshot:')}
                                          onClick={() => abrirEditorInspecaoHistorica(insp)}
                                          className="rounded border border-blue-200 bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-50"
                                        >
                                          Editar
                                        </button>
                                      </td>
                                    ) : null}
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        )}

                        {historicalInspectionDraft ? (
                          <div className="mt-4 rounded-xl border border-blue-200 bg-blue-50 p-4">
                            <div className="flex flex-wrap items-center justify-between gap-3">
                              <div>
                                <h3 className="text-base font-semibold text-blue-900">
                                  {historicalInspectionDraft.id ? 'Editar inspeção passada' : 'Nova inspeção passada'}
                                </h3>
                                <p className="text-sm text-blue-700">Este editor atualiza o histórico da jangada sem mexer no stock atual.</p>
                              </div>
                              <div className="flex gap-2">
                                <button
                                  type="button"
                                  onClick={() => setHistoricalInspectionDraft(null)}
                                  className="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
                                  disabled={historicalInspectionSaveState === 'saving'}
                                >
                                  Cancelar
                                </button>
                                <button
                                  type="button"
                                  onClick={() => void guardarInspecaoHistorica()}
                                  className="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60"
                                  disabled={historicalInspectionSaveState === 'saving'}
                                >
                                  {historicalInspectionSaveState === 'saving' ? 'A guardar...' : 'Guardar inspeção'}
                                </button>
                              </div>
                            </div>

                            {historicalInspectionSaveState === 'error' ? (
                              <div className="mt-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
                                Ocorreu um erro ao guardar a inspeção passada. Revê os dados e tenta novamente.
                              </div>
                            ) : null}

                            <div className="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-5">
                              <div>
                                <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-blue-700">Certificado</label>
                                <input
                                  className="w-full rounded border border-blue-200 bg-white px-3 py-2 text-sm"
                                  value={historicalInspectionDraft.certificadoNumero}
                                  onChange={(e) => atualizarCampoInspecaoHistorica('certificadoNumero', e.target.value)}
                                  placeholder="Número do certificado"
                                />
                              </div>
                              <div>
                                <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-blue-700">Data inspeção</label>
                                <input
                                  type="date"
                                  className="w-full rounded border border-blue-200 bg-white px-3 py-2 text-sm"
                                  value={historicalInspectionDraft.dataInspecao}
                                  onChange={(e) => atualizarCampoInspecaoHistorica('dataInspecao', e.target.value)}
                                />
                              </div>
                              <div>
                                <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-blue-700">Próx. inspeção</label>
                                <input
                                  type="date"
                                  className="w-full rounded border border-blue-200 bg-white px-3 py-2 text-sm"
                                  value={historicalInspectionDraft.dataProxInspecao}
                                  onChange={(e) => atualizarCampoInspecaoHistorica('dataProxInspecao', e.target.value)}
                                />
                              </div>
                              <div>
                                <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-blue-700">Status</label>
                                <input
                                  className="w-full rounded border border-blue-200 bg-white px-3 py-2 text-sm"
                                  value={historicalInspectionDraft.status}
                                  onChange={(e) => atualizarCampoInspecaoHistorica('status', e.target.value)}
                                  placeholder="Concluída"
                                />
                              </div>
                              <div>
                                <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-blue-700">Arquivo origem</label>
                                <input
                                  className="w-full rounded border border-blue-200 bg-white px-3 py-2 text-sm"
                                  value={historicalInspectionDraft.sourceFile}
                                  onChange={(e) => atualizarCampoInspecaoHistorica('sourceFile', e.target.value)}
                                  placeholder="jangada_historico_manual"
                                />
                              </div>
                            </div>

                            <div className="mt-4 rounded-xl border border-white/70 bg-white p-4">
                              <div className="flex flex-wrap items-center justify-between gap-3">
                                <div>
                                  <h4 className="text-sm font-semibold text-slate-900">Artigos substituídos nesta inspeção</h4>
                                  <p className="text-xs text-slate-600">Regista nome, quantidade substituída, validade e referência do que foi substituído nesta inspeção passada.</p>
                                </div>
                                <div className="flex flex-wrap gap-2">
                                  <button
                                    type="button"
                                    onClick={adicionarArtigoManualInspecaoHistorica}
                                    className="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"
                                  >
                                    + Linha manual
                                  </button>
                                  <ArtigoSelector
                                    onSelect={(artigo) => adicionarArtigoStockInspecaoHistorica(artigo)}
                                    buttonLabel="+ Adicionar do stock"
                                    initialQuantity={1}
                                  />
                                </div>
                              </div>

                              {normalizeArtigos(historicalInspectionDraft.artigos).length === 0 ? (
                                <div className="mt-3 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-500">
                                  Ainda não há artigos registados nesta inspeção passada.
                                </div>
                              ) : (
                                <div className="mt-3 overflow-x-auto">
                                  <table className="min-w-[920px] text-sm">
                                    <thead>
                                      <tr className="bg-slate-100 text-slate-700">
                                        <th className="p-2 text-left">Artigo</th>
                                        <th className="p-2 text-left">Qtd. substituída</th>
                                        <th className="p-2 text-left">Validade</th>
                                        <th className="p-2 text-left">Referência</th>
                                        <th className="p-2 text-left">Cód. fabricante</th>
                                        <th className="p-2 text-left">Ações</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      {normalizeArtigos(historicalInspectionDraft.artigos).map((artigo, index) => (
                                        <tr key={`historical-article-${index}`} className="border-t border-slate-200 align-top">
                                          <td className="p-2">
                                            <input
                                              className="w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm"
                                              value={String(artigo.name || '')}
                                              onChange={(e) => atualizarArtigoInspecaoHistorica(index, { name: e.target.value })}
                                              placeholder="Nome do artigo"
                                            />
                                          </td>
                                          <td className="p-2">
                                            <input
                                              type="number"
                                              min={1}
                                              className="w-24 rounded border border-slate-300 bg-white px-2 py-1 text-sm"
                                              value={String(artigo.quantidade || 1)}
                                              onChange={(e) => atualizarArtigoInspecaoHistorica(index, { quantidade: Math.max(1, Number(e.target.value || 1)) })}
                                            />
                                          </td>
                                          <td className="p-2">
                                            <input
                                              className="w-28 rounded border border-slate-300 bg-white px-2 py-1 text-sm"
                                              value={String(artigo.validade || '')}
                                              onChange={(e) => atualizarArtigoInspecaoHistorica(index, { validade: maskMonthYearInput(e.target.value) })}
                                              placeholder="MM/AAAA"
                                            />
                                          </td>
                                          <td className="p-2">
                                            <input
                                              className="w-full rounded border border-slate-300 bg-white px-2 py-1 font-mono text-sm"
                                              value={String(artigo.referencia || '')}
                                              onChange={(e) => atualizarArtigoInspecaoHistorica(index, { referencia: e.target.value })}
                                              onBlur={(e) => atualizarArtigoInspecaoHistorica(index, sincronizarArtigoHistoricoComStockPorReferencia(artigo, e.target.value))}
                                              placeholder="Referência"
                                            />
                                          </td>
                                          <td className="p-2">
                                            <input
                                              className="w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm"
                                              value={String(artigo.codigoFabricante || '')}
                                              onChange={(e) => atualizarArtigoInspecaoHistorica(index, { codigoFabricante: e.target.value })}
                                              placeholder="Código fabricante"
                                            />
                                          </td>
                                          <td className="p-2">
                                            <button
                                              type="button"
                                              onClick={() => removerArtigoInspecaoHistorica(index)}
                                              className="rounded border border-red-200 bg-red-50 px-2 py-1 text-xs font-medium text-red-700 hover:bg-red-100"
                                            >
                                              Remover
                                            </button>
                                          </td>
                                        </tr>
                                      ))}
                                    </tbody>
                                  </table>
                                </div>
                              )}
                            </div>
                          </div>
                        ) : null}
                      </div>
                    )}
        </div>

        <form ref={formTopRef} id="jangada-edit-form" onSubmit={handleSubmit} className="space-y-4">
          <div className="min-w-0 space-y-4">
          <div className="sticky top-[76px] z-20 rounded-3xl border border-slate-200 bg-white/95 p-4 shadow-sm backdrop-blur">
            <div className="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Navegação principal da ficha</p>
                <h2 className="mt-1 text-base font-semibold text-slate-900">Troca rápida entre as secções críticas</h2>
                <p className="mt-1 text-xs text-slate-600">
                  A navegação mantém o rascunho atual e não altera o pack associado. Pack desta jangada: <b>{currentPackLabel || String(form.packType || raft?.packType || 'Sem pack definido')}</b>.
                </p>
              </div>
              <div className="flex flex-wrap gap-2 text-[11px] font-semibold uppercase tracking-wide">
                <span className="rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-cyan-800">
                  Pack atual: {currentPackLabel || String(form.packType || raft?.packType || '—')}
                </span>
                <span className={`rounded-full border px-3 py-1 ${edit ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-slate-200 bg-slate-50 text-slate-600'}`}>
                  {edit ? 'Rascunho mantido' : 'Modo leitura'}
                </span>
              </div>
            </div>

            <div className="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
              {coreNavigationSections.map((section) => {
                const isActive = activeSection === section.key;
                return (
                  <button
                    key={`core-nav-${section.key}`}
                    type="button"
                    onClick={() => scrollToSection(section.key)}
                    className={`rounded-2xl border p-4 text-left transition hover:-translate-y-0.5 hover:shadow-sm ${isActive ? 'border-slate-900 bg-slate-900 text-white' : section.tone}`}
                  >
                    <div className="flex items-start justify-between gap-3">
                      <div>
                        <p className="text-[11px] font-semibold uppercase tracking-[0.18em] opacity-70">Secção</p>
                        <h3 className="mt-2 text-base font-semibold">{section.label}</h3>
                      </div>
                      <span className={`rounded-full border px-2 py-0.5 text-[10px] font-semibold ${isActive ? 'border-white/20 bg-white/10 text-white' : 'border-current/15 bg-white/70 text-current'}`}>
                        {isActive ? 'Ativa' : 'Abrir'}
                      </span>
                    </div>
                    <p className="mt-2 text-xs opacity-80">{section.detail}</p>
                    {section.key === 'pack' ? (
                      <p className="mt-2 text-[11px] opacity-75">
                        {missingRequiredPackArticles > 0
                          ? `${missingRequiredPackArticles} item(ns) por rever antes do fecho.`
                          : 'Pack associado mantido e pronto para consulta.'}
                      </p>
                    ) : null}
                  </button>
                );
              })}
            </div>
          </div>

          {activeSection === "resumo" && (
            <div ref={(node) => { sectionRefs.current.resumo = node; }}>
              {renderResumoUltimaInspecao()}
            </div>
          )}

          <div ref={(node) => { sectionRefs.current.geral = node; }} className="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
            <button
              type="button"
              onClick={() => togglePrimarySection('geral')}
              className="flex w-full items-start justify-between gap-4 bg-gradient-to-r from-slate-50 via-white to-cyan-50 px-5 py-4 text-left transition hover:bg-slate-50"
            >
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Secção prioritária</p>
                <h2 className="mt-1 text-xl font-bold text-slate-900">Dados Gerais</h2>
                <p className="mt-1 text-sm text-slate-600">Identificação, certificado, próxima inspeção, HRU e contexto operacional da jangada.</p>
              </div>
              <div className="text-right">
                <span className="rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-slate-600">
                  {expandedPrimarySections.geral ? 'aberto' : 'fechado'}
                </span>
                <p className="mt-2 text-xs text-slate-500">{expandedPrimarySections.geral ? 'Recolher' : 'Expandir'}</p>
              </div>
            </button>

            {expandedPrimarySections.geral ? (
            <div className="border-t border-slate-200 p-4">
              <div className="mb-4 rounded-2xl border border-slate-200 bg-gradient-to-r from-slate-50 via-white to-cyan-50 p-4">
                <div className="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h2 className="text-lg font-semibold text-slate-900">Núcleo operacional da ficha</h2>
                    <p className="mt-1 text-sm text-slate-600">
                      Aqui ficam os dados que mais mexes no dia a dia: identificação, certificado, inspeção, pack e estado operacional.
                    </p>
                  </div>
                  <div className="flex flex-wrap gap-2 text-[11px] font-semibold uppercase tracking-wide">
                    <span className="rounded-full border border-slate-200 bg-white px-3 py-1 text-slate-700">{inspectionCycleLabel}</span>
                    <span className={`rounded-full border px-3 py-1 ${raftStatusTone.className}`}>{raftStatusTone.label}</span>
                    <span className={`rounded-full border px-3 py-1 ${edit ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-slate-200 bg-slate-50 text-slate-600'}`}>
                      {edit ? 'Edição ativa' : 'Leitura / inspeção'}
                    </span>
                  </div>
                </div>

                <div className="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-2">
                  <div className="rounded-2xl border border-slate-200 bg-white p-4">
                    <p className="text-xs uppercase tracking-wide text-slate-500">Modelo técnico</p>
                    <p className="mt-1 text-base font-semibold text-slate-900">{technicalModel?.name || String(form.model || raft?.model || '—')}</p>
                    <p className="mt-1 text-xs text-slate-600">{canonicalBrandOption || String(form.brand || raft?.brand || 'Marca por validar')}</p>
                  </div>
                  <div className="rounded-2xl border border-slate-200 bg-white p-4">
                    <p className="text-xs uppercase tracking-wide text-slate-500">Próxima inspeção</p>
                    <p className="mt-1 text-base font-semibold text-slate-900">{formatDatePt(String(form.dataProxInspecao || raft?.dataProxInspecao || recommendedNextInspection || '')) || '—'}</p>
                    <p className={`mt-1 text-xs ${recommendedNextInspection && !nextInspectionMatchesRule ? 'text-amber-700' : 'text-slate-600'}`}>
                      {recommendedNextInspection && !nextInspectionMatchesRule
                        ? `Regra sugere ${formatDatePt(recommendedNextInspection)}`
                        : 'Alinhada com a regra operacional atual'}
                    </p>
                  </div>
                  <div className="rounded-2xl border border-slate-200 bg-white p-4">
                    <p className="text-xs uppercase tracking-wide text-slate-500">{isValiseContainer ? 'Pack & invólucro' : 'Pack & contentor'}</p>
                    <p className="mt-1 text-base font-semibold text-slate-900">{String(form.packType || raft?.packType || '—')}</p>
                    <p className="mt-1 text-xs text-slate-600">{currentContainerLabel || (isValiseContainer ? 'Valise por validar' : 'Contentor por validar')} · {formatCapacityValue(form.capacity || raft?.capacity)} pax</p>
                  </div>
                  <div className="rounded-2xl border border-slate-200 bg-white p-4">
                    <p className="text-xs uppercase tracking-wide text-slate-500">Boletins & foco</p>
                    <p className="mt-1 text-base font-semibold text-slate-900">{appliedServiceBulletinsCount}/{applicableServiceBulletins.length} aplicados</p>
                    <p className="mt-1 text-xs text-slate-600">{smartFocusPreferredTarget?.title || 'Sem foco crítico pendente neste momento'}</p>
                  </div>
                  <div className={`rounded-2xl border p-4 ${isDelivered ? 'border-emerald-200 bg-emerald-50' : 'border-amber-200 bg-amber-50'}`}>
                    <p className={`text-xs uppercase tracking-wide ${isDelivered ? 'text-emerald-700' : 'text-amber-700'}`}>Estado de entrega</p>
                    <p className={`mt-1 text-base font-semibold ${isDelivered ? 'text-emerald-900' : 'text-amber-900'}`}>{isDelivered ? 'Entregue' : 'Por entregar'}</p>
                    <p className={`mt-1 text-xs ${isDelivered ? 'text-emerald-800' : 'text-amber-800'}`}>
                      {isDelivered
                        ? `Registada em ${formatDatePt(deliveredAtValue) || deliveredAtValue}`
                        : 'Sem registo logístico de entrega nesta ficha'}
                    </p>
                  </div>
                  <div className={`rounded-2xl border p-4 ${serviceStationStatusMeta.className}`}>
                    <p className="text-xs uppercase tracking-wide">Estado operacional</p>
                    <p className="mt-1 text-base font-semibold">{serviceStationStatusMeta.label}</p>
                    <p className="mt-1 text-xs">{operationalStateDescription}</p>
                  </div>
                </div>

                <div className="mt-4 flex flex-wrap gap-2">
                  <button
                    type="button"
                    onClick={() => scrollToSection('cilindro')}
                    className="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-800 transition hover:bg-emerald-100"
                  >
                    Abrir cilindros
                  </button>
                  <button
                    type="button"
                    onClick={() => scrollToSection('pack')}
                    className="rounded-xl border border-cyan-200 bg-cyan-50 px-3 py-2 text-xs font-medium text-cyan-800 transition hover:bg-cyan-100"
                  >
                    Abrir pack obrigatório
                  </button>
                  {!isValiseContainer ? (
                    <button
                      type="button"
                      onClick={() => scrollToSection('contentor')}
                      className="rounded-xl border border-indigo-200 bg-indigo-50 px-3 py-2 text-xs font-medium text-indigo-800 transition hover:bg-indigo-100"
                    >
                      Abrir contentor
                    </button>
                  ) : null}
                  <button
                    type="button"
                    onClick={() => scrollToSection('historico')}
                    className="rounded-xl border border-violet-200 bg-violet-50 px-3 py-2 text-xs font-medium text-violet-800 transition hover:bg-violet-100"
                  >
                    Abrir histórico
                  </button>
                  {canEditJangadaPage ? (
                    <button
                      type="button"
                      onClick={() => void handleDeliveredToggle(!isDelivered)}
                      disabled={saving || autosaveState === 'saving'}
                      className={`rounded-xl border px-3 py-2 text-xs font-medium transition disabled:cursor-not-allowed disabled:opacity-60 ${isDelivered ? 'border-slate-300 bg-slate-50 text-slate-700 hover:bg-slate-100' : 'border-emerald-200 bg-emerald-50 text-emerald-800 hover:bg-emerald-100'}`}
                    >
                      {isDelivered ? 'Remover entregue' : 'Marcar como entregue'}
                    </button>
                  ) : null}
                  {recommendedNextInspection && !nextInspectionMatchesRule ? (
                    <button
                      type="button"
                      onClick={applyRecommendedNextInspection}
                      className="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-800 transition hover:bg-amber-100"
                    >
                      Aplicar próxima inspeção sugerida
                    </button>
                  ) : null}
                </div>
              </div>

              <details className="mb-4 rounded-2xl border border-slate-200 bg-slate-50" open>
                <summary className="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-900">Documentos & certificação</summary>
                <div className="border-t border-slate-200 p-3">
                  <div className="flex flex-wrap items-center gap-2 rounded-lg border border-slate-200 bg-white p-3">
                    <span className="text-sm text-slate-700">Ação disponível nesta ficha</span>
                    <button
                      type="button"
                      onClick={generateOreyCertificateExcel}
                      disabled={!hasCertificateData || generatingCertificate}
                      className="rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 disabled:cursor-not-allowed disabled:opacity-50"
                    >
                      {generatingCertificate ? 'A gerar Excel...' : 'Gerar Certificado Excel'}
                    </button>
                    <button
                      type="button"
                      onClick={openCertificatePreview}
                      disabled={!hasCertificateData || generatingCertificate}
                      className="rounded-lg border border-blue-300 bg-blue-50 px-4 py-2 text-sm font-medium text-blue-700 disabled:cursor-not-allowed disabled:opacity-50"
                    >
                      {generatingCertificate ? 'A gerar preview...' : 'Pré-visualizar Certificado Orey'}
                    </button>
                    <button
                      type="button"
                      onClick={openModernInspectionReportPreview}
                      disabled={!hasCertificateData || generatingCertificate}
                      className="rounded-lg border border-indigo-300 bg-indigo-50 px-4 py-2 text-sm font-medium text-indigo-700 disabled:cursor-not-allowed disabled:opacity-50"
                    >
                      {generatingCertificate ? 'A gerar relatório...' : 'Pré-visualizar Relatório Moderno'}
                    </button>
                    <button
                      type="button"
                      onClick={generateQuadroExcel}
                      className="rounded-lg border border-emerald-700 bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700"
                    >
                      Gerar Quadro Excel
                    </button>
                  </div>
                </div>
              </details>

              <details className="mb-4 rounded-2xl border border-slate-200 bg-slate-50">
                <summary className="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-900">Inteligência técnica & leitura rápida</summary>
                <div className="border-t border-slate-200 p-3 space-y-3">
                  {technicalModel ? (
                    <div className="rounded-lg border border-teal-200 bg-teal-50 p-3 text-sm text-teal-900">
                      <span className="font-semibold">Ficha técnica reconhecida:</span>{' '}
                      <span className="font-semibold">{canonicalBrandOption || String(form.brand || raft?.brand || '—')}</span>
                      {' / '}
                      <span className="font-semibold">{technicalModel.name}</span>
                      {technicalPackOptions.length > 0 ? (
                        <span className="text-teal-700"> · Packs possíveis: {technicalPackOptions.join(', ')}</span>
                      ) : null}
                    </div>
                  ) : null}

                  {smartFocusPreferredTarget ? (
                    <div className={`rounded-xl border p-4 ${smartFocusPreferredTarget.tone}`}>
                      <div className="flex flex-wrap items-start justify-between gap-3">
                        <div>
                          <p className="text-xs font-semibold uppercase tracking-[0.18em] opacity-70">Recomendação inteligente da ficha</p>
                          <h3 className="mt-1 text-sm font-semibold">{smartFocusPreferredTarget.title}</h3>
                          <p className="mt-1 text-xs opacity-90">{smartFocusPreferredTarget.description}</p>
                          <p className="mt-2 text-[11px] opacity-80"><span className="font-semibold">Porque agora:</span> {smartFocusPreferredTarget.whyUrgent}</p>
                        </div>
                        <button
                          type="button"
                          onClick={() => navigateToSmartFocusTarget(smartFocusPreferredTarget.target)}
                          className="rounded-lg border border-current/20 bg-white/70 px-3 py-2 text-xs font-semibold transition hover:bg-white"
                        >
                          {smartFocusPreferredTarget.actionLabel}
                        </button>
                      </div>
                    </div>
                  ) : null}

                  <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-2">
                    {generalCommandDeck.map((card) => (
                      <div key={card.title} className={`rounded-2xl border p-4 ${card.tone}`}>
                        <p className="text-[11px] font-semibold uppercase tracking-[0.18em] opacity-70">{card.title}</p>
                        <p className="mt-2 text-base font-bold">{card.value}</p>
                        <p className="mt-2 text-xs opacity-80">{card.detail}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </details>

              <div className="mt-4 grid gap-4 xl:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
                <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                  <div className="mb-3 flex items-start justify-between gap-3">
                    <div>
                      <p className="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Bloco temático</p>
                      <h3 className="mt-1 text-base font-semibold text-slate-900">Identificação & operação</h3>
                      <p className="mt-1 text-xs text-slate-600">Tudo o que define a jangada, a embarcação ligada e a configuração operacional base.</p>
                    </div>
                    <span className="rounded-full border border-slate-200 bg-slate-50 px-2 py-1 text-[11px] font-semibold text-slate-700">
                      Base da ficha
                    </span>
                  </div>
                  <div className="grid grid-cols-1 gap-3 md:grid-cols-2">
                    {renderField("Nº Série", "serial")}
                    {renderShipField()}
                    {renderModelField()}
                    {renderBrandField()}
                    {renderField("Capacidade", "capacity")}
                    {renderOwnerField()}
                    {renderPackTypeField()}
                    {renderLaunchTypeField()}
                    {renderFabricTypeField()}
                  </div>

                  <div className="mt-4 rounded-2xl border border-indigo-200 bg-indigo-50 p-4">
                    <div className="mb-3 flex items-start justify-between gap-3">
                      <div>
                        <p className="text-xs font-semibold uppercase tracking-[0.18em] text-indigo-700">Bloco visível</p>
                        <h3 className="mt-1 text-base font-semibold text-indigo-950">Estado operacional & logística</h3>
                        <p className="mt-1 text-xs text-indigo-800">
                          Este bloco manda no mesmo fluxo usado pela estação de serviço, logística e agenda — sem estados paralelos marotos.
                        </p>
                      </div>
                      <span className={`rounded-full border px-2 py-1 text-[11px] font-semibold ${serviceStationStatusMeta.className}`}>
                        {serviceStationStatusMeta.label}
                      </span>
                    </div>

                    <div className="grid grid-cols-1 gap-3 md:grid-cols-2">
                      <div className="rounded-xl border border-indigo-200 bg-white p-3">
                        <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-indigo-700">Estado na estação</label>
                        {edit && canEditJangadaPage ? (
                          <select
                            className="w-full rounded border border-indigo-200 bg-white px-3 py-2 text-sm"
                            value={serviceStationStatusValue}
                            onChange={(e) => handleChange('serviceStationStatus', e.target.value)}
                          >
                            {SERVICE_STATION_STATUS_OPTIONS.map((option) => (
                              <option key={option.value} value={option.value}>{option.label}</option>
                            ))}
                          </select>
                        ) : (
                          <p className="text-sm font-medium text-slate-900">{serviceStationStatusMeta.label}</p>
                        )}
                        <p className="mt-2 text-xs text-slate-600">
                          {(SERVICE_STATION_STATUS_OPTIONS.find((option) => option.value === serviceStationStatusValue) || SERVICE_STATION_STATUS_OPTIONS[0]).help}
                        </p>
                      </div>

                      <div className="rounded-xl border border-indigo-200 bg-white p-3">
                        <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-indigo-700">Entrega prevista</label>
                        {edit && canEditJangadaPage ? (
                          <input
                            type="date"
                            className="w-full rounded border border-indigo-200 bg-white px-3 py-2 text-sm"
                            value={String(form.expectedDeliveryDate || raft?.expectedDeliveryDate || '').slice(0, 10)}
                            onChange={(e) => handleChange('expectedDeliveryDate', e.target.value)}
                          />
                        ) : (
                          <p className="text-sm font-medium text-slate-900">{formatDatePt(String(form.expectedDeliveryDate || raft?.expectedDeliveryDate || '')) || '—'}</p>
                        )}
                        <p className="mt-2 text-xs text-slate-600">Serve de ponte realista entre oficina, logística e entrega.</p>
                      </div>

                      <div className="rounded-xl border border-indigo-200 bg-white p-3 md:col-span-2">
                        <div className="grid grid-cols-1 gap-3 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
                          <div>
                            <label className="mb-2 block text-xs font-semibold uppercase tracking-wide text-indigo-700">Pronta para entrega</label>
                            {edit && canEditJangadaPage ? (
                              <label className="inline-flex items-center gap-2 text-sm text-slate-700">
                                <input
                                  type="checkbox"
                                  checked={readyForDeliveryValue}
                                  onChange={(e) => handleChange('readyForDelivery', e.target.checked)}
                                />
                                Marcar como pronta para entrega
                              </label>
                            ) : (
                              <p className="text-sm font-medium text-slate-900">{readyForDeliveryValue ? 'Sim' : 'Não'}</p>
                            )}
                            <p className="mt-2 text-xs text-slate-600">Usado também pela logística para preparar a saída.</p>
                          </div>

                          <div>
                            <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-indigo-700">Método de entrega</label>
                            {edit && canEditJangadaPage ? (
                              <select
                                className="w-full rounded border border-indigo-200 bg-white px-3 py-2 text-sm"
                                value={deliveryMethodValue}
                                onChange={(e) => handleChange('deliveryMethod', e.target.value)}
                              >
                                <option value="">Selecionar...</option>
                                <option value="cliente">{DELIVERY_METHOD_LABELS.cliente}</option>
                                <option value="transitario">{DELIVERY_METHOD_LABELS.transitario}</option>
                                <option value="navio">{DELIVERY_METHOD_LABELS.navio}</option>
                              </select>
                            ) : (
                              <p className="text-sm font-medium text-slate-900">{deliveryMethodLabel}</p>
                            )}
                            <p className="mt-2 text-xs text-slate-600">Mantido com os mesmos valores usados no módulo de logística.</p>
                          </div>
                        </div>
                      </div>

                      <div className={`rounded-xl border p-3 md:col-span-2 ${isDelivered ? 'border-emerald-200 bg-emerald-50' : 'border-slate-200 bg-white'}`}>
                        <div className="flex flex-wrap items-start justify-between gap-3">
                          <div>
                            <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-600">Entrega final</label>
                            <p className={`text-sm font-semibold ${isDelivered ? 'text-emerald-900' : 'text-slate-900'}`}>{isDelivered ? 'Entregue' : 'Ainda por entregar'}</p>
                            <p className={`mt-1 text-xs ${isDelivered ? 'text-emerald-800' : 'text-slate-600'}`}>
                              {isDelivered
                                ? `Registo final de entrega${deliveredAtValue ? ` em ${formatDatePt(deliveredAtValue) || deliveredAtValue}` : ''}.`
                                : 'Só usar quando a jangada sair efetivamente da cadeia logística.'}
                            </p>
                          </div>
                          {canEditJangadaPage ? (
                            <button
                              type="button"
                              onClick={() => void handleDeliveredToggle(!isDelivered)}
                              disabled={saving || autosaveState === 'saving'}
                              className={`rounded-xl border px-3 py-2 text-xs font-medium transition disabled:cursor-not-allowed disabled:opacity-60 ${isDelivered ? 'border-slate-300 bg-slate-50 text-slate-700 hover:bg-slate-100' : 'border-emerald-200 bg-emerald-50 text-emerald-800 hover:bg-emerald-100'}`}
                            >
                              {isDelivered ? 'Remover entregue' : 'Marcar como entregue'}
                            </button>
                          ) : null}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div className="space-y-4">
                  <div className="rounded-2xl border border-cyan-200 bg-cyan-50 p-4 shadow-sm">
                    <div className="mb-3 flex items-start justify-between gap-3">
                      <div>
                        <p className="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-700">Bloco temático</p>
                        <h3 className="mt-1 text-base font-semibold text-cyan-950">Certificação & inspeção</h3>
                        <p className="mt-1 text-xs text-cyan-800">Fabrico, histórico inspetivo, certificado e OT visível sem andar à caça de campos.</p>
                      </div>
                      <span className="rounded-full border border-cyan-200 bg-white px-2 py-1 text-[11px] font-semibold text-cyan-700">
                        Fecho documental
                      </span>
                    </div>
                    <div className="grid grid-cols-1 gap-3 md:grid-cols-2">
                      {renderField("Data Fabrico", "dataFabrico")}
                      {renderField("Data Última Inspeção", "dataInspecao")}
                      {renderField("Data Próxima Inspeção", "dataProxInspecao")}
                      {renderField("Nº Último Certificado", "ultimoCertificadoNumero", certificadoPreferencial?.certificadoNumero || ultimaInspecao?.certificadoNumero || "-")}
                      {renderField("Grupo OT", "numeroObra")}
                    </div>
                  </div>

                  <div className="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm">
                    <div className="mb-3 flex items-start justify-between gap-3">
                      <div>
                        <p className="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">Bloco temático</p>
                        <h3 className="mt-1 text-base font-semibold text-amber-950">HRU & segurança</h3>
                        <p className="mt-1 text-xs text-amber-800">Aplicabilidade do HRU e dados mínimos para perceber se há risco escondido nesta ficha.</p>
                      </div>
                      <span className="rounded-full border border-amber-200 bg-white px-2 py-1 text-[11px] font-semibold text-amber-700">
                        Segurança crítica
                      </span>
                    </div>
                    <div className="grid grid-cols-1 gap-3 md:grid-cols-2">
                      {renderHruApplicableField()}
                      {renderField("HRU Nº Série / Referência", "hruReferencia")}
                      {renderField("HRU Data de Instalação", "hruDataInstalacao")}
                      {renderField("HRU Data de Validade", "hruValidade")}
                    </div>
                  </div>
                </div>
              </div>

              {(() => {
                const explicitApplicability = String(form.hruAplicavel || "").trim().toUpperCase();
                const hasHruData = Boolean(
                  String(form.hruReferencia || raft?.hruReferencia || "").trim() ||
                  String(form.hruDataInstalacao || raft?.hruDataInstalacao || "").trim() ||
                  String(form.hruValidade || raft?.hruValidade || "").trim()
                );
                const hruApplicable = explicitApplicability
                  ? explicitApplicability === "SIM"
                  : hasHruData;

                if (!hruApplicable) return null;

                const validade = String(form.hruValidade || raft?.hruValidade || "").trim();
                const referencia = String(form.hruReferencia || raft?.hruReferencia || "").trim();
                const diasRestantes = daysUntil(validade);

                if (!validade) {
                  return (
                    <div className="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">
                      <p className="font-semibold">⚠️ HRU aplicável sem data de validade</p>
                      <p className="mt-1 text-xs">Preencha a data de instalação para o sistema calcular automaticamente a validade (+2 anos).</p>
                    </div>
                  );
                }

                if (diasRestantes === null) {
                  return (
                    <div className="mt-4 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-900">
                      <p className="font-semibold">⛔ Data de validade HRU inválida</p>
                      <p className="mt-1 text-xs">A data atual não pôde ser interpretada. Corrija a data de instalação para recalcular a validade.</p>
                    </div>
                  );
                }

                let alertClassName = "mt-4 rounded-lg border p-3 text-sm";
                let title = "✅ HRU dentro da validade";
                let detail = `${referencia ? `Ref. ${referencia} · ` : ""}Validade a ${formatMonthYear(validade)} (${diasRestantes} dias restantes).`;

                if (diasRestantes < 0) {
                  alertClassName += " border-red-300 bg-red-50 text-red-900";
                  title = "⛔ HRU expirado";
                  detail = `${referencia ? `Ref. ${referencia} · ` : ""}Validade em ${formatMonthYear(validade)} (expirado há ${Math.abs(diasRestantes)} dias).`;
                } else if (diasRestantes <= 30) {
                  alertClassName += " border-red-300 bg-red-50 text-red-900";
                  title = "⚠️ HRU a expirar em breve";
                  detail = `${referencia ? `Ref. ${referencia} · ` : ""}Validade em ${formatMonthYear(validade)} (${diasRestantes} dias restantes).`;
                } else if (diasRestantes <= 90) {
                  alertClassName += " border-amber-300 bg-amber-50 text-amber-900";
                  title = "⚠️ HRU entra em janela de atenção";
                  detail = `${referencia ? `Ref. ${referencia} · ` : ""}Validade em ${formatMonthYear(validade)} (${diasRestantes} dias restantes).`;
                } else {
                  alertClassName += " border-emerald-300 bg-emerald-50 text-emerald-900";
                }

                return (
                  <div className={alertClassName}>
                    <p className="font-semibold">{title}</p>
                    <p className="mt-1 text-xs">{detail}</p>
                  </div>
                );
              })()}

              <details className="mt-4 rounded-lg border border-amber-200 bg-amber-50">
                <summary className="cursor-pointer px-4 py-3 text-sm font-semibold text-amber-900">Service boletins aplicáveis</summary>
                <div className="border-t border-amber-200 p-4">
                <div className="flex items-center justify-between gap-3 mb-2">
                  <div>
                    <h3 className="text-sm font-semibold text-amber-900">Service Boletins aplicáveis</h3>
                    <p className="text-xs text-amber-800">Calculado automaticamente pela marca, modelo e sistema/válvulas; para OTS-65 a aplicação está ativa independentemente do ano de fabrico.</p>
                  </div>
                  <div className="flex flex-wrap items-center justify-end gap-2">
                    <span className="inline-flex rounded-full border border-amber-300 bg-white px-2 py-0.5 text-[11px] font-semibold text-amber-800">
                      {applicableServiceBulletins.length} aplicável{applicableServiceBulletins.length === 1 ? '' : 'eis'}
                    </span>
                    <span className="inline-flex rounded-full border border-emerald-300 bg-white px-2 py-0.5 text-[11px] font-semibold text-emerald-700">
                      {appliedServiceBulletinsCount} marcado{appliedServiceBulletinsCount === 1 ? '' : 's'} como aplicado{appliedServiceBulletinsCount === 1 ? '' : 's'}
                    </span>
                  </div>
                </div>
                {bulletinSaveState !== 'idle' ? (
                  <div className={`mb-3 inline-flex rounded-full border px-2 py-1 text-[11px] font-medium ${bulletinSaveState === 'saving' ? 'border-amber-300 bg-amber-100 text-amber-800' : bulletinSaveState === 'saved' ? 'border-emerald-300 bg-emerald-100 text-emerald-800' : 'border-red-300 bg-red-100 text-red-700'}`}>
                    {bulletinSaveState === 'saving' ? 'A guardar estado do boletim...' : bulletinSaveState === 'saved' ? 'Estado do boletim guardado' : 'Erro ao guardar o estado do boletim'}
                  </div>
                ) : null}
                {applicableServiceBulletins.length === 0 ? (
                  <p className="text-sm text-amber-900">Nenhum service boletim aplicável para esta jangada com os dados atuais.</p>
                ) : (
                  <div className="space-y-2">
                    {applicableServiceBulletins.map((bulletin) => (
                      <div key={`${bulletin.id}-${bulletin.matchedRuleLabel}`} className="rounded-lg border border-amber-200 bg-white p-3">
                        <div className="grid gap-3 md:grid-cols-[minmax(0,1fr)_240px] md:items-start">
                          <div className="min-w-0">
                            <p className="font-medium text-amber-950">
                              {bulletin.bulletinNumber || bulletin.title}
                              {bulletin.shortDescription ? ` · ${bulletin.shortDescription}` : ''}
                            </p>
                            <p className="text-xs text-gray-600 mt-1">{bulletin.title}</p>
                            {bulletin.issueDate ? (
                              <p className="text-xs text-amber-900 mt-1"><b>Data:</b> {bulletin.issueDate}</p>
                            ) : null}
                            <p className="text-xs text-amber-800 mt-1">{bulletin.reason}</p>
                            <p className="text-xs text-gray-600 mt-1">
                              Modelo compatível: <b>{bulletin.matchedRuleLabel}</b>
                              {bulletin.matchedContainer ? <> · Contentor: <b>{bulletin.matchedContainer}</b></> : null}
                              {typeof bulletin.yearFrom === 'number' || typeof bulletin.yearTo === 'number'
                                ? ` · intervalo ${bulletin.yearFrom ?? '—'}–${bulletin.yearTo ?? '—'}`
                                : ''}
                            </p>
                          </div>
                          <div className="flex flex-col gap-2 md:items-stretch md:self-start md:justify-start">
                            <a
                              href={bulletin.fileUrl}
                              target="_blank"
                              rel="noreferrer"
                              className="inline-flex w-full justify-center rounded-lg border border-amber-300 bg-amber-100 px-3 py-1.5 text-xs font-medium text-amber-900 hover:bg-amber-200"
                            >
                              Abrir PDF
                            </a>
                            <button
                              type="button"
                              disabled={bulletinSaveState === 'saving'}
                              onClick={() => handleServiceBulletinAppliedChange(bulletin.id, false)}
                              className={`inline-flex w-full justify-center rounded-lg border px-3 py-1.5 text-xs font-medium ${serviceBulletinsApplied[bulletin.id]
                                ? 'border-slate-400 bg-slate-100 text-slate-800 hover:bg-slate-200'
                                : 'border-slate-200 bg-slate-50 text-slate-500 hover:bg-slate-100'} disabled:cursor-not-allowed disabled:opacity-60`}
                            >
                              Boletim não aplicado
                            </button>
                            <label className="inline-flex w-full items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-900">
                              <input
                                type="checkbox"
                                className="h-4 w-4 rounded border-emerald-400 text-emerald-600 focus:ring-emerald-500"
                                checked={Boolean(serviceBulletinsApplied[bulletin.id])}
                                disabled={bulletinSaveState === 'saving'}
                                onChange={(e) => handleServiceBulletinAppliedChange(bulletin.id, e.target.checked)}
                              />
                              <span>Boletim aplicado nesta jangada</span>
                            </label>
                          </div>
                        </div>
                        <p className={`mt-2 text-xs ${serviceBulletinsApplied[bulletin.id] ? 'text-emerald-700' : 'text-gray-500'}`}>
                          {serviceBulletinsApplied[bulletin.id]
                            ? 'Marcado como aplicado para esta jangada.'
                            : 'Ainda não marcado como aplicado nesta jangada.'}
                        </p>
                      </div>
                    ))}
                  </div>
                )}
                </div>
              </details>

              <details className="mt-4 rounded-lg border border-sky-200 bg-sky-50">
                <summary className="cursor-pointer px-4 py-3 text-sm font-semibold text-sky-900">Anos dos testes e sinais rápidos</summary>
                <div className="border-t border-sky-200 p-3">
                <h3 className="text-sm font-semibold text-sky-900 mb-2">Anos dos testes desta jangada</h3>
                <div className="flex flex-col gap-2 text-sm">
                  <div className="flex flex-wrap items-center gap-2">
                    <span className="text-sky-800 font-medium">Inspeções:</span>
                    {testYearsSummary.inspecao.length > 0 ? (
                      testYearsSummary.inspecao.map((ano) => (
                        <span key={`inspecao-${ano}`} className="px-2 py-0.5 rounded-full bg-white border border-sky-200 text-sky-800 text-xs font-semibold">
                          {ano}
                        </span>
                      ))
                    ) : (
                      <span className="text-gray-500 text-xs">Sem anos registados</span>
                    )}
                  </div>
                  <div className="flex flex-wrap items-center gap-2">
                    <span className="text-sky-800 font-medium">Teste hidráulico:</span>
                    {testYearsSummary.hidraulico.length > 0 ? (
                      testYearsSummary.hidraulico.map((ano) => (
                        <span key={`hidraulico-${ano}`} className="px-2 py-0.5 rounded-full bg-white border border-sky-200 text-sky-800 text-xs font-semibold">
                          {ano}
                        </span>
                      ))
                    ) : (
                      <span className="text-gray-500 text-xs">Sem anos registados</span>
                    )}
                  </div>
                </div>
                </div>
              </details>

              {renderInspectionModeChecklistGroup(
                "Checklist — Dados Gerais",
                ["serial", "ship", "brand_model", "capacity", "owner", "dataFabrico", "packType"],
                "Durante a inspeção, confirma aqui a identificação base da jangada antes de avançar para os componentes técnicos."
              )}

            </div>
            ) : null}
          </div>

          {activeSection === "cilindro" && (
            <div ref={(node) => { sectionRefs.current.cilindro = node; }} className="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <h2 className="text-lg font-semibold mb-3">Dados do Cilindro (importados)</h2>

              <div className="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 p-3">
                <div className="mb-2 flex flex-wrap items-center justify-between gap-2">
                  <p className="text-sm font-semibold text-emerald-900">Substituição GI (cilindros cheios disponíveis)</p>
                  <span className="rounded-full border border-emerald-300 bg-white px-2 py-0.5 text-xs font-semibold text-emerald-800">
                    {cilindrosCheiosParaGi.length} disponível{cilindrosCheiosParaGi.length === 1 ? "" : "eis"}
                  </span>
                </div>

                {cilindrosCheiosParaGi.length === 0 ? (
                  <p className="text-xs text-emerald-800">Sem cilindros cheios disponíveis no stock para GI.</p>
                ) : (
                  <div className="flex flex-wrap gap-2">
                    {cilindrosCheiosParaGi.slice(0, 20).map((item) => (
                      <button
                        key={`gi-replacement-${item.id}`}
                        type="button"
                        disabled={giReplacementSaving || !canEditJangadaPage}
                        onClick={() => void aplicarSubstituicaoGi(item)}
                        className="rounded border border-emerald-300 bg-white px-2 py-1 text-xs text-emerald-900 hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-60"
                        title={`${item.descricao || "Cilindro"} · ${item.referencia}`}
                      >
                        🔁 {item.referencia} {item.testeHidraulico ? `· TH ${formatDatePt(item.testeHidraulico)}` : ""}
                      </button>
                    ))}
                  </div>
                )}
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3">
                {technicalModel && technicalCylinderSpec?.cylinder && (
                  <div className="col-span-full mb-4 rounded-xl border border-teal-200 bg-teal-50 p-4">
                    <div className="flex flex-wrap items-center gap-2 mb-3">
                      <span className="text-sm font-semibold text-teal-800">🛠️ Especificação técnica do cilindro — {technicalModel.name}</span>
                      <span className="rounded bg-teal-100 px-2 py-0.5 text-xs text-teal-700 border border-teal-200">
                        {String(form.brand || raft?.brand || '').trim() || 'Marca'} · {formatCapacityValue(form.capacity || raft?.capacity)} pessoas
                      </span>
                      {technicalCylinderSpec.pack && (
                        <span className="rounded bg-white px-2 py-0.5 text-xs text-teal-700 border border-teal-200">
                          Pack: {technicalCylinderSpec.pack}
                        </span>
                      )}
                    </div>
                    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 text-sm">
                      <div className="rounded border border-teal-100 bg-white p-3">
                        <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">CO₂ nominal</p>
                        <p className="font-semibold text-teal-900">{technicalCylinderSpec.cylinder.co2} kg</p>
                      </div>
                      {typeof technicalCylinderSpec.cylinder.n2 === 'number' && (
                        <div className="rounded border border-teal-100 bg-white p-3">
                          <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">N₂ nominal</p>
                          <p className="font-semibold text-teal-900">{technicalCylinderSpec.cylinder.n2} kg</p>
                        </div>
                      )}
                      {typeof technicalCylinderSpec.cylinder.volume === 'number' && (
                        <div className="rounded border border-teal-100 bg-white p-3">
                          <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">Volume</p>
                          <p className="font-semibold text-teal-900">{technicalCylinderSpec.cylinder.volume} L</p>
                        </div>
                      )}
                      {technicalCylinderSpec.codRef && (
                        <div className="rounded border border-teal-100 bg-white p-3">
                          <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">Ref. técnica</p>
                          <p className="font-mono font-semibold text-teal-900">{technicalCylinderSpec.codRef}</p>
                        </div>
                      )}
                    </div>
                    <p className="mt-3 text-xs text-teal-700">
                      Este quadro mostra a especificação técnica do modelo para consulta rápida na ficha da jangada.
                    </p>
                  </div>
                )}
                {/* ── Painel de referência do manual Survitec MK IV ── */}
                {(() => {
                  const cap = Number(form.capacity ?? raft?.capacity);
                  const isMkiv = isSurvitecMkiv(
                    String(form.brand ?? raft?.brand ?? ""),
                    String(form.model ?? raft?.model ?? "")
                  );
                  if (!isMkiv) return null;
                  const specTped = getMkivCylinderSpec(cap);
                  const specDot = cap ? SURVITEC_MKIV_CYLINDER_SPECS_DOT.find((e) => e.capacidade === cap) ?? null : null;
                  if (!specTped && !specDot) return null;
                  const renderOption = (opt: MkivCylinderOption, label: string) => (
                    <div className="rounded border border-gray-200 bg-white p-3">
                      <p className="text-xs uppercase tracking-wide font-semibold text-gray-600 mb-2">{label}</p>
                      <div className="grid grid-cols-2 gap-x-4 gap-y-1 text-xs">
                        <span className="text-gray-500">P/N Cilindro Carregado</span>
                        <span className="font-mono font-semibold text-blue-800">{opt.pnCarregado}</span>
                        <span className="text-gray-500">CO₂ (carga)</span>
                        <span className="font-semibold text-emerald-700">{opt.co2Kg} kg</span>
                        <span className="text-gray-500">N₂ (carga)</span>
                        <span className="font-semibold text-sky-700">{opt.n2Kg} kg</span>
                        {opt.pnVazio && (
                          <>
                            <span className="text-gray-500">P/N Cilindro Vazio</span>
                            <span className="font-mono text-gray-700">{opt.pnVazio}</span>
                          </>
                        )}
                        {opt.volumeLitros && (
                          <>
                            <span className="text-gray-500">Volume</span>
                            <span className="text-gray-700">{opt.volumeLitros}</span>
                          </>
                        )}
                      </div>
                    </div>
                  );
                  return (
                    <div className="col-span-full mb-4 rounded-xl border border-indigo-200 bg-indigo-50 p-4">
                      <div className="flex items-center gap-2 mb-3">
                        <span className="text-indigo-700 font-semibold text-sm">📋 Especificações do cilindro — Manual Survitec MK IV / DSB LR07</span>
                        <span className="ml-auto rounded bg-indigo-100 border border-indigo-300 px-2 py-0.5 text-xs text-indigo-700">
                          Lotação: {cap} pessoas · Fonte: Tabela 1124 &amp; A-2 (M269-00)
                        </span>
                      </div>
                      <p className="text-xs text-indigo-600 mb-3">
                        Tolerâncias: CO₂ +0/−46 g · N₂ +0/−10 g · Total +0/−56 g (Manual pág. 407)
                      </p>
                      {specTped && (
                        <div className="mb-3">
                          <p className="text-xs font-semibold text-indigo-800 mb-2">🇪🇺 TPED (Europeu) — Tabela 1124</p>
                          <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                            {renderOption(specTped.lancamento, "Lançamento (throw-overboard)")}
                            {specTped.turco && renderOption(specTped.turco, "Lançamento por turco (davit)")}
                          </div>
                        </div>
                      )}
                      {specDot && (
                        <div>
                          <p className="text-xs font-semibold text-indigo-800 mb-2">🇺🇸 DOT (USDOT) — Tabela A-2</p>
                          <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                            {renderOption(specDot.lancamento, "Lançamento (throw-overboard)")}
                            {specDot.turco && renderOption(specDot.turco, "Lançamento por turco (davit)")}
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })()}
                {renderField("Serial", "cylinderSerial")}
                {renderField("Tara", "cylinderTara")}
                {renderField("Peso Bruto", "cylinderPesoBruto")}
                {renderField("CO2", "cylinderCo2")}
                {renderField("N2", "cylinderN2")}
                {renderField("Data Teste", "cylinderDataTeste")}
                {renderField("Data Próx. Teste", "cylinderDataProxTeste")}
                {renderInflationSystemField()}
                {renderFiringHeadField()}
                {renderField("Cabeça de Disparo (Descrição)", "cylinderCabecaDisparoDescricao")}
                {renderField("Tubo/Hose Câmara Superior (Ref.)", "cylinderTuboCamaraSuperiorRef")}
                {renderField("Tubo/Hose Câmara Superior (Descrição)", "cylinderTuboCamaraSuperiorDescricao")}
                {renderField("Tubo/Hose Câmara Inferior (Ref.)", "cylinderTuboCamaraInferiorRef")}
                {renderField("Tubo/Hose Câmara Inferior (Descrição)", "cylinderTuboCamaraInferiorDescricao")}
              </div>

              <div className="mt-4 rounded-lg border border-gray-200 bg-gray-50 p-3">
                <p className="text-xs uppercase tracking-wide text-gray-500 mb-2">Cabeça de disparo via stock</p>
                {cabecaDisparoStock ? (
                  <div className="mb-3 text-sm text-gray-800">
                    Selecionado: <span className="font-semibold">{cabecaDisparoStock.referencia}</span> — {cabecaDisparoStock.descricao}
                  </div>
                ) : (form.cylinderCabecaDisparoRef || raft?.cylinderCabecaDisparoRef) ? (
                  <div className="mb-3 text-sm text-gray-800">
                    Referência selecionada: <span className="font-semibold">{String(form.cylinderCabecaDisparoRef || raft?.cylinderCabecaDisparoRef)}</span>
                    {(form.cylinderCabecaDisparoDescricao || raft?.cylinderCabecaDisparoDescricao)
                      ? ` — ${String(form.cylinderCabecaDisparoDescricao || raft?.cylinderCabecaDisparoDescricao)}`
                      : ""}
                  </div>
                ) : (
                  <div className="mb-3 text-sm text-gray-500">Nenhum artigo de stock selecionado.</div>
                )}

                {edit ? (
                  <div className="flex flex-wrap gap-2">
                    <ArtigoSelector onSelect={aplicarCabecaDisparoDoStock} buttonLabel="+ Selecionar cabeça de disparo" />
                    {(form.cylinderCabecaDisparoRef || form.cylinderCabecaDisparoDescricao) && (
                      <button
                        type="button"
                        className="px-3 py-1 rounded bg-gray-200 text-sm"
                        onClick={() => {
                          setForm((prev: FormState) => {
                            const next: FormState = {
                              ...prev,
                              cylinderCabecaDisparoRef: "",
                              cylinderCabecaDisparoDescricao: "",
                            };
                            scheduleAutosave(next);
                            return next;
                          });
                        }}
                      >
                        Limpar cabeça de disparo
                      </button>
                    )}
                  </div>
                ) : null}
                {renderTechnicalStockQuickSelector('Sugestões técnicas da cabeça de disparo', technicalHeadItems, aplicarCabecaDisparoDoStock)}
              </div>

              <div className="mt-4 grid grid-cols-1 lg:grid-cols-2 gap-3">
                <div className="rounded-lg border border-gray-200 bg-gray-50 p-3">
                  <p className="text-xs uppercase tracking-wide text-gray-500 mb-2">Tubo/Hose Câmara Superior via stock</p>
                  {tuboSuperiorStock ? (
                    <div className="mb-3 text-sm text-gray-800">
                      Selecionado: <span className="font-semibold">{tuboSuperiorStock.referencia}</span> — {tuboSuperiorStock.descricao}
                    </div>
                  ) : (form.cylinderTuboCamaraSuperiorRef || raft?.cylinderTuboCamaraSuperiorRef) ? (
