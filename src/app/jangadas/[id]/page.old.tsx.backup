                      <ArtigoSelector onSelect={aplicarTuboInferiorDoStock} buttonLabel="+ Selecionar tubo câmara inferior" />
                    </div>
                  ) : null}
                    {renderTechnicalStockQuickSelector('Tubos / adaptadores técnicos', technicalTubeItems, aplicarTuboInferiorDoStock, adicionarAcessorioInferior)}
                  <p className="text-xs uppercase tracking-wide text-gray-500 mb-2">Acessórios Câmara Superior (adaptadores, vedantes, anilhas)</p>
                  <div className="mb-3 flex flex-wrap gap-2">
                    {acessoriosSuperior.length === 0 ? (
                      <span className="text-sm text-gray-500">Sem acessórios selecionados.</span>
                    ) : acessoriosSuperior.map((a) => (
                      <span key={`sup-${a.referencia}`} className="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-2 py-1 text-xs text-blue-800">
                        <span>{a.referencia}{a.descricao ? ` — ${a.descricao}` : ""}</span>
                        {edit ? <button type="button" className="text-red-600" onClick={() => removerAcessorioSuperior(a.referencia)}>✕</button> : null}
                      </span>
                    ))}
                  </div>
                  {edit ? <ArtigoSelector onSelect={adicionarAcessorioSuperior} buttonLabel="+ Adicionar acessório superior" /> : null}
                </div>

                <div className="rounded-lg border border-gray-200 bg-gray-50 p-3">
                  <p className="text-xs uppercase tracking-wide text-gray-500 mb-2">Acessórios Câmara Inferior (adaptadores, vedantes, anilhas)</p>
                  <div className="mb-3 flex flex-wrap gap-2">
                    {acessoriosInferior.length === 0 ? (
                      <span className="text-sm text-gray-500">Sem acessórios selecionados.</span>
                    ) : acessoriosInferior.map((a) => (
                      <span key={`inf-${a.referencia}`} className="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-2 py-1 text-xs text-emerald-800">
                        <span>{a.referencia}{a.descricao ? ` — ${a.descricao}` : ""}</span>
                        {edit ? <button type="button" className="text-red-600" onClick={() => removerAcessorioInferior(a.referencia)}>✕</button> : null}
                      </span>
                    ))}
                  </div>
                  {edit ? <ArtigoSelector onSelect={adicionarAcessorioInferior} buttonLabel="+ Adicionar acessório inferior" /> : null}
                </div>
              </div>

              {renderInspectionModeChecklistGroup(
                "Checklist — Estrutura exterior e inflação",
                [
                  "tubo_identificacao",
                  "camara_fundos",
                  "tubos_alta_pressao",
                  "cilindro_co2",
                  "cabeca_disparo",
                  "uniao_banjo_superior",
                  "uniao_banjo_inferior",
                  "capa_sistema_insuflacao",
                  "bolsa_cilindro",
                  "valvulas_seguranca"
                ],
                "Secção de verificação rápida dos itens do quadro ligados ao conjunto de insuflação, cilindro e estrutura exterior."
              )}

            </div>
          )}

          {activeSection === "valvulas" && (
            <div ref={(node) => { sectionRefs.current.valvulas = node; }} className="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <h2 className="text-lg font-semibold mb-3">Válvulas</h2>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                {renderField("Válvulas de Alívio", "valvulasAlivio")}
                {renderField("Válvulas de Atestar", "valvulasAtestar")}
              </div>

              <div className="mt-4 grid grid-cols-1 lg:grid-cols-2 gap-3">
                <div className="rounded-lg border border-gray-200 bg-gray-50 p-3">
                  <p className="text-xs uppercase tracking-wide text-gray-500 mb-2">Válvulas de alívio via stock</p>
                  {valvulaAlivioStock ? (
                    <div className="mb-3 text-sm text-gray-800">
                      Selecionado: <span className="font-semibold">{valvulaAlivioStock.referencia}</span> — {valvulaAlivioStock.descricao}
                    </div>
                  ) : (form.valvulasAlivio || raft?.valvulasAlivio) ? (
                    <div className="mb-3 text-sm text-gray-800">
                      Referência selecionada: <span className="font-semibold">{String(form.valvulasAlivio || raft?.valvulasAlivio)}</span>
                    </div>
                  ) : (
                    <div className="mb-3 text-sm text-gray-500">Nenhum artigo de stock selecionado.</div>
                  )}
                  {edit ? (
                    <div className="flex flex-wrap gap-2">
                      <ArtigoSelector
                        onSelect={aplicarValvulaAlivioDoStock}
                        buttonLabel="+ Selecionar válvula de alívio"
                      />
                      {form.valvulasAlivio && (
                        <button
                          type="button"
                          className="px-3 py-1 rounded bg-gray-200 text-sm"
                          onClick={() => {
                            setForm((prev: FormState) => {
                              const next: FormState = { ...prev, valvulasAlivio: "" };
                              scheduleAutosave(next);
                              return next;
                            });
                          }}
                        >
                          Limpar válvula de alívio
                        </button>
                      )}
                    </div>
                  ) : null}
                </div>

                <div className="rounded-lg border border-gray-200 bg-gray-50 p-3">
                  <p className="text-xs uppercase tracking-wide text-gray-500 mb-2">Válvulas de atestar via stock</p>
                  {valvulaAtestarStock ? (
                    <div className="mb-3 text-sm text-gray-800">
                      Selecionado: <span className="font-semibold">{valvulaAtestarStock.referencia}</span> — {valvulaAtestarStock.descricao}
                    </div>
                  ) : (form.valvulasAtestar || raft?.valvulasAtestar) ? (
                    <div className="mb-3 text-sm text-gray-800">
                      Referência selecionada: <span className="font-semibold">{String(form.valvulasAtestar || raft?.valvulasAtestar)}</span>
                    </div>
                  ) : (
                    <div className="mb-3 text-sm text-gray-500">Nenhum artigo de stock selecionado.</div>
                  )}
                  {edit ? (
                    <div className="flex flex-wrap gap-2">
                      <ArtigoSelector
                        onSelect={aplicarValvulaAtestarDoStock}
                        buttonLabel="+ Selecionar válvula de atestar"
                      />
                      {form.valvulasAtestar && (
                        <button
                          type="button"
                          className="px-3 py-1 rounded bg-gray-200 text-sm"
                          onClick={() => {
                            setForm((prev: FormState) => {
                              const next: FormState = { ...prev, valvulasAtestar: "" };
                              scheduleAutosave(next);
                              return next;
                            });
                          }}
                        >
                          Limpar válvula de atestar
                        </button>
                      )}
                    </div>
                  ) : null}
                </div>
              </div>

              {renderInspectionModeChecklistGroup(
                "Checklist — Interior e válvulas",
                [
                  "valvulas_insuflacao",
                  "valvulas_atestar_interior",
                  "cobertura_interior",
                  "fecho_cobertura",
                  "protectores_juntas_interior",
                  "suporte_antena",
                  "arco_cinta_remate",
                  "colectores_agua"
                ],
                "Agrupa os pontos da checklist relacionados com o interior da jangada e os conjuntos de válvulas para a ronda técnica."
              )}

            </div>
          )}



          <div ref={(node) => { sectionRefs.current.pack = node; }} className="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
            <button
              type="button"
              onClick={() => togglePrimarySection('pack')}
              className="flex w-full items-start justify-between gap-4 bg-gradient-to-r from-cyan-50 via-white to-emerald-50 px-5 py-4 text-left transition hover:bg-cyan-50"
            >
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Secção prioritária</p>
                <h2 className="mt-1 text-xl font-bold text-slate-900">Pack Obrigatório</h2>
                <p className="mt-1 text-sm text-slate-600">Obrigatórios, faltas, validades e associação real dos artigos da jangada.</p>
              </div>
              <div className="text-right">
                <span className="rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-slate-600">
                  {expandedPrimarySections.pack ? 'aberto' : 'fechado'}
                </span>
                <p className="mt-2 text-xs text-slate-500">{expandedPrimarySections.pack ? 'Recolher' : 'Expandir'}</p>
              </div>
            </button>

            {expandedPrimarySections.pack ? (
            <div className="border-t border-slate-200 p-4">
              {(() => {
                const { packType, capacidade, artigosObrigatorios, resumo, packNormalizado } = packCalc;
                
                if (!packType) {
                  return (
                    <div className="rounded-lg border border-yellow-300 bg-yellow-50 p-4 text-sm text-yellow-800">
                      ⚠️ Tipo de pack não definido. Configure o "Tipo de Pack" na seção "Dados Gerais".
                    </div>
                  );
                }
                
                if (capacidade <= 0) {
                  return (
                    <div className="rounded-lg border border-yellow-300 bg-yellow-50 p-4 text-sm text-yellow-800">
                      ⚠️ Capacidade não definida. Configure a "Capacidade" na seção "Dados Gerais".
                    </div>
                  );
                }
                
                if (artigosObrigatorios.length === 0) {
                  return (
                    <div className="rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-800">
                      ❌ Pack "{packType}" não reconhecido no sistema. Packs disponíveis: SOLAS A, SOLAS B, ISO-RAFT, COASTAL, OFFSHORE, ORC, SIMPLIFICADO MÍNIMO.
                    </div>
                  );
                }

                const categoryOrder = [
                  'SINALIZAÇÃO',
                  'ILUMINAÇÃO',
                  'RAFT',
                  'EQUIPAMENTO',
                  'PRIMEIROS SOCORROS',
                  'CONSUMÍVEIS',
                  'SOBREVIVÊNCIA',
                  'OUTROS',
                ];

                const categoriasResumo = Object.entries(resumo).sort(([categoriaA], [categoriaB]) => {
                  const idxA = categoryOrder.indexOf(categoriaA);
                  const idxB = categoryOrder.indexOf(categoriaB);
                  const normalizedIdxA = idxA === -1 ? Number.MAX_SAFE_INTEGER : idxA;
                  const normalizedIdxB = idxB === -1 ? Number.MAX_SAFE_INTEGER : idxB;
                  if (normalizedIdxA !== normalizedIdxB) return normalizedIdxA - normalizedIdxB;
                  return categoriaA.localeCompare(categoriaB, 'pt-PT');
                });

                const classifyPackArticle = (categoria: string, artigoObrig: any, originalRowIdx: number) => {
                  const articleHasManagedValidity = certificateItemHasManagedValidity(String(artigoObrig?.nome || ''));
                  const verificado = obterArtigoVerificado(artigoObrig.nome);
                  const stockItem = obterStockItem(artigoObrig.nome);
                  const fixedReference = getFixedReferenceForArticleName(artigoObrig.nome);
                  const preferredStockReference = getPreferredStockReferenceForArticleName(artigoObrig.nome);
                  const referenciaVerificada = String(verificado?.art?.referencia || '').trim();
                  const refStock = referenciaVerificada || preferredStockReference || fixedReference || stockItem?.referencia;
                  const thumbRef = normalizeReference(String(refStock || ''));
                  const stockMetaByRef = thumbRef
                    ? (stockMapByReferencia[thumbRef] || stockMapByCodigoFabricante[thumbRef])
                    : undefined;
                  const matchedStockMeta = stockMetaByRef || stockItem;
                  const validadeUltima = articleHasManagedValidity ? obterValidadeUltimaInspecao(artigoObrig.nome) : undefined;
                  const validadeCertificado = articleHasManagedValidity ? obterValidadeCertificado(artigoObrig.nome) : undefined;
                  const stockValidity = articleHasManagedValidity ? normalizeMonthYearValue(String(matchedStockMeta?.validade || "")) : '';
                  const validadeVerif = articleHasManagedValidity
                    ? (verificado?.art?.validade || validadeCertificado || validadeUltima || stockValidity)
                    : '';
                  const temVerificado = !!verificado;
                  const validadeCurta = articleHasManagedValidity ? expiresWithinMonths(validadeVerif, 12, inspectionDateBase || undefined) : false;
                  const stockQuantidade = typeof matchedStockMeta?.quantidade === 'number' ? matchedStockMeta.quantidade : null;
                  const stockQuantidadeMinima = typeof matchedStockMeta?.quantidadeMinima === 'number' ? matchedStockMeta.quantidadeMinima : null;
                  const stockEmpty = stockQuantidade !== null && stockQuantidade <= 0;
                  const stockBelowMinimum = stockQuantidade !== null && stockQuantidadeMinima !== null && stockQuantidade <= stockQuantidadeMinima;
                  const hasSubstituicaoBoletim =
                    normalizeText(String(matchedStockMeta?.estadoArtigo || "")).includes("substituid") &&
                    String(matchedStockMeta?.referenciaSubstituta || "").trim().length > 0;
                  const validadeExpirada = articleHasManagedValidity ? isExpiredMonthYear(validadeVerif, inspectionDateBase || undefined) : false;

                  let priority: 'critical' | 'attention' | 'missing' | 'done' = 'done';
                  let priorityLabel = 'OK';

                  if (hasSubstituicaoBoletim || (inspectionMode && validadeExpirada) || stockEmpty) {
                    priority = 'critical';
                    priorityLabel = 'Atenção';
                  } else if ((inspectionMode && validadeCurta) || stockBelowMinimum) {
                    priority = 'attention';
                    priorityLabel = 'Atenção';
                  } else if (!temVerificado) {
                    priority = 'missing';
                    priorityLabel = 'Em falta';
                  }

                  return {
                    categoria,
                    artigoObrig,
                    originalRowIdx,
                    priority,
                    priorityLabel,
                  };
                };

                const categorizedPackRows = categoriasResumo.map(([categoria, artigos]: [string, any]) => {
                  return [
                    categoria,
                    artigos.map((artigoObrig: any, originalRowIdx: number) => classifyPackArticle(categoria, artigoObrig, originalRowIdx)),
                  ] as const;
                });

                const packPrioritySummary = categorizedPackRows
                  .flatMap(([, artigos]) => artigos)
                  .reduce(
                    (acc, row) => {
                      acc[row.priority] += 1;
                      return acc;
                    },
                    { critical: 0, attention: 0, missing: 0, done: 0 }
                  );

                const visibleAttentionCount = packPrioritySummary.attention + packPrioritySummary.critical;
                const normalizedPackPriorityFilter = packPriorityFilter === 'critical' ? 'attention' : packPriorityFilter;

                const filteredCategoriasResumo = categorizedPackRows
                  .map(([categoria, artigos]) => {
                    const filteredRows = normalizedPackPriorityFilter === 'all'
                      ? artigos
                      : artigos.filter((row: { priority: 'critical' | 'attention' | 'missing' | 'done' }) => {
                          if (normalizedPackPriorityFilter === 'attention') {
                            return row.priority === 'attention' || row.priority === 'critical';
                          }
                          return row.priority === normalizedPackPriorityFilter;
                        });
                    return [categoria, filteredRows] as const;
                  })
                  .filter(([, artigos]) => artigos.length > 0);

                const filteredPackRowsCount = filteredCategoriasResumo.reduce((acc, [, artigos]) => acc + artigos.length, 0);
                const totalPackRows = categorizedPackRows.flatMap(([, artigos]) => artigos).length;
                const packCompletionPercent = totalPackRows > 0
                  ? Math.round((packPrioritySummary.done / totalPackRows) * 100)
                  : 0;
                const packNextAction = packPrioritySummary.missing > 0
                    ? `Associar ${packPrioritySummary.missing} item${packPrioritySummary.missing === 1 ? '' : 's'} ainda em falta.`
                    : visibleAttentionCount > 0
                      ? `Rever ${visibleAttentionCount} item${visibleAttentionCount === 1 ? '' : 's'} com atenção antes de fechar.`
                      : 'Pack pronto para fecho operacional.';
                const packActionQueue = [
                  {
                    key: 'missing',
                    title: 'Em falta',
                    description: 'Obrigatórios ainda não associados na ficha real.',
                    count: packPrioritySummary.missing,
                    tone: 'border-orange-200 bg-orange-50 text-orange-900',
                  },
                  {
                    key: 'attention',
                    title: 'Atenção',
                    description: 'Itens a rever: validades, mínimos, ruturas de stock ou substituições sinalizadas.',
                    count: visibleAttentionCount,
                    tone: 'border-amber-200 bg-amber-50 text-amber-900',
                  },
                  {
                    key: 'done',
                    title: 'Prontos',
                    description: 'Itens já verificados e operacionais.',
                    count: packPrioritySummary.done,
                    tone: 'border-emerald-200 bg-emerald-50 text-emerald-900',
                  },
                ] as const;
                const packVisualModes = [
                  {
                    key: 'missing',
                    eyebrow: 'Modo rápido',
                    title: 'Só faltas',
                    description: 'Mostra apenas obrigatórios sem associação real.',
                    count: packPrioritySummary.missing,
                    tone: 'border-orange-200 bg-orange-50 text-orange-900',
                  },
                  {
                    key: 'attention',
                    eyebrow: 'Modo rápido',
                    title: 'Só urgências',
                    description: 'Junta validades curtas, rupturas e alertas críticos.',
                    count: visibleAttentionCount,
                    tone: 'border-amber-200 bg-amber-50 text-amber-900',
                  },
                  {
                    key: 'done',
                    eyebrow: 'Modo rápido',
                    title: 'Só OK',
                    description: 'Isola o que já está pronto para fecho.',
                    count: packPrioritySummary.done,
                    tone: 'border-emerald-200 bg-emerald-50 text-emerald-900',
                  },
                  {
                    key: 'all',
                    eyebrow: 'Modo rápido',
                    title: 'Vista completa',
                    description: 'Volta ao cockpit completo do pack.',
                    count: totalPackRows,
                    tone: 'border-slate-200 bg-white text-slate-900',
                  },
                ] as const;
                const packCriticalHeadline = packPrioritySummary.missing > 0
                  ? `${packPrioritySummary.missing} obrigatório(s) ainda sem associação real.`
                  : visibleAttentionCount > 0
                    ? `${visibleAttentionCount} linha(s) precisam de revisão antes do fecho.`
                    : 'Pack estável e pronto para fecho operacional.';
                const activePackVisualMode = packVisualModes.find((item) => item.key === normalizedPackPriorityFilter) || packVisualModes[3];
                
                return (
                  <div className="space-y-4">
                    <div className="app-light-blue-surface overflow-hidden rounded-2xl shadow-sm">
                      <div className="grid gap-4 p-4 xl:grid-cols-[minmax(0,1.3fr)_minmax(280px,0.9fr)] lg:p-5">
                        <div>
                          <div className="app-light-blue-kicker flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em]">
                            <span>Centro operacional do pack</span>
                            <span className={`rounded-full border px-2 py-1 normal-case tracking-normal ${packPrioritySummary.missing > 0 || visibleAttentionCount > 0 ? 'border-amber-200 bg-amber-100 text-amber-800' : 'border-emerald-200 bg-emerald-100 text-emerald-800'}`}>
                              {packNextAction}
                            </span>
                          </div>
                          <h3 className="mt-2 text-2xl font-bold tracking-tight">Pack {packNormalizado || packType} · {capacidade} pessoas</h3>
                          <p className="app-light-blue-muted mt-2 text-sm">
                            Aqui decides o que falta associar, o que precisa de substituição e o que já está pronto para fechar a inspeção.
                          </p>
                          <div className="mt-4 rounded-2xl border border-white/50 bg-white/60 px-4 py-3 text-sm text-slate-900">
                            <span className="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Leitura imediata</span>
                            <p className="mt-1 text-base font-semibold">{packCriticalHeadline}</p>
                            <p className="mt-1 text-xs text-slate-600">{packNextAction}</p>
                          </div>
                          <div className="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                            <div className="app-light-blue-glass rounded-2xl p-3">
                              <p className="app-light-blue-muted text-xs uppercase tracking-wide">Cobertura do pack</p>
                              <p className="mt-1 text-3xl font-bold">{packCompletionPercent}%</p>
                              <p className="app-light-blue-muted mt-1 text-xs">Itens OK sobre o total obrigatório.</p>
                            </div>
                            <div className="app-light-blue-glass rounded-2xl p-3">
                              <p className="app-light-blue-muted text-xs uppercase tracking-wide">Itens visíveis</p>
                              <p className="mt-1 text-3xl font-bold">{filteredPackRowsCount}</p>
                              <p className="app-light-blue-muted mt-1 text-xs">Com o filtro atual aplicado.</p>
                            </div>
                            <div className="app-light-blue-glass rounded-2xl p-3">
                              <p className="app-light-blue-muted text-xs uppercase tracking-wide">Checklist ligada</p>
                              <p className="mt-1 text-3xl font-bold">{inspectionMode ? 'ON' : 'OFF'}</p>
                              <p className="app-light-blue-muted mt-1 text-xs">Modo inspeção {inspectionMode ? 'ativo' : 'inativo'}.</p>
                            </div>
                            <div className="app-light-blue-glass rounded-2xl p-3">
                              <p className="app-light-blue-muted text-xs uppercase tracking-wide">Risco operacional</p>
                              <p className="mt-1 text-3xl font-bold">{packPrioritySummary.missing > 0 ? 'ALTO' : visibleAttentionCount > 0 ? 'MÉDIO' : 'OK'}</p>
                              <p className="app-light-blue-muted mt-1 text-xs">Leitura direta para perceber se o pack está mesmo fechável.</p>
                            </div>
                          </div>
                        </div>

                        <div className="app-light-blue-glass rounded-2xl p-4">
                          <p className="text-sm font-semibold text-slate-900">Fila de ações</p>
                          <div className="mt-3 space-y-2">
                            {packActionQueue.map((item) => (
                              <button
                                key={item.key}
                                type="button"
                                onClick={() => setPackPriorityFilter(item.key)}
                                className={`w-full rounded-xl border px-3 py-3 text-left transition hover:shadow-sm ${item.tone}`}
                              >
                                <div className="flex items-center justify-between gap-3">
                                  <span className="font-semibold">{item.title}</span>
                                  <span className="rounded-full border border-current/20 px-2 py-0.5 text-xs font-bold">{item.count}</span>
                                </div>
                                <p className="mt-1 text-xs opacity-80">{item.description}</p>
                              </button>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>

                    <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                      {packVisualModes.map((mode) => {
                        const isActive = normalizedPackPriorityFilter === mode.key;
                        return (
                          <button
                            key={mode.key}
                            type="button"
                            onClick={() => setPackPriorityFilter(mode.key)}
                            className={`rounded-2xl border p-4 text-left shadow-sm transition hover:-translate-y-0.5 hover:shadow-md ${isActive ? `${mode.tone} ring-2 ring-offset-2 ring-current/20` : 'border-slate-200 bg-white text-slate-800'}`}
                          >
                            <p className="text-[11px] font-semibold uppercase tracking-[0.18em] opacity-70">{mode.eyebrow}</p>
                            <div className="mt-2 flex items-start justify-between gap-3">
                              <div>
                                <h4 className="text-base font-semibold">{mode.title}</h4>
                                <p className="mt-1 text-xs opacity-80">{mode.description}</p>
                              </div>
                              <span className="rounded-full border border-current/15 px-2 py-1 text-xs font-bold">{mode.count}</span>
                            </div>
                          </button>
                        );
                      })}
                    </div>

                    <div className="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-2">
                      <div className="rounded-lg border border-blue-200 bg-blue-50 p-3">
                        <p className="text-xs uppercase tracking-wide text-blue-600 mb-1">Tipo de Pack</p>
                        <p className="text-lg font-bold text-blue-900">{packNormalizado || packType}</p>
                      </div>
                      <div className="rounded-lg border border-purple-200 bg-purple-50 p-3">
                        <p className="text-xs uppercase tracking-wide text-purple-600 mb-1">Capacidade</p>
                        <p className="text-lg font-bold text-purple-900">{capacidade} pessoas</p>
                      </div>
                      <div className="rounded-lg border border-green-200 bg-green-50 p-3">
                        <p className="text-xs uppercase tracking-wide text-green-600 mb-1">Artigos Obrigatórios</p>
                        <p className="text-lg font-bold text-green-900">{artigosObrigatorios.length} itens</p>
                      </div>
                    </div>

                    <details className="rounded-lg border border-slate-200 bg-slate-50" open>
                      <summary className="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-900">Diagnóstico & filtros do pack</summary>
                      <div className="border-t border-slate-200 p-3 space-y-3">
                    <div className={`rounded-2xl border px-4 py-3 text-sm ${activePackVisualMode.tone}`}>
                      <p className="text-[11px] font-semibold uppercase tracking-[0.18em] opacity-75">Modo ativo</p>
                      <div className="mt-1 flex flex-wrap items-center justify-between gap-3">
                        <div>
                          <p className="font-semibold">{activePackVisualMode.title}</p>
                          <p className="mt-1 text-xs opacity-80">{activePackVisualMode.description}</p>
                        </div>
                        <span className="rounded-full border border-current/20 px-2 py-1 text-xs font-bold">{filteredPackRowsCount} visível{filteredPackRowsCount === 1 ? '' : 'eis'}</span>
                      </div>
                    </div>

                    {packCalc.source === 'manual' && technicalPackEquipment ? (
                      <div className="rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700">
                        <span className="font-semibold text-gray-900">Fonte do pack:</span> manual técnico do fabricante para <span className="font-semibold">{technicalModel?.name || String(form.model || raft?.model || 'SEA-SAFE')}</span>
                        {technicalPackEquipment.pack ? (
                          <span> · correspondência: <span className="font-semibold">{technicalPackEquipment.pack}</span>{matchesTechnicalPack(technicalPackEquipment.pack, packType) ? '' : ` · pack registado: ${packType}`}</span>
                        ) : null}
                        {technicalPackEquipment.summary ? (
                          <p className="mt-1 text-xs text-gray-500">{technicalPackEquipment.summary}</p>
                        ) : null}
                      </div>
                    ) : null}

                    <div className="rounded-lg border border-slate-200 bg-white p-3">
                      <div className="mb-3 grid grid-cols-2 md:grid-cols-3 gap-2 text-xs">
                        <div className="rounded-lg border border-amber-200 bg-white px-3 py-2">
                          <p className="font-semibold text-amber-800">◔ Atenção</p>
                          <p className="mt-1 text-lg font-bold text-amber-700">{visibleAttentionCount}</p>
                        </div>
                        <div className="rounded-lg border border-orange-200 bg-white px-3 py-2">
                          <p className="font-semibold text-orange-800">⚠ Em falta</p>
                          <p className="mt-1 text-lg font-bold text-orange-700">{packPrioritySummary.missing}</p>
                        </div>
                        <div className="rounded-lg border border-emerald-200 bg-white px-3 py-2">
                          <p className="font-semibold text-emerald-800">✓ OK</p>
                          <p className="mt-1 text-lg font-bold text-emerald-700">{packPrioritySummary.done}</p>
                        </div>
                      </div>

                      <div className="flex flex-wrap items-center gap-2">
                        {([
                          { key: 'all', label: 'Vista completa', icon: '🧭', count: categorizedPackRows.flatMap(([, artigos]) => artigos).length, tone: 'border-gray-300 bg-white text-gray-800' },
                          { key: 'attention', label: 'Só urgências', icon: '◔', count: visibleAttentionCount, tone: 'border-amber-300 bg-amber-50 text-amber-800' },
                          { key: 'missing', label: 'Só faltas', icon: '⚠', count: packPrioritySummary.missing, tone: 'border-orange-300 bg-orange-50 text-orange-800' },
                          { key: 'done', label: 'Só OK', icon: '✓', count: packPrioritySummary.done, tone: 'border-emerald-300 bg-emerald-50 text-emerald-800' },
                        ] as const).map((filterOption) => {
                          const isActive = normalizedPackPriorityFilter === filterOption.key;
                          return (
                            <button
                              key={filterOption.key}
                              type="button"
                              onClick={() => setPackPriorityFilter(filterOption.key)}
                              className={`inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-medium transition ${isActive ? filterOption.tone + ' ring-2 ring-offset-1 ring-current/20' : 'border-gray-200 bg-white text-gray-600 hover:bg-gray-50'}`}
                            >
                              <span aria-hidden="true">{filterOption.icon}</span>
                              <span>{filterOption.label}</span>
                              <span className="rounded-full border border-current/20 px-1.5 py-0.5 text-[10px] font-semibold">{filterOption.count}</span>
                            </button>
                          );
                        })}
                      </div>

                      <div className="mt-3 text-xs text-slate-700">
                        A mostrar <b>{filteredPackRowsCount}</b> item{filteredPackRowsCount === 1 ? '' : 's'}
                        {normalizedPackPriorityFilter === 'all' ? ' do pack completo' : ` com filtro ${normalizedPackPriorityFilter}` }.
                      </div>
                    </div>
                      </div>
                    </details>
                    
                    {/* Tabela consolidada por CATEGORIAS - Obrigatórios + Reais */}
                    <details className="rounded-lg border border-slate-200 bg-white" open>
                      <summary className="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-900">Tabela operacional do pack</summary>
                      <div className="border-t border-slate-200 p-4 space-y-4">
                                        {normalizedPackPriorityFilter !== 'all' ? (
                                          <div className={`rounded-2xl border px-4 py-3 text-sm ${activePackVisualMode.tone}`}>
                                            <p className="font-semibold">Vista filtrada em {activePackVisualMode.title.toLowerCase()}</p>
                                            <p className="mt-1 text-xs opacity-80">
                                              Esta tabela está a mostrar apenas as linhas relevantes para este modo. Usa “Vista completa” se quiseres voltar ao pack inteiro.
                                            </p>
                                          </div>
                                        ) : null}
                    <div className="space-y-4">
                      {filteredCategoriasResumo.map(([categoria, artigos]) => (
                        <details key={`categoria-${categoria}`} className="rounded-lg border border-gray-200 open" open>
                          <summary className="cursor-pointer bg-gray-100 hover:bg-gray-150 px-4 py-2 font-semibold text-sm text-gray-900">
                            📋 {categoria} ({artigos.length} itens)
                          </summary>
                          <div className="overflow-x-auto">
                            <table className="min-w-[1180px] text-sm">
                              <thead className="bg-gray-50">
                                <tr>
                                  <th className="p-2 text-center font-semibold text-xs">Foto</th>
                                  <th className="p-2 text-left font-semibold">Artigo</th>
                                  <th className="p-2 text-center font-semibold text-blue-600 text-xs">OBRIGATÓRIO</th>
                                  <th className="p-2 text-center font-semibold text-xs">Qtd. obrig.</th>
                                  <th className="p-2 text-center font-semibold text-xs">Qtd. subst.</th>
                                  <th className="p-2 text-center font-semibold text-green-600 text-xs">Estado</th>
                                  <th className="p-2 text-center font-semibold text-xs">Qtd. verif.</th>
                                  <th className="p-2 text-center font-semibold text-xs">Validade</th>
                                  <th className="p-2 text-center font-semibold text-xs">Stock</th>
                                  <th className="w-28 p-2 text-center font-semibold text-xs">Referência</th>
                                  <th className="p-2 text-center font-semibold text-xs">Cód. Fabricante</th>
                                  {edit && <th className="p-2 text-center font-semibold text-xs">Ações</th>}
                                </tr>
                              </thead>
                              <tbody>
                                {artigos.map((row: { artigoObrig: any; originalRowIdx: number; priority: 'critical' | 'attention' | 'missing' | 'done'; priorityLabel: string }) => {
                              const { artigoObrig, originalRowIdx, priority, priorityLabel } = row;
                              const rowIdx = originalRowIdx;
                              const articleHasManagedValidity = certificateItemHasManagedValidity(String(artigoObrig?.nome || ''));
                              const verificado = obterArtigoVerificado(artigoObrig.nome);
                              const stockItem = obterStockItem(artigoObrig.nome);
                              const fixedReference = getFixedReferenceForArticleName(artigoObrig.nome);
                              const preferredStockReference = getPreferredStockReferenceForArticleName(artigoObrig.nome);
                              const referenciaObrigatoria = String(preferredStockReference || fixedReference || stockItem?.referencia || '').trim();
                              const referenciaVerificada = String(verificado?.art?.referencia || '').trim();
                              const refStock = referenciaVerificada || preferredStockReference || fixedReference || stockItem?.referencia;
                              const thumbRef = normalizeReference(String(refStock || ''));
                              const stockMetaByRef = thumbRef
                                ? (stockMapByReferencia[thumbRef] || stockMapByCodigoFabricante[thumbRef])
                                : undefined;
                              const matchedStockMeta = stockMetaByRef || stockItem;
                              const stockId = matchedStockMeta?.id;
                              const validadeUltima = articleHasManagedValidity ? obterValidadeUltimaInspecao(artigoObrig.nome) : undefined;
                              const validadeCertificado = articleHasManagedValidity ? obterValidadeCertificado(artigoObrig.nome) : undefined;
                              const stockValidity = articleHasManagedValidity ? normalizeMonthYearValue(String(matchedStockMeta?.validade || "")) : '';
                              const validadeVerif = articleHasManagedValidity
                                ? (verificado?.art?.validade || validadeCertificado || validadeUltima || stockValidity)
                                : '';
                              const qtdVerif = verificado?.art?.quantidade;
                              const codigoFabVerif = verificado?.art?.codigoFabricante;
                              const temVerificado = !!verificado;
                              const explicitReplacementKey = buildExplicitReplacementChecklistKey(artigoObrig.nome);
                              const quantidadeSubstituida = parseExplicitReplacementQuantity(
                                explicitReplacementKey ? inspectionChecklistValues[explicitReplacementKey] : 0
                              );
                              const foiSubstituida = quantidadeSubstituida > 0;
                              const quantidadeObrigatoriaNumerica = parseArticleQuantity(artigoObrig.quantidade, 0);
                              const quantidadeVerificadaNumerica = parseArticleQuantity(qtdVerif, 0);
                              const hasQuantidadeVerificadaSuficiente = temVerificado
                                && quantidadeObrigatoriaNumerica > 0
                                && quantidadeVerificadaNumerica >= quantidadeObrigatoriaNumerica;
                              const validadeCurta = articleHasManagedValidity ? expiresWithinMonths(validadeVerif, 12, inspectionDateBase || undefined) : false;
                              const rowReplacementKey = `required:${categoria}:${String(artigoObrig.nome || "").trim()}:${rowIdx}`;
                              const thumbSrc =
                                (thumbRef && stockThumbByReferencia[thumbRef]) ||
                                stockItem?.foto ||
                                undefined;
                              const stockQuantidade = typeof matchedStockMeta?.quantidade === 'number' ? matchedStockMeta.quantidade : null;
                              const stockQuantidadeMinima = typeof matchedStockMeta?.quantidadeMinima === 'number' ? matchedStockMeta.quantidadeMinima : null;
                              const stockLote = String(matchedStockMeta?.lote || '').trim();
                              const stockLocalizacao = String(matchedStockMeta?.localizacao || '').trim();
                              const stockEmpty = stockQuantidade !== null && stockQuantidade <= 0;
                              const stockBelowMinimum = stockQuantidade !== null && stockQuantidadeMinima !== null && stockQuantidade <= stockQuantidadeMinima;
                              const hasSubstituicaoBoletim =
                                normalizeText(String(matchedStockMeta?.estadoArtigo || "")).includes("substituid") &&
                                String(matchedStockMeta?.referenciaSubstituta || "").trim().length > 0;
                              const referenciaSubstituta = String(matchedStockMeta?.referenciaSubstituta || "").trim();
                              const validadePrincipalNormalizada = normalizeMonthYearValue(String(validadeVerif || ''));
                              const validadeExpirada = articleHasManagedValidity ? isExpiredMonthYear(validadeVerif, inspectionDateBase || undefined) : false;
                              const validitySourceLabel = verificado?.art?.validade
                                ? 'Ficha'
                                : validadeCertificado
                                ? 'Cert.'
                                : validadeUltima
                                ? 'Últ. insp.'
                                : stockValidity
                                ? 'Stock'
                                : '';
                              const isFocusedPackRow = packRowFocusKey === rowReplacementKey || replacementPicker?.key === rowReplacementKey;
                              const rowClassName = hasSubstituicaoBoletim
                                ? "border-t bg-amber-50"
                                : inspectionMode && validadeExpirada
                                ? "border-t bg-amber-50"
                                : inspectionMode && validadeCurta
                                ? "border-t bg-amber-50"
                                : temVerificado
                                ? "border-t bg-green-50"
                                : "border-t bg-orange-50";
                              const displayPriority = hasQuantidadeVerificadaSuficiente ? 'done' : priority;
                              const displayPriorityLabel = hasQuantidadeVerificadaSuficiente ? 'OK' : (priority === 'critical' ? 'Atenção' : priorityLabel);

                              return (
                                <tr
                                  key={rowIdx}
                                  ref={(node) => { packRowRefs.current[rowReplacementKey] = node; }}
                                  className={`${rowClassName} ${isFocusedPackRow ? 'relative z-[1] scale-[1.002] shadow-[inset_0_0_0_3px_rgba(14,165,233,0.65),0_0_0_2px_rgba(186,230,253,0.85)] transition-all' : ''}`}
                                >
                                  <td className="p-2 align-middle text-center">
                                    {thumbSrc ? (
                                      stockId ? (
                                        <Link href={`/stock?itemId=${stockId}`} className="inline-flex" title="Abrir ficha do artigo no stock">
                                          <img
                                            src={thumbSrc}
                                            alt={artigoObrig.nome}
                                            className="mx-auto h-10 w-10 rounded border border-gray-200 object-cover hover:ring-2 hover:ring-blue-300"
                                          />
                                        </Link>
                                      ) : (
                                        <img
                                          src={thumbSrc}
                                          alt={artigoObrig.nome}
                                          className="mx-auto h-10 w-10 rounded border border-gray-200 object-cover"
                                        />
                                      )
                                    ) : (
                                      <span className="text-gray-400 text-xs">—</span>
                                    )}
                                  </td>
                                  <td className="p-2 text-gray-900 font-medium">
                                    {!temVerificado && <span className="mr-1 text-orange-500">⚠</span>}
                                    {artigoObrig.nome}
                                    <span className={`ml-2 inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold ${displayPriority === 'critical' || displayPriority === 'attention' ? 'border-amber-200 bg-amber-100 text-amber-700' : displayPriority === 'missing' ? 'border-orange-200 bg-orange-100 text-orange-700' : 'border-emerald-200 bg-emerald-100 text-emerald-700'}`}>
                                      {displayPriority === 'missing' ? '⚠' : displayPriority === 'done' ? '✓' : '◔'} {displayPriorityLabel}
                                    </span>
                                    {hasSubstituicaoBoletim ? (
                                      <div className="mt-1 text-[11px] font-semibold text-red-700">
                                        ⚠ Produto descontinuado por boletim de serviço.
                                        {referenciaSubstituta ? ` Usar ref. substituta: ${referenciaSubstituta}` : ""}
                                      </div>
                                    ) : null}
                                    {replacementPicker?.key === rowReplacementKey ? (
                                      <div className="mt-1 inline-flex items-center rounded-full border border-sky-200 bg-sky-100 px-2 py-0.5 text-[10px] font-semibold text-sky-800">
                                        🎯 Linha aberta a partir da checklist
                                      </div>
                                    ) : null}
                                  </td>
                                  <td className="p-2 text-center text-xs text-blue-600">✓ Obrig.</td>
                                  <td className="p-2 text-center text-xs text-gray-600">{artigoObrig.descricaoQuantidade || "—"}</td>
                                  <td className="p-2 text-center">
                                    <div className="flex flex-col items-center gap-1">
                                      {edit && explicitReplacementKey ? (
                                        <>
                                          <input
                                            type="number"
                                            min="0"
                                            step="1"
                                            inputMode="numeric"
                                            className="w-16 border rounded px-2 py-1 text-center text-sm"
                                            value={String(inspectionChecklistValues[explicitReplacementKey] ?? (foiSubstituida ? quantidadeSubstituida : ''))}
                                            onChange={(e) => {
                                              const rawValue = String(e.target.value || '').trim();
                                              handleChecklistFieldChange(explicitReplacementKey, rawValue);
                                            }}
                                          />
                                          <span className="text-[10px] text-amber-700">
                                            {inspectionMode ? 'Manual / stock' : 'Manual'}
                                          </span>
                                        </>
                                      ) : foiSubstituida ? (
                                        <span className="inline-block rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-800">
                                          {quantidadeSubstituida}
                                        </span>
                                      ) : <span className="text-gray-400 text-xs">0</span>}
                                    </div>
                                  </td>
                                  <td className="p-2 text-center text-xs">
                                    {temVerificado ? (
                                      <span className={`inline-block rounded px-2 py-0.5 text-xs font-medium ${validadeExpirada ? 'bg-red-100 text-red-800' : validadeCurta ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-800'}`}>
                                        {validadeExpirada ? '✕ Cad.' : validadeCurta ? '⚠ Brev.' : '✓ Pre.'}
                                      </span>
                                    ) : (
                                      <span className="text-gray-400">—</span>
                                    )}
                                  </td>
                                  <td className="p-2 text-center">
                                    {edit ? (
                                      <input
                                        type="text"
                                        className="w-16 border rounded px-2 py-1 text-sm"
                                        placeholder="—"
                                        value={qtdVerif || ""}
                                        onChange={(e) => atualizarArtigoVerificado(artigoObrig.nome, { quantidade: e.target.value })}
                                      />
                                    ) : (
                                      <span className={qtdVerif ? "font-medium text-gray-900" : "text-gray-400"}>{qtdVerif || "—"}</span>
                                    )}
                                  </td>
                                  <td className="p-2">
                                    {!articleHasManagedValidity ? (
                                      <div className="flex flex-col items-start gap-1">
                                        <span className="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-700">
                                          N/A
                                        </span>
                                        <span className="text-[10px] text-slate-500">Sem validade gerida</span>
                                      </div>
                                    ) : edit ? (
                                      (() => {
                                        const validadeKey = `${categoria}:${String(artigoObrig.nome || "").trim()}:${rowIdx}`;
                                        const draftValue = validadeDraftByKey[validadeKey] ?? monthYearDraftFromValue(validadeVerif);
                                        const draftInvalid = isInvalidMonthYearDraft(draftValue);
                                        return (
                                          <div className="flex flex-col items-start gap-1">
                                            <input
                                              type="text"
                                              inputMode="numeric"
                                              placeholder="MM/AAAA"
                                              className={`w-24 border rounded px-2 py-1 text-sm ${draftInvalid || validadeExpirada ? "border-red-400 bg-red-50 text-red-700" : validadeCurta ? "border-amber-400 bg-amber-50 text-amber-800" : ""}`}
                                              value={draftValue}
                                              onChange={(e) => {
                                                const masked = maskMonthYearInput(e.target.value);
                                                setValidadeDraftByKey((prev) => ({
                                                  ...prev,
                                                  [validadeKey]: masked,
                                                }));
                                                const normalized = normalizeMonthYearValue(masked);
                                                if (normalized) {
                                                  atualizarArtigoVerificado(artigoObrig.nome, { validade: normalized });
                                                }
                                              }}
                                              onBlur={() => {
                                                const currentDraft = validadeDraftByKey[validadeKey] ?? "";
                                                if (!currentDraft.trim()) {
                                                  atualizarArtigoVerificado(artigoObrig.nome, { validade: "" });
                                                  setValidadeDraftByKey((prev) => {
                                                    const next = { ...prev };
                                                    delete next[validadeKey];
                                                    return next;
                                                  });
                                                  return;
                                                }
                                                const normalized = normalizeMonthYearValue(currentDraft);
                                                if (normalized) {
                                                  atualizarArtigoVerificado(artigoObrig.nome, { validade: normalized });
                                                  setValidadeDraftByKey((prev) => ({
                                                    ...prev,
                                                    [validadeKey]: monthYearDraftFromValue(normalized),
                                                  }));
                                                }
                                              }}
                                            />
                                            <div className="flex items-center gap-1">
                                              <button
                                                type="button"
                                                className="rounded border border-blue-200 bg-blue-50 px-1.5 py-0.5 text-[10px] text-blue-700"
                                                onClick={() => {
                                                  const oneYearFromNow = new Date();
                                                  oneYearFromNow.setFullYear(oneYearFromNow.getFullYear() + 1);
                                                  const nextValue = `${String(oneYearFromNow.getMonth() + 1).padStart(2, '0')}/${oneYearFromNow.getFullYear()}`;
                                                  setValidityForArticle(artigoObrig.nome, nextValue, validadeKey);
                                                }}
                                                title="Preencher com validade de 1 ano"
                                              >
                                                1 ano
                                              </button>
                                              {validadeUltima ? (
                                                <button
                                                  type="button"
                                                  className="rounded border border-emerald-200 bg-emerald-50 px-1.5 py-0.5 text-[10px] text-emerald-700"
                                                  onClick={() => setValidityForArticle(artigoObrig.nome, validadeUltima, validadeKey)}
                                                  title="Usar validade da última inspeção"
                                                >
                                                  Última
                                                </button>
                                              ) : null}
                                              <button
                                                type="button"
                                                className="rounded border border-gray-200 bg-gray-50 px-1.5 py-0.5 text-[10px] text-gray-700"
                                                onClick={() => {
                                                  atualizarArtigoVerificado(artigoObrig.nome, { validade: "" });
                                                  setValidadeDraftByKey((prev) => {
                                                    const next = { ...prev };
                                                    delete next[validadeKey];
                                                    return next;
                                                  });
                                                }}
                                                title="Limpar validade"
                                              >
                                                Limpar
                                              </button>
                                            </div>
                                            {draftInvalid ? (
                                              <span className="text-[10px] text-red-600">Formato inválido (usar MM/AAAA)</span>
                                            ) : validadeExpirada ? (
                                              <span className="text-[10px] font-semibold text-red-600">Caducado — substituir</span>
                                            ) : validadeCurta ? (
                                              <span className="text-[10px] font-semibold text-amber-600">Expira em menos de 12 meses</span>
                                            ) : null}
                                          </div>
                                        );
                                      })()
                                    ) : (
                                      <div className="flex flex-col items-start gap-1">
                                        <span className={validadeVerif ? (validadeExpirada ? 'text-red-600 font-medium' : validadeCurta ? 'text-amber-600 font-medium' : 'text-green-700 font-medium') : 'text-gray-400'}>
                                          {formatMonthYear(validadeVerif) || '—'}
                                        </span>
                                        {validitySourceLabel ? (
                                          <span className="text-[10px] uppercase tracking-wide text-gray-500">{validitySourceLabel}</span>
                                        ) : null}
                                        {stockValidity && stockValidity !== validadePrincipalNormalizada ? (
                                          <span className="text-[10px] text-gray-500">Stock: {formatMonthYear(stockValidity)}</span>
                                        ) : null}
                                        {validadeExpirada ? (
                                          <span className="ml-2 inline-flex items-center rounded-full border border-red-200 bg-red-100 px-2 py-0.5 text-[10px] font-semibold text-red-700">
                                            Substituir
                                          </span>
                                        ) : validadeCurta ? (
                                          <span className="ml-2 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-700 border border-amber-200">
                                            Substituir
                                          </span>
                                        ) : null}
                                      </div>
                                    )}
                                  </td>
                                  <td className="p-2 text-center text-xs align-middle">
                                    {matchedStockMeta ? (
                                      <div className="flex min-w-[7rem] flex-col items-center gap-1">
                                        <span className={`inline-flex rounded-full px-2 py-0.5 text-xs font-semibold ${stockEmpty ? 'bg-red-100 text-red-700' : stockBelowMinimum ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'}`}>
                                          {formatStockQuantity(stockQuantidade)} un.
                                        </span>
                                        {stockQuantidadeMinima !== null ? (
                                          <span className="text-[10px] text-gray-500">Min. {stockQuantidadeMinima}</span>
                                        ) : null}
                                        {stockLote ? (
                                          <span className="text-[10px] text-gray-500">Lote {stockLote}</span>
                                        ) : null}
                                        {stockLocalizacao ? (
                                          <span className="text-[10px] text-gray-500">{stockLocalizacao}</span>
                                        ) : null}
                                      </div>
                                    ) : (
                                      <span className="text-gray-400 text-xs">—</span>
                                    )}
                                  </td>
                                  <td className="w-28 p-2 text-center text-xs whitespace-nowrap align-middle">
                                    {edit ? (
                                      <input
                                        className="w-full border rounded px-2 py-1 text-center font-mono text-sm tracking-wide"
                                        value={refStock || ""}
                                        onChange={(e) => atualizarArtigoVerificado(artigoObrig.nome, { referencia: e.target.value })}
                                        onBlur={(e) => {
                                          const referenciaNormalizada = String(e.target.value || '').trim();
                                          if (!referenciaNormalizada) return;
                                          atualizarArtigoVerificado(
                                            artigoObrig.nome,
                                            sincronizarArtigoObrigatorioComStockPorReferencia(
                                              artigoObrig.nome,
                                              referenciaNormalizada,
                                              verificado?.art
                                            )
                                          );
                                        }}
                                      />
                                    ) : (
                                      refStock ? (
                                        stockId ? (
                                          <Link
                                            href={`/stock?id=${stockId}`}
                                            className="inline-flex min-w-[5.5rem] items-center justify-center rounded border border-blue-200 bg-blue-50 px-1.5 py-0.5 text-center font-mono text-xs tracking-wide text-blue-700 hover:bg-blue-100 whitespace-nowrap"
                                          >
                                            {formatReferenceDisplay(refStock)}
                                          </Link>
                                        ) : (
                                            <span className="inline-flex min-w-[5.5rem] items-center justify-center rounded border border-blue-200 bg-blue-50 px-1.5 py-0.5 text-center font-mono text-xs tracking-wide text-blue-700 whitespace-nowrap">
                                              {formatReferenceDisplay(refStock)}
                                            </span>
                                        )
                                      ) : (
                                        <span className="text-gray-400 text-xs">—</span>
                                      )
                                    )}
                                  </td>
                                  <td className="p-2 text-xs">
                                    {edit ? (
                                      <input
                                        className="w-full border rounded px-2 py-1 text-sm"
                                        value={codigoFabVerif || ""}
                                        onChange={(e) => atualizarArtigoVerificado(artigoObrig.nome, { codigoFabricante: e.target.value })}
                                      />
                                    ) : (
                                      <span className="text-gray-600">{codigoFabVerif || "—"}</span>
                                    )}
                                  </td>
                                  {edit && (
                                    <td className="p-2 text-center">
                                      <div className="flex flex-col items-center gap-1">
                                        <button
                                          type="button"
                                          className={`px-2 py-1 text-xs rounded text-white ${inspectionMode && validadeExpirada ? 'bg-red-600 hover:bg-red-700' : inspectionMode && validadeCurta ? 'bg-amber-500 hover:bg-amber-600' : inspectionMode ? 'bg-slate-600 hover:bg-slate-700' : 'bg-blue-600 hover:bg-blue-700'}`}
                                          onClick={() => setReplacementPicker({
                                            key: rowReplacementKey,
                                            articleName: artigoObrig.nome,
                                            defaultBusca: refStock || artigoObrig.nome,
                                          })}
                                        >
                                          {inspectionMode ? 'Substituir' : 'Associar ref.'}
                                        </button>
                                        {temVerificado && (
                                          <button
                                            type="button"
                                            className="px-2 py-1 text-xs bg-red-500 text-white rounded hover:bg-red-600"
                                            onClick={() => {
                                              const artigos = [...normalizeArtigos(form.artigos)];
                                              artigos.splice(verificado.idx, 1);
                                              setForm((f) => {
                                                const next = { ...f, artigos };
                                                scheduleAutosave(next);
                                                return next;
                                              });
                                            }}
                                          >
                                            Remover
                                          </button>
                                        )}
                                        {replacementPicker?.key === rowReplacementKey ? (
                                          <div className="mt-1 w-72 rounded border border-blue-200 bg-white p-2 shadow-sm">
                                            <ArtigoSelector
                                              onSelect={(artigo) => {
                                                if (inspectionMode) {
                                                  aplicarSubstituicaoStock(artigoObrig.nome, artigo, false);
                                                } else {
                                                  atualizarArtigoVerificado(artigoObrig.nome, {
                                                    referencia: String(artigo.referencia || '').trim(),
                                                    codigoFabricante: String(artigo.codigoFabricante || '').trim(),
                                                  });
                                                  setReplacementPicker(null);
                                                }
                                              }}
                                              buttonLabel="Escolher do stock"
                                              defaultBusca={replacementPicker.defaultBusca}
                                              initialQuantity={qtdVerif || artigoObrig.quantidade || 1}
                                              initialOpen
                                            />
                                          </div>
                                        ) : null}
                                      </div>
                                    </td>
                                  )}
                                </tr>
                              );
                            })}
                              </tbody>
                            </table>
                          </div>
                        </details>
                      ))}

                      {filteredCategoriasResumo.length === 0 ? (
                        <div className="rounded-lg border border-dashed border-slate-300 bg-white p-4 text-sm text-slate-700">
                          Nenhum artigo do pack corresponde a este filtro. Troca o filtro acima para voltar a ver todas as linhas.
                        </div>
                      ) : null}
                    </div>

                    <div className="rounded-lg border border-blue-100 bg-blue-50 p-3 text-xs text-blue-700 mt-4">
                      💡 <b>Coluna OBRIGATÓRIO:</b> Mostra os artigos exigidos pelo pack. <b>Coluna REAL:</b> Preencha com os artigos reais associados. Artigos em verde têm verificação; em laranja, estão pendentes.
                    </div>
                      </div>
                    </details>

                    <details className="rounded-lg border border-slate-200 bg-slate-50">
                      <summary className="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-900">Checklist do pack</summary>
                      <div className="border-t border-slate-200 p-3">
                        {renderInspectionModeChecklistGroup(
                          "Checklist — Equipamento da jangada",
                          ["equip_pack_type", "pagaias", "fole", "jogo_reparacao", "ancora_flutuante_linha", "batedouro", "reflector_radar"],
                          "Confirma os componentes técnicos permanentes da jangada antes de validar o pack consumível."
                        )}

                        {renderInspectionModeChecklistGroup(
                          "Checklist — Equipamento de emergência",
                          [
                            "saco_agua",
                            "validade_agua",
                            "racoes_alimentares",
                            "validade_racoes",
                            "ambulancia",
                            "validade_farmacia",
                            "comprimidos_enjoo",
                            "validade_comprimidos",
                            "foguetoes_paraquedas",
                            "validade_paraquedas",
                            "fachos_mao",
                            "validade_fachos_mao",
                            "potes_fumo",
                            "validade_potes_fumo",
                            "lanterna",
                            "pilhas_lanterna",
                            "validade_pilhas_lanterna",
                            "apito",
                            "estojo_pesca",
                            "esponjas",
                            "abre_latas",
                            "tesouras",
                            "sacos_enjoo",
                            "heliografo",
                            "manual_sobrevivencia",
                            "quadro_sinais"
                          ],
                          "Checklist distribuída do pack de emergência, alinhada com os artigos obrigatórios e respetivas validades."
                        )}
                      </div>
                    </details>
                  </div>
                );
              })()}
            </div>
            ) : null}
          </div>

          {!isValiseContainer && activeSection === "contentor" && (
            <div ref={(node) => { sectionRefs.current.contentor = node; }} className="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <h2 className="text-lg font-semibold mb-3">Contentor</h2>

              <input
                ref={evidenciasInputRef}
                type="file"
                accept="image/*"
                multiple
                className="hidden"
                onChange={handleEvidenceFileChange}
              />
              <input
                ref={evidenciasCameraInputRef}
                type="file"
                accept="image/*"
                capture="environment"
                className="hidden"
                onChange={handleEvidenceFileChange}
              />

              <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3">
                {renderContainerField()}
                {renderPainterLengthField()}
                {renderField("Altura Máx.", "maxStowageHeight")}
                {renderLaunchTypeField()}
              </div>

              <div className="mt-4 rounded-xl border border-violet-200 bg-violet-50 p-4">
                <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <h3 className="text-sm font-semibold text-violet-900">Saco de vácuo (Contentor / Valise)</h3>
                    <p className="mt-1 text-xs text-violet-700">
                      Seleciona se a jangada leva saco de vácuo e a referência usada na inspeção. As sugestões abaixo são extraídas dos manuais técnicos carregados para esta família.
                    </p>
                  </div>
                  {vacuumBagShouldBeRecommended ? (
                    <span className="rounded-full border border-violet-200 bg-white px-2 py-0.5 text-[11px] font-medium text-violet-700">
                      Recomendado para {isValiseContainer ? 'valise' : 'esta marca/família'}
                    </span>
                  ) : null}
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <div className="rounded border border-violet-100 bg-white p-3">
                    <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">Leva saco de vácuo?</p>
                    {edit ? (
                      <select
                        className="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm"
                        value={vacuumBagRequiredValue}
                        onChange={(event) => {
                          const selectedValue = String(event.target.value || '').toUpperCase();
                          handleChecklistFieldChange('contentor_saco_vacuo', selectedValue);
                          if (selectedValue === 'NAO') {
                            handleChecklistFieldChange('contentor_saco_vacuo_ref', '');
                          }
                        }}
                      >
                        <option value="">Selecionar…</option>
                        <option value="SIM">Sim</option>
                        <option value="NAO">Não</option>
                      </select>
                    ) : (
                      <p className="text-sm font-semibold text-violet-900">{vacuumBagRequiredValue || '—'}</p>
                    )}
                    {vacuumBagShouldBeRecommended && vacuumBagRequiredValue !== 'SIM' ? (
                      <p className="mt-2 text-[11px] text-amber-700">⚠️ Esta configuração normalmente usa saco de vácuo.</p>
                    ) : null}
                  </div>

                  <div className="rounded border border-violet-100 bg-white p-3">
                    <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">Referência do saco de vácuo</p>
                    {edit ? (
                      <>
                        {manualVacuumBagReferenceOptions.length > 0 ? (
                          <select
                            className="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm"
                            value={hasKnownVacuumBagReference ? vacuumBagReferenceValue : (vacuumBagReferenceValue ? '__other__' : '')}
                            onChange={(event) => {
                              const selectedValue = String(event.target.value || '');
                              if (!selectedValue) {
                                handleChecklistFieldChange('contentor_saco_vacuo_ref', '');
                                return;
                              }
                              if (selectedValue === '__other__') return;
                              handleChecklistFieldChange('contentor_saco_vacuo_ref', selectedValue);
                            }}
                          >
                            <option value="">Selecionar referência…</option>
                            {manualVacuumBagReferenceOptions.map((reference) => (
                              <option key={reference} value={reference}>{reference}</option>
                            ))}
                            <option value="__other__">Outra referência (manual/stock)…</option>
                          </select>
                        ) : null}

                        {(manualVacuumBagReferenceOptions.length === 0 || !hasKnownVacuumBagReference || !vacuumBagReferenceValue) ? (
                          <input
                            className="mt-2 w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm"
                            value={vacuumBagReferenceValue}
                            onChange={(event) => handleChecklistFieldChange('contentor_saco_vacuo_ref', event.target.value)}
                            placeholder={manualVacuumBagReferenceOptions.length === 0 ? 'Sem referência automática no manual — inserir manualmente' : 'Inserir referência manual'}
                          />
                        ) : null}
                      </>
                    ) : (
                      <p className="text-sm font-semibold text-violet-900">{vacuumBagReferenceValue || '—'}</p>
                    )}

                    {manualVacuumBagReferenceOptions.length > 0 ? (
                      <p className="mt-2 text-[11px] text-violet-700">
                        Referências manuais detetadas: <b>{manualVacuumBagReferenceOptions.join(' · ')}</b>
                      </p>
                    ) : (
                      <p className="mt-2 text-[11px] text-gray-600">
                        Não foi encontrada referência explícita de “Vacuum Bag” no manual técnico carregado para esta jangada.
                      </p>
                    )}
                  </div>
                </div>

                {vacuumBagShouldBeRecommended ? (
                  <div className="mt-3 rounded-lg border border-violet-200 bg-white px-3 py-2 text-xs text-violet-900">
                    ♻️ <b>Regra operacional:</b> nas jangadas que usam saco de vácuo, <b>todos os serviços levam saco de vácuo novo</b>.
                  </div>
                ) : null}
              </div>

              <div className="mt-4 grid grid-cols-1 xl:grid-cols-[1.1fr_1.9fr] gap-4">
                <div className="rounded-xl border border-sky-200 bg-sky-50 p-4">
                  <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
                    <div>
                      <p className="text-xs uppercase tracking-wide text-sky-700 mb-1">Imagem técnica</p>
                      <p className="text-sm text-sky-900">
                        Modelo: <b>{currentContainerLabel || "—"}</b>
                        {currentCapacity > 0 ? <> · Lotação: <b>{formatCapacityValue(currentCapacity)} pessoas</b></> : null}
                      </p>
                    </div>
                    {selectedPackBucket ? (
                      <span className="rounded-full border border-sky-200 bg-white px-2 py-1 text-[11px] font-medium text-sky-700">
                        Pack SOLAS {selectedPackBucket}
                      </span>
                    ) : null}
                  </div>
                  <div className="rounded-lg border border-sky-100 bg-white p-3">
                    <ContainerImage
                      containerModel={currentContainerLabel}
                      lotacao={currentCapacity || ""}
                      style={{ maxWidth: 320, margin: "0 auto" }}
                    />
                  </div>
                  <p className="mt-3 text-xs text-sky-700">
                    {isValiseContainer
                      ? 'Vista técnica da valise atualmente configurada na ficha. Serve de apoio visual durante a conferência do invólucro e da identificação.'
                      : 'Vista técnica do contentor atualmente configurado na ficha. Serve de apoio visual durante a conferência do invólucro e da etiquetagem.'}
                  </p>
                </div>

                <div className="space-y-4">
                  <div className="rounded-xl border border-indigo-200 bg-indigo-50 p-4">
                    <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
                      <div>
                        <h3 className="text-sm font-semibold text-indigo-900">Resumo do {packagingLabelLower} configurado</h3>
                        <p className="mt-1 text-xs text-indigo-700">Dados base usados para validar o {packagingLabelLower}, a estiva e a retenida.</p>
                      </div>
                      <span className="rounded-full border border-indigo-200 bg-white px-2 py-0.5 text-[11px] font-medium text-indigo-700">
                        {isEurovinilFicha ? "Eurovinil" : "Biblioteca técnica"}
                      </span>
                    </div>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                      <div className="rounded border border-indigo-100 bg-white p-3">
                        <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">{isValiseContainer ? 'Modelo da valise' : 'Modelo do contentor'}</p>
                        <p className="font-semibold text-indigo-900">{currentContainerLabel || "—"}</p>
                      </div>
                      <div className="rounded border border-indigo-100 bg-white p-3">
                        <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">{isValiseContainer ? 'Dimensão da valise' : 'Size do contentor'}</p>
                        <p className="font-semibold text-indigo-900">{contentorSizeLabel}</p>
                      </div>
                      <div className="rounded border border-indigo-100 bg-white p-3">
                        <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">Pack atual</p>
                        <p className="font-semibold text-indigo-900">{currentPackLabel || "—"}</p>
                      </div>
                      <div className="rounded border border-indigo-100 bg-white p-3">
                        <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">Configuração manual</p>
                        <p className="font-semibold text-indigo-900">{contentorManualConfigurationLabel}</p>
                      </div>
                      <div className="rounded border border-indigo-100 bg-white p-3">
                        <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">Tipo de lançamento</p>
                        <p className="font-semibold text-indigo-900">{String(form.launchType || raft?.launchType || "—")}</p>
                      </div>
                      <div className="rounded border border-indigo-100 bg-white p-3">
                        <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">Comprimento da retenida</p>
                        <p className="font-semibold text-indigo-900">{painterLengthDisplay}</p>
                      </div>
                      <div className="rounded border border-indigo-100 bg-white p-3">
                        <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">Altura máx. de estiva</p>
                        <p className="font-semibold text-indigo-900">{String(form.maxStowageHeight || raft?.maxStowageHeight || "—")}</p>
                      </div>
                      <div className="rounded border border-indigo-100 bg-white p-3">
                        <p className="text-xs uppercase tracking-wide text-gray-500 mb-1">Ref. principal do fecho</p>
                        <p className="font-semibold text-indigo-900">{contentorManualReferenceLabel}</p>
                      </div>
                    </div>
                    {shouldShowContentorClosureHighlight ? (
                      <div className="mt-3 rounded-xl border border-fuchsia-200 bg-white p-4 shadow-sm">
                        <div className="flex flex-wrap items-start justify-between gap-3">
                          <div>
                            <p className="text-xs font-semibold uppercase tracking-[0.18em] text-fuchsia-700">Cintas de fecho automáticas</p>
                            <h4 className="mt-1 text-sm font-semibold text-fuchsia-950">Referência e quantidade para este contentor</h4>
                            <p className="mt-1 text-xs text-fuchsia-800">
                              {contentorPrimaryClosureEntry?.description || 'Cintas de fecho do contentor'}
                              {contentorPrimaryClosureEntry?.size ? ` · Size ${contentorPrimaryClosureEntry.size}` : ''}
                              {contentorPrimaryClosureEntry?.page ? ` · pág. ${contentorPrimaryClosureEntry.page}` : ''}
                            </p>
                          </div>
                          <span className="rounded-full border border-fuchsia-200 bg-fuchsia-50 px-3 py-1 text-xs font-semibold text-fuchsia-800">
                            {contentorPrimaryClosureEntry?.strapQuantity || 1} cinta{(contentorPrimaryClosureEntry?.strapQuantity || 1) === 1 ? '' : 's'}
                          </span>
                        </div>

                        <div className="mt-3 grid grid-cols-1 gap-3 md:grid-cols-3">
                          <div className="rounded-lg border border-fuchsia-100 bg-fuchsia-50 p-3">
                            <p className="text-[11px] uppercase tracking-wide text-fuchsia-700 mb-1">Referência principal</p>
                            <p className="font-mono text-sm font-semibold text-fuchsia-950">{contentorManualReferenceLabel}</p>
                          </div>
                          <div className="rounded-lg border border-fuchsia-100 bg-fuchsia-50 p-3">
                            <p className="text-[11px] uppercase tracking-wide text-fuchsia-700 mb-1">Referências úteis</p>
                            <p className="text-sm font-semibold text-fuchsia-950">{contentorClosureReferenceSummary || '—'}</p>
                          </div>
                          <div className="rounded-lg border border-fuchsia-100 bg-fuchsia-50 p-3">
                            <p className="text-[11px] uppercase tracking-wide text-fuchsia-700 mb-1">Stock ligado</p>
                            <p className="text-sm font-semibold text-fuchsia-950">
                              {contentorClosureStockItem
                                ? `${contentorClosureStockItem.quantidade ?? '—'} un. · ${contentorClosureStockItem.referencia}`
                                : 'Sem artigo ligado'}
                            </p>
                          </div>
                        </div>

                        <p className="mt-3 text-xs text-fuchsia-800">
                          ♻️ Regra operacional: estas cintas de fecho são substituídas em todas as inspeções do contentor.
                        </p>
                      </div>
                    ) : null}
                    {isEurovinilFicha ? (
                      <p className="mt-3 text-xs text-indigo-700">
                        Para modelos Eurovinil, a configuração trabalha entre <b>Contentor</b> e <b>Valise</b> em vez da família MK de contentores Survitec.
                      </p>
                    ) : null}
                  </div>

                  <div className="rounded-xl border border-sky-200 bg-sky-50 p-4">
                    <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
                      <div>
                        <h3 className="text-sm font-semibold text-sky-900">Foto do contentor / retenida</h3>
                        <p className="mt-1 text-xs text-sky-700">Neste separador já podes colar com <b>Ctrl+V</b> ou carregar fotos diretamente para documentar o contentor e o saco da retenida.</p>
                      </div>
                      <div className="flex flex-wrap items-center gap-2">
                        <span className="rounded-full border border-sky-200 bg-white px-2 py-1 text-[11px] font-medium text-sky-700">
                          {evidencias.length} ficheiro{evidencias.length === 1 ? '' : 's'}
                        </span>
                        {canEditJangadaPage ? (
                          <>
                            <button
                              type="button"
                              onClick={() => evidenciasInputRef.current?.click()}
                              className="rounded-lg border border-sky-300 bg-white px-3 py-1.5 text-xs font-medium text-sky-800 hover:bg-sky-100 disabled:cursor-not-allowed disabled:opacity-60"
                              disabled={uploadingEvidencias}
                            >
                              {uploadingEvidencias ? 'A enviar…' : 'Adicionar foto'}
                            </button>
                            <button
                              type="button"
                              onClick={() => evidenciasCameraInputRef.current?.click()}
                              className="rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-800 hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-60"
                              disabled={uploadingEvidencias}
                            >
                              {uploadingEvidencias ? 'A enviar…' : 'Tirar foto'}
                            </button>
                          </>
                        ) : null}
                      </div>
                    </div>

                    {latestEvidencePreview ? (
                      <div className="grid grid-cols-1 md:grid-cols-[220px_minmax(0,1fr)] gap-3 rounded-lg border border-sky-100 bg-white p-3">
                        <a href={latestEvidencePreview.url} target="_blank" rel="noreferrer" className="block overflow-hidden rounded-lg border border-sky-100 bg-slate-50">
                          <img
                            src={latestEvidencePreview.url}
                            alt={latestEvidencePreview.originalName || latestEvidencePreview.name}
                            className="h-52 w-full object-cover"
                            loading="lazy"
                          />
                        </a>
                        <div className="text-sm text-sky-950">
                          <p className="font-semibold">Última foto associada à jangada</p>
                          <p className="mt-1 break-words text-xs text-sky-700">{latestEvidencePreview.originalName || latestEvidencePreview.name}</p>
                          <div className="mt-3 space-y-1 text-xs text-slate-600">
                            <p><span className="font-medium text-slate-900">Enviada em:</span> {latestEvidencePreview.uploadedAt ? new Date(latestEvidencePreview.uploadedAt).toLocaleString('pt-PT') : '—'}</p>
                            <p><span className="font-medium text-slate-900">Objetivo:</span> usar para contentor, saco da retenida ou defeitos visuais do invólucro.</p>
                          </div>
                          <div className="mt-3 flex flex-wrap gap-2">
                            <a
                              href={latestEvidencePreview.url}
                              target="_blank"
                              rel="noreferrer"
                              className="inline-flex rounded-lg border border-sky-300 bg-sky-50 px-3 py-1.5 text-xs font-medium text-sky-800 hover:bg-sky-100"
                            >
                              Abrir foto
                            </a>
                            <button
                              type="button"
                              onClick={() => setActiveSection('evidencias')}
                              className="inline-flex rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50"
                            >
                              Ver galeria completa
                            </button>
                          </div>
                        </div>
                      </div>
                    ) : (
                      <div className="rounded-lg border border-dashed border-sky-300 bg-white p-4 text-sm text-sky-800">
                        Ainda não há fotos anexadas a esta jangada. Podes colar já uma imagem do contentor ou do saco da retenida neste separador.
                      </div>
                    )}
                  </div>

                  <div className="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
                    <div className="mb-3 flex items-center justify-between gap-2">
                      <div>
                        <h3 className="text-sm font-semibold text-emerald-900">Especificações do manual</h3>
                        <p className="mt-1 text-xs text-emerald-700">Dimensões e pesos encontrados para o modelo/lotação/pack selecionados.</p>
                      </div>
                      <span className="rounded-full border border-emerald-200 bg-white px-2 py-0.5 text-[11px] font-medium text-emerald-700">
                        {selectedContainerSpecs.length} correspondência{selectedContainerSpecs.length === 1 ? "" : "s"}
                      </span>
                    </div>
                    {selectedContainerSpecs.length === 0 ? (
                      <div className="rounded-lg border border-dashed border-emerald-300 bg-white p-3 text-sm text-emerald-800">
                        Sem especificação manual exata para esta combinação de contentor, lotação e pack. Mantém a imagem técnica e confirma manualmente no fabricante.
                      </div>
                    ) : (
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                        {selectedContainerSpecs.map((spec) => (
                          <div key={`${spec.containerKey}-${spec.capacityKey}-${spec.pack}-${spec.launchType}`} className="rounded-lg border border-emerald-100 bg-white p-3 text-sm">
                            <div className="mb-2 flex items-center justify-between gap-2">
                              <p className="font-semibold text-emerald-900">
                                {spec.containerKey} · {spec.launchType === "throwover" ? "Throw-over" : spec.launchType === "davit" ? "Davit" : "Flat pack"}
                              </p>
                              <span className="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">
                                pág. {spec.page}
                              </span>
                            </div>
                            <div className="grid grid-cols-2 gap-x-4 gap-y-1 text-xs text-gray-700">
                              <span>Comprimento</span>
                              <span className="font-semibold">{spec.comprimentoMm ? `${spec.comprimentoMm} mm` : "—"}</span>
                              <span>Diâmetro</span>
                              <span className="font-semibold">{spec.diametroMm ? `${spec.diametroMm} mm` : "—"}</span>
                              <span>Largura</span>
                              <span className="font-semibold">{spec.larguraMm ? `${spec.larguraMm} mm` : "—"}</span>
                              <span>Altura</span>
                              <span className="font-semibold">{spec.alturaMm ? `${spec.alturaMm} mm` : "—"}</span>
                              <span>Peso</span>
                              <span className="font-semibold">{spec.pesoKg ? `${spec.pesoKg} kg` : "—"}</span>
                            </div>
                            {spec.notes ? <p className="mt-2 text-[11px] text-gray-500">{spec.notes}</p> : null}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>

                  {(contentorClosureBundle.exactMatches.length > 0 || contentorClosureBundle.familyMatches.length > 0 || contentorClosureBundle.operationalNotes.length > 0) ? (
                    <div className="rounded-xl border border-fuchsia-200 bg-fuchsia-50 p-4">
                      <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
                        <div>
                          <h3 className="text-sm font-semibold text-fuchsia-900">Cintas de fecho do contentor</h3>
                          <p className="mt-1 text-xs text-fuchsia-700">Mapeamento operacional por família/tamanho de contentor com ligação direta às referências de stock.</p>
                        </div>
                        <div className="flex flex-wrap gap-2 text-[11px]">
                          <span className="rounded-full border border-fuchsia-200 bg-white px-2 py-0.5 font-medium text-fuchsia-700">
                            {contentorClosureBundle.exactMatches.length} exata{contentorClosureBundle.exactMatches.length === 1 ? '' : 's'}
                          </span>
                          <span className="rounded-full border border-amber-200 bg-white px-2 py-0.5 font-medium text-amber-700">
                            {contentorClosureBundle.familyMatches.length} família
                          </span>
                        </div>
                      </div>

                      <div className="mb-3 rounded-lg border border-fuchsia-200 bg-white px-3 py-2 text-xs text-fuchsia-900">
                        ♻️ <b>Regra operacional:</b> as <b>cintas de fecho são substituídas em todas as inspeções</b>.
                      </div>

                      {contentorClosureBundle.exactMatches.length > 0 || contentorClosureBundle.familyMatches.length > 0 ? (
                        <div className="space-y-2">
                          {[...contentorClosureBundle.exactMatches, ...contentorClosureBundle.familyMatches].map((entry) => {
                            const stockItem = stockMapByReferencia[normalizeReference(entry.stockReference)] || stockMapByCodigoFabricante[normalizeReference(entry.stockReference)];
                            const replacementKey = `contentor-closure:${entry.key}`;
                            return (
                              <div key={`closure-card-${entry.key}`} className="rounded-lg border border-fuchsia-100 bg-white p-3 text-sm shadow-sm">
                                <div className="flex flex-wrap items-start justify-between gap-2">
                                  <div>
                                    <p className="font-semibold text-fuchsia-950">{entry.description}</p>
                                    <p className="mt-1 text-xs text-fuchsia-700">
                                      {entry.containerLabel} · {entry.launchType}{entry.size ? ` · Size ${entry.size}` : ''} · {formatContainerClosureCapacities(entry)}
                                    </p>
                                  </div>
                                  <div className="flex flex-wrap gap-2 text-[11px]">
                                    <span className={`rounded-full border px-2 py-0.5 font-medium ${entry.certainty === 'exact' ? 'border-emerald-200 bg-emerald-100 text-emerald-700' : 'border-amber-200 bg-amber-100 text-amber-700'}`}>
                                      {entry.certainty === 'exact' ? 'Match exato' : 'Família / operacional'}
                                    </span>
                                    <span className={`rounded-full border px-2 py-0.5 font-medium ${stockItem ? 'border-blue-200 bg-blue-100 text-blue-700' : 'border-gray-200 bg-gray-100 text-gray-600'}`}>
                                      {stockItem ? `Stock ${stockItem.quantidade ?? '—'} un.` : 'Sem stock ligado'}
                                    </span>
                                  </div>
                                </div>
                                <div className="mt-2 grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-gray-700">
                                  <div><span className="font-medium text-gray-900">Ref. stock:</span> {entry.stockReference}</div>
                                  {entry.maxStowedHeightMeters ? <div><span className="font-medium text-gray-900">Estiva máx.:</span> até {entry.maxStowedHeightMeters} m</div> : null}
                                  <div><span className="font-medium text-gray-900">Qtd. cintas:</span> {entry.strapQuantity}</div>
                                  {entry.completePartNumber ? <div><span className="font-medium text-gray-900">Ref. completa:</span> {entry.completePartNumber}</div> : null}
                                  {entry.upperPartNumber ? <div><span className="font-medium text-gray-900">Parte superior:</span> {entry.upperPartNumber}</div> : null}
                                  {entry.lowerPartNumber ? <div><span className="font-medium text-gray-900">Parte inferior:</span> {entry.lowerPartNumber}</div> : null}
                                  {entry.coverPartNumber ? <div><span className="font-medium text-gray-900">Cobertura:</span> {entry.coverPartNumber}</div> : null}
                                  {entry.strapPartNumber ? <div><span className="font-medium text-gray-900">Ref. cinta:</span> {entry.strapPartNumber}</div> : null}
                                  {entry.sealPartNumber ? <div><span className="font-medium text-gray-900">Ref. selo:</span> {entry.sealPartNumber}</div> : null}
                                  {entry.page ? <div><span className="font-medium text-gray-900">Página:</span> {entry.page}</div> : null}
                                  {stockItem?.descricao ? <div><span className="font-medium text-gray-900">Artigo ligado:</span> {stockItem.descricao}</div> : null}
                                </div>
                                <div className="mt-2 flex flex-wrap gap-2">
                                  {stockItem?.id ? (
                                    <Link
                                      href={`/stock?itemId=${stockItem.id}`}
                                      className="inline-flex rounded-lg border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700 hover:bg-blue-100"
                                    >
                                      Abrir artigo no stock
                                    </Link>
                                  ) : null}
                                  {canEditJangadaPage ? (
                                    <button
                                      type="button"
                                      onClick={() => setReplacementPicker({
                                        key: replacementKey,
                                        articleName: entry.description,
                                        defaultBusca: entry.stockReference || entry.strapPartNumber || entry.description,
                                        technical: true,
                                      })}
                                      className="inline-flex rounded-lg border border-fuchsia-300 bg-fuchsia-50 px-3 py-1.5 text-xs font-medium text-fuchsia-800 hover:bg-fuchsia-100"
                                    >
                                      {stockItem ? 'Escolher outra ref. do stock' : 'Escolher ref. alternativa do stock'}
                                    </button>
                                  ) : null}
                                </div>
                                {replacementPicker?.key === replacementKey ? (
                                  <div className="mt-3 rounded-lg border border-fuchsia-200 bg-fuchsia-50 p-3">
                                    <ArtigoSelector
                                      onSelect={(artigo) => {
                                        adicionarArtigoDoStock({
                                          name: entry.description,
                                          referencia: String(artigo.referencia || '').trim(),
                                          codigoFabricante: String(artigo.codigoFabricante || '').trim() || undefined,
                                          quantidade: String(entry.strapQuantity || 1),
                                          validade: normalizeMonthYearValue(String(artigo.validade || '')) || undefined,
                                        });
                                        setReplacementPicker(null);
                                      }}
                                      buttonLabel="Selecionar referência alternativa"
                                      defaultBusca={replacementPicker.defaultBusca}
                                      initialQuantity={entry.strapQuantity || 1}
                                      initialOpen
                                    />
                                  </div>
                                ) : null}
                                {entry.notes ? <p className="mt-2 text-[11px] text-gray-500">{entry.notes}</p> : null}
                              </div>
                            );
                          })}
                        </div>
                      ) : null}

                      {contentorClosureBundle.operationalNotes.length > 0 ? (
                        <div className="mt-3 space-y-1">
                          {contentorClosureBundle.operationalNotes.map((note: string) => (
                            <p key={note} className="rounded-lg border border-fuchsia-100 bg-white px-3 py-2 text-[11px] text-fuchsia-900">
                              ℹ️ {note}
                            </p>
                          ))}
                        </div>
                      ) : null}
                    </div>
                  ) : null}

                  {inspectionMode ? (
                    <div className="rounded-xl border border-rose-200 bg-rose-50 p-4">
                      <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
                        <div>
                          <h3 className="text-sm font-semibold text-rose-900">Decisão operacional do contentor</h3>
                          <p className="mt-1 text-xs text-rose-700">
                            Fluxo rápido de inspeção: marcar OK, deixar pendente ou abrir logo a substituição do item no stock.
                          </p>
                        </div>
                        <span className="rounded-full border border-rose-200 bg-white px-2 py-0.5 text-[11px] font-medium text-rose-700">
                          {contentorOperationalSummary.completed}/{contentorOperationalSummary.total} concluídos
                        </span>
                      </div>

                      <div className="mb-4 grid grid-cols-2 md:grid-cols-4 gap-2">
                        <div className="rounded-lg border border-amber-200 bg-white px-3 py-2 text-xs">
                          <p className="font-semibold text-amber-800">◔ Atenção</p>
                          <p className="mt-1 text-lg font-bold text-amber-700">{visibleContentorAttentionCount}</p>
                        </div>
                        <div className="rounded-lg border border-blue-200 bg-white px-3 py-2 text-xs">
                          <p className="font-semibold text-blue-800">🔧 Pronto a substituir</p>
                          <p className="mt-1 text-lg font-bold text-blue-700">{contentorPrioritySummary.ready}</p>
                        </div>
                        <div className="rounded-lg border border-emerald-200 bg-white px-3 py-2 text-xs">
                          <p className="font-semibold text-emerald-800">✓ Pronto</p>
                          <p className="mt-1 text-lg font-bold text-emerald-700">{contentorPrioritySummary.done}</p>
                        </div>
                      </div>

                      <div className="mb-4 flex flex-wrap items-center gap-2">
                        {([
                          { key: 'all', label: 'Todos', icon: '🧭', count: contentorOperationalCards.length, tone: 'border-gray-300 bg-white text-gray-800' },
                          { key: 'attention', label: 'Atenção', icon: '◔', count: visibleContentorAttentionCount, tone: 'border-amber-300 bg-amber-50 text-amber-800' },
                          { key: 'ready', label: 'Prontos a substituir', icon: '🔧', count: contentorPrioritySummary.ready, tone: 'border-blue-300 bg-blue-50 text-blue-800' },
                          { key: 'done', label: 'Prontos', icon: '✓', count: contentorPrioritySummary.done, tone: 'border-emerald-300 bg-emerald-50 text-emerald-800' },
                        ] as const).map((filterOption) => {
                          const isActive = normalizedContentorPriorityFilter === filterOption.key;
                          return (
                            <button
                              key={filterOption.key}
                              type="button"
                              onClick={() => setContentorPriorityFilter(filterOption.key)}
                              className={`inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-medium transition ${isActive ? filterOption.tone + ' ring-2 ring-offset-1 ring-current/20' : 'border-gray-200 bg-white text-gray-600 hover:bg-gray-50'}`}
                            >
                              <span aria-hidden="true">{filterOption.icon}</span>
                              <span>{filterOption.label}</span>
                              <span className="rounded-full border border-current/20 px-1.5 py-0.5 text-[10px] font-semibold">{filterOption.count}</span>
                            </button>
                          );
                        })}
                      </div>

                      <div className="mb-3 text-xs text-rose-800">
                        A mostrar <b>{filteredContentorOperationalCards.length}</b> item{filteredContentorOperationalCards.length === 1 ? '' : 's'}
                        {normalizedContentorPriorityFilter === 'all' ? ' de todas as prioridades' : ` com filtro ${normalizedContentorPriorityFilter}` }.
                      </div>

                      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                        {filteredContentorOperationalCards.map((item) => {
                          const replacementKey = `contentor-operational:${item.key}`;
                          const stockItem = item.stockItem;
                          const stockQuantity = typeof stockItem?.quantidade === 'number' ? stockItem.quantidade : null;

                          return (
                            <div key={item.key} className={`relative overflow-hidden rounded-lg border p-3 shadow-sm ${item.cardClassName}`}>
                              <div className={`absolute left-0 top-0 h-full w-1.5 ${item.accentClassName}`} />
                              <div className="flex flex-wrap items-start justify-between gap-2">
                                <div className="pl-2">
                                  <p className="text-sm font-semibold text-rose-950">{item.title}</p>
                                  <p className="mt-1 text-xs text-gray-600">{item.description}</p>
                                  <p className="mt-2 text-[11px] font-medium text-gray-500">{item.priorityHint}</p>
                                </div>
                                <div className="flex flex-col items-end gap-1">
                                  <span className={`inline-flex rounded-full border px-2 py-0.5 text-[11px] font-semibold ${item.badgeClassName}`}>
                                    <span className="mr-1" aria-hidden="true">{item.priorityIcon}</span>
                                    {item.priorityLabel}
                                  </span>
                                  <span className={`inline-flex rounded-full border px-2 py-0.5 text-[11px] font-semibold ${item.isComplete ? 'border-emerald-200 bg-emerald-100 text-emerald-700' : 'border-amber-200 bg-amber-100 text-amber-700'}`}>
                                    {item.isComplete ? 'OK registado' : 'Pendente'}
                                  </span>
                                </div>
                              </div>

                              {item.suggestion ? (
                                <div className="mt-3 ml-2 rounded-lg border border-gray-200 bg-white/80 p-3 text-xs text-gray-700">
                                  <div><span className="font-semibold text-gray-900">Artigo alvo:</span> {item.suggestion.articleName}</div>
                                  <div className="mt-1"><span className="font-semibold text-gray-900">Refs:</span> {item.suggestion.references.length ? item.suggestion.references.join(' · ') : '—'}</div>
                                  <div className="mt-1 flex flex-wrap items-center gap-2">
                                    <span className={`inline-flex rounded-full border px-2 py-0.5 font-semibold ${item.suggestion.alwaysReplaceOnService ? 'border-rose-200 bg-rose-100 text-rose-700' : item.suggestion.present ? 'border-emerald-200 bg-emerald-100 text-emerald-700' : stockItem ? 'border-blue-200 bg-blue-100 text-blue-700' : 'border-gray-200 bg-gray-100 text-gray-600'}`}>
                                      {item.suggestion.alwaysReplaceOnService ? 'Troca obrigatória por serviço' : item.suggestion.present ? 'Já na jangada' : stockItem ? 'Stock encontrado' : 'Sem match'}
                                    </span>
                                    {stockItem?.referencia ? (
                                      <span className="font-mono text-[11px] text-gray-700">{stockItem.referencia}</span>
                                    ) : null}
                                    {stockQuantity !== null ? (
                                      <span className="text-[11px] text-gray-500">{stockQuantity} un.</span>
                                    ) : null}
                                  </div>
                                </div>
                              ) : null}

                              <div className="mt-3 ml-2 flex flex-wrap items-center gap-2">
                                <button
                                  type="button"
                                  className={`inline-flex rounded-lg border px-3 py-1.5 text-xs font-medium ${item.isComplete ? 'border-emerald-300 bg-emerald-100 text-emerald-800' : 'border-emerald-300 bg-emerald-50 text-emerald-800 hover:bg-emerald-100'}`}
                                  onClick={() => handleContentorOperationalStatus(item.checklistFieldName, 'ok')}
                                >
                                  <span className="mr-1" aria-hidden="true">✓</span>
                                  Marcar OK
                                </button>
                                <button
                                  type="button"
                                  className="inline-flex rounded-lg border border-amber-300 bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-800 hover:bg-amber-100"
                                  onClick={() => handleContentorOperationalStatus(item.checklistFieldName, 'pending')}
                                >
                                  <span className="mr-1" aria-hidden="true">◔</span>
                                  Marcar pendente
                                </button>
                                {item.suggestion ? (
                                  <>
                                    <button
                                      type="button"
                                      className="inline-flex rounded-lg border border-rose-300 bg-rose-50 px-3 py-1.5 text-xs font-medium text-rose-800 hover:bg-rose-100"
                                      onClick={() => setReplacementPicker({
                                        key: replacementKey,
                                        articleName: item.suggestion?.articleName || item.title,
                                        defaultBusca: stockItem?.referencia || item.suggestion?.references[0] || item.suggestion?.articleName,
                                        technical: true,
                                      })}
                                    >
                                      <span className="mr-1" aria-hidden="true">🔧</span>
                                      Substituir
                                    </button>
                                    <button
                                      type="button"
                                      className="inline-flex rounded-lg border border-blue-300 bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-800 hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-50"
                                      onClick={() => {
                                        if (!item.suggestion) return;
                                        adicionarSugestaoContentor(item.suggestion);
                                        handleContentorOperationalStatus(item.checklistFieldName, 'ok');
                                      }}
                                      disabled={!stockItem || (!item.suggestion.alwaysReplaceOnService && Boolean(item.suggestion.present))}
                                    >
                                      <span className="mr-1" aria-hidden="true">{item.suggestion.alwaysReplaceOnService ? '♻️' : item.suggestion.present ? '✓' : '📦'}</span>
                                      {item.suggestion.alwaysReplaceOnService ? 'Lançar novo do stock' : item.suggestion.present ? 'Já associado' : 'Adicionar do stock'}
                                    </button>
                                  </>
                                ) : null}
                              </div>

                              {item.checklistFieldName === 'comprimento_retenida' ? (
                                <div className="mt-3 ml-2 rounded-lg border border-sky-100 bg-sky-50 p-3">
                                  <p className="text-[11px] uppercase tracking-wide text-sky-700 mb-1">Valor registado na checklist</p>
                                  <div className="text-sm font-semibold text-sky-900">
                                    {String(inspectionChecklistValues[item.checklistFieldName] || form.painterLength || raft?.painterLength || '—')}
                                  </div>
                                </div>
                              ) : null}

                              {replacementPicker?.key === replacementKey ? (
                                <div className="mt-3 ml-2 rounded-lg border border-rose-200 bg-rose-50 p-3">
                                  <ArtigoSelector
                                    onSelect={(artigo) => {
                                      aplicarSubstituicaoStock(item.suggestion?.articleName || item.title, artigo, true);
                                      handleContentorOperationalStatus(item.checklistFieldName, 'ok');
                                    }}
                                    buttonLabel="🔧 Escolher substituição do stock"
                                    defaultBusca={replacementPicker.defaultBusca}
                                    initialQuantity={item.suggestion?.quantity || 1}
                                    initialOpen
                                  />
                                </div>
                              ) : null}
                            </div>
                          );
                        })}
                      </div>

                      {filteredContentorOperationalCards.length === 0 ? (
                        <div className="mt-3 rounded-lg border border-dashed border-rose-300 bg-white p-4 text-sm text-rose-800">
                          Nenhum item nesta prioridade. Podes trocar o filtro acima para voltar a ver todos os pontos do contentor.
                        </div>
                      ) : null}
                    </div>
                  ) : null}

                  <div className="rounded-xl border border-violet-200 bg-violet-50 p-4">
                    <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
                      <div>
                        <h3 className="text-sm font-semibold text-violet-900">Sugestões de stock para o {isValiseContainer ? 'saco / valise' : 'contentor'}</h3>
                        <p className="mt-1 text-xs text-violet-700">
                          {isValiseContainer
                            ? 'Artigos técnicos e consumíveis da valise detetados pela configuração atual da jangada, já cruzados com o stock disponível.'
                            : 'Artigos técnicos e consumíveis do contentor detetados pela configuração atual da jangada, já cruzados com o stock disponível.'}
                        </p>
                      </div>
                      <span className="rounded-full border border-violet-200 bg-white px-2 py-0.5 text-[11px] font-medium text-violet-700">
                        {contentorSuggestionItems.length} sugestão{contentorSuggestionItems.length === 1 ? '' : 'ões'}
                      </span>
                    </div>

                    {contentorSuggestionItems.length === 0 ? (
                      <div className="rounded-lg border border-dashed border-violet-300 bg-white p-3 text-sm text-violet-800">
                        Sem sugestões automáticas para {isValiseContainer ? 'esta valise' : 'este contentor'} com os dados atuais.
                      </div>
                    ) : (
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                        {contentorSuggestionItems.map((suggestion) => {
                          const stockItem = suggestion.stockItem;
                          const stockQuantidade = typeof stockItem?.quantidade === 'number' ? stockItem.quantidade : null;
                          const badgeClassName = suggestion.present
                            ? 'border-emerald-200 bg-emerald-100 text-emerald-700'
                            : stockItem
                            ? 'border-blue-200 bg-blue-100 text-blue-700'
                            : 'border-gray-200 bg-gray-100 text-gray-600';

                          return (
                            <div key={suggestion.key} className="rounded-lg border border-violet-100 bg-white p-3 shadow-sm">
                              <div className="flex flex-wrap items-start justify-between gap-2">
                                <div>
                                  <p className="text-sm font-semibold text-violet-950">{suggestion.title}</p>
                                  <p className="mt-1 text-[11px] uppercase tracking-wide text-violet-700">{suggestion.sourceLabel}</p>
                                </div>
                                <span className={`inline-flex rounded-full border px-2 py-0.5 text-[11px] font-semibold ${suggestion.alwaysReplaceOnService ? 'border-rose-200 bg-rose-100 text-rose-700' : badgeClassName}`}>
                                  {suggestion.alwaysReplaceOnService ? 'Troca obrigatória por serviço' : suggestion.present ? 'Já associado' : stockItem ? 'Stock encontrado' : 'Sem match no stock'}
                                </span>
                              </div>

                              {suggestion.notes ? (
                                <p className="mt-2 text-xs text-gray-600">{suggestion.notes}</p>
                              ) : null}

                              <div className="mt-3 grid grid-cols-1 gap-2 text-xs text-gray-700">
                                <div>
                                  <span className="font-semibold text-gray-900">Artigo:</span> {suggestion.articleName}
                                </div>
                                <div>
                                  <span className="font-semibold text-gray-900">Referências:</span>{' '}
                                  {suggestion.references.length > 0 ? suggestion.references.join(' · ') : '—'}
                                </div>
                                <div>
                                  <span className="font-semibold text-gray-900">Qtd. sugerida:</span> {suggestion.quantity}
                                </div>
                                {stockItem ? (
                                  <>
                                    <div>
                                      <span className="font-semibold text-gray-900">Stock:</span> {stockItem.descricao}
                                    </div>
                                    <div className="flex flex-wrap items-center gap-2">
                                      <span>
                                        <span className="font-semibold text-gray-900">Ref. stock:</span> {stockItem.referencia}
                                      </span>
                                      {stockQuantidade !== null ? (
                                        <span className="inline-flex rounded-full border border-violet-200 bg-violet-100 px-2 py-0.5 text-[11px] font-semibold text-violet-700">
                                          {stockQuantidade} un.
                                        </span>
                                      ) : null}
                                      {stockItem.validade ? (
                                        <span>
                                          <span className="font-semibold text-gray-900">Validade:</span> {formatMonthYear(stockItem.validade)}
                                        </span>
                                      ) : null}
                                    </div>
                                  </>
                                ) : null}
                              </div>

                              <div className="mt-3 flex flex-wrap items-center gap-2">
                                {stockItem?.id ? (
                                  <Link
                                    href={`/stock?id=${stockItem.id}`}
                                    className="inline-flex rounded-lg border border-violet-300 bg-violet-50 px-3 py-1.5 text-xs font-medium text-violet-800 hover:bg-violet-100"
                                  >
                                    Abrir no stock
                                  </Link>
                                ) : null}
                                <button
                                  type="button"
                                  onClick={() => adicionarSugestaoContentor(suggestion)}
                                  disabled={!stockItem || (!suggestion.alwaysReplaceOnService && suggestion.present)}
                                  className="inline-flex rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-800 hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50"
                                >
                                  {suggestion.alwaysReplaceOnService ? 'Lançar novo à jangada' : suggestion.present ? 'Já está na jangada' : stockItem ? 'Adicionar à jangada' : 'Sem stock para adicionar'}
                                </button>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </div>
                </div>
              </div>

              {renderInspectionModeChecklistGroup(
                `Checklist — ${packagingSectionTitle}`,
                [packagingClosureFieldName, "saco_retenida", "comprimento_retenida", "marcas_involucro"],
                isValiseContainer
                  ? 'Pontos do quadro relativos à valise, retenida e marcas do invólucro para o fecho final da inspeção.'
                  : 'Pontos do quadro relativos ao contentor, retenida e marcas do invólucro para o fecho final da inspeção.'
              )}
            </div>
          )}

          {activeSection === "evidencias" && (
            <div ref={(node) => { sectionRefs.current.evidencias = node; }} className="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <div className="flex flex-wrap items-start justify-between gap-3 mb-4">
                <div>
                  <h2 className="text-lg font-semibold mb-1">Evidências</h2>
                  <p className="text-sm text-gray-600">
                    Fotografias de anomalias e defeitos observados na jangada — por exemplo contentor partido, humidade, corrosão no cilindro ou qualquer não conformidade.
                  </p>
                </div>
                <div className="flex flex-wrap items-center gap-2">
                  <span className="inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700">
                    {loadingEvidencias ? 'A carregar…' : `${evidencias.length} evidência${evidencias.length === 1 ? '' : 's'}`}
                  </span>
                  <button
                    type="button"
                    onClick={() => void fetchEvidencias()}
                    className="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
                    disabled={loadingEvidencias || uploadingEvidencias}
                  >
                    Atualizar
                  </button>
                  {canEditJangadaPage ? (
                    <>
                      <button
                        type="button"
                        onClick={() => evidenciasInputRef.current?.click()}
                        className="rounded-lg border border-blue-300 bg-blue-50 px-3 py-2 text-sm font-medium text-blue-800 hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-60"
                        disabled={uploadingEvidencias}
                      >
                        {uploadingEvidencias ? 'A enviar…' : 'Adicionar fotos'}
                      </button>
                      <button
                        type="button"
                        onClick={() => evidenciasCameraInputRef.current?.click()}
                        className="rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-800 hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-60"
                        disabled={uploadingEvidencias}
                      >
                        {uploadingEvidencias ? 'A enviar…' : 'Tirar foto'}
                      </button>
                    </>
                  ) : null}
                </div>
              </div>

              <input
                ref={evidenciasInputRef}
                type="file"
                accept="image/*"
                multiple
                className="hidden"
                onChange={handleEvidenceFileChange}
              />
              <input
                ref={evidenciasCameraInputRef}
                type="file"
                accept="image/*"
                capture="environment"
                className="hidden"
                onChange={handleEvidenceFileChange}
              />

              <div className="mb-4 rounded-xl border border-sky-200 bg-sky-50 p-4">
                <div className="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h3 className="text-sm font-semibold text-sky-900">Upload e colar imagem</h3>
                    <p className="mt-1 text-xs text-sky-700">
                      Usa o mesmo padrão rápido de colar imagem: entra neste separador e faz <b>Ctrl+V</b> depois de copiar uma foto. Também podes selecionar várias imagens de uma vez.
                    </p>
                  </div>
                  <span className="rounded-full border border-sky-200 bg-white px-2 py-1 text-[11px] font-medium text-sky-700">
                    JPG · PNG · WEBP · até 20 MB
                  </span>
                </div>
              </div>

              {loadingEvidencias ? (
                <div className="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-600">
                  A carregar evidências da jangada…
                </div>
              ) : evidencias.length === 0 ? (
                <div className="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-600">
                  Ainda não existem evidências nesta ficha. Adiciona fotos de defeitos, danos, humidade, corrosão ou outras observações relevantes.
                </div>
              ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                  {evidencias.map((evidencia) => (
                    <div key={evidencia.name} className="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
                      <a href={evidencia.url} target="_blank" rel="noreferrer" className="block bg-gray-100">
                        <img
                          src={evidencia.url}
                          alt={evidencia.originalName || evidencia.name}
                          className="h-56 w-full object-cover"
                          loading="lazy"
                        />
                      </a>
                      <div className="p-3">
                        <p className="text-sm font-semibold text-gray-900 break-words">{evidencia.originalName || evidencia.name}</p>
                        <div className="mt-2 space-y-1 text-xs text-gray-500">
                          <p>Enviado em: {evidencia.uploadedAt ? new Date(evidencia.uploadedAt).toLocaleString('pt-PT') : '—'}</p>
                          <p>Tamanho: {typeof evidencia.size === 'number' ? `${(evidencia.size / 1024 / 1024).toFixed(2)} MB` : '—'}</p>
                        </div>
                        <div className="mt-3 flex flex-wrap items-center gap-2">
                          <a
                            href={evidencia.url}
                            target="_blank"
                            rel="noreferrer"
                            className="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50"
                          >
                            Abrir
                          </a>
                          {canEditJangadaPage ? (
                            <button
                              type="button"
                              onClick={() => void handleDeleteEvidence(evidencia.name)}
                              className="rounded-lg border border-red-300 bg-red-50 px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-60"
                              disabled={deletingEvidenceName === evidencia.name}
                            >
                              {deletingEvidenceName === evidencia.name ? 'A remover…' : 'Remover'}
                            </button>
                          ) : null}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          {activeSection === "testes" && (
            <div ref={(node) => { sectionRefs.current.testes = node; }} className="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <h2 className="text-lg font-semibold mb-3">Testes</h2>
              <div className="rounded-lg border border-blue-100 bg-blue-50 p-3 mb-3 text-xs text-blue-800">
                Os testes são selecionados automaticamente pela idade da jangada: <b>WP</b> anual, <b>GI</b> de 5 em 5 anos, <b>FS</b> e <b>NAP</b> ao 11.º ano e depois anualmente.
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-3">
                {([
                  ["WP", "testeWP", derivedTestDefaults.testeWP],
                  ["NAP", "testeNAP", derivedTestDefaults.testeNAP],
                  ["FS", "testeFS", derivedTestDefaults.testeFS],
                  ["GI", "testeGI", derivedTestDefaults.testeGI],
                  ["DL", "testeDL", derivedTestDefaults.testeDL],
                ] as Array<[string, keyof FormState, "YES" | "NO" | "N/A"]>).map(([label, key, fallback]) => {
                  const current = normalizeTestResult(form[key], fallback);
                  return (
                    <div key={String(key)} className="rounded-lg border border-gray-200 bg-gray-50 p-3">
                      <p className="text-[11px] uppercase tracking-wide text-gray-500 mb-1">Teste {label}</p>
                      {edit ? (
                        <select
                          className="w-full border rounded px-2 py-1 text-sm bg-white"
                          value={current}
                          onChange={(e) => handleChange(String(key), e.target.value)}
                        >
                          <option value="YES">YES</option>
                          <option value="NO">NO</option>
                          <option value="N/A">N/A</option>
                        </select>
                      ) : (
                        <p className="text-sm text-gray-900 font-semibold">{current}</p>
                      )}
                    </div>
                  );
                })}
              </div>

              <div className="mt-4 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3">
                {([
                  ["Temp. Inicial (°C)", "testeWPTemperaturaInicial", "Ex.: 18.5"],
                  ["Temp. Final (°C)", "testeWPTemperaturaFinal", "Ex.: 19.5"],
                  ["Pressão Atmosférica Inicial (mb)", "testeWPPressaoAtmosfericaInicial", "Ex.: 1013"],
                  ["Pressão Atmosférica Final (mb)", "testeWPPressaoAtmosfericaFinal", "Ex.: 1011"],
                ] as Array<[string, keyof FormState, string]>).map(([label, key, placeholder]) => {
                  const current = String(form[key] || "");
                  return (
                    <div key={String(key)} className="rounded-lg border border-gray-200 bg-gray-50 p-3">
                      <p className="text-[11px] uppercase tracking-wide text-gray-500 mb-1">{label}</p>
                      {edit ? (
                        <input
                          className="w-full border rounded px-2 py-1 text-sm bg-white"
                          value={current}
                          onChange={(e) => handleChange(String(key), e.target.value)}
                          placeholder={placeholder}
                        />
                      ) : (
                        <p className="text-sm text-gray-900 font-semibold">{current || "—"}</p>
                      )}
                    </div>
                  );
                })}
              </div>

              <div className="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 p-4">
                <div className="mb-3">
                  <h3 className="text-sm font-semibold text-emerald-900">Dados WP para o quadro de inspeção</h3>
                  <p className="text-xs text-emerald-700 mt-1">
                    Estes campos alimentam diretamente o quadro Excel: unidade, hora do ensaio e leituras das câmaras superior e inferior.
                  </p>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                  <div className="rounded-lg border border-emerald-200 bg-white p-3">
                    <p className="text-[11px] uppercase tracking-wide text-gray-500 mb-1">Unidade de pressão</p>
                    {edit ? (
                      <select
                        className="w-full border rounded px-2 py-1 text-sm bg-white"
                        value={String(form.testeWPUnidadePressao || raft?.testeWPUnidadePressao || 'inH2O')}
                        onChange={(e) => handleChange('testeWPUnidadePressao', e.target.value)}
                      >
                        <option value="inH2O">inH2O</option>
                        <option value="inHg">inHg</option>
                        <option value="mbar">mbar</option>
                      </select>
                    ) : (
                      <p className="text-sm text-gray-900 font-semibold">{String(form.testeWPUnidadePressao || raft?.testeWPUnidadePressao || 'inH2O')}</p>
                    )}
                  </div>

                  {([
                    ['Hora início', 'testeWPHoraInicio', 'Ex.: 09:00'],
                    ['Hora fim (+60 min)', 'testeWPHoraFim', 'Calculado automaticamente'],
                  ] as Array<[string, keyof FormState, string]>).map(([label, key, placeholder]) => {
                    const current = String(form[key] || raft?.[key] || '');
                    const isCalculatedField = key === 'testeWPHoraFim';
                    return (
                      <div key={String(key)} className="rounded-lg border border-emerald-200 bg-white p-3">
                        <p className="text-[11px] uppercase tracking-wide text-gray-500 mb-1">{label}</p>
                        {edit ? (
                          <input
                            className="w-full border rounded px-2 py-1 text-sm bg-white"
                            value={current}
                            onChange={(e) => handleChange(String(key), e.target.value)}
                            placeholder={placeholder}
                            disabled={isCalculatedField}
                          />
                        ) : (
                          <p className="text-sm text-gray-900 font-semibold">{current || '—'}</p>
                        )}
                      </div>
                    );
                  })}
                </div>

                <div className="mt-4 grid grid-cols-1 xl:grid-cols-2 gap-4">
                  {([
                    ['Câmara superior', 'testeWPCamaraSuperiorInicio', 'testeWPCamaraSuperiorFim', 'testeWPCamaraSuperiorQueda', form.testePressaoCamaraSuperior || raft?.testePressaoCamaraSuperior || '', wpDerived.upper],
                    ['Câmara inferior', 'testeWPCamaraInferiorInicio', 'testeWPCamaraInferiorFim', 'testeWPCamaraInferiorQueda', form.testePressaoCamaraInferior || raft?.testePressaoCamaraInferior || '', wpDerived.lower],
                  ] as Array<[string, keyof FormState, keyof FormState, keyof FormState, string, typeof wpDerived.upper]>).map(([title, startKey, endKey, dropKey, fallbackStart, derived]) => {
                    const startValue = String(form[startKey] || raft?.[startKey] || fallbackStart || '');
                    const endValue = String(form[endKey] || raft?.[endKey] || '');
                    const dropValue = String(derived.dropDisplay || form[dropKey] || raft?.[dropKey] || '');
                    const valveOpeningKey = startKey === 'testeWPCamaraSuperiorInicio'
                      ? 'testeWPCamaraSuperiorAberturaValvula'
                      : 'testeWPCamaraInferiorAberturaValvula';
                    const valveClosingKey = startKey === 'testeWPCamaraSuperiorInicio'
                      ? 'testeWPCamaraSuperiorFechoValvula'
                      : 'testeWPCamaraInferiorFechoValvula';
                    const valveOpeningValue = String(form[valveOpeningKey] || raft?.[valveOpeningKey] || '');
                    const valveClosingValue = String(form[valveClosingKey] || raft?.[valveClosingKey] || startValue || '');

                    return (
                      <div key={String(startKey)} className="rounded-lg border border-emerald-200 bg-white p-3">
                        <p className="text-sm font-semibold text-emerald-900 mb-3">{title}</p>
                        <div className="grid grid-cols-1 md:grid-cols-5 gap-3">
                          {([
                            ['Abertura válvula', valveOpeningKey, valveOpeningValue, 'Ex.: 2.80'],
                            ['Fecho válvula', valveClosingKey, valveClosingValue, 'Igual à pressão inicial WP'],
                            ['Leitura inicial', startKey, startValue, 'Ex.: 2.50'],
                            ['Leitura final', endKey, endValue, 'Ex.: 2.45'],
                            ['Queda', dropKey, dropValue, 'Ex.: 0.05'],
                          ] as Array<[string, keyof FormState, string, string]>).map(([label, key, value, placeholder]) => (
                            <div key={String(key)}>
                              <p className="text-[11px] uppercase tracking-wide text-gray-500 mb-1">{label}</p>
                              {edit ? (
                                <input
                                  className="w-full border rounded px-2 py-1 text-sm bg-white"
                                  value={value}
                                  onChange={(e) => handleChange(String(key), e.target.value)}
                                  placeholder={placeholder}
                                  disabled={key === dropKey}
                                />
                              ) : (
                                <p className="text-sm text-gray-900 font-semibold">{value || '—'}</p>
                              )}
                              {key === valveClosingKey ? (
                                <p className="mt-1 text-[10px] text-emerald-700">Sincronizado com a pressão inicial do WP.</p>
                              ) : null}
                            </div>
                          ))}
                        </div>

                        <div className="mt-3 grid grid-cols-1 md:grid-cols-4 gap-3 rounded-lg border border-emerald-100 bg-emerald-50 p-3 text-sm">
                          <div>
                            <p className="text-[11px] uppercase tracking-wide text-emerald-700 mb-1">Pressão corrigida</p>
                            <p className="font-semibold text-emerald-900">{derived.correctedEndDisplay || '—'} {String(form.testeWPUnidadePressao || raft?.testeWPUnidadePressao || 'inH2O')}</p>
                          </div>
                          <div>
                            <p className="text-[11px] uppercase tracking-wide text-emerald-700 mb-1">Perda real</p>
                            <p className="font-semibold text-emerald-900">{derived.dropDisplay || '—'} {String(form.testeWPUnidadePressao || raft?.testeWPUnidadePressao || 'inH2O')}</p>
                          </div>
                          <div>
                            <p className="text-[11px] uppercase tracking-wide text-emerald-700 mb-1">Perda %</p>
                            <p className="font-semibold text-emerald-900">{derived.dropPercentDisplay ? `${derived.dropPercentDisplay}%` : '—'}</p>
                          </div>
                          <div>
                            <p className="text-[11px] uppercase tracking-wide text-emerald-700 mb-1">Estado</p>
                            <p className={`font-semibold ${derived.passes === null ? 'text-gray-500' : derived.passes ? 'text-emerald-700' : 'text-red-600'}`}>
                              {derived.passes === null ? '—' : derived.passes ? 'Aprovado' : 'Reprovado'}
                            </p>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>

                <div className="mt-4 rounded-lg border border-blue-200 bg-blue-50 p-3 text-sm text-blue-900">
                  <div className="grid grid-cols-1 md:grid-cols-4 gap-3">
                    <div>
                      <p className="text-[11px] uppercase tracking-wide text-blue-700 mb-1">Δ Temperatura</p>
                      <p className="font-semibold">{wpDerived.tempDelta === null ? '—' : `${formatDecimal(wpDerived.tempDelta, 2)} °C`}</p>
                    </div>
                    <div>
                      <p className="text-[11px] uppercase tracking-wide text-blue-700 mb-1">Correção temperatura</p>
                      <p className="font-semibold">{wpCorrectionTempInSelectedUnit === null ? '—' : `${formatDecimal(wpCorrectionTempInSelectedUnit, 2)} ${wpUnitLabel}`}</p>
                    </div>
                    <div>
                      <p className="text-[11px] uppercase tracking-wide text-blue-700 mb-1">Correção barométrica</p>
                      <p className="font-semibold">{wpCorrectionBaroInSelectedUnit === null ? '—' : `${formatDecimal(wpCorrectionBaroInSelectedUnit, 2)} ${wpUnitLabel}`}</p>
                    </div>
                    <div>
                      <p className="text-[11px] uppercase tracking-wide text-blue-700 mb-1">Regra MKIV</p>
                      <p className={`font-semibold ${wpDerived.temperatureWithinManual === false ? 'text-red-600' : 'text-blue-900'}`}>
                        {wpDerived.temperatureWithinManual === null ? '—' : wpDerived.temperatureWithinManual ? 'ΔT ≤ 3,5°C' : 'ΔT acima de 3,5°C'}
                      </p>
                    </div>
                  </div>
                  <p className="mt-3 text-xs text-blue-700">
                    MKIV: cada compartimento é ensaiado por <b>60 minutos</b>; a leitura final é corrigida em <b>-4 mb por cada +1°C</b> e em <b>±1 mb por cada 1 mb</b> de variação barométrica. A perda admissível é <b>máximo 5%</b>.
                  </p>
                </div>

                <div className="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
                  <p className="font-semibold">Referência manual aplicada às válvulas (MKIV / throw-over)</p>
                  <p className="mt-1 text-xs text-amber-800">
                    Valor de fecho/reseat de referência: <b>1970 mmWG / 2.8 psi ≈ 193 mbar</b>. Na unidade atual, isso corresponde a <b>{wpManualReseatThresholdSelectedUnit === null ? '—' : `${formatDecimal(wpManualReseatThresholdSelectedUnit, 2)} ${wpUnitLabel}`}</b>.
                  </p>
                  <p className="mt-1 text-xs text-amber-800">
                    Regra operacional desta ficha: o campo <b>Fecho válvula</b> fica alinhado com a <b>leitura inicial / pressão inicial do WP</b> em cada câmara.
                  </p>
                </div>
              </div>
            </div>
          )}

          {activeSection === "checklist" && (
            <div ref={(node) => { sectionRefs.current.checklist = node; }} className="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <h2 className="text-lg font-semibold mb-3">Checklist de inspeção da jangada</h2>
              {!inspectionMode ? (
                <div className="rounded-xl border border-dashed border-indigo-300 bg-indigo-50 p-5 text-sm text-indigo-900">
                  A checklist só fica disponível quando entrares em <b>modo de inspeção</b>. Carrega em <b>Inspecionar</b> para abrir o assistente passo a passo.
                </div>
              ) : currentChecklistWizardSection ? (
                <div className="space-y-4">
                  <div className="app-light-blue-surface overflow-hidden rounded-2xl shadow-sm">
                    <div className="grid gap-4 p-4 lg:grid-cols-[minmax(0,1.3fr)_minmax(280px,0.9fr)] lg:p-5">
                      <div>
                        <div className="app-light-blue-kicker flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em]">
                          <span>Wizard de inspeção</span>
                          <span className={`rounded-full border px-2 py-1 normal-case tracking-normal ${checklistCompletionPercent >= 100 ? 'border-emerald-200 bg-emerald-100 text-emerald-800' : checklistCompletionPercent >= 60 ? 'border-amber-200 bg-amber-100 text-amber-800' : 'border-sky-200 bg-sky-100 text-sky-800'}`}>
                            {nextChecklistAction}
                          </span>
                        </div>
                        <h3 className="mt-2 text-2xl font-bold tracking-tight">{checklistCompletionPercent}% da checklist concluída</h3>
                        <p className="app-light-blue-muted mt-2 text-sm">
                          {checklistCompletedFields} de {checklistTotalFields} campos fechados. O objetivo aqui é tornar a inspeção uma sequência clara, não um safari por tabs.
                        </p>
                        <div className="mt-4 h-3 overflow-hidden rounded-full bg-sky-100">
                          <div
                            className="h-full rounded-full bg-sky-500 transition-all"
                            style={{ width: `${checklistCompletionPercent}%` }}
                          />
                        </div>
                      </div>

                      <div className="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
                        <div className="app-light-blue-glass rounded-2xl p-3">
                          <p className="app-light-blue-muted text-xs uppercase tracking-wide">Passo atual</p>
                          <p className="mt-1 text-lg font-bold">{inspectionWizardStep + 1}/{checklistWizardSections.length}</p>
                          <p className="app-light-blue-muted mt-1 text-xs">{currentChecklistWizardSection.title}</p>
                        </div>
                        <div className="app-light-blue-glass rounded-2xl p-3">
                          <p className="app-light-blue-muted text-xs uppercase tracking-wide">Separadores concluídos</p>
                          <p className="mt-1 text-lg font-bold">{completedChecklistWizardSections}</p>
                          <p className="app-light-blue-muted mt-1 text-xs">de {checklistWizardSections.length} grupos.</p>
                        </div>
                        <div className="app-light-blue-glass rounded-2xl p-3">
                          <p className="app-light-blue-muted text-xs uppercase tracking-wide">Destino seguinte</p>
                          <p className="mt-1 text-lg font-bold">{currentChecklistWizardSection.destination?.tabLabel || 'Wizard'}</p>
                          <p className="app-light-blue-muted mt-1 text-xs">{currentChecklistWizardSection.destination?.description || 'Continuar no passo atual.'}</p>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <div className="mb-3">
                      <h3 className="text-sm font-semibold text-slate-900">Próximos passos da inspeção</h3>
                      <p className="mt-1 text-xs text-slate-600">Atalhos rápidos para fechar o circuito técnico sem andar aos ziguezagues.</p>
                    </div>
                    <div className="grid gap-3 md:grid-cols-3">
                      <button
                        type="button"
                        onClick={() => setActiveSection('pack')}
                        className="rounded-xl border border-emerald-200 bg-white px-4 py-3 text-left hover:bg-emerald-50"
                      >
                        <p className="text-sm font-semibold text-emerald-900">Ir ao pack</p>
                        <p className="mt-1 text-xs text-slate-600">Consumíveis, faltas e substituições rápidas.</p>
                      </button>
                      <button
                        type="button"
                        onClick={() => setActiveSection('contentor')}
                        className="rounded-xl border border-sky-200 bg-white px-4 py-3 text-left hover:bg-sky-50"
                      >
                        <p className="text-sm font-semibold text-sky-900">Ir ao contentor</p>
                        <p className="mt-1 text-xs text-slate-600">Fecho, retenida, etiquetas e decisão operacional.</p>
                      </button>
                      <button
                        type="button"
                        onClick={() => setActiveSection('testes')}
                        className="rounded-xl border border-violet-200 bg-white px-4 py-3 text-left hover:bg-violet-50"
                      >
                        <p className="text-sm font-semibold text-violet-900">Ir aos testes</p>
                        <p className="mt-1 text-xs text-slate-600">WP, NAP, FS, GI, DL e fecho técnico da ficha.</p>
                      </button>
                    </div>
                  </div>

                  <div className="rounded-xl border border-indigo-200 bg-indigo-50 p-4">
                    <div className="flex flex-wrap items-start justify-between gap-3">
                      <div>
                        <p className="text-xs font-semibold uppercase tracking-[0.18em] text-indigo-700">
                          Passo {inspectionWizardStep + 1} de {checklistWizardSections.length}
                        </p>
                        <h3 className="mt-1 text-lg font-semibold text-indigo-950">{currentChecklistWizardSection.title}</h3>
                        {currentChecklistWizardSection.englishTitle ? (
                          <p className="mt-1 text-sm text-indigo-700">{currentChecklistWizardSection.englishTitle}</p>
                        ) : null}
                        {currentChecklistWizardSection.destination?.description ? (
                          <p className="mt-2 text-xs text-indigo-700">{currentChecklistWizardSection.destination.description}</p>
                        ) : null}
                      </div>
                      <div className="min-w-[180px] rounded-lg border border-indigo-200 bg-white px-3 py-2 text-right text-xs text-indigo-800">
                        <div><b>{completedChecklistWizardSections}</b> separadores concluídos</div>
                        <div className="mt-1">
                          <b>{currentChecklistWizardSection.completedFields}</b> / {currentChecklistWizardSection.totalFields} campos deste passo
                        </div>
                      </div>
                    </div>

                    <div className="mt-4 h-2 overflow-hidden rounded-full bg-indigo-100">
                      <div
                        className="h-full rounded-full bg-indigo-600 transition-all"
                        style={{ width: `${((inspectionWizardStep + 1) / Math.max(checklistWizardSections.length, 1)) * 100}%` }}
                      />
                    </div>

                    <div className="mt-4 grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
                      {checklistWizardSections.map((section, index) => {
                        const isCurrent = index === inspectionWizardStep;
                        const isDone = section.totalFields > 0 && section.completedFields >= section.totalFields;
                        return (
                          <button
                            key={`wizard-step-${section.title}-${index}`}
                            type="button"
                            onClick={() => setInspectionWizardStep(index)}
                            className={`rounded-lg border px-3 py-2 text-left text-sm transition ${isCurrent
                              ? 'border-indigo-500 bg-white text-indigo-950 shadow-sm'
                              : isDone
                              ? 'border-emerald-200 bg-emerald-50 text-emerald-900 hover:bg-emerald-100'
                              : 'border-indigo-200 bg-white text-gray-700 hover:bg-indigo-50'
                            }`}
                          >
                            <div className="flex items-center justify-between gap-2">
                              <span className="font-medium">{section.title}</span>
                              <span className={`rounded-full px-2 py-0.5 text-[11px] font-semibold ${isCurrent
                                ? 'bg-indigo-100 text-indigo-700'
                                : isDone
                                ? 'bg-emerald-100 text-emerald-700'
                                : 'bg-gray-100 text-gray-600'
                              }`}>
                                {section.completedFields}/{section.totalFields}
                              </span>
                            </div>
                          </button>
                        );
                      })}
                    </div>
                  </div>

                  <div className="rounded-xl border border-gray-200 bg-gray-50 p-4">
                    <div className="mb-4 flex flex-wrap items-center justify-between gap-3">
                      <div>
                        <h4 className="text-sm font-semibold text-gray-900">Preenchimento do passo atual</h4>
                        <p className="mt-1 text-xs text-gray-600">
                          Avança como num wizard: preencher, validar, seguir para o próximo passo — sem caça ao tesouro pelo ecrã.
                        </p>
                      </div>
                      {currentChecklistWizardSection.destination ? (
                        <button
                          type="button"
                          onClick={() => setActiveSection(currentChecklistWizardSection.destination?.section || 'geral')}
                          className="rounded-lg border border-sky-300 bg-sky-50 px-3 py-2 text-xs font-medium text-sky-800 hover:bg-sky-100"
                        >
                          Abrir separador {currentChecklistWizardSection.destination.tabLabel}
                        </button>
                      ) : null}
                    </div>

                    {currentChecklistVisualAids.length > 0 ? (
                      <div className="mb-4 rounded-xl border border-sky-200 bg-sky-50 p-4">
                        <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
                          <div>
                            <h4 className="text-sm font-semibold text-sky-950">Apoios do manual para este passo</h4>
                            <p className="mt-1 text-xs text-sky-700">Fotos, tabelas e esquemas que ajudam a validar este passo sem sair da checklist.</p>
                          </div>
                          <span className="rounded-full border border-sky-200 bg-white px-2 py-1 text-[11px] font-medium text-sky-700">
                            {currentChecklistVisualAids.length} apoio{currentChecklistVisualAids.length === 1 ? '' : 's'}
                          </span>
                        </div>

                        <div className="grid grid-cols-1 gap-3 xl:grid-cols-2">
                          {currentChecklistVisualAids.map((aid) => {
                            if (aid.kind === 'image') {
                              return (
                                <button
                                  key={aid.id}
                                  type="button"
                                  onClick={() => setActiveChecklistImageAid(aid)}
                                  className="overflow-hidden rounded-xl border border-sky-100 bg-white text-left shadow-sm transition hover:border-sky-300 hover:shadow-md"
                                >
                                  <img
                                    src={aid.src}
                                    alt={aid.alt}
                                    className="h-56 w-full object-contain bg-slate-50"
                                    loading="lazy"
                                  />
                                  <div className="p-3">
                                    <div className="flex flex-wrap items-center gap-2">
                                      <p className="text-sm font-semibold text-slate-900">{aid.title}</p>
                                      {aid.badge ? (
                                        <span className="rounded-full border border-sky-200 bg-sky-100 px-2 py-0.5 text-[10px] font-semibold text-sky-800">
                                          {aid.badge}
                                        </span>
                                      ) : null}
                                      <span className="ml-auto text-[10px] font-semibold uppercase tracking-wide text-sky-700">Clique para ampliar</span>
                                    </div>
                                    {aid.description ? <p className="mt-1 text-xs text-slate-600">{aid.description}</p> : null}
                                    {aid.sourceLabel ? <p className="mt-2 text-[11px] text-sky-700">Fonte: <b>{aid.sourceLabel}</b></p> : null}
                                  </div>
                                </button>
                              );
                            }

                            if (aid.kind === 'table') {
                              return (
                                <div key={aid.id} className="rounded-xl border border-sky-100 bg-white p-3 shadow-sm xl:col-span-2">
                                  <div className="mb-2 flex flex-wrap items-center gap-2">
                                    <p className="text-sm font-semibold text-slate-900">{aid.title}</p>
                                    {aid.badge ? (
                                      <span className="rounded-full border border-sky-200 bg-sky-100 px-2 py-0.5 text-[10px] font-semibold text-sky-800">
                                        {aid.badge}
                                      </span>
                                    ) : null}
                                  </div>
                                  {aid.description ? <p className="mb-3 text-xs text-slate-600">{aid.description}</p> : null}
                                  <div className="overflow-auto rounded-lg border border-sky-100">
                                    <table className="min-w-full text-xs">
                                      <thead className="bg-sky-100 text-sky-950">
                                        <tr>
                                          {aid.columns.map((column) => (
                                            <th key={`${aid.id}-${column}`} className="p-2 text-left font-semibold">{column}</th>
                                          ))}
                                        </tr>
                                      </thead>
                                      <tbody>
                                        {aid.rows.map((row, rowIdx) => (
                                          <tr key={`${aid.id}-row-${rowIdx}`} className="border-t border-sky-100">
                                            {row.map((cell, cellIdx) => (
                                              <td key={`${aid.id}-row-${rowIdx}-cell-${cellIdx}`} className="p-2 text-slate-700">{cell}</td>
                                            ))}
                                          </tr>
                                        ))}
                                      </tbody>
                                    </table>
                                  </div>
                                  {aid.sourceLabel ? <p className="mt-2 text-[11px] text-sky-700">Fonte: <b>{aid.sourceLabel}</b></p> : null}
                                </div>
                              );
                            }

                            return (
                              <div key={aid.id} className="rounded-xl border border-sky-100 bg-white p-3 shadow-sm xl:col-span-2">
                                <div className="flex flex-wrap items-center gap-2">
                                  <p className="text-sm font-semibold text-slate-900">{aid.title}</p>
                                  {aid.badge ? (
                                    <span className="rounded-full border border-sky-200 bg-sky-100 px-2 py-0.5 text-[10px] font-semibold text-sky-800">
                                      {aid.badge}
                                    </span>
                                  ) : null}
                                </div>
                                <p className="mt-1 text-xs text-slate-600">{aid.description}</p>
                                {aid.sourceLabel ? <p className="mt-2 text-[11px] text-sky-700">Fonte: <b>{aid.sourceLabel}</b></p> : null}
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    ) : null}

                    <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
                      {currentChecklistWizardSection.fields.map((field, index) => renderInspectionChecklistField(field, `wizard:${currentChecklistWizardSection.title}:${field.name}:${index}`))}
                    </div>
                  </div>

                  <div className="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white p-4">
                    <button
                      type="button"
                      onClick={() => setInspectionWizardStep((prev) => Math.max(prev - 1, 0))}
                      disabled={inspectionWizardStep === 0}
                      className="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50"
                    >
                      Anterior
                    </button>

                    <div className="text-xs text-gray-600">
                      {inspectionWizardStep === checklistWizardSections.length - 1
                        ? 'Último passo da checklist. Depois podes guardar a inspeção.'
                        : 'Depois deste passo, o wizard leva-te ao grupo seguinte.'}
                    </div>

                    {inspectionWizardStep === checklistWizardSections.length - 1 ? (
                      <button
                        type="button"
                        onClick={() => setActiveSection('testes')}
                        className="rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-800 hover:bg-emerald-100"
                      >
                        Ir para testes finais
                      </button>
                    ) : (
                      <button
                        type="button"
                        onClick={() => setInspectionWizardStep((prev) => Math.min(prev + 1, checklistWizardSections.length - 1))}
                        className="rounded-lg border border-indigo-300 bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
                      >
                        Seguinte
                      </button>
                    )}
                  </div>
                </div>
              ) : (
                <div className="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-5 text-sm text-gray-700">
                  Sem grupos de checklist disponíveis para esta jangada neste momento.
                </div>
              )}
            </div>
          )}

          {activeSection === "detalhes" && (
            <div ref={(node) => { sectionRefs.current.detalhes = node; }} className="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <h2 className="text-lg font-semibold mb-2">Detalhes completos da ficha</h2>
              <p className="text-sm text-gray-600 mb-4">Vista técnica reorganizada com fotografia do contentor, campos principais, especificações, torques e referências úteis.</p>

              <div className="mb-4 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3">
                {technicalSummaryCards.map((card) => {
                  const toneClasses = card.tone === "emerald"
                    ? "border-emerald-200 bg-emerald-50 text-emerald-900"
                    : card.tone === "blue"
                    ? "border-blue-200 bg-blue-50 text-blue-900"
                    : card.tone === "violet"
                    ? "border-violet-200 bg-violet-50 text-violet-900"
                    : "border-slate-200 bg-slate-50 text-slate-900";

                  return (
                    <div key={card.label} className={`rounded-xl border p-3 ${toneClasses}`}>
                      <p className="text-[11px] uppercase tracking-wide opacity-75 mb-1">{card.label}</p>
                      <p className="text-sm font-semibold">{card.value}</p>
                    </div>
                  );
                })}
              </div>

              <div className="mb-4 grid grid-cols-1 xl:grid-cols-[1.15fr_1.85fr] gap-4">
                <div className="rounded-xl border border-sky-200 bg-sky-50 p-4">
                  <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
                    <div>
                      <p className="text-xs uppercase tracking-wide text-sky-700 mb-1">Foto técnica do {packagingLabelLower}</p>
                      <p className="text-sm text-sky-900">Modelo: <b>{currentContainerLabel || "—"}</b> · Lotação: <b>{currentCapacity > 0 ? formatCapacityValue(currentCapacity) : "—"}</b></p>
                    </div>
                    {selectedPackBucket ? (
                      <span className="rounded-full border border-sky-200 bg-white px-2 py-1 text-[11px] font-medium text-sky-700">
                        Pack {`SOLAS ${selectedPackBucket}`}
                      </span>
                    ) : null}
                  </div>
                  <div className="rounded-lg border border-sky-100 bg-white p-3">
                    <ContainerImage
                      containerModel={currentContainerLabel}
                      lotacao={currentCapacity || ""}
                      style={{ maxWidth: 320, margin: "0 auto" }}
                    />
                  </div>
                  <p className="mt-3 text-xs text-sky-700">
                    {isValiseContainer
                      ? 'A imagem aparece automaticamente quando existe correspondência entre modelo da valise e lotação na biblioteca técnica.'
                      : 'A imagem aparece automaticamente quando existe correspondência entre modelo do contentor e lotação na biblioteca técnica.'}
                  </p>
                </div>

                <div className="space-y-4">
                  <div className="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
                    <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
                      <div>
                        <p className="text-xs uppercase tracking-wide text-emerald-700 mb-1">{packagingLabel} e dimensões</p>
                        <p className="text-sm text-emerald-900">
                          {packagingLabel}: <b>{selectedContainerModel || "—"}</b> · Pack: <b>{selectedPackBucket ? `SOLAS ${selectedPackBucket}-PACK` : currentPackLabel || "—"}</b> · Lotação: <b>{currentCapacity > 0 ? formatCapacityValue(currentCapacity) : "—"}</b>
                        </p>
                      </div>
                      <span className="rounded-full border border-emerald-200 bg-white px-2 py-1 text-[11px] font-medium text-emerald-700">
                        Fonte: Manual MK IV pág. 108–113
                      </span>
                    </div>

                    {selectedContainerSpecs.length > 0 ? (
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                        {selectedContainerSpecs.map((spec) => (
                          <div key={`${spec.containerKey}-${spec.capacityKey}-${spec.pack}-${spec.launchType}`} className="rounded border border-emerald-100 bg-white p-3 text-sm">
                            <p className="text-xs uppercase tracking-wide text-emerald-700 mb-2">
                              {spec.launchType === "throwover" ? "Lançamento" : spec.launchType === "davit" ? "Lançamento por turco" : "Flat-Pack"}
                            </p>
                            <div className="grid grid-cols-2 gap-x-4 gap-y-1">
                              <span className="text-gray-500">Comprimento</span>
                              <span className="font-semibold text-gray-900">{spec.comprimentoMm ? `${spec.comprimentoMm} mm` : "—"}</span>
                              {spec.diametroMm !== undefined ? (
                                <>
                                  <span className="text-gray-500">Diâmetro</span>
                                  <span className="font-semibold text-gray-900">{spec.diametroMm} mm</span>
                                </>
                              ) : (
                                <>
                                  <span className="text-gray-500">Largura</span>
                                  <span className="font-semibold text-gray-900">{spec.larguraMm ? `${spec.larguraMm} mm` : "—"}</span>
                                </>
                              )}
                              {spec.diametroMm !== undefined ? null : (
                                <>
                                  <span className="text-gray-500">Altura</span>
                                  <span className="font-semibold text-gray-900">{spec.alturaMm ? `${spec.alturaMm} mm` : "—"}</span>
                                </>
                              )}
                              <span className="text-gray-500">Peso operacional</span>
                              <span className="font-semibold text-gray-900">{spec.pesoKg ? `${spec.pesoKg} kg` : "—"}</span>
                              <span className="text-gray-500">Página manual</span>
                              <span className="text-gray-700">{spec.page}</span>
                            </div>
                            {spec.notes ? <p className="mt-2 text-xs text-gray-500">{spec.notes}</p> : null}
                          </div>
                        ))}
                      </div>
                    ) : selectedContainerModel && selectedPackBucket ? (
                      <div className="rounded border border-dashed border-emerald-300 bg-white p-3 text-sm text-emerald-900">
                        Não encontrei uma linha exata para <b>{selectedContainerModel}</b> com <b>SOLAS {selectedPackBucket}-PACK</b> e lotação <b>{currentCapacity > 0 ? formatCapacityValue(currentCapacity) : "—"}</b> nas tabelas já mapeadas do manual.
                      </div>
                    ) : (
                      <div className="rounded border border-dashed border-emerald-300 bg-white p-3 text-sm text-emerald-900">
                        Escolha um <b>contentor</b> nos Dados Gerais e mantenha o <b>tipo de pack</b> preenchido para mostrar automaticamente os sizes técnicos.
                      </div>
                    )}
                  </div>

                  <div className="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <p className="text-xs uppercase tracking-wide text-slate-600 mb-2">Dados principais da ficha</p>
                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                      {technicalDetailSections.map((section) => {
                        const sectionToneClasses = section.tone === "emerald"
                          ? "border-emerald-100 bg-emerald-50/60"
                          : section.tone === "blue"
                          ? "border-blue-100 bg-blue-50/60"
                          : section.tone === "amber"
                          ? "border-amber-100 bg-amber-50/60"
                          : "border-slate-200 bg-white";

                        return (
                          <div key={section.title} className={`rounded-lg border p-3 ${sectionToneClasses}`}>
                            <h3 className="text-sm font-semibold text-gray-900 mb-2">{section.title}</h3>
                            <div className="overflow-auto">
                              <table className="min-w-full text-sm">
                                <tbody>
                                  {section.rows.map((row) => (
                                    <tr key={row.key} className="border-t border-black/5 first:border-t-0 align-top">
                                      <td className="py-2 pr-3 text-gray-500 w-1/2">{row.label}</td>
                                      <td className="py-2 text-gray-900 font-medium whitespace-pre-wrap break-words">{formatTechnicalValue(row.value)}</td>
                                    </tr>
                                  ))}
                                </tbody>
                              </table>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>
              </div>

              {(technicalModel || technicalSpecifications.length > 0 || technicalKeyDataEntries.length > 0) && (
                <div className="mb-4 space-y-4">
                  <div className="rounded-lg border border-slate-200 bg-slate-50 p-3">
                    <p className="text-xs uppercase tracking-wide text-slate-600 mb-1">Especificações técnicas por marca/modelo</p>
                    <p className="text-sm text-slate-800">
                      Ficha atual: <b>{String(form.brand || raft?.brand || "—")}</b> / <b>{String(form.model || raft?.model || "—")}</b>
                      {technicalModel ? <> · modelo técnico reconhecido: <b>{technicalModel.name}</b></> : null}
                    </p>
                  </div>

                  {technicalKeyDataEntries.length > 0 && (
                    <div className="rounded-lg border border-indigo-200 bg-indigo-50 p-3">
                      <div className="mb-2 flex items-center justify-between gap-2">
                        <div>
                          <p className="text-xs uppercase tracking-wide text-indigo-700 mb-1">Resumo técnico do manual</p>
                          <p className="text-sm text-indigo-900">Dados-chave reconhecidos automaticamente para este modelo.</p>
                        </div>
                        <span className="rounded-full border border-indigo-200 bg-white px-2 py-1 text-[11px] font-medium text-indigo-700">
                          {technicalKeyDataEntries.length} pontos
                        </span>
                      </div>
                      <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3">
                        {technicalKeyDataEntries.map(([key, value]) => (
                          <div key={key} className="rounded border border-indigo-100 bg-white p-3">
                            <p className="text-[11px] uppercase tracking-wide text-indigo-700 mb-1">{key}</p>
                            <p className="text-sm font-medium text-gray-900">{String(value)}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {technicalSpecifications.length > 0 && (
                    <div className="rounded-lg border border-teal-200 bg-teal-50 p-3">
                      <div className="mb-2 flex flex-wrap items-center justify-between gap-2">
                        <div>
                          <p className="text-xs uppercase tracking-wide text-teal-700 mb-1">Todas as especificações técnicas da jangada</p>
                          <p className="text-sm text-teal-900">Capacidade, pack, sistema e carga nominal do cilindro disponíveis para consulta direta.</p>
                        </div>
                        <span className="rounded-full border border-teal-200 bg-white px-2 py-1 text-[11px] font-medium text-teal-700">
                          {technicalSpecifications.length} especificações
                        </span>
                      </div>
                      <div className="overflow-auto rounded border border-teal-100 bg-white">
                        <table className="min-w-full text-sm">
                          <thead className="bg-teal-100 text-teal-900">
                            <tr>
                              <th className="p-2 text-left font-semibold">Ref.</th>
                              <th className="p-2 text-center font-semibold">Capacidade</th>
                              <th className="p-2 text-left font-semibold">Pack</th>
                              <th className="p-2 text-left font-semibold">Sistema</th>
                              <th className="p-2 text-center font-semibold">CO₂</th>
                              <th className="p-2 text-center font-semibold">N₂</th>
                              <th className="p-2 text-left font-semibold">Válvulas</th>
                              <th className="p-2 text-left font-semibold">Fonte</th>
                            </tr>
                          </thead>
                          <tbody>
                            {technicalSpecifications.map((spec) => {
                              const isCurrentSpec = (currentCapacity <= 0 || spec.capacity === currentCapacity)
                                && (!currentPackTechnicalLabel || !spec.pack || matchesTechnicalSpecPack(spec.pack, currentPackTechnicalLabel));
                              return (
                                <tr key={`${spec.codRef || spec.capacity}-${spec.pack || "no-pack"}`} className={`border-t align-top ${isCurrentSpec ? "bg-teal-50" : "bg-white"}`}>
                                  <td className="p-2 font-mono text-xs text-gray-900">{spec.codRef || "—"}</td>
                                  <td className="p-2 text-center text-gray-900">{formatCapacityValue(spec.capacity)}</td>
                                  <td className="p-2 text-gray-900">{spec.pack || "—"}</td>
                                  <td className="p-2 text-gray-900">{spec.inflationSystem || "—"}</td>
                                  <td className="p-2 text-center text-gray-900">{typeof spec.cylinder?.co2 === "number" ? `${spec.cylinder.co2} kg` : "—"}</td>
                                  <td className="p-2 text-center text-gray-900">{typeof spec.cylinder?.n2 === "number" ? `${spec.cylinder.n2} kg` : "—"}</td>
                                  <td className="p-2 text-gray-900 whitespace-pre-wrap break-words">{spec.valves || "—"}</td>
                                  <td className="p-2 text-xs text-gray-600 whitespace-pre-wrap break-words">{spec.source?.note || spec.source?.manual || spec.source?.chapter || "—"}</td>
                                </tr>
                              );
                            })}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  )}

                  {sb4621Applicable && sb4621LayoutGuide ? (
                    <div className="rounded-lg border border-blue-200 bg-blue-50 p-3">
                      <div className="mb-2 flex flex-wrap items-center justify-between gap-2">
                        <div>
                          <p className="text-xs uppercase tracking-wide text-blue-700 mb-1">SB 46/21 Ver.2 — Disposição dos autocolantes</p>
                          <p className="text-sm text-blue-900">
                            Modelo/regra: <b>{sb4621Applicable.matchedRuleLabel || "—"}</b> · Contentor: <b>{selectedContainerModel || form.containerModel || raft?.containerModel || "—"}</b>
                          </p>
                          <p className="mt-1 text-xs text-blue-800">{sb4621LayoutGuide.subtitle}</p>
                        </div>
                        {sb4621Applicable.fileUrl ? (
                          <a
                            href={sb4621Applicable.fileUrl}
                            target="_blank"
                            rel="noreferrer"
                            className="rounded border border-blue-300 bg-white px-3 py-2 text-xs font-medium text-blue-700 hover:bg-blue-100"
                          >
                            Abrir boletim SB 46/21
                          </a>
                        ) : null}
                      </div>

                      <div className="mb-2 flex flex-wrap gap-2 text-[11px] text-blue-900">
                        {sb4621LayoutGuide.sheets.map((sheet) => (
                          <span key={sheet} className="rounded-full border border-blue-200 bg-white px-2 py-1">
                            {sheet}
                          </span>
                        ))}
                      </div>

                      <div className="rounded border border-blue-100 bg-white p-3">
                        {sb4621LayoutGuide.figurePath ? (
                          <img
                            src={sb4621LayoutGuide.figurePath}
                            alt={`SB 46/21 ${sb4621LayoutGuide.title} — figura real da disposição dos autocolantes`}
                            className="h-auto w-full rounded border border-blue-100"
                            loading="lazy"
                          />
                        ) : (
                          <div className="rounded border border-dashed border-blue-300 bg-blue-50 px-3 py-4 text-sm text-blue-800">
                            Não foi possível determinar automaticamente a figura específica deste modelo. Usa o botão “Abrir boletim SB 46/21” para confirmar a página aplicável.
                          </div>
                        )}
                      </div>

                      <p className="mt-2 text-xs text-blue-700">
                        Figura real extraída do <b>SB 46/21 Ver.2</b>{sb4621LayoutGuide.figurePage ? <> (pág. <b>{sb4621LayoutGuide.figurePage}</b>)</> : null}; para validação final por variante de contentor, confirmar no PDF oficial do boletim.
                      </p>
                    </div>
                  ) : null}

                  {!isMkivFicha && genericTorqueEntries.length > 0 && (
                    <div className="rounded-lg border border-violet-200 bg-violet-50 p-3">
                      <div className="mb-2 flex items-center justify-between gap-2">
                        <div>
                          <p className="text-xs uppercase tracking-wide text-violet-700 mb-1">Torques de referência</p>
                          <p className="text-sm text-violet-900">Torques técnicos disponíveis para este modelo fora da tabela detalhada MKIV.</p>
                        </div>
                        <span className="rounded-full border border-violet-200 bg-white px-2 py-1 text-[11px] font-medium text-violet-700">
                          {genericTorqueEntries.length} referências
                        </span>
                      </div>
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                        {genericTorqueEntries.map((torque, index) => (
                          <div key={`generic-torque-${index}`} className="rounded border border-violet-100 bg-white px-3 py-2 text-sm text-violet-900">
                            {torque}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {isMkivFicha && (
                    <div className="rounded-lg border border-violet-200 bg-violet-50 p-3">
                      <div className="mb-2 flex flex-wrap items-center justify-between gap-2">
                        <div>
                          <p className="text-xs uppercase tracking-wide text-violet-700 mb-1">Torques do manual MKIV/LR07</p>
                          <p className="text-sm text-violet-900">Tabela 101 — Configurações de torque do sistema de inflação Leafield.</p>
                        </div>
                        <span className="rounded-full border border-violet-200 bg-white px-2 py-1 text-[11px] font-medium text-violet-700">
                          {MKIV_TORQUE_SETTINGS.length} pontos de torque
                        </span>
                      </div>

                      <div className="mb-3 flex flex-wrap gap-2 text-[11px] text-violet-800">
                        <span className="rounded-full border border-violet-200 bg-white px-2 py-1">
                          Fonte: <b>{MKIV_TORQUE_SOURCE.manual}</b>
                        </span>
                        <span className="rounded-full border border-violet-200 bg-white px-2 py-1">
                          Página: <b>{MKIV_TORQUE_SOURCE.pagina}</b>
                        </span>
                        <span className="rounded-full border border-violet-200 bg-white px-2 py-1">
                          {MKIV_TORQUE_SOURCE.tabela} · {MKIV_TORQUE_SOURCE.secao}
                        </span>
                      </div>

                      {mkivRelevantTorqueSettings.length > 0 && (
                        <div className="mb-3 rounded border border-violet-100 bg-white p-3">
                          <p className="mb-2 text-xs font-semibold uppercase tracking-wide text-violet-700">Torques mais relevantes para os componentes preenchidos</p>
                          <div className="flex flex-wrap gap-2">
                            {mkivRelevantTorqueSettings.map((item) => (
                              <div key={`torque-highlight-${item.componente}`} className="rounded-lg border border-violet-100 bg-violet-50 px-3 py-2 text-xs text-violet-900">
                                <div className="font-medium">{item.componente}</div>
                                <div className="mt-1 font-mono">{item.torqueNm} Nm · {item.torqueFtLb} pé·lbf</div>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      <div className="overflow-auto rounded border border-violet-100 bg-white">
                        <table className="min-w-full text-xs">
                          <thead className="bg-violet-100 text-violet-900">
                            <tr>
                              <th className="p-2 text-left font-semibold">Componente</th>
                              <th className="p-2 text-center font-semibold whitespace-nowrap">Torque (Nm)</th>
                              <th className="p-2 text-center font-semibold whitespace-nowrap">Pé·lbf</th>
                              <th className="p-2 text-center font-semibold whitespace-nowrap">Ferramenta especial</th>
                            </tr>
                          </thead>
                          <tbody>
                            {MKIV_TORQUE_SETTINGS.map((item) => (
                              <tr key={`torque-${item.componente}`} className="border-t border-violet-100 align-top">
                                <td className="p-2 text-gray-900">{item.componente}</td>
                                <td className="p-2 text-center font-mono text-gray-900 whitespace-nowrap">{item.torqueNm}</td>
                                <td className="p-2 text-center font-mono text-gray-700 whitespace-nowrap">{item.torqueFtLb}</td>
                                <td className="p-2 text-center">
                                  <span className={`inline-flex rounded-full px-2 py-0.5 font-medium ${item.ferramentaEspecial ? "bg-amber-100 text-amber-800" : "bg-gray-100 text-gray-700"}`}>
                                    {item.ferramentaEspecial ? "Sim" : "Não"}
                                  </span>
                                </td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>

                      <p className="mt-2 text-xs text-violet-700">
                        Inclui também os torques do <b>H-Pack</b> e da <b>válvula de vácuo</b>, para ficarem logo à mão na ficha técnica.
                      </p>
                    </div>
                  )}

                  {isMkivFicha && (
                    <div className="rounded-lg border border-indigo-200 bg-indigo-50 p-3">
                      <div className="mb-2 flex flex-wrap items-center justify-between gap-2">
                        <div>
                          <p className="text-xs uppercase tracking-wide text-indigo-700 mb-1">Válvulas do Manual MKIV/LR07 (referências)</p>
                          <p className="text-sm text-indigo-900">Referências técnicas extraídas do material MKIV e mostradas para fichas da família MKIV/LR07.</p>
                        </div>
                        <span className="rounded-full border border-indigo-200 bg-white px-2 py-1 text-[11px] font-medium text-indigo-700">
                          {mkivValvulasManualList.length} referências
                        </span>
                      </div>

                      <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                        {(() => {
                          const porCategoria = mkivValvulasManualList.reduce((acc: Record<string, typeof mkivValvulasManualList>, item) => {
                            if (!acc[item.categoria]) acc[item.categoria] = [];
                            acc[item.categoria].push(item);
                            return acc;
                          }, {} as Record<string, typeof mkivValvulasManualList>);

                          return Object.entries(porCategoria).map(([categoria, items]) => {
                            const style = MKIV_CATEGORIA_STYLES[categoria] || {
                              icon: "📦",
                              containerClassName: "border-indigo-100 bg-white",
                              titleClassName: "text-indigo-700",
                              itemClassName: "border-gray-100 bg-gray-50",
                            };

                            return (
                            <div key={`mkiv-cat-${categoria}`} className={`rounded border p-2 ${style.containerClassName}`}>
                              <h5 className={`mb-2 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide ${style.titleClassName}`}>
                                <span>{style.icon}</span>
                                <span>{categoria}</span>
                              </h5>
                              <div className="space-y-2">
                                {items.map((v) => (
                                  <div key={`mkiv-valvula-tecnica-${v.referencia}`} className={`rounded border p-2 ${style.itemClassName}`}>
                                    <div className="flex items-start justify-between gap-2">
                                      <div>
                                        <p className="text-sm font-semibold text-indigo-900">{v.referencia}</p>
                                        <p className="text-sm text-gray-800">{v.descricao}</p>
                                        {v.codigoFabricante ? (
                                          <p className="text-xs text-gray-500">Cód. fabricante: {v.codigoFabricante}</p>
                                        ) : null}
                                      </div>
                                      {edit && inspectionMode ? (
                                        <button
                                          type="button"
                                          className="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-700"
                                          onClick={() => setReplacementPicker({ key: `technical:mkiv:${v.referencia}`, articleName: v.descricao, defaultBusca: v.referencia || v.descricao, technical: true })}
                                        >
                                          Substituir
                                        </button>
                                      ) : null}
                                    </div>
                                    {replacementPicker?.key === `technical:mkiv:${v.referencia}` ? (
                                      <div className="mt-2 rounded border border-indigo-100 bg-white p-2">
                                        <ArtigoSelector
                                          onSelect={(artigo) => aplicarSubstituicaoStock(v.descricao, artigo, true)}
                                          buttonLabel="Escolher do stock"
                                          defaultBusca={replacementPicker.defaultBusca}
                                          initialOpen
                                        />
                                      </div>
                                    ) : null}
                                  </div>
                                ))}
                              </div>
                            </div>
                          );});
                        })()}
                      </div>

                      <p className="mt-2 text-xs text-indigo-700">Referências extraídas do material MKIV/LR07 já integrado no projeto e enriquecidas com descrição do stock quando disponível.</p>
                    </div>
                  )}

                  {isMkivFicha && (
                    <div className="rounded-lg border border-amber-200 bg-amber-50 p-3">
                      <p className="text-xs uppercase tracking-wide text-amber-700 mb-2">Sugestões MKIV/LR07 para sistema GIST/LEAFIELD</p>
                      <p className="mb-2 text-xs text-amber-700">Sistema selecionado: <b>{String(form.cylinderSistema || raft?.cylinderSistema || "Não definido")}</b> (apenas para fichas MKIV/LR07)</p>
                      {mkivGistLeafieldSugestoes.length === 0 ? (
                        <p className="text-sm text-amber-800">Sem sugestões MKIV encontradas para esta ficha.</p>
                      ) : (
                        <ul className="list-disc pl-5 text-sm text-amber-900 space-y-1">
                          {mkivGistLeafieldSugestoes.map((s) => (
                            <li key={`mkiv-${s.referencia}`} className="rounded border border-amber-100 bg-white px-2 py-2">
                              <div className="flex items-start justify-between gap-2">
                                <div>
                                  {s.referencia} — {s.descricao}{s.codigoFabricante ? ` (${s.codigoFabricante})` : ""}
                                  {getSystemCompatibilityScore(s) > 0 ? " ★ compatível com sistema" : ""}
                                </div>
                                {edit && inspectionMode ? (
                                  <button
                                    type="button"
                                    className="rounded bg-amber-500 px-2 py-1 text-xs text-white hover:bg-amber-600"
                                    onClick={() => setReplacementPicker({ key: `technical:gist:${s.referencia}`, articleName: s.descricao, defaultBusca: s.referencia || s.descricao, technical: true })}
                                  >
                                    Substituir
                                  </button>
                                ) : null}
                              </div>
                              {replacementPicker?.key === `technical:gist:${s.referencia}` ? (
                                <div className="mt-2 rounded border border-amber-100 bg-white p-2">
                                  <ArtigoSelector
                                    onSelect={(artigo) => aplicarSubstituicaoStock(s.descricao, artigo, true)}
                                    buttonLabel="Escolher do stock"
                                    defaultBusca={replacementPicker.defaultBusca}
                                    initialOpen
                                  />
                                </div>
                              ) : null}
                            </li>
                          ))}
                        </ul>
                      )}
                      <p className="mt-2 text-xs text-amber-700">Mostrado apenas quando a ficha corresponde a modelos MKIV/LR07.</p>
                    </div>
                  )}

                  {isLr97Ficha && (
                    <div className="rounded-lg border border-sky-200 bg-sky-50 p-3">
                      <p className="text-xs uppercase tracking-wide text-sky-700 mb-2">Sugestões LR97 (tubos, adaptadores, vedantes, anilhas)</p>
                      <p className="mb-2 text-xs text-sky-700">Sistema selecionado: <b>{String(form.cylinderSistema || raft?.cylinderSistema || "Não definido")}</b> (apenas para fichas LR97)</p>
                      {lr97InflacaoSugestoes.length === 0 ? (
                        <p className="text-sm text-sky-800">Sem sugestões LR97 encontradas para esta ficha.</p>
                      ) : (
                        <ul className="list-disc pl-5 text-sm text-sky-900 space-y-1">
                          {lr97InflacaoSugestoes.map((s) => (
                            <li key={`lr97-${s.referencia}`} className="rounded border border-sky-100 bg-white px-2 py-2">
                              <div className="flex items-start justify-between gap-2">
                                <div>
                                  {s.referencia} — {s.descricao}{s.codigoFabricante ? ` (${s.codigoFabricante})` : ""}
                                  {getSystemCompatibilityScore(s) > 0 ? " ★ compatível com sistema" : ""}
                                </div>
                                {edit && inspectionMode ? (
                                  <button
                                    type="button"
                                    className="rounded bg-sky-600 px-2 py-1 text-xs text-white hover:bg-sky-700"
                                    onClick={() => setReplacementPicker({ key: `technical:lr97:${s.referencia}`, articleName: s.descricao, defaultBusca: s.referencia || s.descricao, technical: true })}
                                  >
                                    Substituir
                                  </button>
                                ) : null}
                              </div>
                              {replacementPicker?.key === `technical:lr97:${s.referencia}` ? (
                                <div className="mt-2 rounded border border-sky-100 bg-white p-2">
                                  <ArtigoSelector
                                    onSelect={(artigo) => aplicarSubstituicaoStock(s.descricao, artigo, true)}
                                    buttonLabel="Escolher do stock"
                                    defaultBusca={replacementPicker.defaultBusca}
                                    initialOpen
                                  />
                                </div>
                              ) : null}
                            </li>
                          ))}
                        </ul>
                      )}
                      <p className="mt-2 text-xs text-sky-700">Filtrado apenas para jangadas cuja ficha corresponde à família LR97.</p>
                    </div>
                  )}

                  {tannerSugestoes.length > 0 && (
                    <div className="rounded-lg border border-orange-200 bg-orange-50 p-3">
                      <p className="text-xs uppercase tracking-wide text-orange-700 mb-2">Componentes Tanner/Thanner (Sistema Compatível)</p>
                      <p className="mb-2 text-xs text-orange-700">Sugestões específicas para sistema <b>Tanner/Thanner</b> e apenas para o modelo atual da ficha</p>
                      <ul className="list-disc pl-5 text-sm text-orange-900 space-y-1">
                        {tannerSugestoes.map((s) => (
                          <li key={`tanner-${s.referencia}`} className="rounded border border-orange-100 bg-white px-2 py-2">
                            <div className="flex items-start justify-between gap-2">
                              <div>
                                <span className="font-medium">[{s.categoria}]</span> {s.referencia} — {s.descricao}{s.codigoFabricante ? ` (${s.codigoFabricante})` : ""}
                              </div>
                              {edit && inspectionMode ? (
                                <button
                                  type="button"
                                  className="rounded bg-orange-500 px-2 py-1 text-xs text-white hover:bg-orange-600"
                                  onClick={() => setReplacementPicker({ key: `technical:tanner:${s.referencia}`, articleName: s.descricao, defaultBusca: s.referencia || s.descricao, technical: true })}
                                >
                                  Substituir
                                </button>
                              ) : null}
                            </div>
                            {replacementPicker?.key === `technical:tanner:${s.referencia}` ? (
                              <div className="mt-2 rounded border border-orange-100 bg-white p-2">
                                <ArtigoSelector
                                  onSelect={(artigo) => aplicarSubstituicaoStock(s.descricao, artigo, true)}
                                  buttonLabel="Escolher do stock"
                                  defaultBusca={replacementPicker.defaultBusca}
                                  initialOpen
                                />
                              </div>
                            ) : null}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {isLr97Ficha && lr97ComponentesAdicionaisSugestoes.length > 0 && (
                    <div className="rounded-lg border border-cyan-200 bg-cyan-50 p-3">
                      <p className="text-xs uppercase tracking-wide text-cyan-700 mb-2">Componentes Adicionais LR97 (Válvulas, Medição, Acoplamentos)</p>
                      <p className="mb-2 text-xs text-cyan-700">Biblioteca complementar apresentada apenas para fichas LR97</p>
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                        {(() => {
                          const byCategoria = lr97ComponentesAdicionaisSugestoes.reduce((acc: Record<string, any[]>, item: any) => {
                            if (!acc[item.categoria]) acc[item.categoria] = [];
                            acc[item.categoria].push(item);
                            return acc;
                          }, {});

                          return Object.entries(byCategoria).map(([categoria, items]: [string, any[]]) => (
                            <div key={categoria} className="rounded border border-cyan-100 bg-white p-2">
                              <h5 className="text-xs font-semibold text-cyan-700 mb-1 capitalize">{categoria}</h5>
                              <ul className="text-xs text-cyan-900 space-y-0.5">
                                {items.map((item, index) => (
                                  <li key={`lr97-comp-${categoria}-${item.referencia || item.referenciaManual || "sem-ref"}-${index}`} className="rounded border border-cyan-100 bg-cyan-50 px-2 py-2">
                                    <div className="flex items-start justify-between gap-2">
                                      <div>
                                        <span className="font-mono font-semibold">{item.referencia}</span>{" "}
                                        <span className="text-gray-700">{item.descricao}{item.codigoFabricante ? ` (${item.codigoFabricante})` : ""}</span>
                                      </div>
                                      {edit && inspectionMode ? (
                                        <button
                                          type="button"
                                          className="rounded bg-cyan-600 px-2 py-1 text-xs text-white hover:bg-cyan-700"
                                          onClick={() => setReplacementPicker({ key: `technical:lr97-add:${item.referenciaManual || item.referencia}`, articleName: item.descricao, defaultBusca: item.defaultBusca || item.referencia || item.descricao, technical: true })}
                                        >
                                          Substituir
                                        </button>
                                      ) : null}
                                    </div>
                                    {replacementPicker?.key === `technical:lr97-add:${item.referenciaManual || item.referencia}` ? (
                                      <div className="mt-2 rounded border border-cyan-100 bg-white p-2">
                                        <ArtigoSelector
                                          onSelect={(artigo) => aplicarSubstituicaoStock(item.descricao, artigo, true)}
                                          buttonLabel="Escolher do stock"
                                          defaultBusca={replacementPicker.defaultBusca}
                                          initialOpen
                                        />
                                      </div>
                                    ) : null}
                                  </li>
                                ))}
                              </ul>
                            </div>
                          ));
                        })()}
                      </div>
                    </div>
                  )}

                  {technicalModel?.notes && technicalModel.notes.length > 0 && (
                    <div className="rounded-lg border border-gray-200 bg-gray-50 p-3">
                      <p className="text-xs uppercase tracking-wide text-gray-600 mb-2">Notas técnicas do modelo</p>
                      <ul className="list-disc pl-5 space-y-1 text-sm text-gray-800">
                        {technicalModel.notes.map((note, index) => (
                          <li key={`technical-note-${index}`}>{note}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              )}

              <details className="rounded-lg border border-gray-200 bg-white" open>
                <summary className="cursor-pointer bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-900">Todos os campos principais da ficha</summary>
                <div className="overflow-auto border-t border-gray-200">
                  <table className="min-w-full text-sm">
                    <thead className="bg-gray-50">
                      <tr>
                        <th className="p-2 text-left font-semibold w-1/3">Campo</th>
                        <th className="p-2 text-left font-semibold">Valor</th>
                      </tr>
                    </thead>
                    <tbody>
                      {remainingTechnicalRows.map(([key, value]) => (
                        <tr key={key} className="border-t align-top">
                          <td className="p-2 text-gray-700 font-medium">{key}</td>
                          <td className="p-2 text-gray-900 whitespace-pre-wrap break-words">{formatTechnicalValue(value)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>

              <details className="mt-3">
                <summary className="cursor-pointer text-xs text-blue-700">Ver JSON completo (avançado)</summary>
                <pre className="app-light-blue-code mt-2 max-h-[50vh] overflow-auto rounded-lg p-3 text-xs">
                  {JSON.stringify(raft, null, 2)}
                </pre>
              </details>
            </div>
          )}

          <div className="flex flex-wrap gap-2 mt-4">
            <button type="button" className="bg-gray-300 px-4 py-2 rounded text-sm" onClick={() => router.back()}>Voltar</button>
            <a href="/jangadas" className="bg-white border border-gray-300 px-4 py-2 rounded text-sm">Lista de Jangadas</a>
          </div>
          </div>
        </form>

        {activeChecklistImageAid ? (
          <div
            className="fixed inset-0 z-[70] flex items-center justify-center bg-slate-950/80 p-4"
            onClick={() => setActiveChecklistImageAid(null)}
          >
            <div
              className="flex max-h-[92vh] w-full max-w-6xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl"
              onClick={(event) => event.stopPropagation()}
            >
              <div className="flex items-start justify-between gap-4 border-b border-slate-200 px-4 py-3">
                <div>
                  <div className="flex flex-wrap items-center gap-2">
                    <h2 className="text-lg font-semibold text-slate-900">{activeChecklistImageAid.title}</h2>
                    {activeChecklistImageAid.badge ? (
                      <span className="rounded-full border border-sky-200 bg-sky-100 px-2 py-0.5 text-[10px] font-semibold text-sky-800">
                        {activeChecklistImageAid.badge}
                      </span>
                    ) : null}
                  </div>
                  {activeChecklistImageAid.description ? <p className="mt-1 text-sm text-slate-600">{activeChecklistImageAid.description}</p> : null}
                  {activeChecklistImageAid.sourceLabel ? <p className="mt-2 text-xs uppercase tracking-wide text-slate-500">{activeChecklistImageAid.sourceLabel}</p> : null}
                </div>
                <button
                  type="button"
                  onClick={() => setActiveChecklistImageAid(null)}
                  className="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
                >
                  Fechar
                </button>
              </div>
              <div className="overflow-auto bg-slate-100 p-4">
                <img
                  src={activeChecklistImageAid.src}
                  alt={activeChecklistImageAid.alt}
                  className="mx-auto h-auto max-h-[calc(92vh-9rem)] w-auto max-w-full rounded-xl border border-slate-200 bg-white object-contain shadow-sm"
                />
              </div>
            </div>
          </div>
        ) : null}

        {showCertificatePreview && certificatePreviewHtml && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4">
            <div className="flex h-[90vh] w-full max-w-6xl flex-col overflow-hidden rounded-xl bg-white shadow-2xl">
              <div className="flex items-center justify-between border-b border-gray-200 px-4 py-3">
                <div>
                  <h2 className="text-lg font-semibold text-gray-900">
                    {certificatePreviewKind === 'orey' ? 'Pré-visualização do Certificado Orey' : 'Pré-visualização do Relatório Moderno'}
                  </h2>
                  <p className="text-xs text-gray-500">
                    {certificatePreviewKind === 'orey'
                      ? 'Pré-visualização gerada a partir do ficheiro real `template certificado orey.xltx`.'
                      : 'Pré-visualização HTML moderna gerada dinamicamente com dados reais da ficha da jangada.'}
                  </p>
                </div>
                <div className="flex items-center gap-2">
                  {certificatePreviewKind === 'orey' ? (
                    <>
                      <button
                        type="button"
                        onClick={downloadOreyCertificateWorkbook}
                        className="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700"
                      >
                        Descarregar Excel do template
                      </button>
                      <button
                        type="button"
                        onClick={openOreyCertificateExcel}
                        className="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700"
                      >
                        Abrir Certificado Excel
                      </button>
                    </>
                  ) : null}
                  <button
                    type="button"
                    onClick={downloadCurrentPreviewHtml}
                    className="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm text-indigo-700"
                  >
                    Descarregar HTML
                  </button>
                  <button
                    type="button"
                    onClick={openCertificatePreviewInNewTab}
                    className="rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-sm text-blue-700"
                  >
                    Abrir em nova aba
                  </button>
                  <button
                    type="button"
                    onClick={() => setShowCertificatePreview(false)}
                    className="rounded-lg border border-sky-200 bg-sky-100 px-3 py-2 text-sm text-sky-900 hover:bg-sky-200"
                  >
                    Fechar
                  </button>
                </div>
              </div>
              <iframe title="Pré-visualização do certificado" srcDoc={certificatePreviewHtml} className="h-full w-full bg-gray-100" />
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

// Componente para selecionar artigo do stock
function isValveLikeSelection(params: {
  artigo: StockLookupItem;
  buscaAtual?: string;
  buscaInicial?: string;
}) {
  const valveHints = [
    "valvula",
    "válvula",
    "valve",
    "prv",
    "ots",
    "a8",
    "a10",
    "filling",
    "relief",
    "inflation",
    "enchimento",
    "alivio",
    "alívio",
  ];

  const haystack = normalizeText([
    params.artigo.descricao,
    params.artigo.referencia,
    params.artigo.codigoFabricante,
    params.artigo.categoria,
    params.buscaAtual,
    params.buscaInicial,
  ].filter(Boolean).join(" "));

  return valveHints.some((hint) => haystack.includes(normalizeText(hint)));
}

function ArtigoSelector({
  onSelect,
  buttonLabel,
  defaultBusca,
  initialQuantity,
  initialOpen,
}: {
  onSelect: (artigo: ArtigoSelectorSelection) => void;
  buttonLabel?: string;
  defaultBusca?: string;
  initialQuantity?: string | number;
  initialOpen?: boolean;
}) {
  const [show, setShow] = useState(Boolean(initialOpen));
  const [artigos, setArtigos] = useState<StockLookupItem[]>([]);
  const [busca, setBusca] = useState(defaultBusca || "");
  const [loading, setLoading] = useState(false);
  const [quantityById, setQuantityById] = useState<Record<number, string>>({});
  useEffect(() => {
    if (!show) return;
    let active = true;
    setLoading(true);
    fetch(`/api/stock?busca=${encodeURIComponent(busca)}`)
      .then(res => res.ok ? res.json() : [])
      .then(data => {
        if (!active) return;
        setArtigos(Array.isArray(data) ? data : []);
      })
      .finally(() => {
        if (active) setLoading(false);
      });
    return () => {
      active = false;
    };
  }, [show, busca]);
  if (!show) return <button className="bg-green-600 text-white px-3 py-1 rounded" type="button" onClick={() => setShow(true)}>{buttonLabel || "+ Associar artigo do stock"}</button>;
  return (
    <div className="flex flex-col items-stretch gap-2">
      <div className="flex items-center gap-2">
        <input className="input input-bordered flex-1" placeholder="Buscar por nome, referência ou cód. fabricante (ex: OTS65, A8, GIST WHITE)" value={busca} onChange={e => setBusca(e.target.value)} />
        <span className="text-[11px] text-gray-500 whitespace-nowrap">{artigos.length} resultado(s)</span>
      </div>
      <div className="max-h-72 overflow-y-auto w-full rounded border border-gray-200">
        {loading ? (
          <div className="p-3 text-sm text-gray-500">A procurar no stock...</div>
        ) : artigos.length === 0 ? (
          <div className="p-3 text-sm text-gray-500">Sem artigos encontrados.</div>
        ) : (
          <ul>
            {artigos.map((a) => {
              const requestedQuantityRaw = quantityById[a.id] ?? String(initialQuantity || 1);
              const requestedQuantity = Math.max(1, Number.parseInt(requestedQuantityRaw, 10) || 1);
              const stockQuantity = typeof a.quantidade === 'number' ? a.quantidade : null;
              const stockValidity = normalizeMonthYearValue(String(a.validade || ''));
              const stockLote = String(a.lote || '').trim();
              const stockInsuficiente = stockQuantity !== null && requestedQuantity > stockQuantity;
              const stockVazio = stockQuantity !== null && stockQuantity <= 0;
              const isValveSelection = isValveLikeSelection({
                artigo: a,
                buscaAtual: busca,
                buscaInicial: defaultBusca,
              });
              const blockByStockLimit = !isValveSelection && (stockVazio || stockInsuficiente);

              return (
                <li key={a.id} className="border-b border-gray-100 p-2 last:border-b-0">
                  <div className="flex items-start justify-between gap-3">
                    <div className="min-w-0 flex-1 text-xs text-gray-700">
                      <div className="font-semibold text-gray-900">{a.referencia} — {a.descricao}</div>
                      <div className="mt-1 flex flex-wrap gap-x-3 gap-y-1">
                        {a.codigoFabricante ? <span>Cód. fab.: <b>{a.codigoFabricante}</b></span> : null}
                        <span>Stock: <b className={stockVazio ? 'text-red-600' : stockInsuficiente ? 'text-amber-600' : 'text-emerald-700'}>{formatStockQuantity(stockQuantity)}</b></span>
                        {stockValidity ? <span>Val.: <b>{formatMonthYear(stockValidity)}</b></span> : null}
                        {stockLote ? <span>Lote: <b>{stockLote}</b></span> : null}
                      </div>
                    </div>
                    <div className="flex shrink-0 items-center gap-2">
                      <input
                        type="number"
                        min="1"
                        className="w-16 rounded border border-gray-300 px-2 py-1 text-sm"
                        value={requestedQuantityRaw}
                        onChange={(e) => setQuantityById((prev) => ({ ...prev, [a.id]: e.target.value }))}
                        aria-label={`Quantidade para ${a.descricao}`}
                      />
                      <button
                        className="ml-2 rounded bg-blue-600 px-2 py-1 text-white disabled:cursor-not-allowed disabled:opacity-50"
                        type="button"
                        disabled={blockByStockLimit}
                        onClick={() => {
                          onSelect({
                            name: a.descricao,
                            descricao: a.descricao,
                            referencia: a.referencia,
                            codigoFabricante: a.codigoFabricante || "",
                            quantidade: String(requestedQuantity),
                            validade: a.validade || "",
                            stockQuantidade: a.quantidade ?? null,
                            quantidadeMinima: a.quantidadeMinima ?? null,
                            lote: a.lote ?? null,
                            stockValidade: a.validade ?? null,
                          });
                          setShow(false);
                        }}
                      >
                        Associar
                      </button>
                    </div>
                  </div>
                  {stockInsuficiente ? (
                    <div className={`mt-1 text-[11px] ${isValveSelection ? 'text-blue-600' : 'text-amber-600'}`}>
                      {isValveSelection
                        ? 'Item de válvula: permitido associar mesmo acima do stock para não bloquear a manutenção.'
                        : 'Quantidade pedida superior ao stock disponível.'}
                    </div>
                  ) : null}
                  {stockVazio ? (
                    <div className={`mt-1 text-[11px] ${isValveSelection ? 'text-blue-600' : 'text-red-600'}`}>
                      {isValveSelection
                        ? 'Item de válvula: permitido associar mesmo sem stock para concluir a intervenção.'
                        : 'Artigo sem stock disponível para substituição.'}
                    </div>
                  ) : null}
                </li>
              );
            })}
          </ul>
        )}
      </div>
      <button className="mt-2 px-2 py-1 bg-gray-300 rounded" type="button" onClick={() => setShow(false)}>Cancelar</button>
    </div>
  );
}
