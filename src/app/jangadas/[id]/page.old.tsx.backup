                    </div>
                  ) : (
                    <div className="mb-3 text-sm text-gray-500">Nenhum artigo de stock selecionado.</div>
                  )}
                  {edit ? (
                    <div className="flex flex-wrap gap-2">
                      <ArtigoSelector onSelect={aplicarTuboSuperiorDoStock} buttonLabel="+ Selecionar tubo câmara superior" />
                    </div>
                  ) : null}
                  {renderTechnicalStockQuickSelector('Tubos / adaptadores técnicos', technicalTubeItems, aplicarTuboSuperiorDoStock, adicionarAcessorioSuperior)}
                </div>

                <div className="rounded-lg border border-gray-200 bg-gray-50 p-3">
                  <p className="text-xs uppercase tracking-wide text-gray-500 mb-2">Tubo/Hose Câmara Inferior via stock</p>
                  {tuboInferiorStock ? (
                    <div className="mb-3 text-sm text-gray-800">
                      Selecionado: <span className="font-semibold">{tuboInferiorStock.referencia}</span> — {tuboInferiorStock.descricao}
                    </div>
                  ) : (form.cylinderTuboCamaraInferiorRef || raft?.cylinderTuboCamaraInferiorRef) ? (
                    <div className="mb-3 text-sm text-gray-800">
