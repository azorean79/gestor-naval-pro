const ALL_PACK_TYPE_OPTIONS = getRecognizedPackTypeOptions(Object.keys(PACK_TEMPLATES));

function dedupeOptions(values: Array<string | null | undefined>) {
  return Array.from(new Set(values.map((value) => String(value || '').trim()).filter(Boolean)));
}

function isDeprecatedPainterLengthOption(value?: string | null) {
  const normalized = String(value || '').replace(/\s+/g, '').toLowerCase();
  return normalized === '28metros';
}

function normalizePainterLengthDisplay(value?: string | null) {
  const raw = String(value || '').trim();
  if (!raw) return '';
  if (isDeprecatedPainterLengthOption(raw)) return '28 m';

  const numericMatch = raw.match(/^(\d{1,3})\s*(m|metro|metros)?$/i);
  if (numericMatch) return `${numericMatch[1]} m`;

  return raw;
}

function splitReferenceCandidates(value?: string | null) {
  const raw = String(value || '').trim();
  if (!raw) return [] as string[];
  return dedupeOptions(
    raw
      .split(/[\/|,;]+/)
      .map((entry) => entry.trim())
      .filter(Boolean)
  );
}

function normalizeLaunchTypeValue(value?: string | null) {
  const normalized = normalizeText(String(value || ''));
  if (!normalized) return '';
  if (normalized.includes('davit') || normalized === 'dl') return 'DL';
  if (normalized.includes('throw') || normalized.includes('over') || normalized === 'to') return 'TO';
  return String(value || '').trim().toUpperCase();
}

function extractLaunchTypeOptions(configuration: string[] | undefined) {
  const mapped = (configuration || [])
    .map((entry) => normalizeLaunchTypeValue(entry))
    .filter(Boolean);
  return dedupeOptions(mapped);
}

function extractSlashSeparatedOptions(value?: string | null) {
  const raw = String(value || '').trim();
  if (!raw) return [];
  if (!raw.includes('/')) return [raw];
  return dedupeOptions(raw.split('/').map((part) => part.trim()));
}

function normalizeTechnicalPack(value?: string | null) {
  const raw = String(value || '').trim().toUpperCase();
  if (!raw) return '';

  const compact = raw.replace(/\s+/g, ' ').trim();

  if (compact === 'INTERNACIONAL' || compact === 'INTERNATIONAL') return 'INTERNACIONAL';
  if (compact.includes('CRUISER STANDARD') || (compact.includes('STANDARD') && compact.includes('STD') && compact.includes('/ R'))) return 'CRUISER STANDARD';
  if (compact.includes('ST-GREEK') || compact.includes('STANDARD GREEK')) return 'ST-GREEK';
  if (
    compact.includes('ST-INTL') ||
    compact.includes('ST INTL') ||
    compact.includes('STD INT') ||
    compact.includes('STANDARD INTERNATIONAL') ||
    compact.includes('STANDARD INT') ||
    compact.includes('ST-USA') ||
    compact.includes('ST USA')
  ) return 'ST-INTL';
  if (compact === 'D' || compact === 'E' || compact === 'R' || compact === 'STD') return compact;
  if (/\bPACK\s*D\b/.test(compact)) return 'D';
  if (/\bPACK\s*E\b/.test(compact)) return 'E';
  if (/\bPACK\s*R\b/.test(compact)) return 'R';
  if (/\bPACK\s*STD\b/.test(compact)) return 'STD';

  return normalizarPackType(compact) || compact;
}

function matchesTechnicalPack(entryPack?: string | null, selectedPack?: string | null) {
  const entry = normalizeTechnicalPack(entryPack);
  const selected = normalizeTechnicalPack(selectedPack);
  if (!entry || !selected) return false;
  if (entry === selected) return true;
  const entryAliases = TECHNICAL_PACK_ALIASES[entry] || [entry];
  const selectedAliases = TECHNICAL_PACK_ALIASES[selected] || [selected];
  return entryAliases.some((alias) => selectedAliases.includes(alias));
}

function matchesTechnicalSpecPack(specPack?: string | null, selectedPack?: string | null) {
  if (!specPack) return true;
  return matchesTechnicalPack(specPack, selectedPack);
}

