function normalizeStockSelectorText(value?: string | null) {
  return String(value || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();
}

function buildStockSelectorLabel(item: { referencia?: string | null; descricao?: string | null; codigoFabricante?: string | null }) {
  const referencia = String(item?.referencia || "").trim();
  const descricao = String(item?.descricao || "").trim();
  const codigoFabricante = String(item?.codigoFabricante || "").trim();
  return `${referencia || "—"}${descricao ? ` — ${descricao}` : ""}${codigoFabricante ? ` (${codigoFabricante})` : ""}`;
}

