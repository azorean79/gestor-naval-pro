  function getMkivCylinderSpec(capacity: number | string | undefined): MkivCylinderEntry | null {
    const cap = Number(capacity);
    if (!cap || isNaN(cap)) return null;
    return SURVITEC_MKIV_CYLINDER_SPECS_TPED.find((e) => e.capacidade === cap) ?? null;
  }

  function isSurvitecMkiv(brand?: string, model?: string): boolean {
    const b = (brand ?? "").toLowerCase();
    const m = (model ?? "").toLowerCase();
    return (
      b.includes("survit") ||
      b.includes("marine mk") ||
      b.includes("mkiv") ||
      m.includes("mkiv") ||
      m.includes("mk iv") ||
      m.includes("mk4") ||
      m.includes("lr07") ||
      (b.includes("dsb") && m.includes("lr"))
    );
  }

