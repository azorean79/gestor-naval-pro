  ];

  function normalizeContainerModel(value?: string | null): string {
    return String(value ?? "").toUpperCase().replace(/\s+/g, "").trim();
  }

  function isEurovinilRaft(brand?: string, model?: string): boolean {
    const b = (brand ?? "").toLowerCase();
    const m = (model ?? "").toLowerCase();
    return b.includes("eurovinil") || m.includes("syntesy") || m.includes("eurovinil");
  }

  function getPackBucket(packType?: string | null): ContainerPackBucket | null {
    const normalized = packType ? normalizarPackType(packType) : null;
    if (normalized === "SOLAS A") return "A";
    if (normalized === "SOLAS B") return "B";
    return null;
  }

  function getContainerCapacityKey(containerModel?: string | null, capacity?: string | number | null): string {
    const container = normalizeContainerModel(containerModel);
    const cap = Number(capacity ?? 0);
    if (!cap) return "";
    if (container === "MK20" && (cap === 20 || cap === 25)) return `${cap}DL`;
    return String(cap);
  }

  // Utilitário para notificação de browser
function isWithinReminderWindow(date = new Date()) {
  const day = date.getDay();
  if (day === 0 || day === 6) return false;

  const minutes = date.getHours() * 60 + date.getMinutes();
  return minutes >= 9 * 60 && minutes <= 17 * 60 + 30;
}

function notifyIfDeliveryTomorrow(expectedDeliveryDate?: string, serial?: string) {
  if (!expectedDeliveryDate) return;
  if (typeof window === 'undefined' || !('Notification' in window)) return;
  const now = new Date();
  if (!isWithinReminderWindow(now)) return;
  const delivery = new Date(expectedDeliveryDate);
  // Notifica se hoje é o dia anterior à entrega
  const diffDays = Math.floor((delivery.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays === 1) {
    Notification.requestPermission().then(permission => {
      if (permission === 'granted') {
        new Notification('Entrega prevista para amanhã', {
          body: `A jangada ${serial || ''} tem entrega prevista para ${delivery.toLocaleDateString('pt-PT')}`
        });
      }
    });
  }
}

