function matchesAnyToken(value: string, tokens: string[]) {
  const normalized = normalizeText(value);
  return tokens.some((token) => normalized.includes(normalizeText(token)));
}

function findValidityByTokens(rows: Array<{ item?: string; validade?: string }> | undefined, tokens: string[]) {
  const match = (rows || []).find((row) => matchesAnyToken(String(row?.item || ""), tokens));
  return match?.validade;
}

function findArticleByTokens(rows: ArtigoJangada[] | undefined, tokens: string[]) {
  return (rows || []).find((row) => matchesAnyToken(String(row?.name || ""), tokens));
}

function buildCertificateChecklistSnapshot(args: {
  raft: FormState | null;
  form: FormState;
  latestInspection: Inspecao | null;
  latestInspectionArticles: ArtigoJangada[];
  activeCertificate: CertificadoExtraido | undefined;
  mandatoryPackItems?: MandatoryPackItem[] | null;
}) {
  const { raft, form, latestInspection, latestInspectionArticles, activeCertificate } = args;
  const validities = Array.isArray(activeCertificate?.validities) ? activeCertificate?.validities : [];
  const artigosFicha = normalizeArtigos(form.artigos);
  const allArticles = [...latestInspectionArticles, ...artigosFicha];
  const mandatoryPackItems = Array.isArray(args.mandatoryPackItems)
    ? args.mandatoryPackItems
    : getMandatoryPackItemsForRaft({
        brand: String(form.brand || raft?.brand || '').trim(),
        model: String(form.model || raft?.model || '').trim(),
        packType: String(form.packType || raft?.packType || '').trim(),
        capacity: Number(form.capacity || raft?.capacity || 0) || undefined,
      });
  const mandatoryPackByChecklistName = new Map(mandatoryPackItems.map((item) => [item.checklistName, item]));

  const getArticle = (tokens: string[]) => findArticleByTokens(allArticles, tokens);
  const getValidity = (tokens: string[]) => findValidityByTokens(validities, tokens) || getArticle(tokens)?.validade;
  const getMandatoryPackState = (checklistName: string, tokens: string[], fallbackReference?: string) => {
    const packItem = mandatoryPackByChecklistName.get(checklistName);
    const matchedArticle = packItem
      ? findMatchingArticleForPackItem(packItem, allArticles)
      : getArticle(tokens);
    const validityTokens = packItem
      ? Array.from(new Set([packItem.label, packItem.englishLabel, packItem.technicalName, ...(packItem.articleTokens || [])].filter(Boolean)))
      : tokens;
    const matchedValidity = (packItem ? findValidityByTokens(validities, validityTokens) : getValidity(tokens)) || matchedArticle?.validade || "";

    return {
      packItem,
      matchedArticle,
      checked: packItem ? Boolean(matchedArticle || matchedValidity) : Boolean(matchedArticle || matchedValidity),
      reference: matchedArticle?.referencia || packItem?.reference || fallbackReference || "",
      validity: matchedValidity,
    };
  };

  const mandatoryPackHasItem = (checklistName: string) => mandatoryPackByChecklistName.has(checklistName);

  const luzExterior = getArticle(["luz exterior", "top light", "luz de localização"]);
  const luzInterior = getArticle(["luz interior", "inside light", "bateria"]);
  const lanterna = getArticle(["waterproof torch", "lanterna impermeavel", "lanterna impermeável", "lanterna estanque"]);
  const pilhasLanterna = getArticle(["pilhas para lanterna", "torch batteries"]);
  const faca = getArticle(["faca", "safety knife", "faca flutuante"]);
  const aguaState = getMandatoryPackState("saco_agua", ["água", "agua", "water sachets", "water"], DRINKING_WATER_STOCK_REFERENCE);
  const racoesState = getMandatoryPackState("racoes_alimentares", ["rações", "racoes", "food rations", "ration"], FOOD_RATIONS_STOCK_REFERENCE);
  const farmaciaState = getMandatoryPackState("ambulancia", ["farmácia", "farmacia", "first aid", "primeiros socorros"], getCanonicalFallbackReferenceForArticleName("first aid kit", {
    brand: String(form.brand || raft?.brand || ""),
    packType: String(form.packType || raft?.packType || ""),
  }) || "06484009");
  const comprimidosState = getMandatoryPackState("comprimidos_enjoo", ["comprimidos", "enjoo", "seasickness tablets", "tablet"], getCanonicalFallbackReferenceForArticleName("seasickness tablets") || "30202051");
  const paraquedasState = getMandatoryPackState("foguetoes_paraquedas", ["paraquedas", "parachute rockets", "foguete"], "20500023");
  const fachosState = getMandatoryPackState("fachos_mao", ["fachos", "facho", "handflares", "fogo de mão", "fogo de mao"], "20500035");
  const fumoState = getMandatoryPackState("potes_fumo", ["fumo", "fumígeno", "fumigeno", "smoke signals"], "20500002");
  const qtyFarmacia = mandatoryPackHasItem("ambulancia")
    ? Math.max(1, Number(farmaciaState.packItem?.quantity || 1))
    : 0;
  const qtyComprimidos = mandatoryPackHasItem("comprimidos_enjoo")
    ? parseArticleQuantity(comprimidosState.matchedArticle?.quantidade, Math.max(1, Number(comprimidosState.packItem?.quantity || 1)))
    : 0;
  const qtyParaquedas = mandatoryPackHasItem("foguetoes_paraquedas")
    ? parseArticleQuantity(paraquedasState.matchedArticle?.quantidade, Math.max(1, Number(paraquedasState.packItem?.quantity || 1)))
    : 0;
  const qtyFachos = mandatoryPackHasItem("fachos_mao")
    ? parseArticleQuantity(fachosState.matchedArticle?.quantidade, Math.max(1, Number(fachosState.packItem?.quantity || 1)))
    : 0;
  const qtyFumo = mandatoryPackHasItem("potes_fumo")
    ? parseArticleQuantity(fumoState.matchedArticle?.quantidade, Math.max(1, Number(fumoState.packItem?.quantity || 1)))
    : 0;
  const qtyPilhasLanterna = parseArticleQuantity(pilhasLanterna?.quantidade, 4);
  const isSosLike = normalizeText(`${form.model || raft?.model || ''} ${form.packType || raft?.packType || ''}`).includes('sos');
  const wpDerived = buildWpDerivedValues({
    pressureUnit: form.testeWPUnidadePressao || raft?.testeWPUnidadePressao,
    launchType: form.launchType || raft?.launchType,
    startTime: form.testeWPHoraInicio || raft?.testeWPHoraInicio,
    tempInitial: form.testeWPTemperaturaInicial || raft?.testeWPTemperaturaInicial,
    tempFinal: form.testeWPTemperaturaFinal || raft?.testeWPTemperaturaFinal,
    baroInitial: form.testeWPPressaoAtmosfericaInicial || raft?.testeWPPressaoAtmosfericaInicial,
    baroFinal: form.testeWPPressaoAtmosfericaFinal || raft?.testeWPPressaoAtmosfericaFinal,
    upperStart: form.testeWPCamaraSuperiorInicio || raft?.testeWPCamaraSuperiorInicio,
    upperEnd: form.testeWPCamaraSuperiorFim || raft?.testeWPCamaraSuperiorFim,
    lowerStart: form.testeWPCamaraInferiorInicio || raft?.testeWPCamaraInferiorInicio,
    lowerEnd: form.testeWPCamaraInferiorFim || raft?.testeWPCamaraInferiorFim,
  });

  return {
    luz_exterior_bateria: Boolean(luzExterior || getValidity(["luz exterior", "top light", "battery"])),
    ref_luz_exterior: luzExterior?.referencia || getCanonicalFallbackReferenceForArticleName("top light and battery") || "12870009",
    validade_luzes_exteriores: getValidity(["luz exterior", "top light", "battery"]) || "",
    tubo_identificacao: Boolean(form.tuboIdentificacao || raft?.tuboIdentificacao),
    tuboIdentificacao: String(form.tuboIdentificacao || raft?.tuboIdentificacao || ""),
    cilindro_co2: String(form.cylinderSerial || raft?.cylinderSerial || ""),
    ref_cilindro_co2: String(form.cylinderSerial || raft?.cylinderSerial || ""),
    luz_interior_bateria: Boolean(luzInterior || getValidity(["luz interior", "inside light", "battery"])),
    ref_bateria: luzInterior?.referencia || getCanonicalFallbackReferenceForArticleName("inside light and battery") || "12869009",
    validade_bateria: getValidity(["luz interior", "inside light", "battery"]) || "",
    lanterna: !isSosLike,
    pilhas_lanterna: !isSosLike,
    validade_pilhas_lanterna: isSosLike ? "" : (getValidity(["pilhas para lanterna", "torch batteries"]) || pilhasLanterna?.validade || ""),
    faca_seguranca: Boolean(faca),
    saco_agua: mandatoryPackHasItem("saco_agua") ? aguaState.checked : Boolean(aguaState.matchedArticle || aguaState.validity),
    ref_agua: aguaState.reference || DRINKING_WATER_STOCK_REFERENCE,
    validade_agua: mandatoryPackHasItem("saco_agua") ? aguaState.validity : (aguaState.validity || ""),
    racoes_alimentares: mandatoryPackHasItem("racoes_alimentares") ? racoesState.checked : Boolean(racoesState.matchedArticle || racoesState.validity),
    ref_racoes: racoesState.reference || FOOD_RATIONS_STOCK_REFERENCE,
    validade_racoes: mandatoryPackHasItem("racoes_alimentares") ? racoesState.validity : (racoesState.validity || ""),
    ambulancia: mandatoryPackHasItem("ambulancia") ? farmaciaState.checked : false,
    ref_farmacia: mandatoryPackHasItem("ambulancia") ? farmaciaState.reference : "",
    qtd_farmacia: qtyFarmacia,
    validade_farmacia: mandatoryPackHasItem("ambulancia") ? farmaciaState.validity : "",
    comprimidos_enjoo: mandatoryPackHasItem("comprimidos_enjoo") ? comprimidosState.checked : false,
    ref_comprimidos: mandatoryPackHasItem("comprimidos_enjoo") ? comprimidosState.reference : "",
    qtd_comprimidos: qtyComprimidos,
    validade_comprimidos: mandatoryPackHasItem("comprimidos_enjoo") ? comprimidosState.validity : "",
    foguetoes_paraquedas: mandatoryPackHasItem("foguetoes_paraquedas") ? paraquedasState.checked : false,
    ref_paraquedas: mandatoryPackHasItem("foguetoes_paraquedas") ? paraquedasState.reference : "",
    qtd_paraquedas: qtyParaquedas,
    validade_paraquedas: mandatoryPackHasItem("foguetoes_paraquedas") ? paraquedasState.validity : "",
    fachos_mao: mandatoryPackHasItem("fachos_mao") ? fachosState.checked : false,
    ref_fachos: mandatoryPackHasItem("fachos_mao") ? fachosState.reference : "",
    qtd_fachos: qtyFachos,
    validade_fachos_mao: mandatoryPackHasItem("fachos_mao") ? fachosState.validity : "",
    potes_fumo: mandatoryPackHasItem("potes_fumo") ? fumoState.checked : false,
    ref_potes: mandatoryPackHasItem("potes_fumo") ? fumoState.reference : "",
    qtd_potes: qtyFumo,
    validade_potes_fumo: mandatoryPackHasItem("potes_fumo") ? fumoState.validity : "",
    qtd_pilhas_lanterna: qtyPilhasLanterna,
    p1_corrigida_inferior: wpDerived.lower.correctedEndDisplay || "—",
    p1_corrigida_superior: wpDerived.upper.correctedEndDisplay || "—",
    queda_real_inferior: wpDerived.lower.dropDisplay || "—",
    queda_real_superior: wpDerived.upper.dropDisplay || "—",
    queda_percentual_inferior: wpDerived.lower.dropPercentDisplay || "—",
    queda_percentual_superior: wpDerived.upper.dropPercentDisplay || "—",
    aprovacao_wp: wpDerived.upper.passes !== false && wpDerived.lower.passes !== false && (wpDerived.upper.passes !== null || wpDerived.lower.passes !== null) ? "YES" : "NO",
  } satisfies CertificateChecklistSnapshot;
}

function normalizeText(value: string) {
  return (value || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();
}

function isTorchBatteriesArticleName(value?: string | null) {
  const normalized = normalizeText(String(value || ''));
  if (!normalized) return false;
  return normalized.includes('torch batter') || normalized.includes('pilhas para lanterna') || normalized.includes('pilhas lanterna');
}

function isWaterproofTorchArticleName(value?: string | null) {
  const normalized = normalizeText(String(value || ''));
  if (!normalized) return false;
  if ((normalized === 'lanterna' || normalized.includes('lanterna')) && !normalized.includes('pilha')) return true;
  return (
    normalized.includes('waterproof torch') ||
    normalized.includes('lanterna impermeavel') ||
    normalized.includes('lanterna impermeável') ||
    normalized.includes('lanterna estanque')
  );
}

function resolveMkivReliefValveVariant(value?: string | null) {
  const normalized = normalizeText(String(value || ''));
  if (!normalized) return null;

  const a10Tokens = ['a10', '08223009', 'r08223009', 'val-leaf-a10', 'osl0160', 'a10 prv'];
  const b10Tokens = ['b10', '08554009', 'val-leaf-b10', 'osl0165', 'b10 prv'];

  if (b10Tokens.some((token) => normalized.includes(normalizeText(token)))) return 'b10' as const;
  if (a10Tokens.some((token) => normalized.includes(normalizeText(token)))) return 'a10' as const;
  return null;
}

function normalizeRaftBrandName(value?: string | null) {
  return String(value || "")
    .trim()
    .replace(/\s+/g, " ")
    .toUpperCase();
}

function isExpired(dateText?: string) {
  if (!dateText) return false;
  const parsed = parseFlexibleDate(dateText);
  if (!parsed) return false;
  return parsed.getTime() < Date.now();
}

function formatDatePt(value?: string) {
  return formatDateDisplay(value);
}

function formatFileSize(value?: number) {
  if (!Number.isFinite(value || 0) || !value) return "—";
  const units = ["B", "KB", "MB", "GB"];
  let size = Number(value);
  let unitIndex = 0;
  while (size >= 1024 && unitIndex < units.length - 1) {
    size /= 1024;
    unitIndex += 1;
  }
  return `${size >= 10 || unitIndex === 0 ? Math.round(size) : size.toFixed(1)} ${units[unitIndex]}`;
}

function buildSafeDate(year: number, month: number, day: number) {
  if (!Number.isInteger(year) || !Number.isInteger(month) || !Number.isInteger(day)) return null;
  if (month < 1 || month > 12 || day < 1 || day > 31) return null;

  const date = new Date(year, month - 1, day);
  if (
    Number.isNaN(date.getTime()) ||
    date.getFullYear() !== year ||
    date.getMonth() !== month - 1 ||
    date.getDate() !== day
  ) {
    return null;
  }

  return date;
}

function parseFlexibleDate(value?: string | null) {
  const raw = String(value || '').trim();
  if (!raw) return null;

  const isoLikeMatch = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})(?:[T\s].*)?$/);
  if (isoLikeMatch) {
    const year = Number(isoLikeMatch[1]);
    const second = Number(isoLikeMatch[2]);
    const third = Number(isoLikeMatch[3]);
    return buildSafeDate(year, second, third) || (second > 12 ? buildSafeDate(year, third, second) : null);
  }

  const dmyMatch = raw.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})(?:[T\s].*)?$/);
  if (dmyMatch) {
    const day = Number(dmyMatch[1]);
    const month = Number(dmyMatch[2]);
    const year = Number(dmyMatch[3]);
    return buildSafeDate(year, month, day);
  }

  const parsed = new Date(raw);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
}

function toLocalIsoDate(value?: string | null) {
  const parsed = parseFlexibleDate(value);
  if (!parsed) return '';
  return `${parsed.getFullYear()}-${String(parsed.getMonth() + 1).padStart(2, '0')}-${String(parsed.getDate()).padStart(2, '0')}`;
}

function getComparableDateValue(value?: string | null) {
  const parsed = parseFlexibleDate(value);
  return parsed ? parsed.getTime() : Number.NEGATIVE_INFINITY;
}

function sortInspectionsByMostRecent<T extends { dataInspecao?: string | null; dataProxInspecao?: string | null; id?: string | number }>(items: T[]) {
  return [...items].sort((a, b) => {
    const byInspectionDate = getComparableDateValue(b.dataInspecao) - getComparableDateValue(a.dataInspecao);
    if (byInspectionDate !== 0) return byInspectionDate;

    const byNextInspectionDate = getComparableDateValue(b.dataProxInspecao) - getComparableDateValue(a.dataProxInspecao);
    if (byNextInspectionDate !== 0) return byNextInspectionDate;

    return String(b.id || '').localeCompare(String(a.id || ''));
  });
}

function clamp(value: number, min: number, max: number) {
  return Math.min(max, Math.max(min, value));
}

function getPremiumHealthTone(score: number) {
  if (score >= 85) {
    return {
      ring: 'stroke-emerald-500',
      text: 'text-emerald-700',
      badge: 'border-emerald-200 bg-emerald-100 text-emerald-800',
      label: 'Robusta',
    };
  }

  if (score >= 65) {
    return {
      ring: 'stroke-amber-500',
      text: 'text-amber-700',
      badge: 'border-amber-200 bg-amber-100 text-amber-800',
      label: 'Sob atenção',
    };
  }

  return {
    ring: 'stroke-rose-500',
    text: 'text-rose-700',
    badge: 'border-rose-200 bg-rose-100 text-rose-800',
    label: 'Crítica',
  };
}

function getPremiumCardTone(kind: 'critical' | 'attention' | 'documents' | 'coverage') {
  switch (kind) {
    case 'critical':
      return 'border-rose-200 bg-rose-50 text-rose-900';
    case 'attention':
      return 'border-amber-200 bg-amber-50 text-amber-900';
    case 'documents':
      return 'border-violet-200 bg-violet-50 text-violet-900';
    case 'coverage':
    default:
      return 'border-sky-200 bg-sky-50 text-sky-900';
  }
}

function getPremiumCategoryScoreTone(score: number) {
  if (score >= 85) return 'border-emerald-200 bg-emerald-50 text-emerald-900';
  if (score >= 65) return 'border-amber-200 bg-amber-50 text-amber-900';
  return 'border-rose-200 bg-rose-50 text-rose-900';
}

function daysUntil(value?: string | null) {
  if (!value) return null;
  const target = parseFlexibleDate(value);
  if (!target) return null;
  const now = new Date();
  const startNow = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const startTarget = new Date(target.getFullYear(), target.getMonth(), target.getDate());
  return Math.round((startTarget.getTime() - startNow.getTime()) / (1000 * 60 * 60 * 24));
}

function normalizeIsoDate(value?: string | null) {
  return toLocalIsoDate(value);
}

function monthYearToDeadlineIso(value?: string | null) {
  const normalized = normalizeMonthYearValue(value || '');
  if (!normalized) return '';
  const [year, month] = normalized.split('-').map(Number);
  if (!year || !month) return '';
  const lastDay = new Date(year, month, 0);
  return lastDay.toISOString().slice(0, 10);
}

function normalizeDeadlineDate(value?: string | null) {
  return normalizeIsoDate(value) || monthYearToDeadlineIso(value) || '';
}

function getDeadlineTone(days: number | null) {
  if (days === null) {
    return {
      badge: 'Sem data',
      className: 'border-slate-200 bg-slate-50 text-slate-700',
    };
  }

  if (days < 0) {
    return {
      badge: `Atrasado ${Math.abs(days)}d`,
      className: 'border-rose-200 bg-rose-50 text-rose-700',
    };
  }

  if (days <= 30) {
    return {
      badge: `${days}d`,
      className: 'border-amber-200 bg-amber-50 text-amber-700',
    };
  }

  return {
    badge: `${days}d`,
    className: 'border-emerald-200 bg-emerald-50 text-emerald-700',
  };
}

const SERVICE_STATION_STATUS_OPTIONS: Array<{ value: ServiceStationStatus; label: string; help: string }> = [
  { value: 'aguardar', label: 'A aguardar receção', help: 'Ainda não entrou formalmente no fluxo ativo da estação.' },
  { value: 'agendada', label: 'Inspeção agendada', help: 'Reservada na agenda e à espera da entrada para oficina.' },
  { value: 'progresso', label: 'Em inspeção', help: 'A jangada está em trabalho técnico na estação.' },
  { value: 'a_secar', label: 'Em secagem / estabilização', help: 'Subestado operacional dentro do trabalho técnico antes do fecho.' },
  { value: 'finalizada', label: 'Finalizada', help: 'Inspeção concluída e pronta para transitar para logística/entrega.' },
];

const DELIVERY_METHOD_LABELS: Record<DeliveryMethod, string> = {
  cliente: 'Entregar ao cliente',
  transitario: 'Entregar ao transitário',
  navio: 'Entregar no navio',
};

function getServiceStationStatusMeta(status?: string | null) {
  switch (String(status || '').trim().toLowerCase()) {
    case 'agendada':
      return {
        label: 'Inspeção agendada',
        className: 'border-blue-200 bg-blue-50 text-blue-800',
        description: 'Em sintonia com a agenda e ainda sem entrada plena em oficina.',
      };
    case 'progresso':
      return {
        label: 'Em inspeção',
        className: 'border-amber-200 bg-amber-50 text-amber-800',
        description: 'Trabalho técnico ativo na estação de serviço.',
      };
    case 'a_secar':
      return {
        label: 'Em secagem / estabilização',
        className: 'border-cyan-200 bg-cyan-50 text-cyan-800',
        description: 'Subestado técnico ainda tratado como trabalho em curso.',
      };
    case 'finalizada':
      return {
        label: 'Finalizada',
        className: 'border-emerald-200 bg-emerald-50 text-emerald-800',
        description: 'Fechada tecnicamente e pronta para a logística assumir.',
      };
    case 'aguardar':
    default:
      return {
        label: 'A aguardar receção',
        className: 'border-slate-200 bg-slate-50 text-slate-700',
        description: 'À espera de entrada operacional na estação.',
      };
  }
}

function getSmartUrgencyWeight(level: SmartUrgencyLevel) {
  switch (level) {
    case 'critical':
      return 4;
    case 'high':
      return 3;
    case 'medium':
      return 2;
    case 'low':
    default:
      return 1;
  }
}

function compareSmartFocusSignals(a: SmartFocusSignal, b: SmartFocusSignal) {
  const severityDelta = getSmartUrgencyWeight(b.severity) - getSmartUrgencyWeight(a.severity);
  if (severityDelta !== 0) return severityDelta;
  return b.score - a.score;
}

function getSmartFocusBadge(level: SmartUrgencyLevel) {
  switch (level) {
    case 'critical':
      return 'Crítico';
    case 'high':
      return 'Alto';
    case 'medium':
      return 'Médio';
    case 'low':
    default:
      return 'Baixo';
  }
}

function getSmartFocusTone(level: SmartUrgencyLevel) {
  switch (level) {
    case 'critical':
      return 'border-rose-200 bg-rose-50 text-rose-900';
    case 'high':
      return 'border-orange-200 bg-orange-50 text-orange-900';
    case 'medium':
      return 'border-amber-200 bg-amber-50 text-amber-900';
    case 'low':
    default:
      return 'border-sky-200 bg-sky-50 text-sky-900';
  }
}

function addYearsToDateInput(value?: string | null, years = 1) {
  const normalized = normalizeIsoDate(value);
  if (!normalized) return '';
  const date = new Date(normalized);
  if (Number.isNaN(date.getTime())) return '';
  date.setFullYear(date.getFullYear() + years);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

function getInspectionCycleYears(brand?: string | null) {
  return getRaftInspectionCycleYearsByBrand(brand);
}

function getInspectionCycleLabel(brand?: string | null) {
  return getRaftInspectionCycleLabelByBrand(brand);
}

function getRecommendedNextInspectionDate(baseDate?: string | null, brand?: string | null) {
  return addYearsToDateInput(baseDate, getInspectionCycleYears(brand));
}

function shouldAutoUpdateNextInspection(currentValue?: string | null, previousRecommendedValue?: string | null) {
  const current = normalizeIsoDate(currentValue);
  const previousRecommended = normalizeIsoDate(previousRecommendedValue);
  return !current || (!!previousRecommended && current === previousRecommended);
}

function isVacuumBagTargetBrand(value?: string | null) {
  const normalized = normalizeText(String(value || ''));
  if (!normalized) return false;

  return [
    'sea-safe',
    'seasafe',
    'ocean safety',
    'seasava plus',
    'eurovinil',
    'plastimo',
  ].some((token) => normalized.includes(normalizeText(token)));
}

function isSeasavaPlusLikeModel(value?: string | null) {
  return normalizeText(String(value || '')).includes('seasava plus');
}

function isWorkshopToolItem(name?: string | null, notes?: string | null) {
  const haystack = normalizeText(`${String(name || '')} ${String(notes || '')}`);
  if (!haystack) return false;

  return [
    ' loading machine',
    'machine ',
    ' tool',
    'tool ',
    'plug tool',
  ].some((token) => haystack.includes(normalizeText(token)));
}

function normalizeMonthYearValue(value?: string) {
  const shared = normalizeMonthYearValueShared(value);
  if (shared) return shared;
  const raw = String(value || '').trim();
  if (!raw) return '';
  const compactDigitsMatch = raw.match(/^(\d{2})(\d{4})$/);
  if (compactDigitsMatch) {
    const month = Number(compactDigitsMatch[1]);
    if (Number.isInteger(month) && month >= 1 && month <= 12) {
      return `${compactDigitsMatch[2]}-${String(month).padStart(2, "0")}`;
    }
  }
  return '';
}

function maskMonthYearInput(value?: string) {
  const raw = String(value || "");
  const digits = raw.replace(/\D/g, "").slice(0, 6);
  if (!digits) return "";
  if (digits.length <= 2) return digits;
  return `${digits.slice(0, 2)}/${digits.slice(2)}`;
}

function isInvalidMonthYearDraft(value?: string) {
  const raw = String(value || "").trim();
  if (!raw) return false;
  const masked = maskMonthYearInput(raw);
  if (!/^\d{2}\/\d{4}$/.test(masked)) return false;
  return !normalizeMonthYearValue(masked);
}

function formatMonthYear(value?: string) {
  return formatMonthYearDisplay(value);
}

function parseArticleQuantity(value: unknown, fallback = 1) {
  const raw = String(value ?? '').trim().replace(',', '.');
  const parsed = Number(raw);
  if (!Number.isFinite(parsed) || parsed <= 0) return fallback;
  return Math.max(1, Math.round(parsed));
}

function buildExplicitReplacementChecklistKey(articleName: string) {
  const normalizedName = normalizeText(String(articleName || ""));
  if (!normalizedName) return "";
  const safeName = normalizedName.replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");
  if (!safeName) return "";
  return `${EXPLICIT_REPLACEMENT_PREFIX}${safeName}`;
}

function parseExplicitReplacementQuantity(value: unknown) {
  if (typeof value === "boolean") return value ? 1 : 0;
  if (typeof value === "number") {
    if (!Number.isFinite(value) || value <= 0) return 0;
    return Math.max(1, Math.round(value));
  }
  if (typeof value === "string") {
    const raw = value.trim().replace(',', '.');
    if (!raw) return 0;
    const normalized = raw.toUpperCase();
    if (["SIM", "YES", "TRUE"].includes(normalized)) return 1;
    const parsed = Number(raw);
    if (!Number.isFinite(parsed) || parsed <= 0) return 0;
    return Math.max(1, Math.round(parsed));
  }
  return 0;
}

function aggregateInspectionSummaryRows(rows: InspectionSummaryRow[]) {
  const aggregated = new Map<string, InspectionSummaryRow & {
    referencias: Set<string>;
    codigos: Set<string>;
    origens: Set<string>;
    notesSet: Set<string>;
  }>();

  rows.forEach((row) => {
    const name = String(row.name || '').trim();
    const referencia = String(row.referencia || '').trim();
    const quantidade = Math.max(1, Number(row.quantidade || 1));
    if (!name && !referencia) return;

    const key = [normalizeText(name), normalizeText(referencia), normalizeText(row.origem || '')]
      .filter(Boolean)
      .join('::');

    const existing = aggregated.get(key);
    if (existing) {
      existing.quantidade += quantidade;
      if (!existing.validade && row.validade) existing.validade = row.validade;
      if (referencia) existing.referencias.add(referencia);
      if (row.codigoFabricante) existing.codigos.add(String(row.codigoFabricante).trim());
      if (row.origem) existing.origens.add(String(row.origem).trim());
      if (row.notes) existing.notesSet.add(String(row.notes).trim());
      return;
    }

    aggregated.set(key, {
      ...row,
      name: name || referencia,
      quantidade,
      referencias: new Set(referencia ? [referencia] : []),
      codigos: new Set(row.codigoFabricante ? [String(row.codigoFabricante).trim()] : []),
      origens: new Set(row.origem ? [String(row.origem).trim()] : []),
      notesSet: new Set(row.notes ? [String(row.notes).trim()] : []),
    });
  });

  return Array.from(aggregated.values())
    .map(({ referencias, codigos, origens, notesSet, ...row }) => ({
      ...row,
      referencia: Array.from(referencias).join(' · '),
      codigoFabricante: Array.from(codigos).join(' · '),
      origem: Array.from(origens).join(' · '),
      notes: Array.from(notesSet).join(' · '),
    }))
    .sort((a, b) => a.name.localeCompare(b.name, 'pt-PT', { sensitivity: 'base' }));
}

function monthYearDraftFromValue(value?: string) {
  if (!value) return "";
  const normalized = normalizeMonthYearValue(value);
  if (normalized) {
    const [year, month] = normalized.split("-");
    return `${month}/${year}`;
  }
  return maskMonthYearInput(value);
}

function currentMonthYearValue() {
  const now = new Date();
  return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
}

function formatReferenceDisplay(value?: string | number | null) {
  const normalized = String(value ?? "").trim();
  return normalized || "—";
}

function formatStockQuantity(value?: number | null) {
  if (value == null || Number.isNaN(Number(value))) return "—";
  return String(value);
}

function formatCurrencyEur(value?: number | null) {
  const numeric = Number(value);
  if (!Number.isFinite(numeric)) return '—';
  return new Intl.NumberFormat('pt-PT', { style: 'currency', currency: 'EUR' }).format(numeric);
}

function normalizeCapacityValue(value: unknown): number | null {
  const numeric = Number(value);
  if (!Number.isFinite(numeric) || numeric <= 0) return null;
  return Math.trunc(numeric);
}

function formatCapacityValue(value: unknown): string {
  const normalized = normalizeCapacityValue(value);
  return normalized === null ? "—" : String(normalized);
}

function getCanonicalFallbackReferenceForArticleName(
  nomeArtigo?: string,
  context?: { brand?: string; packType?: string }
) {
  const target = normalizeText(nomeArtigo || "");
  const brand = normalizeText(context?.brand || "");
  const packType = normalizeText(context?.packType || "");
  const isIsoLikeMedical =
    brand.includes("sea safe") ||
    brand.includes("plastimo") ||
    brand.includes("eurovinil") ||
    brand.includes("surviva") ||
    brand.includes("rfd") ||
    brand.includes("dsb") ||
    packType.includes("coastal") ||
    packType.includes("offshore") ||
    packType.includes("iso");

  if (
    target.includes("first aid") ||
    target === "farmacia" ||
    target === "farmácia" ||
    target.includes("primeiros socorros")
  ) {
    if (target.includes("solas")) return "12865009";
    if (target.includes("ext")) return "12874009";
    return isIsoLikeMedical ? "06484009" : "12865009";
  }

  if (
    target.includes("seasickness bags") ||
    target.includes("sea sick bags") ||
    target.includes("sacos para enjoo") ||
    target.includes("sacos de enjoo") ||
    target.includes("saco de enjoo")
  ) {
    return undefined;
  }

  if (
    target.includes("seasickness") ||
    target.includes("enjoo") ||
    target.includes("comprimido") ||
    target.includes("tablet")
  ) {
    return "30202051";
  }

  if (
    target.includes("top light") ||
    target.includes("luz exterior") ||
    target.includes("external lamp")
  ) {
    return normalizeStockReferenceByRule("", "external lamp unit rl5", nomeArtigo || "");
  }

  if (
    target.includes("inside light") ||
    target.includes("luz interior") ||
    target.includes("internal lamp") ||
    target.includes("battery") ||
    target.includes("bateria")
  ) {
    return normalizeStockReferenceByRule("", "internal lamp unit rl5", nomeArtigo || "");
  }

  if (
    target.includes("food rations") ||
    target === "rations" ||
    target === "racao" ||
    target === "ração" ||
    target.includes("racoes") ||
    target.includes("rações")
  ) {
    return FOOD_RATIONS_STOCK_REFERENCE;
  }

  if (
    target === "water" ||
    target === "drinking water" ||
    target === "aguas" ||
    target === "águas" ||
    target.includes("agua") ||
    target.includes("água")
  ) {
    return DRINKING_WATER_STOCK_REFERENCE;
  }

  return undefined;
}

function getFixedReferenceForArticleName(nomeArtigo?: string) {
  const canonical = getCanonicalFallbackReferenceForArticleName(nomeArtigo);
  if (canonical) return canonical;

  const target = normalizeText(nomeArtigo || "");
  if (
    target.includes("seasickness bags") ||
    target.includes("sea sick bags") ||
    target.includes("sacos para enjoo") ||
    target.includes("sacos de enjoo") ||
    target.includes("saco de enjoo")
  ) {
    return undefined;
  }

  if (
    target.includes("parachute rockets") ||
    target === "paraquedas" ||
    target.includes("foguete paraquedas")
  ) {
    return "20500023";
  }
  if (
    target.includes("handflares") ||
    target.includes("red hand flares") ||
    target === "fachos de mao" ||
    target === "fachos de mão" ||
    target.includes("facho de mao") ||
    target.includes("facho de mão")
  ) {
    return "20500035";
  }
  if (
    target.includes("smoke signals") ||
    target === "potes" ||
    target.includes("pote de fumo") ||
    target.includes("potes de fumo") ||
    target.includes("floating smoke")
  ) {
    return "20500002";
  }
  if (
    target.includes("first aid kit") ||
    target === "farmacia" ||
    target === "farmácia" ||
    target.includes("primeiros socorros")
  ) {
    return "30202050";
  }
  if (
    target.includes("seasickness tablets") ||
    target.includes("comprimido") ||
    target.includes("enjoo") ||
    (target.includes("seasickness") && target.includes("tablet"))
  ) {
    return "30202051";
  }
  if (
    target.includes("food rations") ||
    target === "rations" ||
    target === "racao" ||
    target === "ração" ||
    target.includes("racoes") ||
    target.includes("rações")
  ) {
    return FOOD_RATIONS_STOCK_REFERENCE;
  }
  if (
    target === "water" ||
    target === "drinking water" ||
    target === "aguas" ||
    target === "águas" ||
    target.includes("agua") ||
    target.includes("água") ||
    target.includes("drinking water") ||
    target.includes("water sachets")
  ) {
    return DRINKING_WATER_STOCK_REFERENCE;
  }
  return undefined;
}

type ArticleLinkCandidate = {
  stockRefs: string[];
  legacyRefs: string[];
  aliases: string[];
};

function getArticleLinkCandidate(
  nomeArtigo?: string,
  context?: { brand?: string; packType?: string }
): ArticleLinkCandidate {
  const target = normalizeText(nomeArtigo || "");
  const brand = normalizeText(context?.brand || "");
  const packType = normalizeText(context?.packType || "");

  const isIsoLikeBrand =
    brand.includes("sea safe") ||
    brand.includes("plastimo") ||
    brand.includes("eurovinil") ||
    brand.includes("surviva") ||
    brand.includes("rfd") ||
    brand.includes("dsb");
  const prefersIsoMedical = isIsoLikeBrand || packType.includes("coastal") || packType.includes("offshore") || packType.includes("iso");

  if (
    target.includes("seasickness bags") ||
    target.includes("sea sick bags") ||
    target.includes("sacos para enjoo") ||
    target.includes("sacos de enjoo") ||
    target.includes("saco de enjoo")
  ) {
    return {
      stockRefs: [],
      legacyRefs: [],
      aliases: ["sacos para enjoo", "sacos de enjoo", "saco de enjoo", "seasickness bags"],
    };
  }

  if (target.includes("parachute") || target.includes("paraquedas") || target.includes("foguete")) {
    return {
      stockRefs: ["PYR-ROCKET-RED"],
      legacyRefs: ["20500023"],
      aliases: ["paraquedas", "foguete paraquedas", "parachute rockets", "foguete parachute"],
    };
  }

  if (target.includes("handflare") || target.includes("hand flare") || target.includes("facho") || target.includes("mao") || target.includes("mão") || target.includes("red hand flare")) {
    return {
      stockRefs: ["PYR-FLARE-RED"],
      legacyRefs: ["20500035"],
      aliases: ["fachos de mao", "fachos de mão", "facho de mao", "facho de mão", "handflares", "red hand flares"],
    };
  }

  if (target.includes("smoke") || target.includes("fumo") || target.includes("potes") || target.includes("floating smoke")) {
    return {
      stockRefs: ["20500002", "PYR-SMOKE-ORANGE"],
      legacyRefs: [],
      aliases: ["potes", "potes de fumo", "pote de fumo", "smoke signals", "floating smoke signals"],
    };
  }

  if (target.includes("first aid") || target.includes("farmacia") || target.includes("farmácia") || target.includes("primeiros socorros")) {
    return {
      stockRefs: prefersIsoMedical ? ["06484009", "12865009", "12874009", "MED-KIT-ISO", "MED-KIT-SOLAS"] : ["12865009", "06484009", "12874009", "MED-KIT-SOLAS", "MED-KIT-ISO"],
      legacyRefs: ["30202050", "15199001", "DSB00940220", "05886009", "11801009", "11802009", "11803009", "11804009", "Z63703", "06556009", "12162009"],
      aliases: ["farmacia", "farmácia", "first aid kit", "primeiros socorros"],
    };
  }

  if (target.includes("seasickness") || target.includes("enjoo") || target.includes("comprimido") || target.includes("tablet")) {
    return {
      stockRefs: ["30202051", "TAB-SICKNESS"],
      legacyRefs: ["01174009", "DSB00940350", "Z64514", "Z7406"],
      aliases: ["comprimidos", "comprimido", "pastilhas enjoo", "seasickness tablets"],
    };
  }

  if (target.includes("food") || target.includes("racao") || target.includes("ração") || target.includes("ration")) {
    return {
      stockRefs: [FOOD_RATIONS_STOCK_REFERENCE],
      legacyRefs: [...FOOD_RATIONS_REFERENCE_CANDIDATES.filter((ref) => ref !== FOOD_RATIONS_STOCK_REFERENCE)],
      aliases: ["ração", "racao", "food rations", "rations"],
    };
  }

  if (target === "water" || target.includes("agua") || target.includes("água") || target.includes("drinking water")) {
    return {
      stockRefs: [DRINKING_WATER_STOCK_REFERENCE],
      legacyRefs: [...DRINKING_WATER_REFERENCE_CANDIDATES.filter((ref) => ref !== DRINKING_WATER_STOCK_REFERENCE)],
      aliases: ["agua", "água", "drinking water", "water sachets"],
    };
  }

  if (target.includes("thermal protective") || target.includes("manta termica") || target.includes("manta térmica")) {
    return {
      stockRefs: ["THER-BLANKET-TPA", "THERM-BLANKET"],
      legacyRefs: [],
      aliases: ["thermal protective aid", "manta térmica", "manta termica", "tpa"],
    };
  }

  if (target.includes("fishing")) {
    return {
      stockRefs: ["FISH-KIT"],
      legacyRefs: [],
      aliases: ["fishing kit", "kit de pesca"],
    };
  }

  if (target.includes("mirror") || target.includes("heliograph") || target.includes("heliografo") || target.includes("heliógrafo")) {
    return {
      stockRefs: ["HELIOGRAPH"],
      legacyRefs: [],
      aliases: ["signal mirror", "heliograph", "heliógrafo", "espelho de sinalização"],
    };
  }

  if ((target.includes("torch") && !isTorchBatteriesArticleName(target)) || ((target === 'lanterna' || target.includes("lanterna")) && !target.includes('pilha'))) {
    return {
      stockRefs: ["TORCH-WATERPROOF"],
      legacyRefs: [],
      aliases: ["waterproof torch", "lanterna impermeável", "lanterna impermeavel", "lanterna"],
    };
  }

  if (target.includes("whistle") || target.includes("apito")) {
    return {
      stockRefs: ["WHISTLE-SOLAS"],
      legacyRefs: [],
      aliases: ["whistle", "apito"],
    };
  }

  if (target.includes("repair kit") || target.includes("reparacao") || target.includes("reparação")) {
    return {
      stockRefs: ["REPAIR-KIT-PLUGS", "GLUE-NEOPRENE"],
      legacyRefs: [],
      aliases: ["repair kit", "kit de reparação", "kit de reparacao"],
    };
  }

  if (target.includes("drogue") || target.includes("sea anchor") || target.includes("ancora flutuante") || target.includes("âncora flutuante")) {
    return {
      stockRefs: ["DROGUE-ANCHOR"],
      legacyRefs: [],
      aliases: ["drogue", "sea anchor", "âncora flutuante", "ancora flutuante"],
    };
  }

  if (target.includes("knife") || target.includes("faca")) {
    return {
      stockRefs: ["KNIFE-FLOATING"],
      legacyRefs: [],
      aliases: ["knife", "faca flutuante", "faca"],
    };
  }

  if (target.includes("survival instructions") || target.includes("manual de sobrevivencia") || target.includes("manual de sobrevivência")) {
    return {
      stockRefs: ["MANUAL-SURVIVAL", "CARD-SALVAGE-SIGNALS"],
      legacyRefs: [],
      aliases: ["survival instructions", "manual de sobrevivência", "manual de sobrevivencia", "sinais de salvamento"],
    };
  }

  if (target.includes("sea sick bags") || target.includes("vomito") || target.includes("vómito")) {
    return {
      stockRefs: ["BAG-SICKNESS"],
      legacyRefs: [],
      aliases: ["sea sick bags", "saco de vómito", "saco de vomito"],
    };
  }

  if (target.includes("inside light") || target.includes("top light")) {
    return {
      stockRefs: ["12869009", "12870009", "12866009", "12868009", "LGT-MASTER1", "LGT-RL6-KIT", "LGT-RL5-INT", "LGT-RL5-EXT"],
      legacyRefs: ["30202206", "30203190", "08279009", "08402009", "11848009", "08280009", "08403009", "11847009"],
      aliases: ["inside light and battery", "top light and battery", "luz interna", "luz exterior", "top light"],
    };
  }

  return { stockRefs: [], legacyRefs: [], aliases: [target] };
}

function isExpiredMonthYear(value?: string, referenceDate?: string | Date) {
  const normalized = normalizeMonthYearValue(value);
  if (!normalized) return false;
  const [year, month] = normalized.split("-").map(Number);
  const expiry = new Date(year, month, 0, 23, 59, 59, 999);
  const base = referenceDate ? new Date(referenceDate) : new Date();
  if (Number.isNaN(base.getTime())) return expiry.getTime() < Date.now();
  return expiry.getTime() < base.getTime();
}

function expiresWithinMonths(value?: string, months = 12, referenceDate?: string | Date) {
  const normalized = normalizeMonthYearValue(value);
  if (!normalized) return false;
  const [year, month] = normalized.split("-").map(Number);
  const expiry = new Date(year, month, 0, 23, 59, 59, 999);
  const now = referenceDate ? new Date(referenceDate) : new Date();
  if (Number.isNaN(now.getTime())) return false;
  const threshold = new Date(now.getFullYear(), now.getMonth() + months, now.getDate(), 23, 59, 59, 999);
  return expiry.getTime() >= now.getTime() && expiry.getTime() <= threshold.getTime();
}

function addFiveYears(value?: string) {
  if (!value) return "";
  const date = parseFlexibleDate(value);
  if (!date) return "";
  date.setFullYear(date.getFullYear() + 5);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

function parseDecimalValue(value: unknown) {
  const raw = String(value ?? "").trim().replace(',', '.');
  if (!raw) return null;
  const parsed = Number(raw);
  return Number.isFinite(parsed) ? parsed : null;
}

function normalizePressureUnit(value: unknown) {
  const raw = String(value ?? '').trim().toLowerCase();
  if (raw === 'inhg') return 'inhg' as const;
  if (raw === 'mbar' || raw === 'mb') return 'mbar' as const;
  return 'inh2o' as const;
}

function convertPressureToMbar(value: unknown, unit: ReturnType<typeof normalizePressureUnit>) {
  const parsed = parseDecimalValue(value);
  if (parsed === null) return null;
  if (unit === 'mbar') return parsed;
  if (unit === 'inhg') return parsed * 33.8638866667;
  return parsed * 2.490889;
}

function convertMbarToUnit(value: number | null, unit: ReturnType<typeof normalizePressureUnit>) {
  if (value === null || !Number.isFinite(value)) return null;
  if (unit === 'mbar') return value;
  if (unit === 'inhg') return value / 33.8638866667;
  return value / 2.490889;
}

function formatDecimal(value: number | null, digits = 2) {
  if (value === null || !Number.isFinite(value)) return '';
  return value.toFixed(digits).replace(/\.0+$/, '').replace(/(\.\d*?)0+$/, '$1');
}

const MKIV_THROWOVER_RESEAT_THRESHOLD_MBAR = 193.1;

function addMinutesToClock(value: unknown, minutesToAdd: number) {
  const raw = String(value ?? '').trim();
  const match = raw.match(/^(\d{1,2}):(\d{2})$/);
  if (!match) return '';
  const hours = Number(match[1]);
  const minutes = Number(match[2]);
  if (!Number.isFinite(hours) || !Number.isFinite(minutes) || hours < 0 || hours > 23 || minutes < 0 || minutes > 59) {
    return '';
  }
  const total = ((hours * 60 + minutes + minutesToAdd) % (24 * 60) + 24 * 60) % (24 * 60);
  return `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
}

function buildWpDerivedValues(source: {
  pressureUnit?: unknown;
  launchType?: unknown;
  startTime?: unknown;
  tempInitial?: unknown;
  tempFinal?: unknown;
  baroInitial?: unknown;
  baroFinal?: unknown;
  upperStart?: unknown;
  upperEnd?: unknown;
  lowerStart?: unknown;
  lowerEnd?: unknown;
}) {
  const unit = normalizePressureUnit(source.pressureUnit);
  const tempInitial = parseDecimalValue(source.tempInitial);
  const tempFinal = parseDecimalValue(source.tempFinal);
  const baroInitial = parseDecimalValue(source.baroInitial);
  const baroFinal = parseDecimalValue(source.baroFinal);
  const tempDelta = tempInitial !== null && tempFinal !== null ? tempFinal - tempInitial : null;
  const baroDelta = baroInitial !== null && baroFinal !== null ? baroFinal - baroInitial : null;
  const correctionTempMb = tempDelta !== null ? -(tempDelta * 4) : null;
  const correctionBaroMb = baroDelta !== null ? baroDelta : null;
  const totalCorrectionMb = correctionTempMb !== null && correctionBaroMb !== null
    ? correctionTempMb + correctionBaroMb
    : correctionTempMb ?? correctionBaroMb;
  const temperatureWithinManual = tempDelta === null ? null : Math.abs(tempDelta) <= 3.5;
  const endTime = addMinutesToClock(source.startTime, 60);

  const analyzeChamber = (startRaw: unknown, endRaw: unknown) => {
    const startMb = convertPressureToMbar(startRaw, unit);
    const endMb = convertPressureToMbar(endRaw, unit);
    const correctedEndMb = endMb !== null && totalCorrectionMb !== null ? endMb + totalCorrectionMb : endMb;
    const dropMbRaw = startMb !== null && correctedEndMb !== null ? startMb - correctedEndMb : null;
    const dropMb = dropMbRaw !== null ? Math.max(0, dropMbRaw) : null;
    const dropPercent = startMb !== null && startMb > 0 && dropMb !== null ? (dropMb / startMb) * 100 : null;
    const passes = dropPercent === null
      ? null
      : dropPercent <= 5 && temperatureWithinManual !== false;

    return {
      correctedEndMb,
      dropMb,
      dropPercent,
      passes,
      correctedEndDisplay: formatDecimal(convertMbarToUnit(correctedEndMb, unit)),
      dropDisplay: formatDecimal(convertMbarToUnit(dropMb, unit)),
      dropPercentDisplay: dropPercent === null ? '' : formatDecimal(dropPercent, 2),
    };
  };

  return {
    unit,
    endTime,
    tempDelta,
    correctionTempMb,
    correctionBaroMb,
    temperatureWithinManual,
    upper: analyzeChamber(source.upperStart, source.upperEnd),
    lower: analyzeChamber(source.lowerStart, source.lowerEnd),
  };
}

function extractYear(value?: string): number | null {
  if (!value) return null;
  const parsed = parseFlexibleDate(value);
  if (!parsed) return null;
  return parsed.getFullYear();
}

function parseStockSelectionList(value: unknown): StockSelectionItem[] {
  if (!value) return [];
  if (Array.isArray(value)) return value as StockSelectionItem[];
  const text = String(value).trim();
  if (!text) return [];
  try {
    const parsed = JSON.parse(text);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

function normalizeArtigos(value: unknown): ArtigoJangada[] {
  if (Array.isArray(value)) return value as ArtigoJangada[];
  if (value && typeof value === "object") {
    const maybeNested = (value as { artigos?: unknown }).artigos;
    if (Array.isArray(maybeNested)) return maybeNested as ArtigoJangada[];
    const objectValues = Object.values(value).filter((item) => item && typeof item === "object" && !Array.isArray(item));
    if (objectValues.length > 0) return objectValues as ArtigoJangada[];
  }
  return [];
}

function normalizeServiceBulletinsApplied(value: unknown): ServiceBulletinsAppliedState {
  if (!value) return {};

  let parsed: unknown = value;
  if (typeof value === "string") {
    const raw = value.trim();
    if (!raw) return {};
    try {
      parsed = JSON.parse(raw);
    } catch {
      return {};
    }
  }

  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return {};

  return Object.entries(parsed as Record<string, unknown>).reduce<ServiceBulletinsAppliedState>((acc, [key, entryValue]) => {
    if (!key) return acc;
    acc[key] = entryValue === true || entryValue === "true" || entryValue === 1 || entryValue === "1";
    return acc;
  }, {});
}

function normalizeInspectionChecklistValues(value: unknown): InspectionChecklistValues {
  if (!value) return {};

  let parsed: unknown = value;
  if (typeof value === "string") {
    const raw = value.trim();
    if (!raw) return {};
    try {
      parsed = JSON.parse(raw);
    } catch {
      return {};
    }
  }

  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return {};

  return Object.entries(parsed as Record<string, unknown>).reduce<InspectionChecklistValues>((acc, [key, entryValue]) => {
    if (!key) return acc;
    if (typeof entryValue === "string" || typeof entryValue === "number" || typeof entryValue === "boolean") {
      acc[key] = entryValue;
    }
    return acc;
  }, {});
}

function normalizeRaftResponse<T extends FormState | null | undefined>(value: T): T {
  if (!value || typeof value !== "object") return value;

  const normalizedStatus = String((value as FormState).serviceStationStatus || "").trim().toLowerCase();
  const serviceStationStatus = (["aguardar", "agendada", "progresso", "a_secar", "finalizada"] as const).includes(normalizedStatus as ServiceStationStatus)
    ? (normalizedStatus as ServiceStationStatus)
    : null;
  const normalizedDeliveryMethod = String((value as FormState).deliveryMethod || "").trim().toLowerCase();
  const deliveryMethod = (["cliente", "transitario", "navio"] as const).includes(normalizedDeliveryMethod as DeliveryMethod)
    ? (normalizedDeliveryMethod as DeliveryMethod)
    : null;

  return {
    ...value,
    brand: normalizeRaftBrandName((value as FormState).brand),
    delivered: Boolean((value as FormState).delivered || (value as FormState).deliveredAt),
    serviceStationStatus,
    deliveryMethod,
    readyForDelivery: Boolean((value as FormState).readyForDelivery),
    artigos: normalizeArtigos((value as FormState).artigos),
    serviceBulletinsApplied: normalizeServiceBulletinsApplied((value as FormState).serviceBulletinsApplied),
    inspectionChecklistValues: normalizeInspectionChecklistValues((value as FormState).inspectionChecklistValues),
  } as T;
}

function hasMeaningfulRaftData(value: FormState | null | undefined) {
  if (!value || typeof value !== "object") return false;

  return [
    value.serial,
    value.brand,
    value.model,
    value.owner,
    value.ownerDisplay,
    value.shipNameManual,
    value.numeroObra,
  ].some((field) => String(field || "").trim().length > 0);
}

function matchesPathPrefix(pathname: string, prefix: string) {
  if (prefix === "/") return pathname === "/";
  return pathname === prefix || pathname.startsWith(`${prefix}/`);
}

export default function JangadaPage() {
  const [isClient, setIsClient] = useState(false);
  const { data: session } = useSession();
  const router = useRouter();
  const params = useParams();
  const searchParams = useSearchParams();
  // All hooks must be called unconditionally
  const rawId = params && typeof params === "object" ? (params as Record<string, string | string[]>).id : undefined;
  const id = Array.isArray(rawId) ? rawId[0] : rawId;
  const [raft, setRaft] = useState<FormState | null>(null);
  const [loading, setLoading] = useState(true);
  const [loadError, setLoadError] = useState<string | null>(null);
  const [edit, setEdit] = useState(false);
  const [saving, setSaving] = useState(false);
  const [form, setForm] = useState<FormState>({});
  const [activeSection, setActiveSection] = useState<SectionKey>("geral");
  const [expandedPrimarySections, setExpandedPrimarySections] = useState<Record<PrimaryAccordionSectionKey, boolean>>({
    geral: true,
    pack: true,
  });
  const [showExecutiveOverview, setShowExecutiveOverview] = useState(true);
  const [showWorkshopRail, setShowWorkshopRail] = useState(false);
  const [workspaceMode, setWorkspaceMode] = useState<'executive' | 'workshop' | 'inspection'>('executive');
  const [dossierFocus, setDossierFocus] = useState<'overview' | 'timeline' | 'documents' | 'observacoes' | 'deadlines' | 'all'>('overview');
  const [inspecoes, setInspecoes] = useState<Inspecao[]>([]);
  const [historicalInspectionDraft, setHistoricalInspectionDraft] = useState<HistoricalInspectionDraft | null>(null);
  const [historicalInspectionSaveState, setHistoricalInspectionSaveState] = useState<"idle" | "saving" | "error">("idle");
  const [exporting, setExporting] = useState<string | null>(null);
  const [stockThumbByReferencia, setStockThumbByReferencia] = useState<Record<string, string>>({});
  const [stockMapByNome, setStockMapByNome] = useState<Record<string, StockLookupItem>>({});
  const [stockMapByReferencia, setStockMapByReferencia] = useState<Record<string, StockLookupItem>>({});
  const [stockMapByCodigoFabricante, setStockMapByCodigoFabricante] = useState<Record<string, StockLookupItem>>({});
  const [raftBrandModelRows, setRaftBrandModelRows] = useState<Array<{ brand: string; model: string; packType?: string }>>([]);
  const [availablePackTypeOptions, setAvailablePackTypeOptions] = useState<string[]>([]);
  const [resolvedMandatoryPackItems, setResolvedMandatoryPackItems] = useState<MandatoryPackItem[] | null>(null);
  const [naviosLookup, setNaviosLookup] = useState<NavioLookup[]>([]);
  const [autosaveState, setAutosaveState] = useState<"idle" | "saving" | "saved" | "error">("idle");
  const [showCertificatePreview, setShowCertificatePreview] = useState(false);
  const [certificatePreviewHtml, setCertificatePreviewHtml] = useState<string | null>(null);
  const [certificatePreviewName, setCertificatePreviewName] = useState("certificado_jangada.xlsx");
  const [certificatePreviewKind, setCertificatePreviewKind] = useState<"orey" | "survitec-modern">("orey");
  const [certificatePayload, setCertificatePayload] = useState<Record<string, unknown> | null>(null);
  const [generatingCertificate, setGeneratingCertificate] = useState(false);
  const [validadeDraftByKey, setValidadeDraftByKey] = useState<Record<string, string>>({});
  const [inspectionMode, setInspectionMode] = useState(false);
  const [inspectionWizardStep, setInspectionWizardStep] = useState(0);
  const [packPriorityFilter, setPackPriorityFilter] = useState<"all" | "critical" | "attention" | "missing" | "done">("all");
  const [contentorPriorityFilter, setContentorPriorityFilter] = useState<"all" | "critical" | "attention" | "ready" | "done">("all");
  const [pausedInspectionDraftInfo, setPausedInspectionDraftInfo] = useState<null | { savedAt: number; inspectionWizardStep: number }>(null);
  const [evidencias, setEvidencias] = useState<EvidenciaItem[]>([]);
  const [loadingEvidencias, setLoadingEvidencias] = useState(false);
  const [uploadingEvidencias, setUploadingEvidencias] = useState(false);
  const [deletingEvidenceName, setDeletingEvidenceName] = useState<string | null>(null);
  const [packRowFocusKey, setPackRowFocusKey] = useState<string | null>(null);
  const [replacementPicker, setReplacementPicker] = useState<null | {
    key: string;
    articleName: string;
    defaultBusca?: string;
    technical?: boolean;
  }>(null);
  const [activeChecklistImageAid, setActiveChecklistImageAid] = useState<ChecklistImageVisualAid | null>(null);
  const [bulletinSaveState, setBulletinSaveState] = useState<"idle" | "saving" | "saved" | "error">("idle");
  const [giReplacementSaving, setGiReplacementSaving] = useState(false);
  const latestFormRef = useRef<FormState>({} as FormState);
  const lastSavedSnapshotRef = useRef<string>("");
  const packStockSyncSignatureRef = useRef<string>("");
  const formTopRef = useRef<HTMLFormElement | null>(null);
  const evidenciasInputRef = useRef<HTMLInputElement | null>(null);
  const evidenciasCameraInputRef = useRef<HTMLInputElement | null>(null);
  const sectionRefs = useRef<Partial<Record<SectionKey, HTMLDivElement | null>>>({});
  const packRowRefs = useRef<Record<string, HTMLTableRowElement | null>>({});
  const previousEditRef = useRef(false);
  const stationInspectionAutoOpenAppliedRef = useRef(false);
  const inspectionWizardAutoPositionedRef = useRef(false);
  const smartFocusAutoAppliedRef = useRef(false);
  const [editSessionLockedUntil, setEditSessionLockedUntil] = useState<number | null>(null);
  const [rememberedSmartFocus, setRememberedSmartFocus] = useState<StoredSmartFocus | null>(null);

  const userRole = session?.user?.role === "ADMIN" ? "ADMIN" : "USER";
  const smartFocusUserKey = useMemo(() => {
    return normalizeText(String(session?.user?.email || session?.user?.name || 'utilizador')) || 'utilizador';
  }, [session?.user?.email, session?.user?.name]);
  const userPermissions = session?.user?.permissions;
  const editablePages = Array.isArray(userPermissions?.editablePages) ? userPermissions.editablePages : [];
  const canEditJangadaPage = userRole === "ADMIN" || editablePages.some((prefix) => matchesPathPrefix("/jangadas", String(prefix)));
  const baseEditableFields = useMemo(() => new Set<string>([
    "brand",
    "model",
    "packType",
    "ultimoCertificadoNumero",
  ]), []);
  const editableFieldSet = useMemo(() => {
    if (userRole === "ADMIN") return new Set<string>();
    const values = userPermissions?.editableFields?.["jangadas-detail"];
    return new Set(Array.isArray(values) ? values.map((item) => String(item)) : []);
  }, [userRole, userPermissions?.editableFields]);
  const canEditField = (field: string) => {
    if (userRole === "ADMIN") return true;
    if (!canEditJangadaPage) return false;
    if (inspectionMode && (field === "dataInspecao" || field === "dataProxInspecao")) return true;
    if (baseEditableFields.has(field)) return true;
    return editableFieldSet.has(field);
  };

  const togglePrimarySection = (section: PrimaryAccordionSectionKey) => {
    setExpandedPrimarySections((prev) => ({
      ...prev,
      [section]: !prev[section],
    }));
    setActiveSection(section);
  };

  const ensurePrimarySectionOpen = (section: PrimaryAccordionSectionKey) => {
    setExpandedPrimarySections((prev) => prev[section] ? prev : { ...prev, [section]: true });
  };

  const scrollToSection = (section: SectionKey) => {
    if (section === 'geral' || section === 'pack') {
      ensurePrimarySectionOpen(section);
    }
    setActiveSection(section);
    window.requestAnimationFrame(() => {
      const node = sectionRefs.current[section];
      node?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  };

  const scrollToDossierBlock = (id: string) => {
    window.requestAnimationFrame(() => {
      document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  };

  const focusDossierBlock = (
    focus: 'overview' | 'timeline' | 'documents' | 'observacoes' | 'deadlines' | 'all',
    blockId?: string
  ) => {
    setShowExecutiveOverview(true);
    setDossierFocus(focus);
    if (!blockId) return;
    window.requestAnimationFrame(() => {
      document.getElementById(blockId)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  };

  const sortedNaviosLookup = useMemo(() => {
    return [...naviosLookup].sort((a, b) => {
      const byName = String(a.nome || '').localeCompare(String(b.nome || ''), 'pt-PT', { sensitivity: 'base' });
      if (byName !== 0) return byName;
      return String(a.matricula || '').localeCompare(String(b.matricula || ''), 'pt-PT', { sensitivity: 'base' });
    });
  }, [naviosLookup]);

  const normalizeReference = (value?: string) => normalizeText(String(value || ""));

  const buildHistoricalInspectionDraft = (inspection?: Inspecao | null): HistoricalInspectionDraft => ({
    id: inspection?.id,
    certificadoNumero: String(inspection?.certificadoNumero || "").trim(),
    dataInspecao: String(inspection?.dataInspecao || "").slice(0, 10),
    dataProxInspecao: String(inspection?.dataProxInspecao || "").slice(0, 10),
    status: String(inspection?.status || "Concluída").trim() || "Concluída",
    sourceFile: String(inspection?.sourceFile || "jangada_historico_manual").trim() || "jangada_historico_manual",
    artigos: normalizeArtigos(inspection?.artigos),
  });

  const sincronizarArtigoHistoricoComStockPorReferencia = (artigo: ArtigoJangada, referenciaInput: string): ArtigoJangada => {
    const referenciaNormalizada = normalizeReference(referenciaInput);
    const stock = referenciaNormalizada
      ? stockMapByReferencia[referenciaNormalizada]
        || stockMapByCodigoFabricante[referenciaNormalizada]
        || (referenciaNormalizada === normalizeReference('MK4-0047')
          ? stockMapByReferencia[normalizeReference('30202051')]
          : undefined)
      : undefined;

    if (!stock) {
      return {
        ...artigo,
        referencia: referenciaInput,
      };
    }

    return {
      ...artigo,
      referencia: stock.referencia,
      name: stock.descricao || artigo.name,
      codigoFabricante: stock.codigoFabricante || artigo.codigoFabricante,
    };
  };

  const abrirEditorInspecaoHistorica = (inspection?: Inspecao | null) => {
    if (!canEditJangadaPage) return;
    if (!edit) {
      startProtectedEditSession({ inspectionMode: false, section: 'historico' });
    }
    setActiveSection('historico');
    setHistoricalInspectionSaveState('idle');
    setHistoricalInspectionDraft(buildHistoricalInspectionDraft(inspection));
  };

  const atualizarCampoInspecaoHistorica = (field: keyof Omit<HistoricalInspectionDraft, 'artigos' | 'id'>, value: string) => {
    setHistoricalInspectionDraft((prev) => prev ? { ...prev, [field]: value } : prev);
  };

  const adicionarArtigoManualInspecaoHistorica = () => {
    setHistoricalInspectionDraft((prev) => {
      if (!prev) return prev;
      return {
        ...prev,
        artigos: [
          ...normalizeArtigos(prev.artigos),
          {
            name: '',
            quantidade: '1',
            validade: '',
            referencia: '',
            codigoFabricante: '',
          },
        ],
      };
    });
  };

  const adicionarArtigoStockInspecaoHistorica = (artigoSelecionado: Partial<ArtigoJangada>) => {
    setHistoricalInspectionDraft((prev) => {
      if (!prev) return prev;

      const artigos = [...normalizeArtigos(prev.artigos)];
      const refSelecionada = normalizeReference(artigoSelecionado.referencia);
      const nomeSelecionado = normalizeText(String(artigoSelecionado.name || ''));
      const idxExistente = artigos.findIndex((art) => {
        const refAtual = normalizeReference(art.referencia);
        const nomeAtual = normalizeText(String(art.name || ''));
        return (refSelecionada && refAtual === refSelecionada) || (nomeSelecionado && nomeAtual === nomeSelecionado);
      });

      const artigoNormalizado: ArtigoJangada = {
        ...(idxExistente >= 0 ? artigos[idxExistente] : ({} as ArtigoJangada)),
        ...artigoSelecionado,
        name: String(artigoSelecionado.name || 'Novo artigo'),
        quantidade: artigoSelecionado.quantidade || '1',
        validade: normalizeMonthYearValue(artigoSelecionado.validade),
      } as ArtigoJangada;

      if (idxExistente >= 0) {
        artigos[idxExistente] = artigoNormalizado;
      } else {
        artigos.push(artigoNormalizado);
      }

      return {
        ...prev,
        artigos,
      };
    });
  };

  const atualizarArtigoInspecaoHistorica = (index: number, updates: Partial<ArtigoJangada>) => {
    setHistoricalInspectionDraft((prev) => {
      if (!prev) return prev;
      const artigos = [...normalizeArtigos(prev.artigos)];
      const current = artigos[index];
      if (!current) return prev;

      const nextUpdates = updates.referencia !== undefined
        ? sincronizarArtigoHistoricoComStockPorReferencia(
            {
              ...current,
              ...updates,
            } as ArtigoJangada,
            String(updates.referencia || '')
          )
        : ({ ...current, ...updates } as ArtigoJangada);

      artigos[index] = {
        ...current,
        ...nextUpdates,
      };

      return {
        ...prev,
        artigos,
      };
    });
  };

  const removerArtigoInspecaoHistorica = (index: number) => {
    setHistoricalInspectionDraft((prev) => {
      if (!prev) return prev;
      const artigos = [...normalizeArtigos(prev.artigos)];
      if (index < 0 || index >= artigos.length) return prev;
      artigos.splice(index, 1);
      return {
        ...prev,
        artigos,
      };
    });
  };

  const guardarInspecaoHistorica = async () => {
    if (!historicalInspectionDraft) return;

    const dataInspecao = String(historicalInspectionDraft.dataInspecao || '').trim();
    if (!dataInspecao) {
      alert('Preenche a data da inspeção passada antes de guardar.');
      return;
    }

    const shipProfile = resolveSelectedShip(form) || resolveSelectedShip(raft) || raft?.shipDetails;
    const navioNome = String(shipProfile?.nome || form.shipNameManual || raft?.shipNameManual || 'Sem navio').trim() || 'Sem navio';
    const artigos = normalizeArtigos(historicalInspectionDraft.artigos)
      .filter((artigo) => String(artigo.name || '').trim())
      .map((artigo) => {
        const refNormalizada = normalizeReference(artigo.referencia);
        const stock = refNormalizada
          ? stockMapByReferencia[refNormalizada] || stockMapByCodigoFabricante[refNormalizada]
          : undefined;

        return {
          stockId: stock?.id ?? null,
          referencia: String(artigo.referencia || '').trim() || null,
          descricao: String(artigo.name || '').trim(),
          quantidade: Math.max(1, Number(artigo.quantidade || 1)),
          validade: normalizeMonthYearValue(artigo.validade) || String(artigo.validade || '').trim() || null,
          codigoFabricante: String(artigo.codigoFabricante || '').trim() || null,
        };
      });

    const payload = {
      id: historicalInspectionDraft.id,
      certificadoNumero: String(historicalInspectionDraft.certificadoNumero || '').trim() || undefined,
      navioNome,
      navioId: shipProfile?.id ? Number(shipProfile.id) : null,
      jangadaId: Number(id),
      jangadaSerial: String(form.serial || raft?.serial || '').trim() || null,
      date: dataInspecao,
      dataInspecao,
      dataProxInspecao: String(historicalInspectionDraft.dataProxInspecao || '').trim() || null,
      status: String(historicalInspectionDraft.status || 'Concluída').trim() || 'Concluída',
      sourceFile: String(historicalInspectionDraft.sourceFile || 'jangada_historico_manual').trim() || 'jangada_historico_manual',
      artigosSubstituidos: artigos,
      applyStockMovements: false,
    };

    try {
      setHistoricalInspectionSaveState('saving');
      const isEditing = Boolean(historicalInspectionDraft.id);
      const response = await fetch(isEditing ? `/api/inspecoes?id=${historicalInspectionDraft.id}` : '/api/inspecoes', {
        method: isEditing ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        const details = await response.text().catch(() => '');
        throw new Error(details || 'Não foi possível guardar a inspeção passada.');
      }

      const savedInspection = await response.json().catch(() => null);
      if (savedInspection) {
        setInspecoes((prev) => {
          const next = prev.some((item) => String(item.id) === String(savedInspection.id))
            ? prev.map((item) => String(item.id) === String(savedInspection.id) ? savedInspection : item)
            : [savedInspection, ...prev];
          return sortInspectionsByMostRecent(next);
        });
      }

      setHistoricalInspectionDraft(null);
      setHistoricalInspectionSaveState('idle');
    } catch (error) {
      console.error('Erro ao guardar inspeção histórica:', error);
      setHistoricalInspectionSaveState('error');
      alert(error instanceof Error ? error.message : 'Não foi possível guardar a inspeção passada.');
    }
  };

  const getArticleLinkCandidateForCurrentRaft = (nomeArtigo: string) => getArticleLinkCandidate(nomeArtigo, {
    brand: String(form.brand || raft?.brand || ""),
    packType: String(form.packType || raft?.packType || ""),
  });

  const getPreferredStockReferenceForArticleName = (nomeArtigo: string): string | undefined => {
    const candidate = getArticleLinkCandidateForCurrentRaft(nomeArtigo);
    return candidate.stockRefs.find((ref) => stockMapByReferencia[normalizeReference(ref)]) || undefined;
  };

  const findUniqueShipByName = (value: unknown) => {
    const normalizedName = normalizeText(String(value || '').trim());
    if (!normalizedName) return undefined;

    const matches = naviosLookup.filter((navio) => normalizeText(navio.nome) === normalizedName);
    return matches.length === 1 ? matches[0] : undefined;
  };

  const resolveSelectedShip = (source?: Partial<FormState> | null) => {
    const shipId = Number(source?.shipId || 0);
    if (Number.isFinite(shipId) && shipId > 0) {
      const shipById = naviosLookup.find((navio) => navio.id === shipId);
      if (shipById) return shipById;
    }

    return findUniqueShipByName(source?.shipNameManual);
  };

  const buildSavePayload = (source: FormState) => ({
    ...source,
    shipId: resolveSelectedShip(source)?.id ?? "",
    shipNameManual: resolveSelectedShip(source)?.nome ?? "",
    brand: normalizeRaftBrandName(source.brand),
    artigos: normalizeArtigos(source.artigos),
    serviceBulletinsApplied: normalizeServiceBulletinsApplied(source.serviceBulletinsApplied),
    inspectionChecklistValues: normalizeInspectionChecklistValues(source.inspectionChecklistValues),
  });

  const getEditSessionStorageKey = () => (id ? `jangada:${id}:edit-session-lock` : null);
  const getFilterSessionStorageKey = () => (id ? `jangada:${id}:inspection-filters` : null);
  const getPausedInspectionStorageKey = () => (id ? `jangada:${id}:paused-inspection-draft` : null);
  const getSmartFocusStorageKey = () => (id ? `jangada:${id}:smart-focus:${smartFocusUserKey}` : null);

  const persistEditSessionLock = (payload: null | { expiresAt: number; inspectionMode: boolean; section: SectionKey }) => {
    if (typeof window === 'undefined') return;
    const storageKey = getEditSessionStorageKey();
    if (!storageKey) return;

    if (!payload) {
      window.sessionStorage.removeItem(storageKey);
      return;
    }

    window.sessionStorage.setItem(storageKey, JSON.stringify(payload));
  };

  const clearEditSessionProtection = () => {
    setEditSessionLockedUntil(null);
    persistEditSessionLock(null);
  };

  const persistPausedInspectionDraft = (payload: PausedInspectionDraft | null) => {
    if (typeof window === 'undefined') return;
    const storageKey = getPausedInspectionStorageKey();
    if (!storageKey) return;

    if (!payload) {
      window.localStorage.removeItem(storageKey);
      setPausedInspectionDraftInfo(null);
      return;
    }

    window.localStorage.setItem(storageKey, JSON.stringify(payload));
    setPausedInspectionDraftInfo({
      savedAt: payload.savedAt,
      inspectionWizardStep: payload.inspectionWizardStep,
    });
  };

  const persistInspectionFilters = (payload: {
    packPriorityFilter: "all" | "critical" | "attention" | "missing" | "done";
    contentorPriorityFilter: "all" | "critical" | "attention" | "ready" | "done";
    activeSection: SectionKey;
  }) => {
    if (typeof window === 'undefined') return;
    const storageKey = getFilterSessionStorageKey();
    if (!storageKey) return;
    window.sessionStorage.setItem(storageKey, JSON.stringify(payload));
  };

  const persistRememberedSmartFocus = (payload: StoredSmartFocus | null) => {
    if (typeof window === 'undefined') return;
    const storageKey = getSmartFocusStorageKey();
    if (!storageKey) return;

    if (!payload) {
      window.localStorage.removeItem(storageKey);
      setRememberedSmartFocus(null);
      return;
    }

    window.localStorage.setItem(storageKey, JSON.stringify(payload));
    setRememberedSmartFocus(payload);
  };

  const navigateToSmartFocusTarget = (target: SmartFocusTarget) => {
    if (target.section) {
      setActiveSection(target.section);
      window.requestAnimationFrame(() => {
        sectionRefs.current[target.section!]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      return;
    }

    if (target.blockId) {
      window.requestAnimationFrame(() => {
        document.getElementById(target.blockId!)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  };

  const startProtectedEditSession = (options?: { inspectionMode?: boolean; section?: SectionKey }) => {
    const nextInspectionMode = options?.inspectionMode ?? false;
    const nextSection = options?.section ?? 'geral';
    const expiresAt = Date.now() + EDIT_SESSION_LOCK_MS;

    setInspectionMode(nextInspectionMode);
    setEditSessionLockedUntil(expiresAt);
    setEdit(true);
    setActiveSection(nextSection);
    persistEditSessionLock({
      expiresAt,
      inspectionMode: nextInspectionMode,
      section: nextSection,
    });
  };

  const snapshotOf = (source: FormState) => JSON.stringify(buildSavePayload(source));

  const scheduleAutosave = (_next: FormState) => {
    // Edição sem limite de tempo: manter apenas gravação manual explícita.
  };

  useEffect(() => {
    latestFormRef.current = form;
  }, [form]);

  useEffect(() => {
    if (typeof window === 'undefined') return;
    const storageKey = getEditSessionStorageKey();
    if (!storageKey) return;

    try {
      const raw = window.sessionStorage.getItem(storageKey);
      if (!raw) return;
      const parsed = JSON.parse(raw) as { expiresAt?: number; inspectionMode?: boolean; section?: SectionKey };
      const expiresAt = Number(parsed?.expiresAt || 0);

      if (!expiresAt || expiresAt <= Date.now()) {
        window.sessionStorage.removeItem(storageKey);
        return;
      }

      setEditSessionLockedUntil(expiresAt);
      setInspectionMode(Boolean(parsed?.inspectionMode));
      setActiveSection(parsed?.section || 'geral');
      setEdit(true);
    } catch {
      window.sessionStorage.removeItem(storageKey);
    }
  }, [id]);

  useEffect(() => {
    if (typeof window === 'undefined') return;
    const storageKey = getFilterSessionStorageKey();
    if (!storageKey) return;

    try {
      const raw = window.sessionStorage.getItem(storageKey);
      if (!raw) return;

      const editLockStorageKey = getEditSessionStorageKey();
      let hasActiveEditLock = false;

      if (editLockStorageKey) {
        try {
          const editLockRaw = window.sessionStorage.getItem(editLockStorageKey);
          if (editLockRaw) {
            const editLockParsed = JSON.parse(editLockRaw) as { expiresAt?: number };
            hasActiveEditLock = Number(editLockParsed?.expiresAt || 0) > Date.now();
          }
        } catch {
          hasActiveEditLock = false;
        }
      }

      const parsed = JSON.parse(raw) as {
        packPriorityFilter?: "all" | "critical" | "attention" | "missing" | "done";
        contentorPriorityFilter?: "all" | "critical" | "attention" | "ready" | "done";
        activeSection?: SectionKey;
      };

      if (parsed?.packPriorityFilter) {
        setPackPriorityFilter(parsed.packPriorityFilter === 'critical' ? 'attention' : parsed.packPriorityFilter);
      }

      if (parsed?.contentorPriorityFilter) {
        setContentorPriorityFilter(parsed.contentorPriorityFilter === 'critical' ? 'attention' : parsed.contentorPriorityFilter);
      }

      if (!hasActiveEditLock && parsed?.activeSection) {
        setActiveSection(parsed.activeSection);
      }
    } catch {
      window.sessionStorage.removeItem(storageKey);
    }
  }, [id]);

  useEffect(() => {
    persistInspectionFilters({
      packPriorityFilter,
      contentorPriorityFilter,
      activeSection,
    });
  }, [id, packPriorityFilter, contentorPriorityFilter, activeSection]);

  useEffect(() => {
    if (!editSessionLockedUntil) return;
    const remaining = editSessionLockedUntil - Date.now();

    if (remaining <= 0) {
      clearEditSessionProtection();
      return;
    }

    const timer = window.setTimeout(() => {
      clearEditSessionProtection();
    }, remaining);

    return () => window.clearTimeout(timer);
  }, [editSessionLockedUntil]);

  useEffect(() => {
    if (saving || edit) return;
    if (!editSessionLockedUntil || editSessionLockedUntil <= Date.now()) return;

    setEdit(true);
  }, [edit, saving, editSessionLockedUntil]);

  useEffect(() => {
    if (activeSection === 'geral' || activeSection === 'pack') {
      ensurePrimarySectionOpen(activeSection);
    }
  }, [activeSection]);

  useEffect(() => {
    if (!inspectionMode) {
      inspectionWizardAutoPositionedRef.current = false;
      setInspectionWizardStep(0);
      if (activeSection === 'checklist') {
        setActiveSection('geral');
      }
    }
  }, [inspectionMode, activeSection]);

  useEffect(() => {
    if (typeof window === 'undefined') return;
    const storageKey = getPausedInspectionStorageKey();
    if (!storageKey) return;

    try {
      const raw = window.localStorage.getItem(storageKey);
      if (!raw) {
        setPausedInspectionDraftInfo(null);
        return;
      }

      const parsed = JSON.parse(raw) as PausedInspectionDraft;
      if (!parsed || typeof parsed !== 'object' || !parsed.savedAt) {
        window.localStorage.removeItem(storageKey);
        setPausedInspectionDraftInfo(null);
        return;
      }

      setPausedInspectionDraftInfo({
        savedAt: parsed.savedAt,
        inspectionWizardStep: Number(parsed.inspectionWizardStep || 0),
      });
    } catch {
      window.localStorage.removeItem(storageKey);
      setPausedInspectionDraftInfo(null);
    }
  }, [id]);

  useEffect(() => {
    if (typeof window === 'undefined') return;
    const storageKey = getSmartFocusStorageKey();
    if (!storageKey) return;

    try {
      const raw = window.localStorage.getItem(storageKey);
      if (!raw) {
        setRememberedSmartFocus(null);
        return;
      }

      const parsed = JSON.parse(raw) as StoredSmartFocus;
      if (!parsed || typeof parsed !== 'object' || !parsed.key) {
        window.localStorage.removeItem(storageKey);
        setRememberedSmartFocus(null);
        return;
      }

      setRememberedSmartFocus(parsed);
    } catch {
      window.localStorage.removeItem(storageKey);
      setRememberedSmartFocus(null);
    }
  }, [id, smartFocusUserKey]);

  useEffect(() => {
    if (!edit) {
      previousEditRef.current = false;
      return;
    }

    const target = sectionRefs.current[activeSection] || formTopRef.current;
    previousEditRef.current = true;

    if (!target) return;

    const raf = window.requestAnimationFrame(() => {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    return () => window.cancelAnimationFrame(raf);
  }, [edit, activeSection]);

  useEffect(() => { setIsClient(true); }, []);

  useEffect(() => {
    if (!isClient) return;
    if (!id) return;
    if (loading) return;
    if (!raft) return;
    if (stationInspectionAutoOpenAppliedRef.current) return;

    const shouldStartInspection = searchParams?.get("startInspection") === "1";
    if (!shouldStartInspection) return;

    stationInspectionAutoOpenAppliedRef.current = true;
    startProtectedEditSession({ inspectionMode: true, section: "checklist" });
  }, [isClient, id, loading, raft, searchParams]);

  // Notificação para entrega prevista
  useEffect(() => {
    if (raft?.expectedDeliveryDate) {
      notifyIfDeliveryTomorrow(raft.expectedDeliveryDate, raft.serial);
    }
  }, [raft?.expectedDeliveryDate, raft?.serial]);

  useEffect(() => {
    if (!id) return;
    setLoading(true);
    setLoadError(null);

    const controller = new AbortController();

    fetch(`/api/jangadas/${id}`, { signal: controller.signal })
      .then(async (res) => {
        const payload = await res.json().catch(() => null);
        if (!res.ok) {
          throw new Error(payload?.error || payload?.message || `Erro ao carregar jangada (${res.status})`);
        }
        return payload;
      })
      .then((data) => {
        const normalized = normalizeRaftResponse(data || {});

        if (!hasMeaningfulRaftData(normalized)) {
          throw new Error("A ficha desta jangada não tem dados base disponíveis para apresentar.");
        }

        setRaft(normalized);
        if (normalized?.cylinderDataTeste && !normalized?.cylinderDataProxTeste) {
          normalized.cylinderDataProxTeste = addFiveYears(normalized.cylinderDataTeste);
        }
        setForm(normalized);
        lastSavedSnapshotRef.current = snapshotOf(normalized);
        // Only reset edit mode if not already editing
        // This prevents edit mode from closing immediately after opening
        // when raft data reloads
        // If you want to force-close edit mode on reload, add: setEdit(false);
      })
      .catch((error) => {
        if (controller.signal.aborted) return;
        setRaft(null);
        setForm({});
        setLoadError(error instanceof Error ? error.message : "Erro ao carregar jangada.");
      })
      .finally(() => {
        if (!controller.signal.aborted) setLoading(false);
      });

    return () => controller.abort();
  }, [id]);

  useEffect(() => {
    let cancelled = false;
    fetch('/api/navios')
      .then((res) => (res.ok ? res.json() : []))
      .then((rows) => {
        if (cancelled) return;
        setNaviosLookup(Array.isArray(rows) ? rows : []);
      })
      .catch(() => {
        if (!cancelled) setNaviosLookup([]);
      });
    return () => {
      cancelled = true;
    };
  }, []);

  useEffect(() => {
    let cancelled = false;

    fetch('/api/jangadas?take=5000', { cache: 'no-store' })
      .then((res) => (res.ok ? res.json() : []))
      .then((rows) => {
        if (cancelled) return;
        const normalizedRows = (Array.isArray(rows) ? rows : [])
          .map((row: any) => ({
            brand: normalizeRaftBrandName(row?.brand),
            model: String(row?.model || '').trim(),
            packType: String(row?.packType || '').trim(),
          }))
          .filter((row) => row.brand || row.model || row.packType);

        setRaftBrandModelRows(normalizedRows);
      })
      .catch(() => {
        if (!cancelled) setRaftBrandModelRows([]);
      });

    return () => {
      cancelled = true;
    };
  }, []);

  useEffect(() => {
    let cancelled = false;

    fetch('/api/jangadas/pack-types', { cache: 'no-store' })
      .then((res) => (res.ok ? res.json() : { options: [] }))
      .then((payload) => {
        if (cancelled) return;
        setAvailablePackTypeOptions(
          Array.isArray(payload?.options)
            ? payload.options.map((item: unknown) => String(item || '').trim()).filter(Boolean)
            : []
        );
      })
      .catch(() => {
        if (!cancelled) setAvailablePackTypeOptions([]);
      });

    return () => {
      cancelled = true;
    };
  }, []);

  useEffect(() => {
    const brand = String(form.brand || raft?.brand || '').trim();
    const model = String(form.model || raft?.model || '').trim();
    const packType = String(form.packType || raft?.packType || '').trim();
    const capacity = Number(form.capacity || raft?.capacity || 0) || undefined;

    if (!packType) {
      setResolvedMandatoryPackItems(null);
      return;
    }

    const raftBrand = String(raft?.brand || '').trim();
    const raftModel = String(raft?.model || '').trim();
    const raftPackType = String(raft?.packType || '').trim();
    const raftCapacity = Number(raft?.capacity || 0) || undefined;
    const matchesLoadedRaft = brand === raftBrand && model === raftModel && packType === raftPackType && capacity === raftCapacity;

    if (matchesLoadedRaft && Array.isArray(raft?.mandatoryPackItems)) {
      setResolvedMandatoryPackItems(raft.mandatoryPackItems as MandatoryPackItem[]);
      return;
    }

    let cancelled = false;
    const search = new URLSearchParams();
    if (brand) search.set('brand', brand);
    if (model) search.set('model', model);
    search.set('packType', packType);
    if (capacity) search.set('capacity', String(capacity));

    fetch(`/api/pack-types/resolve?${search.toString()}`, { cache: 'no-store' })
      .then(async (res) => {
        const payload = await res.json().catch(() => null);
        if (!res.ok) {
          throw new Error(payload?.error || 'Erro ao resolver o pack atual.');
        }
        return payload;
      })
      .then((payload) => {
        if (cancelled) return;
        setResolvedMandatoryPackItems(Array.isArray(payload?.items) ? payload.items : null);
      })
      .catch(() => {
        if (!cancelled) setResolvedMandatoryPackItems(null);
      });

    return () => {
      cancelled = true;
    };
  }, [form.brand, raft?.brand, form.model, raft?.model, form.packType, raft?.packType, form.capacity, raft?.capacity, raft?.mandatoryPackItems]);

  const fetchEvidencias = async () => {
    if (!id) return;
    setLoadingEvidencias(true);
    try {
      const response = await fetch(`/api/jangadas/${id}/evidencias`, { cache: 'no-store' });
      const payload = await response.json().catch(() => null);
      if (!response.ok) {
        throw new Error(payload?.error || payload?.message || 'Não foi possível carregar as evidências.');
      }
      setEvidencias(Array.isArray(payload?.evidencias) ? payload.evidencias : []);
    } catch (error) {
      console.error(error);
      setEvidencias([]);
    } finally {
      setLoadingEvidencias(false);
    }
  };

  useEffect(() => {
    fetchEvidencias();
  }, [id]);

  const uploadEvidencias = async (files: File[]) => {
    if (!id || files.length === 0) return;
    setUploadingEvidencias(true);
    try {
      const formData = new FormData();
      files.forEach((file) => formData.append('files', file));

      const response = await fetch(`/api/jangadas/${id}/evidencias`, {
        method: 'POST',
        body: formData,
      });

      const payload = await response.json().catch(() => null);
      if (!response.ok) {
        throw new Error(payload?.error || payload?.message || 'Não foi possível enviar as evidências.');
      }

      await fetchEvidencias();
    } catch (error) {
      alert(error instanceof Error ? error.message : 'Não foi possível enviar as evidências.');
    } finally {
      setUploadingEvidencias(false);
      if (evidenciasInputRef.current) evidenciasInputRef.current.value = '';
      if (evidenciasCameraInputRef.current) evidenciasCameraInputRef.current.value = '';
    }
  };

  const handleEvidenceFileChange = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const files = Array.from(event.target.files || []);
    if (files.length === 0) return;
    await uploadEvidencias(files);
  };

  const handleDeleteEvidence = async (name: string) => {
    if (!id || !name) return;
    if (!window.confirm('Remover esta evidência da ficha da jangada?')) return;

    setDeletingEvidenceName(name);
    try {
      const response = await fetch(`/api/jangadas/${id}/evidencias?name=${encodeURIComponent(name)}`, {
        method: 'DELETE',
      });
      const payload = await response.json().catch(() => null);
      if (!response.ok) {
        throw new Error(payload?.error || payload?.message || 'Não foi possível remover a evidência.');
      }
      await fetchEvidencias();
    } catch (error) {
      alert(error instanceof Error ? error.message : 'Não foi possível remover a evidência.');
    } finally {
      setDeletingEvidenceName(null);
    }
  };

  useEffect(() => {
    if (activeSection !== 'evidencias' && activeSection !== 'contentor') return;
    if (!canEditJangadaPage) return;

    const onPaste = (event: ClipboardEvent) => {
      const items = event.clipboardData?.items;
      if (!items || items.length === 0) return;

      const imageFiles = Array.from(items)
        .filter((item) => item.type.startsWith('image/'))
        .map((item) => item.getAsFile())
        .filter((file): file is File => Boolean(file));

      if (imageFiles.length === 0) return;

      event.preventDefault();
      void uploadEvidencias(imageFiles);
    };

    window.addEventListener('paste', onPaste);
    return () => window.removeEventListener('paste', onPaste);
  }, [activeSection, canEditJangadaPage, id]);

  useEffect(() => {
    if (!activeChecklistImageAid) return;

    const previousOverflow = document.body.style.overflow;
    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        setActiveChecklistImageAid(null);
      }
    };

    document.body.style.overflow = 'hidden';
    window.addEventListener('keydown', handleKeyDown);

    return () => {
      document.body.style.overflow = previousOverflow;
      window.removeEventListener('keydown', handleKeyDown);
    };
  }, [activeChecklistImageAid]);

  // Buscar inspeções da jangada
  useEffect(() => {
    if (!id) return;
    fetch(`/api/inspecoes?jangadaId=${id}`)
      .then(res => res.ok ? res.json() : [])
      .then(data => {
        if (Array.isArray(data)) {
          setInspecoes(sortInspectionsByMostRecent(data));
        }
      });
  }, [id]);

  useEffect(() => {
    if (typeof window === "undefined") return;
    let cancelled = false;

    const loadThumbs = async () => {
      try {
        const response = await fetch("/api/stock?take=5000");
        if (!response.ok) return;
        const stockRows = (await response.json()) as Array<{ id: number; referencia?: string; descricao?: string; foto?: string; codigoFabricante?: string; precoCompra?: number | null; precoVenda?: number | null; estadoArtigo?: string | null; referenciaSubstituta?: string | null; validade?: string | null; categoria?: string | null; aplicavelModeloJangada?: string | null; quantidade?: number | null; quantidadeMinima?: number | null; estadoCargaCilindro?: string | null; testeHidraulico?: string | null; lote?: string | null; localizacao?: string | null }>;

        const thumbMap: Record<string, string> = {};
        const nomeMap: Record<string, StockLookupItem> = {};
        const refMap: Record<string, StockLookupItem> = {};
        const codigoFabricanteMap: Record<string, StockLookupItem> = {};
        for (const row of stockRows) {
          const refKey = normalizeReference(row.referencia);
          const photo = row.foto || "";
          if (refKey && photo) thumbMap[refKey] = photo;
          if (refKey && row.referencia) {
            refMap[refKey] = {
              id: row.id,
              referencia: row.referencia,
              descricao: row.descricao || "",
              foto: photo || undefined,
              codigoFabricante: row.codigoFabricante || undefined,
              precoCompra: row.precoCompra ?? null,
              precoVenda: row.precoVenda ?? null,
              estadoArtigo: row.estadoArtigo ?? null,
              referenciaSubstituta: row.referenciaSubstituta ?? null,
              validade: row.validade ?? null,
              categoria: row.categoria ?? null,
              aplicavelModeloJangada: row.aplicavelModeloJangada ?? null,
              quantidade: row.quantidade ?? null,
              quantidadeMinima: row.quantidadeMinima ?? null,
              estadoCargaCilindro: row.estadoCargaCilindro ?? null,
              testeHidraulico: row.testeHidraulico ?? null,
              lote: row.lote ?? null,
              localizacao: row.localizacao ?? null,
            };
          }
          // Indexa por nome normalizado para ligação a partir do pack
          const nomeKey = normalizeText(row.descricao || "");
          if (nomeKey && row.referencia) {
            nomeMap[nomeKey] = {
              id: row.id,
              referencia: row.referencia,
              descricao: row.descricao || "",
              foto: photo || undefined,
              codigoFabricante: row.codigoFabricante || undefined,
              precoCompra: row.precoCompra ?? null,
              precoVenda: row.precoVenda ?? null,
              estadoArtigo: row.estadoArtigo ?? null,
              referenciaSubstituta: row.referenciaSubstituta ?? null,
              validade: row.validade ?? null,
              categoria: row.categoria ?? null,
              aplicavelModeloJangada: row.aplicavelModeloJangada ?? null,
              quantidade: row.quantidade ?? null,
              quantidadeMinima: row.quantidadeMinima ?? null,
              estadoCargaCilindro: row.estadoCargaCilindro ?? null,
              testeHidraulico: row.testeHidraulico ?? null,
              lote: row.lote ?? null,
              localizacao: row.localizacao ?? null,
            };
          }

          const codigoFabricanteKey = normalizeReference(row.codigoFabricante);
          if (codigoFabricanteKey && row.referencia) {
            codigoFabricanteMap[codigoFabricanteKey] = {
              id: row.id,
              referencia: row.referencia,
              descricao: row.descricao || "",
              foto: photo || undefined,
              codigoFabricante: row.codigoFabricante || undefined,
              precoCompra: row.precoCompra ?? null,
              precoVenda: row.precoVenda ?? null,
              estadoArtigo: row.estadoArtigo ?? null,
              referenciaSubstituta: row.referenciaSubstituta ?? null,
              validade: row.validade ?? null,
              categoria: row.categoria ?? null,
              aplicavelModeloJangada: row.aplicavelModeloJangada ?? null,
              quantidade: row.quantidade ?? null,
              quantidadeMinima: row.quantidadeMinima ?? null,
              estadoCargaCilindro: row.estadoCargaCilindro ?? null,
              testeHidraulico: row.testeHidraulico ?? null,
              lote: row.lote ?? null,
              localizacao: row.localizacao ?? null,
            };
          }
        }

        if (!cancelled) {
          setStockThumbByReferencia(thumbMap);
          setStockMapByNome(nomeMap);
          setStockMapByReferencia(refMap);
          setStockMapByCodigoFabricante(codigoFabricanteMap);
        }

        const referencias = Array.from(
          new Set(
            stockRows
              .map((row) => String(row.referencia || "").trim())
              .filter(Boolean)
          )
        );

        const chunkSize = 5;
        for (let i = 0; i < referencias.length; i += chunkSize) {
          if (cancelled) break;
          const chunk = referencias.slice(i, i + chunkSize);
          try {
            const params = new URLSearchParams({
              includeFoto: "true",
              refs: chunk.join(","),
            });
            const responseFotos = await fetch(`/api/stock?${params.toString()}`);
            if (!responseFotos.ok) continue;
            const rowsFotos = await responseFotos.json();
            if (!Array.isArray(rowsFotos)) continue;

            for (const row of rowsFotos) {
              const refKey = normalizeReference(row?.referencia);
              const foto = String(row?.foto || "").trim();
              if (!refKey || !foto) continue;

              thumbMap[refKey] = foto;
              if (refMap[refKey]) {
                refMap[refKey] = { ...refMap[refKey], foto };
              }

              const nomeKey = normalizeText(String(row?.descricao || ""));
              if (nomeKey && nomeMap[nomeKey]) {
                nomeMap[nomeKey] = { ...nomeMap[nomeKey], foto };
              }

              const codigoFabricanteKey = normalizeReference(row?.codigoFabricante);
              if (codigoFabricanteKey && codigoFabricanteMap[codigoFabricanteKey]) {
                codigoFabricanteMap[codigoFabricanteKey] = {
                  ...codigoFabricanteMap[codigoFabricanteKey],
                  foto,
                };
              }
            }
          } catch {
            // Ignorar falhas de lote para não bloquear renderização da ficha
          }
        }

        if (!cancelled) {
          setStockThumbByReferencia({ ...thumbMap });
          setStockMapByNome({ ...nomeMap });
          setStockMapByReferencia({ ...refMap });
          setStockMapByCodigoFabricante({ ...codigoFabricanteMap });
        }
      } catch {
        if (!cancelled) {
          setStockThumbByReferencia({});
          setStockMapByNome({});
          setStockMapByReferencia({});
          setStockMapByCodigoFabricante({});
        }
      }
    };

    loadThumbs();

    return () => {
      cancelled = true;
    };
  }, []);

  const certs2025 = useMemo(() => {
    if (!raft) return [] as CertificadoExtraido[];
    const extras = Array.isArray(raft.certificadosExtraidos) ? raft.certificadosExtraidos : [];
    const base = extras.filter((c: any) => Number(c?.sourceYear) === 2025);
    if (raft?.certificadoAtivo && Number(raft.certificadoAtivo.sourceYear) === 2025) {
      const already = base.some((c: any) => c.id === raft.certificadoAtivo?.id);
      if (!already) base.unshift(raft.certificadoAtivo);
    }
    return base;
  }, [raft]);

  const inspecoesOrdenadas = useMemo(() => sortInspectionsByMostRecent(inspecoes), [inspecoes]);

  const testYearsSummary = useMemo(() => {
    const anosInspecao = new Set<number>();
    const anosTesteHidraulico = new Set<number>();

    const addInspecao = (dateValue?: string) => {
      const y = extractYear(dateValue);
      if (y) anosInspecao.add(y);
    };

    const addHidraulico = (dateValue?: string) => {
      const y = extractYear(dateValue);
      if (y) anosTesteHidraulico.add(y);
    };

    addInspecao(String(form.dataInspecao || raft?.dataInspecao || ""));
    addHidraulico(String(form.cylinderDataTeste || raft?.cylinderDataTeste || ""));

    inspecoesOrdenadas.forEach((insp) => {
      addInspecao(insp?.dataInspecao);
    });

    const extras = Array.isArray(raft?.certificadosExtraidos) ? raft?.certificadosExtraidos : [];
    extras.forEach((cert) => addInspecao(cert?.dataInspecao));
    if (raft?.certificadoAtivo) addInspecao(raft.certificadoAtivo.dataInspecao);

    const toSorted = (set: Set<number>) => Array.from(set).sort((a, b) => b - a);

    return {
      inspecao: toSorted(anosInspecao),
      hidraulico: toSorted(anosTesteHidraulico),
    };
  }, [form.dataInspecao, form.cylinderDataTeste, raft, inspecoesOrdenadas]);

  const criticalValidityCards = useMemo(() => {
    const allRows = certs2025.flatMap((cert: any) => {
      const rows = Array.isArray(cert.validities) ? cert.validities : [];
      return rows.map((row: any) => ({
        item: row.item || "",
        validade: row.validade || "",
        certId: cert.id,
        certNumero: cert.certificadoNumero || cert.fileName || `Certificado ${cert.id}`,
        certInspecao: cert.dataInspecao,
      }));
    }).filter((row: any) => certificateItemHasManagedValidity(String(row.item || "")));

    return CRITICAL_ITEMS.map((group: { key: string; label: string; tokens: string[] }) => {
      const matches = allRows.filter((row: any) => {
        const itemNorm = normalizeText(row.item);
        return group.tokens.some((token: string) => itemNorm.includes(normalizeText(token)));
      });

      const sorted = matches.slice().sort((a: any, b: any) => {
        const da = Date.parse(a.validade || "") || 0;
        const db = Date.parse(b.validade || "") || 0;
        return da - db;
      });

      const nearest = sorted[0];

      return {
        ...group,
        total: matches.length,
        nearest,
        rows: sorted,
      };
    });
  }, [certs2025]);

  const inspecoesVisiveis = useMemo(() => {
    const historico = inspecoesOrdenadas;
    const dataInspecaoAtual = String(form.dataInspecao || raft?.dataInspecao || '').trim();
    const certificadoAtual = String(form.ultimoCertificadoNumero || raft?.ultimoCertificadoNumero || '').trim();

    if (!dataInspecaoAtual) return historico;

    const normalizedCurrentDate = normalizeIsoDate(dataInspecaoAtual);
    const currentAlreadyInHistory = historico.some((item) => {
      const sameDate = normalizeIsoDate(item.dataInspecao) === normalizedCurrentDate;
      if (!sameDate) return false;
      if (!certificadoAtual) return true;
      return String(item.certificadoNumero || '').trim() === certificadoAtual;
    });

    if (currentAlreadyInHistory) return historico;

    const snapshotAtual: Inspecao = {
      id: `snapshot:${certificadoAtual || normalizedCurrentDate || 'ficha'}`,
      certificadoNumero: certificadoAtual || 'Registo atual da ficha',
      dataInspecao: dataInspecaoAtual,
      dataProxInspecao: String(form.dataProxInspecao || raft?.dataProxInspecao || '').trim(),
      status: String(form.status || raft?.status || 'Concluída').trim() || 'Concluída',
      sourceFile: 'ficha_jangada',
      artigos: normalizeArtigos(form.artigos || raft?.artigos),
    };

    return sortInspectionsByMostRecent([snapshotAtual, ...historico]);
  }, [
    inspecoesOrdenadas,
    form.dataInspecao,
    raft?.dataInspecao,
    form.ultimoCertificadoNumero,
    raft?.ultimoCertificadoNumero,
    form.dataProxInspecao,
    raft?.dataProxInspecao,
    form.status,
    raft?.status,
    form.artigos,
    raft?.artigos,
  ]);

  const ultimaInspecao = inspecoesVisiveis.length > 0 ? inspecoesVisiveis[0] : null;

  const certificadoPreferencial = useMemo(() => {
    const extraidos = Array.isArray(raft?.certificadosExtraidos) ? raft.certificadosExtraidos : [];
    const combined = [
      ...(raft?.certificadoAtivo ? [raft.certificadoAtivo] : []),
      ...extraidos,
    ].filter(Boolean);

    const deduped = Array.from(
      new Map(combined.map((cert) => [String(cert?.id || cert?.certificadoNumero || cert?.fileName || ''), cert])).values()
    );

    return deduped.sort((a, b) => {
      const byInspection = getComparableDateValue(b?.dataInspecao) - getComparableDateValue(a?.dataInspecao);
      if (byInspection !== 0) return byInspection;

      const byNextInspection = getComparableDateValue(b?.dataProxInspecao) - getComparableDateValue(a?.dataProxInspecao);
      if (byNextInspection !== 0) return byNextInspection;

      return Number(b?.sourceYear || 0) - Number(a?.sourceYear || 0);
    })[0];
  }, [raft]);

  const certificadoExternoUrl = useMemo(() => {
    const fileName = String(certificadoPreferencial?.fileName || "").trim();
    if (!fileName || !fileName.toLowerCase().endsWith(".pdf")) return null;
    return `/certificados-externos/${encodeURIComponent(fileName)}`;
  }, [certificadoPreferencial]);

  const normalizeTestResult = (value: unknown, fallback: "YES" | "NO" | "N/A" = "NO") => {
    const raw = String(value || "").trim().toUpperCase();
    if (!raw) return fallback;
    if (["YES", "SIM", "OK", "TRUE", "1"].includes(raw)) return "YES";
    if (["NO", "NAO", "NÃO", "FALSE", "0", "NOT_OK"].includes(raw)) return "NO";
    if (["N/A", "NA", "N.D", "ND"].includes(raw)) return "N/A";
    return fallback;
  };

  const derivedTestDefaults = useMemo(() => {
    return getAutomaticRaftTests({
      brand: String(form.brand || raft?.brand || ''),
      model: String(form.model || raft?.model || ''),
      launchType: String(form.launchType || raft?.launchType || ''),
      dataFabrico: String(form.dataFabrico || raft?.dataFabrico || ''),
      inspectionDate: String(form.dataInspecao || raft?.dataInspecao || ''),
    });
  }, [form.brand, raft?.brand, form.model, raft?.model, form.launchType, raft?.launchType, form.dataFabrico, raft?.dataFabrico, form.dataInspecao, raft?.dataInspecao]);

  useEffect(() => {
    setForm((prev: FormState) => {
      const next: FormState = { ...prev };
      let changed = false;

      const automaticTests: Array<[keyof FormState, string]> = [
        ['testeWP', derivedTestDefaults.testeWP],
        ['testeNAP', derivedTestDefaults.testeNAP],
        ['testeFS', derivedTestDefaults.testeFS],
        ['testeGI', derivedTestDefaults.testeGI],
        ['testeDL', derivedTestDefaults.testeDL],
      ];

      automaticTests.forEach(([key, value]) => {
        if (String(prev[key] || '').trim().toUpperCase() !== value) {
          next[key] = value;
          changed = true;
        }
      });

      return changed ? next : prev;
    });
  }, [
    derivedTestDefaults.testeWP,
    derivedTestDefaults.testeNAP,
    derivedTestDefaults.testeFS,
    derivedTestDefaults.testeGI,
    derivedTestDefaults.testeDL,
  ]);

  const wpDerived = useMemo(() => buildWpDerivedValues({
    pressureUnit: form.testeWPUnidadePressao || raft?.testeWPUnidadePressao,
    launchType: form.launchType || raft?.launchType,
    startTime: form.testeWPHoraInicio || raft?.testeWPHoraInicio,
    tempInitial: form.testeWPTemperaturaInicial || raft?.testeWPTemperaturaInicial,
    tempFinal: form.testeWPTemperaturaFinal || raft?.testeWPTemperaturaFinal,
    baroInitial: form.testeWPPressaoAtmosfericaInicial || raft?.testeWPPressaoAtmosfericaInicial,
    baroFinal: form.testeWPPressaoAtmosfericaFinal || raft?.testeWPPressaoAtmosfericaFinal,
    upperStart: form.testeWPCamaraSuperiorInicio || raft?.testeWPCamaraSuperiorInicio || form.testePressaoCamaraSuperior || raft?.testePressaoCamaraSuperior,
    upperEnd: form.testeWPCamaraSuperiorFim || raft?.testeWPCamaraSuperiorFim,
    lowerStart: form.testeWPCamaraInferiorInicio || raft?.testeWPCamaraInferiorInicio || form.testePressaoCamaraInferior || raft?.testePressaoCamaraInferior,
    lowerEnd: form.testeWPCamaraInferiorFim || raft?.testeWPCamaraInferiorFim,
  }), [
    form.testeWPUnidadePressao,
    raft?.testeWPUnidadePressao,
    form.launchType,
    raft?.launchType,
    form.testeWPHoraInicio,
    raft?.testeWPHoraInicio,
    form.testeWPTemperaturaInicial,
    raft?.testeWPTemperaturaInicial,
    form.testeWPTemperaturaFinal,
    raft?.testeWPTemperaturaFinal,
    form.testeWPPressaoAtmosfericaInicial,
    raft?.testeWPPressaoAtmosfericaInicial,
    form.testeWPPressaoAtmosfericaFinal,
    raft?.testeWPPressaoAtmosfericaFinal,
    form.testeWPCamaraSuperiorInicio,
    raft?.testeWPCamaraSuperiorInicio,
    form.testeWPCamaraSuperiorFim,
    raft?.testeWPCamaraSuperiorFim,
    form.testeWPCamaraInferiorInicio,
    raft?.testeWPCamaraInferiorInicio,
    form.testeWPCamaraInferiorFim,
    raft?.testeWPCamaraInferiorFim,
    form.testePressaoCamaraSuperior,
    raft?.testePressaoCamaraSuperior,
    form.testePressaoCamaraInferior,
    raft?.testePressaoCamaraInferior,
  ]);

  const wpUnitSelected = useMemo(() => normalizePressureUnit(form.testeWPUnidadePressao || raft?.testeWPUnidadePressao || 'inh2o'), [form.testeWPUnidadePressao, raft?.testeWPUnidadePressao]);
  const wpUnitLabel = wpUnitSelected === 'inhg' ? 'inHg' : wpUnitSelected === 'mbar' ? 'mbar' : 'inH2O';
  const wpCorrectionTempInSelectedUnit = convertMbarToUnit(wpDerived.correctionTempMb, wpUnitSelected);
  const wpCorrectionBaroInSelectedUnit = convertMbarToUnit(wpDerived.correctionBaroMb, wpUnitSelected);
  const wpManualReseatThresholdSelectedUnit = convertMbarToUnit(MKIV_THROWOVER_RESEAT_THRESHOLD_MBAR, wpUnitSelected);

  // Artigos da última inspeção (useMemo must be before early returns)
  const ultimaInspecaoArtigos = useMemo(() => {
    return normalizeArtigos(ultimaInspecao?.artigos || []);
  }, [ultimaInspecao]);

  const hasCertificateData = useMemo(() => {
    return Boolean(
      form.ultimoCertificadoNumero ||
      raft?.ultimoCertificadoNumero ||
      certificadoPreferencial?.certificadoNumero ||
      ultimaInspecao?.certificadoNumero ||
      form.dataInspecao ||
      raft?.dataInspecao ||
      ultimaInspecao?.dataInspecao
    );
  }, [form.ultimoCertificadoNumero, raft?.ultimoCertificadoNumero, certificadoPreferencial?.certificadoNumero, ultimaInspecao?.certificadoNumero, form.dataInspecao, raft?.dataInspecao, ultimaInspecao?.dataInspecao]);

  const applicableServiceBulletins = useMemo(() => {
    return Array.isArray(raft?.applicableServiceBulletins) ? raft.applicableServiceBulletins : [];
  }, [raft?.applicableServiceBulletins]);

  const serviceBulletinsApplied = useMemo(() => {
    return normalizeServiceBulletinsApplied(form.serviceBulletinsApplied ?? raft?.serviceBulletinsApplied);
  }, [form.serviceBulletinsApplied, raft?.serviceBulletinsApplied]);

  const appliedServiceBulletinsCount = useMemo(() => {
    const applicableIds = new Set(applicableServiceBulletins.map((bulletin) => bulletin.id));
    return Object.entries(serviceBulletinsApplied).filter(([bulletinId, applied]) => applied && applicableIds.has(bulletinId)).length;
  }, [applicableServiceBulletins, serviceBulletinsApplied]);

  const sb4621Applicable = useMemo(() => {
    return applicableServiceBulletins.find((bulletin) => bulletin.id === "survitec-multi-label-sheets-46-21") || null;
  }, [applicableServiceBulletins]);

  const sb4621LayoutGuide = useMemo(() => {
    if (!sb4621Applicable) return null;

    const matchedRule = String(sb4621Applicable.matchedRuleLabel || "").toLowerCase();
    const launchType = String(form.launchType || raft?.launchType || "").trim().toUpperCase();
    const isDavit = launchType === "DL" || launchType === "DAVIT";

    if (matchedRule.includes("annual")) {
      return {
        title: isDavit ? "Annual Service — Davit Launch" : "Annual Service — Throw Over",
        subtitle: isDavit
          ? "Aplicar Item 1 + Item 2 no contentor associado ao modelo atual."
          : "Aplicar Item 1 no contentor associado ao modelo atual.",
        sheets: isDavit
          ? ["Item 1 · 53795001 / 53796001 / 53797001 / 53819001", "Item 2 · 53801001"]
          : ["Item 1 · 53795001 / 53796001 / 53797001 / 53819001"],
        diagramMode: isDavit ? "annual-dl" : "annual-to",
        figurePath: isDavit ? "/boletins/sb-46-21/annual-dl.png" : "/boletins/sb-46-21/annual-to.png",
        figurePage: isDavit ? 24 : 14,
      } as const;
    }

    if (matchedRule.includes("extended")) {
      return {
        title: isDavit ? "Extended Service — Davit Launch" : "Extended Service",
        subtitle: isDavit
          ? "Aplicar Item 2 + Item 3 no contentor associado ao modelo atual."
          : "Aplicar Item 3 no contentor associado ao modelo atual.",
        sheets: isDavit
          ? ["Item 2 · 53801001", "Item 3 · 53800001"]
          : ["Item 3 · 53800001"],
        diagramMode: isDavit ? "extended-dl" : "extended-to",
        figurePath: isDavit ? "/boletins/sb-46-21/extended-dl.png" : "/boletins/sb-46-21/extended-to.png",
        figurePage: isDavit ? 37 : 31,
      } as const;
    }

    if (matchedRule.includes("ferryman")) {
      return {
        title: "Ferryman",
        subtitle: "Aplicar Item 4 no contentor throw-over afetado.",
        sheets: ["Item 4 · 53798001"],
        diagramMode: "ferryman",
        figurePath: "/boletins/sb-46-21/ferryman.png",
        figurePage: 42,
      } as const;
    }

    if (matchedRule.includes("means of rescue") || matchedRule.includes("mor")) {
      return {
        title: "Means of Rescue (MOR)",
        subtitle: "Aplicar Item 5 no contentor MOR afetado.",
        sheets: ["Item 5 · 53799001"],
        diagramMode: "mor",
        figurePath: "/boletins/sb-46-21/mor.png",
        figurePage: 50,
      } as const;
    }

    return {
      title: "SB 46/21 Ver.2",
      subtitle: "Confirmar no boletim a folha multi-etiquetas e a posição aplicável ao modelo/contentor atual.",
      sheets: ["Ver combinação exata no PDF do SB 46/21"],
      diagramMode: "generic",
      figurePath: null,
      figurePage: null,
    } as const;
  }, [sb4621Applicable, form.launchType, raft?.launchType]);

  const persistServiceBulletinsApplied = async (nextAppliedState: ServiceBulletinsAppliedState) => {
    const previousForm = form;
    const nextForm = normalizeRaftResponse({
      ...form,
      serviceBulletinsApplied: nextAppliedState,
    }) as FormState;

    setForm(nextForm);
    latestFormRef.current = nextForm;
    setBulletinSaveState("saving");

    try {
      const response = await fetch(`/api/jangadas/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(buildSavePayload(nextForm)),
      });

      if (!response.ok) {
        throw new Error("Falha ao guardar o boletim aplicado.");
      }

      const updated = await response.json().catch(() => null);
      const normalized = normalizeRaftResponse(updated || nextForm);

      setRaft(normalized);
      setForm(normalized);
      latestFormRef.current = normalized;
      lastSavedSnapshotRef.current = snapshotOf(normalized);
      setBulletinSaveState("saved");
      setTimeout(() => setBulletinSaveState("idle"), 1500);
    } catch {
      const restored = normalizeRaftResponse(previousForm);
      setForm(restored);
      latestFormRef.current = restored;
      setBulletinSaveState("error");
    }
  };

  const handleServiceBulletinAppliedChange = (bulletinId: string, checked: boolean) => {
    const nextAppliedState: ServiceBulletinsAppliedState = {
      ...serviceBulletinsApplied,
      [bulletinId]: checked,
    };

    if (!checked) {
      delete nextAppliedState[bulletinId];
    }

    void persistServiceBulletinsApplied(nextAppliedState);
  };

  const checklistRaftInput = useMemo<ChecklistRaftInput>(() => {
    const checklistArtigos: ChecklistRaftInput['artigos'] = normalizeArtigos(form.artigos || raft?.artigos).map((artigo) => {
      const parsedQuantidade = Number(String(artigo?.quantidade ?? "").replace(",", "."));
      return {
        name: String(artigo?.name || ""),
        quantidade: Number.isFinite(parsedQuantidade) ? parsedQuantidade : undefined,
        validade: String(artigo?.validade || ""),
        referencia: String(artigo?.referencia || ""),
      };
    });

    const checklistMandatoryPackItems = Array.isArray(resolvedMandatoryPackItems)
      ? resolvedMandatoryPackItems
      : getMandatoryPackItemsForRaft({
          brand: String(form.brand || raft?.brand || '').trim(),
          model: String(form.model || raft?.model || '').trim(),
          packType: String(form.packType || raft?.packType || '').trim(),
          capacity: Number(form.capacity || raft?.capacity || 0) || undefined,
        });

    return {
      serial: String(form.serial || raft?.serial || ""),
      brand: String(form.brand || raft?.brand || ""),
      model: String(form.model || raft?.model || ""),
      capacity: Number(form.capacity || raft?.capacity || 0) || undefined,
      owner: String(form.owner || raft?.owner || raft?.ownerDisplay || ""),
      dataFabrico: String(form.dataFabrico || raft?.dataFabrico || ""),
      packType: String(form.packType || raft?.packType || ""),
      containerModel: String(form.containerModel || raft?.containerModel || ""),
      cylinderCabecaDisparoRef: String(form.cylinderCabecaDisparoRef || raft?.cylinderCabecaDisparoRef || ""),
      tuboIdentificacao: String(form.tuboIdentificacao || raft?.tuboIdentificacao || ""),
      dataInspecao: String(form.dataInspecao || raft?.dataInspecao || ""),
      shipNameManual: String(form.shipNameManual || raft?.shipNameManual || ""),
      cylinder: {
        serial: String(form.cylinderSerial || raft?.cylinderSerial || ""),
        tara: String(form.cylinderTara || raft?.cylinderTara || ""),
        pesoBruto: String(form.cylinderPesoBruto || raft?.cylinderPesoBruto || ""),
        co2: String(form.cylinderCo2 || raft?.cylinderCo2 || ""),
        n2: String(form.cylinderN2 || raft?.cylinderN2 || ""),
        dataTeste: String(form.cylinderDataTeste || raft?.cylinderDataTeste || ""),
        dataProxTeste: String(form.cylinderDataProxTeste || raft?.cylinderDataProxTeste || ""),
        sistema: String(form.cylinderSistema || raft?.cylinderSistema || ""),
      },
      artigos: checklistArtigos,
      mandatoryPackItems: checklistMandatoryPackItems,
      serviceBulletinsApplied,
    };
  }, [
    form.serial,
    raft?.serial,
    form.brand,
    raft?.brand,
    form.model,
    raft?.model,
    form.capacity,
    raft?.capacity,
    form.owner,
    raft?.owner,
    raft?.ownerDisplay,
    form.dataFabrico,
    raft?.dataFabrico,
    form.packType,
    raft?.packType,
    form.containerModel,
    raft?.containerModel,
    form.cylinderCabecaDisparoRef,
    raft?.cylinderCabecaDisparoRef,
    form.tuboIdentificacao,
    raft?.tuboIdentificacao,
    form.dataInspecao,
    raft?.dataInspecao,
    form.shipNameManual,
    raft?.shipNameManual,
    form.cylinderSerial,
    raft?.cylinderSerial,
    form.cylinderTara,
    raft?.cylinderTara,
    form.cylinderPesoBruto,
    raft?.cylinderPesoBruto,
    form.cylinderCo2,
    raft?.cylinderCo2,
    form.cylinderN2,
    raft?.cylinderN2,
    form.cylinderDataTeste,
    raft?.cylinderDataTeste,
    form.cylinderDataProxTeste,
    raft?.cylinderDataProxTeste,
    form.cylinderSistema,
    raft?.cylinderSistema,
    form.artigos,
    raft?.artigos,
    resolvedMandatoryPackItems,
    serviceBulletinsApplied,
  ]);

  const inspectionChecklistSections = useMemo(() => {
    return buildInspectionChecklistFromQuadro(checklistRaftInput);
  }, [checklistRaftInput]);

  const inspectionChecklistValues = useMemo(() => {
    return normalizeInspectionChecklistValues(form.inspectionChecklistValues ?? raft?.inspectionChecklistValues);
  }, [form.inspectionChecklistValues, raft?.inspectionChecklistValues]);

  const linkedChecklistValues = useMemo(() => {
    const initialValues = buildChecklistInitialValues(inspectionChecklistSections, checklistRaftInput as any);
    const linkedFields = inspectionChecklistSections.flatMap((section) => section.fields)
      .filter((field) => field.packItem || field.bulletinId);

    return linkedFields.reduce<InspectionChecklistValues>((acc, field) => {
      const value = initialValues[field.name];
      if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') {
        acc[field.name] = value;
      }
      return acc;
    }, {});
  }, [inspectionChecklistSections, checklistRaftInput]);

  useEffect(() => {
    if (!inspectionChecklistSections.length) return;

    const initialValues = buildChecklistInitialValues(inspectionChecklistSections, checklistRaftInput as any);
    setForm((prev) => {
      const currentValues = normalizeInspectionChecklistValues(prev.inspectionChecklistValues);
      const mergedValues: InspectionChecklistValues = { ...currentValues };
      let changed = false;

      for (const [key, value] of Object.entries(initialValues)) {
        const current = mergedValues[key];
        const isEmpty = current === undefined || current === null || (typeof current === "string" && current.trim() === "");
        if (isEmpty && (typeof value === "string" || typeof value === "number" || typeof value === "boolean")) {
          mergedValues[key] = value;
          changed = true;
        }
      }

      if (!changed) return prev;
      return {
        ...prev,
        inspectionChecklistValues: mergedValues,
      };
    });
  }, [inspectionChecklistSections, checklistRaftInput]);

  useEffect(() => {
    if (!inspectionChecklistSections.length) return;

    setForm((prev) => {
      const currentValues = normalizeInspectionChecklistValues(prev.inspectionChecklistValues);
      const mergedValues: InspectionChecklistValues = { ...currentValues };
      let changed = false;

      for (const [key, value] of Object.entries(linkedChecklistValues)) {
        if (mergedValues[key] !== value) {
          mergedValues[key] = value;
          changed = true;
        }
      }

      if (!changed) return prev;
      return {
        ...prev,
        inspectionChecklistValues: mergedValues,
      };
    });
  }, [inspectionChecklistSections, linkedChecklistValues]);

  const syncPackChecklistFieldToArticles = (
    articlesInput: ArtigoJangada[],
    field: ChecklistField,
    nextValue: string | number | boolean,
    currentChecklistValues: InspectionChecklistValues,
  ) => {
    const packItem = field.packItem;
    if (!packItem) return articlesInput;

    const articles = [...articlesInput];
    const existingIndex = articles.findIndex((article) => Boolean(findMatchingArticleForPackItem(packItem, [article])));
    const existingArticle = existingIndex >= 0 ? articles[existingIndex] : undefined;

    if (field.type === 'checkbox') {
      if (!Boolean(nextValue)) {
        if (existingIndex >= 0) articles.splice(existingIndex, 1);
        return articles;
      }

      const linkedValidityValue = packItem.validityFieldName
        ? String(currentChecklistValues[packItem.validityFieldName] ?? '').trim()
        : '';
      const normalizedValidity = normalizeMonthYearValue(linkedValidityValue);
      const preferredReference = String(
        existingArticle?.referencia
        || getPreferredStockReferenceForArticleName(packItem.label)
        || packItem.reference
        || ''
      ).trim();
      const stockSynced = preferredReference
        ? sincronizarArtigoObrigatorioComStockPorReferencia(packItem.label, preferredReference, existingArticle)
        : { ...existingArticle, name: packItem.label };
      const nextArticle: ArtigoJangada = {
        ...(existingArticle || ({} as ArtigoJangada)),
        ...stockSynced,
        name: packItem.label,
        quantidade: existingArticle?.quantidade || String(packItem.quantity || 1),
      };

      if (normalizedValidity) {
        nextArticle.validade = normalizedValidity;
      }

      if (existingIndex >= 0) {
        articles[existingIndex] = nextArticle;
      } else {
        articles.push(nextArticle);
      }

      return articles;
    }

    if (field.type === 'date') {
      const rawValue = String(nextValue ?? '').trim();
      const normalizedValidity = normalizeMonthYearValue(rawValue);

      if (!normalizedValidity && existingIndex < 0) return articles;

      const preferredReference = String(
        existingArticle?.referencia
        || getPreferredStockReferenceForArticleName(packItem.label)
        || packItem.reference
        || ''
      ).trim();
      const stockSynced = preferredReference
        ? sincronizarArtigoObrigatorioComStockPorReferencia(packItem.label, preferredReference, existingArticle)
        : { ...existingArticle, name: packItem.label };
      const nextArticle: ArtigoJangada = {
        ...(existingArticle || ({} as ArtigoJangada)),
        ...stockSynced,
        name: packItem.label,
        quantidade: existingArticle?.quantidade || String(packItem.quantity || 1),
        validade: normalizedValidity || '',
      };

      if (existingIndex >= 0) {
        articles[existingIndex] = nextArticle;
      } else {
        articles.push(nextArticle);
      }

      return articles;
    }

    return articles;
  };

  useEffect(() => {
    if (!inspectionChecklistSections.length) {
      setInspectionWizardStep(0);
      return;
    }

    setInspectionWizardStep((prev) => Math.min(prev, inspectionChecklistSections.length - 1));
  }, [inspectionChecklistSections]);

  const handleChecklistFieldChange = (fieldName: string, value: string | number | boolean) => {
    setForm((prev) => {
      const currentValues = normalizeInspectionChecklistValues(prev.inspectionChecklistValues);
      const nextChecklistValues: InspectionChecklistValues = {
        ...currentValues,
        [fieldName]: value,
      };
      const field = inspectionChecklistSections
        .flatMap((section) => section.fields)
        .find((candidate) => candidate.name === fieldName);

      let nextServiceBulletinsApplied = normalizeServiceBulletinsApplied(prev.serviceBulletinsApplied);
      if (field?.bulletinId) {
        nextServiceBulletinsApplied = {
          ...nextServiceBulletinsApplied,
          [field.bulletinId]: Boolean(value),
        };
        if (!Boolean(value)) {
          delete nextServiceBulletinsApplied[field.bulletinId];
        }
      }

      const nextArtigos = field?.packItem
        ? syncPackChecklistFieldToArticles(normalizeArtigos(prev.artigos), field, value, nextChecklistValues)
        : normalizeArtigos(prev.artigos);

      return {
        ...prev,
        artigos: nextArtigos,
        serviceBulletinsApplied: nextServiceBulletinsApplied,
        inspectionChecklistValues: nextChecklistValues,
      };
    });
  };

  const buildOreyCertificatePayload = () => {
    const certNumber = String(
      form.ultimoCertificadoNumero ||
      raft?.ultimoCertificadoNumero ||
      certificadoPreferencial?.certificadoNumero ||
      ultimaInspecao?.certificadoNumero ||
      'SEM-NUMERO'
    ).trim();
    const selectedShip = resolveSelectedShip(form) || resolveSelectedShip(raft);
    const shipName = String(selectedShip?.nome || form.shipNameManual || raft?.shipDetails?.nome || raft?.shipNameManual || 'Sem navio').trim() || 'Sem navio';
    const selectedOwner = String(selectedShip?.proprietario || selectedShip?.cliente?.nome || '').trim();
    const normalizedBrand = normalizeText(String(form.brand || raft?.brand || ''));
    const logoCandidates = Array.from(
      new Map(
        Object.values(stockMapByReferencia)
          .filter((item) => item?.foto)
          .map((item) => [String(item.id), item])
      ).values()
    );
    const brandLogoItem = logoCandidates
      .filter((item) => {
        const descricao = normalizeText(item.descricao || '');
        const codigoFabricante = normalizeText(item.codigoFabricante || '');
        const categoria = normalizeText(item.categoria || '');
        const haystack = `${descricao} ${codigoFabricante} ${categoria}`;
        return normalizedBrand && haystack.includes(normalizedBrand);
      })
      .sort((a, b) => {
        const score = (item: StockLookupItem) => {
          const descricao = normalizeText(item.descricao || '');
          const codigoFabricante = normalizeText(item.codigoFabricante || '');
          const categoria = normalizeText(item.categoria || '');
          const haystack = `${descricao} ${codigoFabricante} ${categoria}`;
          let total = 0;
          if (haystack.includes('logo')) total += 10;
          if (haystack.includes('marca')) total += 6;
          if (descricao === normalizedBrand) total += 5;
          if (descricao.startsWith(normalizedBrand)) total += 3;
          return total;
        };
        return score(b) - score(a);
      })[0];
    const checklist = buildCertificateChecklistSnapshot({
      raft,
      form,
      latestInspection: ultimaInspecao,
      latestInspectionArticles: ultimaInspecaoArtigos,
      activeCertificate: certificadoPreferencial,
      mandatoryPackItems: mandatoryPackChecklistItems,
    });

    const checklistWithTests = {
      ...checklist,
      teste_wp: normalizeTestResult(form.testeWP, derivedTestDefaults.testeWP),
      teste_nap: normalizeTestResult(form.testeNAP, derivedTestDefaults.testeNAP),
      teste_fs: normalizeTestResult(form.testeFS, derivedTestDefaults.testeFS),
      teste_gi: normalizeTestResult(form.testeGI, derivedTestDefaults.testeGI),
      teste_dl: normalizeTestResult(form.testeDL, derivedTestDefaults.testeDL),
      teste_temperatura_camara_superior: String(form.testeTemperaturaCamaraSuperior || "").trim(),
      teste_temperatura_camara_inferior: String(form.testeTemperaturaCamaraInferior || "").trim(),
      teste_pressao_camara_superior: String(form.testePressaoCamaraSuperior || "").trim(),
      teste_pressao_camara_inferior: String(form.testePressaoCamaraInferior || "").trim(),
      teste_wp_valvula_abertura_superior: String(form.testeWPCamaraSuperiorAberturaValvula || raft?.testeWPCamaraSuperiorAberturaValvula || '').trim(),
      teste_wp_valvula_fecho_superior: String(form.testeWPCamaraSuperiorFechoValvula || raft?.testeWPCamaraSuperiorFechoValvula || form.testeWPCamaraSuperiorInicio || raft?.testeWPCamaraSuperiorInicio || form.testePressaoCamaraSuperior || raft?.testePressaoCamaraSuperior || '').trim(),
      teste_wp_valvula_abertura_inferior: String(form.testeWPCamaraInferiorAberturaValvula || raft?.testeWPCamaraInferiorAberturaValvula || '').trim(),
      teste_wp_valvula_fecho_inferior: String(form.testeWPCamaraInferiorFechoValvula || raft?.testeWPCamaraInferiorFechoValvula || form.testeWPCamaraInferiorInicio || raft?.testeWPCamaraInferiorInicio || form.testePressaoCamaraInferior || raft?.testePressaoCamaraInferior || '').trim(),
    };

    return {
      id: undefined,
      certNumber,
      inspectionDate: String(form.dataInspecao || raft?.dataInspecao || certificadoPreferencial?.dataInspecao || ultimaInspecao?.dataInspecao || ''),
      nextInspectionDate: String(form.dataProxInspecao || raft?.dataProxInspecao || certificadoPreferencial?.dataProxInspecao || ultimaInspecao?.dataProxInspecao || ''),
      shipName: String(selectedShip?.nome || raft?.shipDetails?.nome || shipName),
      shipFlag: String(selectedShip?.bandeira || raft?.shipDetails?.bandeira || ''),
      shipImo: String(selectedShip?.imo || raft?.shipDetails?.imo || ''),
      shipCallSign: String(selectedShip?.callSignal || raft?.shipDetails?.callSignal || ''),
      owner: String(form.owner || selectedOwner || raft?.shipDetails?.proprietario || raft?.ownerDisplay || raft?.owner || ''),
      brand: String(form.brand || raft?.brand || ''),
      brandLogoUrl: String(brandLogoItem?.foto || ''),
      launchType: String(form.launchType || raft?.launchType || ''),
      raftType: String(form.containerModel || raft?.containerModel || ''),
      raftModel: String(technicalModel?.name || form.model || raft?.model || ''),
      raftCapacity: String(form.capacity || raft?.capacity || ''),
      raftSerial: String(form.serial || raft?.serial || 'SEM-SERIAL'),
      manufactureDate: String(form.dataFabrico || raft?.dataFabrico || ''),
      fabricType: String(technicalModel?.material || ''),
      painterLength: String(form.painterLength || raft?.painterLength || ''),
      maxStowageHeight: String(form.maxStowageHeight || raft?.maxStowageHeight || ''),
      cylinderSerial: String(form.cylinderSerial || raft?.cylinderSerial || ''),
      cylinderCo2: String(form.cylinderCo2 || raft?.cylinderCo2 || ''),
      cylinderN2: String(form.cylinderN2 || raft?.cylinderN2 || ''),
      cylinderHydroTestDate: String(form.cylinderDataTeste || raft?.cylinderDataTeste || ''),
      packType: String(form.packType || raft?.packType || ''),
      hruReference: String(form.hruReferencia || raft?.hruReferencia || raft?.shipDetails?.hruReferencia || ''),
      hruExpiry: String(form.hruValidade || raft?.hruValidade || raft?.shipDetails?.hruValidade || ''),
      radarReflector: String(form.radarReflector || raft?.radarReflector || raft?.shipDetails?.radarReflector || ''),
      radarReflectorExpiry: String(form.radarReflectorValidade || raft?.radarReflectorValidade || raft?.shipDetails?.radarReflectorValidade || ''),
      technician: String(ultimaInspecao?.responsavel || ''),
      status: String(ultimaInspecao?.status || 'Concluída'),
      checklist: checklistWithTests,
    };
  };

  const fetchOreyCertificateWorkbook = async () => {
    const payload = certificatePayload || buildOreyCertificatePayload();
    const response = await fetch('/api/certificados/orey?format=xlsx', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (!response.ok) {
      throw new Error('Falha ao descarregar o certificado Orey.');
    }

    const blob = await response.blob();
    const fileName = response.headers.get('Content-Disposition')?.match(/filename="?([^";]+)"?/)?.[1] || certificatePreviewName;
    return { blob, fileName };
  };

  const downloadOreyCertificateWorkbook = async () => {
    const { blob, fileName } = await fetchOreyCertificateWorkbook();
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = fileName;
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
    URL.revokeObjectURL(url);
  };

  const openOreyCertificateExcel = async () => {
    setGeneratingCertificate(true);
    try {
      const { blob } = await fetchOreyCertificateWorkbook();
      const url = URL.createObjectURL(blob);
      const opened = window.open(url, '_blank', 'noopener,noreferrer');

      if (!opened) {
        URL.revokeObjectURL(url);
        throw new Error('Popup bloqueado ao abrir o Excel.');
      }

      setTimeout(() => URL.revokeObjectURL(url), 60000);
    } catch (error) {
      console.error('Erro ao abrir certificado Excel:', error);
      alert('Não foi possível abrir o certificado Excel. Vou deixar-te usar o botão de gerar/download do Excel.');
    } finally {
      setGeneratingCertificate(false);
    }
  };

  const generateOreyCertificateExcel = async () => {
    setGeneratingCertificate(true);
    try {
      await downloadOreyCertificateWorkbook();
    } catch (error) {
      console.error('Erro ao gerar certificado Excel:', error);
      alert('Não foi possível gerar o certificado Excel desta jangada.');
    } finally {
      setGeneratingCertificate(false);
    }
  };

  const buildQuadroPayload = () => {
    const certNumber = String(
      form.ultimoCertificadoNumero ||
      raft?.ultimoCertificadoNumero ||
      certificadoPreferencial?.certificadoNumero ||
      ultimaInspecao?.certificadoNumero ||
      'SEM-NUMERO'
    ).trim();
    const inspectionDate = String(form.dataInspecao || raft?.dataInspecao || certificadoPreferencial?.dataInspecao || ultimaInspecao?.dataInspecao || '');
    const selectedShip = resolveSelectedShip(form) || resolveSelectedShip(raft);
    const checklistDefaults = buildChecklistInitialValues(inspectionChecklistSections, checklistRaftInput as any);
    const certificateChecklistSnapshot = buildCertificateChecklistSnapshot({
      raft,
      form,
      latestInspection: ultimaInspecao,
      latestInspectionArticles: ultimaInspecaoArtigos,
      activeCertificate: certificadoPreferencial,
    });
    const mergedChecklist: Record<string, string | number | boolean> = {
      ...checklistDefaults,
      ...certificateChecklistSnapshot,
      ...inspectionChecklistValues,
    };
    const primaryClosureEntry = contentorClosureBundle.exactMatches[0] || contentorClosureBundle.familyMatches[0] || null;
    const closureQuantity = primaryClosureEntry?.strapQuantity;
    const closureReferenceCandidates = [
      primaryClosureEntry?.stockReference,
      primaryClosureEntry?.completePartNumber,
      primaryClosureEntry?.upperPartNumber,
      primaryClosureEntry?.lowerPartNumber,
      primaryClosureEntry?.strapPartNumber,
      primaryClosureEntry?.sealPartNumber,
    ]
      .map((value) => String(value || '').trim())
      .filter(Boolean);
    const closureStockItem = closureReferenceCandidates
      .map((reference) => normalizeReference(reference))
      .map((reference) => stockMapByReferencia[reference] || stockMapByCodigoFabricante[reference])
      .find(Boolean);
    const closureReference = String(
      closureStockItem?.referencia ||
      primaryClosureEntry?.stockReference ||
      primaryClosureEntry?.completePartNumber ||
      primaryClosureEntry?.upperPartNumber ||
      primaryClosureEntry?.lowerPartNumber ||
      primaryClosureEntry?.strapPartNumber ||
      ''
    ).trim();
    const closureText = closureReference
      ? (typeof closureQuantity === 'number' && closureQuantity > 0
          ? `${closureReference} (${closureQuantity})`
          : closureReference)
      : (typeof closureQuantity === 'number' && closureQuantity > 0
          ? `${closureQuantity} cinta${closureQuantity === 1 ? '' : 's'}`
          : '');
    const painterLength = String(
      mergedChecklist['comprimento_retenida'] ||
      form.painterLength ||
      raft?.painterLength ||
      ''
    ).trim();

    return {
      numeroObra: String(form.numeroObra || raft?.numeroObra || ''),
      certNumber,
      inspectionDate,
      nextInspectionDate: String(form.dataProxInspecao || raft?.dataProxInspecao || certificadoPreferencial?.dataProxInspecao || ultimaInspecao?.dataProxInspecao || ''),
      shipName: String(selectedShip?.nome || raft?.shipDetails?.nome || form.shipNameManual || raft?.shipNameManual || ''),
      brand: String(form.brand || raft?.brand || ''),
      raftModel: String(technicalModel?.name || form.model || raft?.model || ''),
      raftCapacity: String(form.capacity || raft?.capacity || ''),
      raftSerial: String(form.serial || raft?.serial || ''),
      manufactureDate: String(form.dataFabrico || raft?.dataFabrico || ''),
      cylinderSerial: String(form.cylinderSerial || raft?.cylinderSerial || ''),
      cylinderGrossWeight: String(form.cylinderPesoBruto || raft?.cylinderPesoBruto || ''),
      cylinderTare: String(form.cylinderTara || raft?.cylinderTara || ''),
      cylinderCo2: String(form.cylinderCo2 || raft?.cylinderCo2 || ''),
      cylinderN2: String(form.cylinderN2 || raft?.cylinderN2 || ''),
      cylinderHydroTestDate: String(form.cylinderDataTeste || raft?.cylinderDataTeste || ''),
      packType: String(form.packType || raft?.packType || ''),
      pressureUnit: String(form.testeWPUnidadePressao || raft?.testeWPUnidadePressao || 'inH2O'),
      tempInitial: String(form.testeWPTemperaturaInicial || raft?.testeWPTemperaturaInicial || ''),
      tempFinal: String(form.testeWPTemperaturaFinal || raft?.testeWPTemperaturaFinal || ''),
      baroInitial: String(form.testeWPPressaoAtmosfericaInicial || raft?.testeWPPressaoAtmosfericaInicial || ''),
      baroFinal: String(form.testeWPPressaoAtmosfericaFinal || raft?.testeWPPressaoAtmosfericaFinal || ''),
      wpStartTime: String(form.testeWPHoraInicio || raft?.testeWPHoraInicio || ''),
      wpEndTime: String(wpDerived.endTime || form.testeWPHoraFim || raft?.testeWPHoraFim || ''),
      wpUpperStart: String(form.testeWPCamaraSuperiorInicio || raft?.testeWPCamaraSuperiorInicio || form.testePressaoCamaraSuperior || raft?.testePressaoCamaraSuperior || ''),
      wpUpperValveOpening: String(form.testeWPCamaraSuperiorAberturaValvula || raft?.testeWPCamaraSuperiorAberturaValvula || ''),
      wpUpperValveClosing: String(form.testeWPCamaraSuperiorFechoValvula || raft?.testeWPCamaraSuperiorFechoValvula || form.testeWPCamaraSuperiorInicio || raft?.testeWPCamaraSuperiorInicio || form.testePressaoCamaraSuperior || raft?.testePressaoCamaraSuperior || ''),
      wpUpperEnd: String(form.testeWPCamaraSuperiorFim || raft?.testeWPCamaraSuperiorFim || ''),
      wpUpperCorrected: String(wpDerived.upper.correctedEndDisplay || ''),
      wpUpperDrop: String(wpDerived.upper.dropDisplay || form.testeWPCamaraSuperiorQueda || raft?.testeWPCamaraSuperiorQueda || ''),
      wpUpperDropPercent: String(wpDerived.upper.dropPercentDisplay || ''),
      wpLowerStart: String(form.testeWPCamaraInferiorInicio || raft?.testeWPCamaraInferiorInicio || form.testePressaoCamaraInferior || raft?.testePressaoCamaraInferior || ''),
      wpLowerValveOpening: String(form.testeWPCamaraInferiorAberturaValvula || raft?.testeWPCamaraInferiorAberturaValvula || ''),
      wpLowerValveClosing: String(form.testeWPCamaraInferiorFechoValvula || raft?.testeWPCamaraInferiorFechoValvula || form.testeWPCamaraInferiorInicio || raft?.testeWPCamaraInferiorInicio || form.testePressaoCamaraInferior || raft?.testePressaoCamaraInferior || ''),
      wpLowerEnd: String(form.testeWPCamaraInferiorFim || raft?.testeWPCamaraInferiorFim || ''),
      wpLowerCorrected: String(wpDerived.lower.correctedEndDisplay || ''),
      wpLowerDrop: String(wpDerived.lower.dropDisplay || form.testeWPCamaraInferiorQueda || raft?.testeWPCamaraInferiorQueda || ''),
      wpLowerDropPercent: String(wpDerived.lower.dropPercentDisplay || ''),
      napTestDone: normalizeTestResult(form.testeNAP || raft?.testeNAP, derivedTestDefaults.testeNAP),
      fsTestDone: normalizeTestResult(form.testeFS || raft?.testeFS, derivedTestDefaults.testeFS),
      giTestDone: normalizeTestResult(form.testeGI || raft?.testeGI, derivedTestDefaults.testeGI),
      loadTestDone: normalizeTestResult(form.testeDL || raft?.testeDL, derivedTestDefaults.testeDL),
      napTestDate: inspectionDate,
      fsTestDate: inspectionDate,
      giTestDate: inspectionDate,
      loadTestDate: inspectionDate,
      contentorClosureText: closureText,
      contentorPainterLength: painterLength,
      checklist: mergedChecklist,
    };
  };

  const generateQuadroExcel = async () => {
    try {
      const response = await fetch('/api/exportar-raft', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(buildQuadroPayload()),
      });

      if (!response.ok) {
        throw new Error('Falha ao gerar quadro de inspeção.');
      }

      const blob = await response.blob();
      const inspectionMonthYear = (() => {
        const raw = String(form.dataInspecao || raft?.dataInspecao || '').trim();
        if (!raw) return '';
        const iso = raw.match(/^(\d{4})-(\d{2})(?:-\d{2})?$/);
        if (iso) return `${iso[2]}/${iso[1]}`;
        const pt = raw.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
        if (pt) return `${String(Number(pt[2])).padStart(2, '0')}/${pt[3]}`;
        return raw;
      })();
      const fileName = response.headers.get('Content-Disposition')?.match(/filename="?([^";]+)"?/)?.[1]
        || `${[String(form.serial || raft?.serial || '').trim(), String(form.brand || raft?.brand || '').trim(), String(form.model || raft?.model || '').trim(), (() => {
          const raw = String(form.capacity || raft?.capacity || '').trim();
          const match = raw.match(/\d+/);
          return match ? `${Number(match[0])}P` : raw;
        })()].filter(Boolean).join(' ').trim() || 'jangada'}${inspectionMonthYear ? ` (${inspectionMonthYear})` : ''}.xlsx`;
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = fileName;
      document.body.appendChild(anchor);
      anchor.click();
      anchor.remove();
      URL.revokeObjectURL(url);
    } catch (error) {
      console.error('Erro ao gerar quadro Excel:', error);
      alert('Não foi possível gerar o quadro Excel desta jangada.');
    }
  };

  const openCertificatePreviewInNewTab = () => {
    if (!certificatePreviewHtml) return;
    const blob = new Blob([certificatePreviewHtml], { type: 'text/html;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    window.open(url, '_blank', 'noopener,noreferrer');
    setTimeout(() => URL.revokeObjectURL(url), 5000);
  };

  const downloadCurrentPreviewHtml = () => {
    if (!certificatePreviewHtml) return;
    const blob = new Blob([certificatePreviewHtml], { type: 'text/html;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = String(certificatePreviewName || 'relatorio_inspecao_moderno.html').replace(/\.xlsx$/i, '.html');
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
    URL.revokeObjectURL(url);
  };

  const openCertificatePreview = async () => {
    setGeneratingCertificate(true);
    try {
      const payload = buildOreyCertificatePayload();
      const response = await fetch('/api/certificados/orey?format=html', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        throw new Error('Falha ao gerar a pré-visualização do certificado Orey.');
      }

      const data = await response.json();
      setCertificatePayload(payload);
  setCertificatePreviewKind('orey');
      setCertificatePreviewHtml(String(data.html || ''));
      setCertificatePreviewName(String(data.fileName || `certificado_${String(form.serial || raft?.serial || 'jangada')}.xlsx`));
      setShowCertificatePreview(true);
    } catch (error) {
      console.error("Erro ao gerar certificado:", error);
      alert("Não foi possível gerar o certificado desta jangada.");
    } finally {
      setGeneratingCertificate(false);
    }
  };

  const openModernInspectionReportPreview = async () => {
    setGeneratingCertificate(true);
    try {
      const payload = buildOreyCertificatePayload();
      const response = await fetch('/api/certificados/survitec-moderno', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        throw new Error('Falha ao gerar a pré-visualização do relatório moderno.');
      }

      const data = await response.json();
      setCertificatePayload(payload);
      setCertificatePreviewKind('survitec-modern');
      setCertificatePreviewHtml(String(data.html || ''));
      setCertificatePreviewName(String(data.fileName || `relatorio_inspecao_moderno_${String(form.serial || raft?.serial || 'jangada')}.html`));
      setShowCertificatePreview(true);
    } catch (error) {
      console.error('Erro ao gerar relatório moderno:', error);
      alert('Não foi possível gerar o relatório de inspeção moderno desta jangada.');
    } finally {
      setGeneratingCertificate(false);
    }
  };

  const obterValidadeUltimaInspecao = (nomeArtigo: string): string | undefined => {
    const target = normalizeText(nomeArtigo || "");
    if (!target) return undefined;
    const found = ultimaInspecaoArtigos.find((art) => {
      const current = normalizeText(art.name || "");
      if (!current) return false;
      return current.includes(target) || target.includes(current);
    });
    return found?.validade;
  };

  const obterValidadeCertificado = (nomeArtigo: string): string | undefined => {
    if (!certificateItemHasManagedValidity(nomeArtigo)) return undefined;

    const candidate = getArticleLinkCandidateForCurrentRaft(nomeArtigo);
    const aliases = [nomeArtigo, ...candidate.aliases].filter(Boolean);
    const certRows = [
      ...(Array.isArray(certificadoPreferencial?.validities) ? certificadoPreferencial.validities : []),
      ...certs2025.flatMap((cert) => (Array.isArray(cert.validities) ? cert.validities : [])),
    ].filter((row) => certificateItemHasManagedValidity(String(row?.item || '')));

    const match = certRows.find((row) => aliases.some((alias) => matchesAnyToken(String(row?.item || ""), [alias])));
    return match?.validade;
  };

  const obterStockItem = (nomeArtigo: string): StockLookupItem | undefined => {
    const target = normalizeText(nomeArtigo || "");
    if (!target) return undefined;

    const candidate = getArticleLinkCandidateForCurrentRaft(nomeArtigo);
    for (const ref of candidate.stockRefs) {
      const stockByMappedRef = stockMapByReferencia[normalizeReference(ref)];
      if (stockByMappedRef) return stockByMappedRef;
    }

    if (
      target.includes("parachute rockets") ||
      target === "paraquedas" ||
      target.includes("foguete paraquedas")
    ) {
      const paraquedas = stockMapByReferencia[normalizeReference("20500023")];
      if (paraquedas) return paraquedas;
    }

    if (
      target.includes("handflares") ||
      target === "fachos de mao" ||
      target === "fachos de mão" ||
      target.includes("facho de mao") ||
      target.includes("facho de mão")
    ) {
      const fachos = stockMapByReferencia[normalizeReference("20500035")];
      if (fachos) return fachos;
    }

    if (
      target.includes("smoke signals") ||
      target === "potes" ||
      target.includes("pote de fumo") ||
      target.includes("potes de fumo")
    ) {
      const potes = stockMapByReferencia[normalizeReference("20500002")]
        || stockMapByReferencia[normalizeReference("PYR-SMOKE-ORANGE")];
      if (potes) return potes;
    }

    if (
      target.includes("food rations") ||
      target === "rations" ||
      target === "racao" ||
      target === "ração" ||
      target.includes("racoes") ||
      target.includes("rações")
    ) {
      for (const ref of FOOD_RATIONS_REFERENCE_CANDIDATES) {
        const racao = stockMapByReferencia[normalizeReference(ref)];
        if (racao) return racao;
      }
    }

    if (
      target === "water" ||
      target === "aguas" ||
      target === "águas" ||
      target.includes("agua") ||
      target.includes("água") ||
      target.includes("water sachets")
    ) {
      for (const ref of DRINKING_WATER_REFERENCE_CANDIDATES) {
        const agua = stockMapByReferencia[normalizeReference(ref)];
        if (agua) return agua;
      }
    }

    if (
      target.includes("first aid kit") ||
      target === "farmacia" ||
      target === "farmácia" ||
      target.includes("primeiros socorros")
    ) {
      const farmacia = stockMapByReferencia[normalizeReference("30202050")];
      if (farmacia) return farmacia;
    }

    if (target.includes("seasickness tablets") || (target.includes("seasickness") && target.includes("tablet"))) {
      const comprimidos = stockMapByReferencia[normalizeReference("30202051")];
      if (comprimidos) return comprimidos;
    }

    const modeloAtual = normalizeText(String(form.model || raft?.model || ""));
    const marcaAtual = normalizeText(String(form.brand || raft?.brand || ""));
    const isSurvivaMkFamily =
      modeloAtual.includes("mkiii") ||
      modeloAtual.includes("mk iii") ||
      modeloAtual.includes("mk3") ||
      modeloAtual.includes("mkiv") ||
      modeloAtual.includes("mk iv") ||
      modeloAtual.includes("mk4") ||
      modeloAtual.includes("lr07") ||
      (marcaAtual.includes("surviva") && (
        modeloAtual.includes("mk iii") ||
        modeloAtual.includes("mkiii") ||
        modeloAtual.includes("mk3") ||
        modeloAtual.includes("mk iv") ||
        modeloAtual.includes("mkiv") ||
        modeloAtual.includes("mk4") ||
        modeloAtual.includes("lr07")
      ));

    // Regra explícita pedida: em Surviva MKIV/LR07, Inside/Top Light and Battery -> RL06 ou RL05
    const isInsideLight = target.includes("inside light") || target.includes("inside light and battery");
    const isTopLight = target.includes("top light") || target.includes("top light and battery");

    if (isSurvivaMkFamily && (isInsideLight || isTopLight)) {
      const preferidas = ["RL06", "RL05", "LGT-RL6-KIT", "LGT-RL5-INT", "LGT-RL5-EXT"];
      for (const ref of preferidas) {
        const stock = stockMapByReferencia[normalizeReference(ref)];
        if (stock) return stock;
      }
    }

    // Try exact match first
    if (stockMapByNome[target]) return stockMapByNome[target];
    // Try partial match
    const entry = Object.entries(stockMapByNome).find(([key]) =>
      key.includes(target) || target.includes(key)
    );
    return entry ? entry[1] : undefined;
  };

  const obterArtigoVerificado = (nomeArtigo: string): { idx: number; art: ArtigoJangada } | undefined => {
    const target = normalizeText(nomeArtigo || "");
    if (!target) return undefined;
    const candidate = getArticleLinkCandidateForCurrentRaft(nomeArtigo);
    const candidateRefs = new Set(
      [...candidate.stockRefs, ...candidate.legacyRefs]
        .map((ref) => normalizeReference(ref))
        .filter(Boolean)
    );
    const candidateAliases = new Set(
      [target, ...candidate.aliases.map((alias) => normalizeText(alias))].filter(Boolean)
    );
    const artigos = normalizeArtigos(form.artigos);
    const idx = artigos.findIndex((art) => {
      const refAtual = normalizeReference(art.referencia || "");
      if (refAtual && candidateRefs.has(refAtual)) return true;
      const current = normalizeText(art.name || "");
      if (!current) return false;

      if (target.includes('pilhas para lanterna') || target.includes('torch batteries')) {
        if (!isTorchBatteriesArticleName(current)) return false;
      }

      if (target === 'lanterna' || target.includes('waterproof torch')) {
        if (!isWaterproofTorchArticleName(current)) return false;
      }

      for (const alias of candidateAliases) {
        if (current.includes(alias) || alias.includes(current)) return true;
      }
      return false;
    });
    if (idx < 0) return undefined;
    return { idx, art: artigos[idx] };
  };

  const sincronizarArtigoObrigatorioComStockPorReferencia = (
    nomeArtigo: string,
    referenciaInput: string,
    artigoAtual?: ArtigoJangada
  ): Partial<ArtigoJangada> => {
    const referenciaNormalizada = normalizeReference(referenciaInput);
    const stock = referenciaNormalizada
      ? stockMapByReferencia[referenciaNormalizada]
        || stockMapByCodigoFabricante[referenciaNormalizada]
        || (referenciaNormalizada === normalizeReference('MK4-0047')
          ? stockMapByReferencia[normalizeReference('30202051')]
          : undefined)
      : undefined;

    if (!stock) {
      return {
        ...artigoAtual,
        name: nomeArtigo,
        referencia: referenciaInput,
      };
    }

    return {
      ...artigoAtual,
      name: nomeArtigo,
      referencia: stock.referencia,
      codigoFabricante: stock.codigoFabricante || artigoAtual?.codigoFabricante,
      validade: artigoAtual?.validade || normalizeMonthYearValue(String(stock.validade || '')) || artigoAtual?.validade,
    };
  };

  const atualizarArtigoVerificado = (
    nomeArtigo: string,
    updates: Partial<ArtigoJangada>,
    explicitReplacementQuantity?: number
  ) => {
    const artigos = [...normalizeArtigos(form.artigos)];
    const existente = obterArtigoVerificado(nomeArtigo);
    const idx = existente?.idx ?? -1;
    const current = idx >= 0 ? artigos[idx] : undefined;
    const nextUpdates = updates.referencia !== undefined
      ? {
          ...updates,
          ...sincronizarArtigoObrigatorioComStockPorReferencia(
            nomeArtigo,
            String(updates.referencia || ''),
            current
          ),
        }
      : updates;
    if (idx >= 0) {
      artigos[idx] = { ...artigos[idx], ...nextUpdates };
    } else {
      artigos.push({ name: nomeArtigo, ...nextUpdates } as ArtigoJangada);
    }
    setForm((f) => {
      const next: FormState = { ...f, artigos };

      const replacementQuantity = Number(explicitReplacementQuantity);
      if (Number.isFinite(replacementQuantity) && replacementQuantity > 0) {
        const replacementKey = buildExplicitReplacementChecklistKey(nomeArtigo);
        if (replacementKey) {
          const currentChecklistValues = normalizeInspectionChecklistValues(next.inspectionChecklistValues);
          next.inspectionChecklistValues = {
            ...currentChecklistValues,
            [replacementKey]: Math.max(1, Math.round(replacementQuantity)),
          };
        }
      }

      scheduleAutosave(next);
      return next;
    });
  };

  const abrirModoInspecao = () => {
    setInspectionWizardStep(0);
    startProtectedEditSession({ inspectionMode: true, section: "checklist" });
  };

  const pausarInspecao = () => {
    persistPausedInspectionDraft({
      savedAt: Date.now(),
      form: buildSavePayload(latestFormRef.current || form),
      inspectionWizardStep,
      activeSection,
      packPriorityFilter,
      contentorPriorityFilter,
    });

    clearEditSessionProtection();
    inspectionWizardAutoPositionedRef.current = false;
    setInspectionMode(false);
    setReplacementPicker(null);
    setEdit(false);
    setActiveSection('geral');
  };

  const continuarInspecaoPausada = () => {
    if (typeof window === 'undefined') return;
    const storageKey = getPausedInspectionStorageKey();
    if (!storageKey) return;

    try {
      const raw = window.localStorage.getItem(storageKey);
      if (!raw) return;

      const parsed = JSON.parse(raw) as PausedInspectionDraft;
      if (!parsed?.form) return;

      const normalizedDraftForm = normalizeRaftResponse(parsed.form);
      setForm(normalizedDraftForm);
      latestFormRef.current = normalizedDraftForm;
      setPackPriorityFilter(parsed.packPriorityFilter === 'critical' ? 'attention' : (parsed.packPriorityFilter || 'all'));
      setContentorPriorityFilter(parsed.contentorPriorityFilter === 'critical' ? 'attention' : (parsed.contentorPriorityFilter || 'all'));
      setInspectionWizardStep(Math.max(0, Number(parsed.inspectionWizardStep || 0)));
      inspectionWizardAutoPositionedRef.current = true;
      startProtectedEditSession({ inspectionMode: true, section: parsed.activeSection || 'checklist' });
    } catch {
      window.localStorage.removeItem(storageKey);
      setPausedInspectionDraftInfo(null);
    }
  };

  useEffect(() => {
    if (!isClient) return;
    if (!id) return;
    if (loading) return;
    if (!raft) return;
    if (edit) return;

    const shouldContinueInspection = searchParams?.get("continueInspection") === "1";
    if (!shouldContinueInspection) return;
    if (!pausedInspectionDraftInfo) return;

    continuarInspecaoPausada();
  }, [isClient, id, loading, raft, edit, searchParams, pausedInspectionDraftInfo]);

  const reporAlteracoesEmEdicao = () => {
    setInspectionMode(false);
    setReplacementPicker(null);
    setForm({ ...raft, artigos: normalizeArtigos(raft?.artigos) });
  };

  const aplicarSubstituicaoStock = (
    nomeArtigo: string,
    artigoSelecionado: ArtigoSelectorSelection,
    technical = false
  ) => {
    const validadeStock = normalizeMonthYearValue(String(artigoSelecionado.validade || ""));
    const referencia = String(artigoSelecionado.referencia || "").trim();
    const codigoFabricante = String(artigoSelecionado.codigoFabricante || "").trim();
    const descricaoStock = String(artigoSelecionado.name || artigoSelecionado.descricao || nomeArtigo).trim();
    const quantidadeSelecionada = Math.max(1, Number.parseInt(String(artigoSelecionado.quantidade || "1"), 10) || 1);

    if (technical) {
      adicionarArtigoDoStock({
        ...artigoSelecionado,
        name: descricaoStock || nomeArtigo,
        referencia,
        codigoFabricante,
        quantidade: String(quantidadeSelecionada),
        validade: validadeStock,
      });
    } else {
      atualizarArtigoVerificado(nomeArtigo, {
        name: nomeArtigo,
        referencia,
        codigoFabricante,
        quantidade: String(quantidadeSelecionada),
        validade: validadeStock,
      }, inspectionMode ? quantidadeSelecionada : undefined);
    }

    setReplacementPicker(null);
  };

  const cilindrosCheiosParaGi = useMemo(() => {
    const unique = new Map<number, StockLookupItem>();
    for (const item of [...Object.values(stockMapByReferencia), ...Object.values(stockMapByCodigoFabricante)]) {
      if (!item?.id || unique.has(item.id)) continue;
      unique.set(item.id, item);
    }

    const currentCylinderRef = normalizeReference(String(form.cylinderSerial || raft?.cylinderSerial || ""));

    return Array.from(unique.values())
      .filter((item) => normalizeText(item.categoria || "") === "cilindros")
      .filter((item) => normalizeText(item.estadoArtigo || "") !== "inativo")
      .filter((item) => Number(item.quantidade || 0) > 0)
      .filter((item) => normalizeText(item.estadoCargaCilindro || "").includes("cheio"))
      .filter((item) => normalizeReference(item.referencia) !== currentCylinderRef)
      .sort((a, b) => String(a.referencia || "").localeCompare(String(b.referencia || ""), "pt-PT"));
  }, [stockMapByReferencia, stockMapByCodigoFabricante, form.cylinderSerial, raft?.cylinderSerial]);

  const aplicarSubstituicaoGi = async (stockItem: StockLookupItem) => {
    if (!id || !canEditJangadaPage) return;
    const referencia = String(stockItem.referencia || "").trim();
    if (!referencia) return;

    const confirmado = window.confirm(`Aplicar substituição GI com o cilindro ${referencia}?`);
    if (!confirmado) return;

    try {
      setGiReplacementSaving(true);
      setAutosaveState("saving");

      const testeHidraulico = String(stockItem.testeHidraulico || "").trim();
      const nextForm = normalizeRaftResponse({
        ...form,
        cylinderSerial: referencia,
        cylinderDataTeste: testeHidraulico || String(form.cylinderDataTeste || raft?.cylinderDataTeste || ""),
        cylinderDataProxTeste: testeHidraulico
          ? addFiveYears(testeHidraulico)
          : String(form.cylinderDataProxTeste || raft?.cylinderDataProxTeste || ""),
      }) as FormState;

      const response = await fetch(`/api/jangadas/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(buildSavePayload(nextForm)),
      });

      if (!response.ok) {
        const message = await response.text().catch(() => "");
        throw new Error(message || "Falha ao aplicar substituição GI.");
      }

      const updated = await response.json().catch(() => null);
      const normalized = normalizeRaftResponse(updated || nextForm);
      setRaft(normalized);
      setForm(normalized);
      latestFormRef.current = normalized;
      lastSavedSnapshotRef.current = snapshotOf(normalized);
      setAutosaveState("saved");
      setTimeout(() => setAutosaveState("idle"), 1200);
    } catch (error) {
      console.error("Erro ao aplicar substituição GI:", error);
      setAutosaveState("error");
      alert("Não foi possível aplicar a substituição GI do cilindro.");
    } finally {
      setGiReplacementSaving(false);
    }
  };

  const handleDeliveredToggle = async (nextDelivered: boolean) => {
    if (!id || !canEditJangadaPage) return;
    if (nextDelivered && !window.confirm('Marcar esta jangada como entregue?')) return;

    try {
      setAutosaveState('saving');

      const response = await fetch(`/api/jangadas/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ delivered: nextDelivered }),
      });

      if (!response.ok) {
        const message = await response.text().catch(() => '');
        throw new Error(message || 'Falha ao atualizar o estado de entrega.');
      }

      const updated = await response.json().catch(() => null);
      const normalized = normalizeRaftResponse(updated || { ...raft, delivered: nextDelivered });
      setRaft(normalized);
      setForm(normalized);
      latestFormRef.current = normalized;
      lastSavedSnapshotRef.current = snapshotOf(normalized);
      setAutosaveState('saved');
      setTimeout(() => setAutosaveState('idle'), 1200);
    } catch (error) {
      console.error('Erro ao atualizar entrega da jangada:', error);
      setAutosaveState('error');
      alert(nextDelivered ? 'Não foi possível marcar a jangada como entregue.' : 'Não foi possível remover o estado de entregue.');
    }
  };

  // Pack calculation (useMemo must be before early returns)
  const packCalcBase = useMemo(() => {
    const packType = String(form.packType || raft?.packType || "").trim();
    const capacidade = Number(form.capacity || raft?.capacity || 0);
    const packNormalizado = packType ? normalizeTechnicalPack(packType) : null;

    return {
      packType,
      capacidade,
      packNormalizado,
    };
  }, [form.packType, form.capacity, raft?.packType, raft?.capacity]);

  const technicalModel = useMemo(() => {
    return findRaftTechnicalModel(
      String(form.brand || raft?.brand || ''),
      String(form.model || raft?.model || '')
    );
  }, [form.brand, form.model, raft?.brand, raft?.model]);

  const canonicalBrandOption = useMemo(() => {
    const currentBrand = normalizeRaftBrandName(form.brand || raft?.brand || '');
    if (!currentBrand) return '';
    return normalizeRaftBrandName(raftBrands.find((brand) => normalizeText(brand) === normalizeText(currentBrand)) || currentBrand);
  }, [form.brand, raft?.brand]);

  const brandFieldOptions = useMemo(() => {
    const currentValue = normalizeRaftBrandName(form.brand || raft?.brand || '');
    return dedupeOptions([
      canonicalBrandOption,
      ...raftBrands.map((brand) => normalizeRaftBrandName(brand)),
      ...Object.keys(raftModels || {}).map((brand) => normalizeRaftBrandName(brand)),
      ...raftBrandModelRows.map((row) => normalizeRaftBrandName(row.brand)),
      currentValue,
    ]);
  }, [canonicalBrandOption, form.brand, raft?.brand, raftBrandModelRows]);

  const allCatalogModelOptions = useMemo(() => {
    const catalog = raftModels as Record<string, string[]>;
    return dedupeOptions(Object.values(catalog).flatMap((models) => models || []));
  }, []);

  const dbModelOptions = useMemo(() => {
    const normalizedSelectedBrand = normalizeText(canonicalBrandOption);
    const scopedRows = normalizedSelectedBrand
      ? raftBrandModelRows.filter((row) => normalizeText(row.brand) === normalizedSelectedBrand)
      : raftBrandModelRows;
    return dedupeOptions(scopedRows.map((row) => String(row.model || '').trim()));
  }, [canonicalBrandOption, raftBrandModelRows]);

  const modelCatalogOptions = useMemo(() => {
    const currentValue = String(form.model || raft?.model || '').trim();
    const catalog = raftModels as Record<string, string[]>;
    const normalizedSelectedBrand = normalizeText(canonicalBrandOption);
    const matchedBrandKey = normalizedSelectedBrand
      ? (Object.keys(catalog).find((brand) => normalizeText(brand) === normalizedSelectedBrand) || '')
      : '';
    const catalogModels = matchedBrandKey
      ? (catalog[matchedBrandKey] || [])
      : allCatalogModelOptions;
    const technicalName = String(technicalModel?.name || '').trim();
    return dedupeOptions([...catalogModels, ...dbModelOptions, technicalName, currentValue]);
  }, [canonicalBrandOption, technicalModel?.name, form.model, raft?.model, allCatalogModelOptions, dbModelOptions]);

  const technicalPackOptions = useMemo(() => {
    if (!technicalModel) return [] as string[];

    const capacity = Number(form.capacity || raft?.capacity || 0);
    const specificationPacks = technicalModel.specifications
      .filter((spec) => !capacity || spec.capacity === capacity)
      .map((spec) => String(spec.pack || '').trim());
    const manualPackOptions = (technicalModel.packEquipment || []).map((entry) => String(entry.pack || '').trim());

    return dedupeOptions([...specificationPacks, ...manualPackOptions, ...(technicalModel.packTypes || [])]);
  }, [technicalModel, form.capacity, raft?.capacity]);

  const dbPackTypeOptions = useMemo(() => {
    return getRecognizedPackTypeOptions(raftBrandModelRows.map((row) => String(row.packType || '').trim()));
  }, [raftBrandModelRows]);

  const technicalLaunchOptions = useMemo(() => {
    return extractLaunchTypeOptions(technicalModel?.configuration);
  }, [technicalModel?.configuration]);

  const isLr97TechnicalFamily = useMemo(() => {
    const currentModel = normalizeText(String(technicalModel?.name || form.model || raft?.model || ''));
    return currentModel.includes('lr97');
  }, [technicalModel?.name, form.model, raft?.model]);

  const technicalContainerOptions = useMemo(() => {
    const packValue = normalizeTechnicalPack(String(form.packType || raft?.packType || ''));
    const capacityValue = Number(form.capacity || raft?.capacity || 0);
    const technicalOptions = extractSlashSeparatedOptions(technicalModel?.containerModel);

    if (isLr97TechnicalFamily) {
      const key = `${packValue}:${capacityValue}`;
      const preferred = LR97_CONTAINER_BY_PACK_AND_CAPACITY[key] || [];
      return dedupeOptions([...preferred, ...LR97_CONTAINER_OPTIONS, ...technicalOptions]);
    }

    return dedupeOptions(technicalOptions);
  }, [technicalModel?.containerModel, isLr97TechnicalFamily, form.packType, raft?.packType, form.capacity, raft?.capacity]);

  const technicalInflationOptions = useMemo(() => {
    return dedupeOptions([
      String(technicalModel?.keyTechnicalData?.inflationSystem || '').trim(),
      ...((technicalModel?.inflationSystem || []).map((item) => String(item || '').trim())),
    ]);
  }, [technicalModel]);

  const technicalCylinderSpec = useMemo(() => {
    const capacity = Number(form.capacity || raft?.capacity || 0);
    const selectedPack = String(form.packType || raft?.packType || '');
    if (!technicalModel || !capacity) return null;
    return technicalModel.specifications.find((spec) => (
      spec.capacity === capacity && matchesTechnicalSpecPack(spec.pack, selectedPack)
    )) || technicalModel.specifications.find((spec) => spec.capacity === capacity) || null;
  }, [technicalModel, form.capacity, raft?.capacity, form.packType, raft?.packType]);

  const technicalPackEquipment = useMemo(() => {
    const selectedPack = String(form.packType || raft?.packType || '');
    if (!technicalModel?.packEquipment?.length) return null;

    const selectedPackNormalized = normalizeTechnicalPack(selectedPack);
    if (selectedPackNormalized) {
      return technicalModel.packEquipment.find((entry) => matchesTechnicalPack(entry.pack, selectedPackNormalized)) || null;
    }

    return technicalModel.packEquipment.find((entry) => matchesTechnicalPack(entry.pack, packCalcBase.packNormalizado || ''))
      || null;
  }, [technicalModel, form.packType, raft?.packType, packCalcBase.packNormalizado]);

  const packTypeOptions = useMemo(() => {
    const currentValue = String(form.packType || raft?.packType || '').trim();
    const lr97Options = isLr97TechnicalFamily ? [...LR97_PACK_OPTIONS] : [];
    return getRecognizedPackTypeOptions([
      ...availablePackTypeOptions,
      ...dbPackTypeOptions,
      ...ALL_PACK_TYPE_OPTIONS,
      ...technicalPackOptions,
      ...lr97Options,
      currentValue,
    ]);
  }, [availablePackTypeOptions, dbPackTypeOptions, technicalPackOptions, form.packType, raft?.packType, isLr97TechnicalFamily]);

  const launchTypeOptions = useMemo(() => {
    const currentValue = normalizeLaunchTypeValue(String(form.launchType || raft?.launchType || ''));
    return dedupeOptions([...technicalLaunchOptions, currentValue || '']);
  }, [technicalLaunchOptions, form.launchType, raft?.launchType]);

  const fabricTypeOptions = useMemo(() => {
    const currentValue = String(form.fabricType || raft?.fabricType || '').trim();
    const technicalMaterial = String(technicalModel?.material || '').trim();
    const lr97Options = isLr97TechnicalFamily ? [...LR97_FABRIC_TYPE_OPTIONS] : [];
    return dedupeOptions([technicalMaterial, ...lr97Options, currentValue]);
  }, [form.fabricType, raft?.fabricType, technicalModel?.material, isLr97TechnicalFamily]);

  const painterLengthOptions = useMemo(() => {
    const currentValue = String(form.painterLength || raft?.painterLength || '').trim();
    const lr97Options = isLr97TechnicalFamily ? [...LR97_PAINTER_LENGTH_OPTIONS] : [];
    return dedupeOptions([...GLOBAL_PAINTER_LENGTH_OPTIONS, ...lr97Options, currentValue]).filter(
      (option) => !isDeprecatedPainterLengthOption(option)
    );
  }, [form.painterLength, raft?.painterLength, isLr97TechnicalFamily]);

  const containerFieldOptions = useMemo(() => {
    const currentValue = String(form.containerModel || raft?.containerModel || '').trim();
    return dedupeOptions([...technicalContainerOptions, currentValue]);
  }, [form.containerModel, raft?.containerModel, technicalContainerOptions]);

  const inflationSystemOptions = useMemo(() => {
    const options = new Set<string>();
    const currentValue = String(form.cylinderSistema || raft?.cylinderSistema || '').trim();

    if (currentValue) options.add(currentValue);
    for (const value of technicalInflationOptions) {
      if (value) options.add(value);
    }

    for (const fallback of FALLBACK_INFLATION_SYSTEM_OPTIONS) {
      if (options.size >= 12) break;
      options.add(fallback);
    }

    return Array.from(options);
  }, [form.cylinderSistema, raft?.cylinderSistema, technicalInflationOptions]);

  const technicalHeadItems = useMemo(() => {
    return (technicalModel?.serviceItems || []).filter((item) => {
      const text = normalizeStockSelectorText(`${item.name} ${item.reference || ''} ${item.notes || ''}`);
      return STOCK_HEAD_KEYWORDS.some((keyword) => text.includes(keyword));
    });
  }, [technicalModel]);

  const firingHeadOptions = useMemo(() => {
    const options = new Map<string, { referencia: string; descricao: string; codigoFabricante: string }>();

    const currentRef = String(form.cylinderCabecaDisparoRef || raft?.cylinderCabecaDisparoRef || '').trim();
    const currentDesc = String(form.cylinderCabecaDisparoDescricao || raft?.cylinderCabecaDisparoDescricao || '').trim();
    if (currentRef) {
      options.set(currentRef, {
        referencia: currentRef,
        descricao: currentDesc || currentRef,
        codigoFabricante: currentRef,
      });
    }

    for (const item of technicalHeadItems) {
      const referencia = String(item.reference || '').trim();
      if (!referencia) continue;
      const stockItem = stockMapByReferencia[normalizeReference(referencia)] || stockMapByCodigoFabricante[normalizeReference(referencia)];
      options.set(referencia, {
        referencia,
        descricao: stockItem?.descricao || item.name,
        codigoFabricante: stockItem?.codigoFabricante || referencia,
      });
    }

    return Array.from(options.values());
  }, [form.cylinderCabecaDisparoRef, form.cylinderCabecaDisparoDescricao, raft?.cylinderCabecaDisparoRef, raft?.cylinderCabecaDisparoDescricao, technicalHeadItems, stockMapByReferencia, stockMapByCodigoFabricante]);

  const technicalTubeItems = useMemo(() => {
    return (technicalModel?.serviceItems || []).filter((item) => {
      const text = normalizeStockSelectorText(`${item.name} ${item.reference || ''} ${item.notes || ''}`);
      return STOCK_TUBE_KEYWORDS.some((keyword) => text.includes(keyword));
    });
  }, [technicalModel]);

  const mandatoryPackChecklistItems = useMemo(() => {
    if (Array.isArray(resolvedMandatoryPackItems)) {
      return resolvedMandatoryPackItems;
    }

    return getMandatoryPackItemsForRaft({
      brand: String(form.brand || raft?.brand || '').trim(),
      model: String(form.model || raft?.model || '').trim(),
      packType: String(form.packType || raft?.packType || '').trim(),
      capacity: Number(form.capacity || raft?.capacity || 0) || undefined,
    });
  }, [resolvedMandatoryPackItems, form.brand, raft?.brand, form.model, raft?.model, form.packType, raft?.packType, form.capacity, raft?.capacity]);

  const packCalc = useMemo(() => {
    const { packType, capacidade, packNormalizado } = packCalcBase;

    return {
      packType,
      capacidade,
      packNormalizado,
      artigosObrigatorios: buildMandatoryPackRows(mandatoryPackChecklistItems),
      resumo: buildMandatoryPackSummary(mandatoryPackChecklistItems),
      source: technicalPackEquipment?.items?.length ? ('manual' as const) : ('template' as const),
    };
  }, [packCalcBase, mandatoryPackChecklistItems, technicalPackEquipment]);

  const packChecklistActionMap = useMemo(() => {
    const inspectionReferenceDate = String(form.dataInspecao || raft?.dataInspecao || ultimaInspecao?.dataInspecao || '').trim();
    const categoryOrder = [
      'SINALIZAÇÃO',
      'ILUMINAÇÃO',
      'RAFT',
      'EQUIPAMENTO',
      'PRIMEIROS SOCORROS',
      'CONSUMÍVEIS',
      'SOBREVIVÊNCIA',
      'OUTROS',
    ];

    const sortedResumoEntries = Object.entries(packCalc.resumo).sort(([categoriaA], [categoriaB]) => {
      const idxA = categoryOrder.indexOf(categoriaA);
      const idxB = categoryOrder.indexOf(categoriaB);
      const normalizedIdxA = idxA === -1 ? Number.MAX_SAFE_INTEGER : idxA;
      const normalizedIdxB = idxB === -1 ? Number.MAX_SAFE_INTEGER : idxB;
      if (normalizedIdxA !== normalizedIdxB) return normalizedIdxA - normalizedIdxB;
      return categoriaA.localeCompare(categoriaB, 'pt-PT');
    });

    const packRows = sortedResumoEntries.flatMap(([categoria, artigos]) =>
      artigos.map((artigoObrig: any, originalRowIdx: number) => ({ categoria, artigoObrig, originalRowIdx }))
    );

    return mandatoryPackChecklistItems.reduce<Record<string, {
      articleName: string;
      rowKey: string | null;
      priority: 'critical' | 'attention' | 'missing' | 'done';
      defaultBusca: string;
    }>>((acc, packItem) => {
      const matchedRow = packRows.find((row) => findMatchingArticleForPackItem(packItem, [{ name: row.artigoObrig?.nome }])) || null;
      const articleName = String(matchedRow?.artigoObrig?.nome || packItem.label || packItem.technicalName || '').trim();
      const articleHasManagedValidity = certificateItemHasManagedValidity(articleName);
      const verificado = articleName ? obterArtigoVerificado(articleName) : undefined;
      const stockItem = articleName ? obterStockItem(articleName) : undefined;
      const fixedReference = articleName ? getFixedReferenceForArticleName(articleName) : undefined;
      const preferredStockReference = articleName ? getPreferredStockReferenceForArticleName(articleName) : undefined;
      const referenciaVerificada = String(verificado?.art?.referencia || '').trim();
      const refStock = referenciaVerificada || preferredStockReference || fixedReference || stockItem?.referencia || '';
      const thumbRef = normalizeReference(String(refStock || ''));
      const stockMetaByRef = thumbRef
        ? (stockMapByReferencia[thumbRef] || stockMapByCodigoFabricante[thumbRef])
        : undefined;
      const matchedStockMeta = stockMetaByRef || stockItem;
      const validadeUltima = articleName && articleHasManagedValidity ? obterValidadeUltimaInspecao(articleName) : undefined;
      const validadeCertificado = articleName && articleHasManagedValidity ? obterValidadeCertificado(articleName) : undefined;
      const stockValidity = articleHasManagedValidity ? normalizeMonthYearValue(String(matchedStockMeta?.validade || '')) : '';
      const validadeVerif = articleHasManagedValidity
        ? (verificado?.art?.validade || validadeCertificado || validadeUltima || stockValidity)
        : '';
      const temVerificado = !!verificado;
      const validadeCurta = articleHasManagedValidity ? expiresWithinMonths(validadeVerif, 12, inspectionReferenceDate || undefined) : false;
      const stockQuantidade = typeof matchedStockMeta?.quantidade === 'number' ? matchedStockMeta.quantidade : null;
      const stockQuantidadeMinima = typeof matchedStockMeta?.quantidadeMinima === 'number' ? matchedStockMeta.quantidadeMinima : null;
      const stockEmpty = stockQuantidade !== null && stockQuantidade <= 0;
      const stockBelowMinimum = stockQuantidade !== null && stockQuantidadeMinima !== null && stockQuantidade <= stockQuantidadeMinima;
      const hasSubstituicaoBoletim =
        normalizeText(String(matchedStockMeta?.estadoArtigo || '')).includes('substituid') &&
        String(matchedStockMeta?.referenciaSubstituta || '').trim().length > 0;
      const validadeExpirada = articleHasManagedValidity ? isExpiredMonthYear(validadeVerif, inspectionReferenceDate || undefined) : false;

      let priority: 'critical' | 'attention' | 'missing' | 'done' = 'done';
      if (hasSubstituicaoBoletim || (inspectionMode && validadeExpirada) || stockEmpty) {
        priority = 'critical';
      } else if ((inspectionMode && validadeCurta) || stockBelowMinimum) {
        priority = 'attention';
      } else if (!temVerificado) {
        priority = 'missing';
      }

      acc[packItem.checklistName] = {
        articleName: articleName || packItem.label,
        rowKey: matchedRow ? `required:${matchedRow.categoria}:${String(matchedRow.artigoObrig?.nome || '').trim()}:${matchedRow.originalRowIdx}` : null,
        priority,
        defaultBusca: refStock || articleName || packItem.label,
      };
      return acc;
    }, {});
  }, [mandatoryPackChecklistItems, packCalc.resumo, inspectionMode, form.artigos, form.dataInspecao, raft?.dataInspecao, ultimaInspecao?.dataInspecao, stockMapByReferencia, stockMapByCodigoFabricante]);

  const openPackReplacementFromChecklist = (field: ChecklistField) => {
    if (!field.packItem) return;

    const packAction = packChecklistActionMap[field.packItem.checklistName];
    setActiveSection('pack');

    if (packAction?.priority && packAction.priority !== 'done') {
      setPackPriorityFilter(packAction.priority === 'critical' ? 'attention' : packAction.priority);
    }

    if (!packAction?.rowKey) {
      setReplacementPicker(null);
      window.setTimeout(() => {
        sectionRefs.current.pack?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 60);
      return;
    }

    setPackRowFocusKey(packAction.rowKey);
    setReplacementPicker({
      key: packAction.rowKey,
      articleName: packAction.articleName,
      defaultBusca: packAction.defaultBusca,
    });

    window.setTimeout(() => {
      sectionRefs.current.pack?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => {
        packRowRefs.current[packAction.rowKey!]?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 180);
    }, 80);
  };

  useEffect(() => {
    if (!packRowFocusKey) return;
    const timer = window.setTimeout(() => setPackRowFocusKey(null), 4500);
    return () => window.clearTimeout(timer);
  }, [packRowFocusKey]);

  useEffect(() => {
    if (!technicalModel) return;

    setForm((prev: FormState) => {
      const next: FormState = { ...prev };
      let changed = false;

      const currentBrand = String(prev.brand || '').trim();
      const currentModel = String(prev.model || '').trim();
      const normalizedCurrentModel = normalizeText(currentModel);
      const normalizedTechnicalModel = normalizeText(String(technicalModel.name || ''));
      const matchedAlias = normalizedCurrentModel
        ? (technicalModel.aliases || []).some((alias) => normalizeText(alias) === normalizedCurrentModel)
        : false;

      if (canonicalBrandOption && normalizeText(currentBrand) !== normalizeText(canonicalBrandOption)) {
        next.brand = canonicalBrandOption;
        changed = true;
      }

      if ((!currentModel && technicalModel.name) || matchedAlias) {
        next.model = technicalModel.name;
        changed = true;
      }

      const currentPack = String(prev.packType || '').trim();
      if (!currentPack && technicalPackOptions.length === 1) {
        next.packType = technicalPackOptions[0];
        changed = true;
      }

      const currentLaunch = normalizeLaunchTypeValue(String(prev.launchType || ''));
      if ((!currentLaunch || !technicalLaunchOptions.includes(currentLaunch)) && technicalLaunchOptions.length === 1) {
        next.launchType = technicalLaunchOptions[0];
        changed = true;
      }

      const currentFabric = String(prev.fabricType || '').trim();
      const technicalMaterial = String(technicalModel.material || '').trim();
      if (technicalMaterial && !currentFabric) {
        next.fabricType = technicalMaterial;
        changed = true;
      }

      const currentContainer = String(prev.containerModel || '').trim();
      if ((!currentContainer || !technicalContainerOptions.includes(currentContainer)) && technicalContainerOptions.length === 1) {
        next.containerModel = technicalContainerOptions[0];
        changed = true;
      }

      const currentInflationSystem = String(prev.cylinderSistema || '').trim();
      if ((!currentInflationSystem || !technicalInflationOptions.includes(currentInflationSystem)) && technicalInflationOptions.length === 1) {
        next.cylinderSistema = technicalInflationOptions[0];
        changed = true;
      }

      if (!changed) return prev;
      if (normalizedCurrentModel && normalizedCurrentModel === normalizedTechnicalModel && normalizeText(currentBrand) === normalizeText(String(next.brand || ''))) {
        const unchangedPack = String(prev.packType || '') === String(next.packType || '');
        const unchangedLaunch = String(prev.launchType || '') === String(next.launchType || '');
        const unchangedFabric = String(prev.fabricType || '') === String(next.fabricType || '');
        const unchangedContainer = String(prev.containerModel || '') === String(next.containerModel || '');
        const unchangedInflation = String(prev.cylinderSistema || '') === String(next.cylinderSistema || '');
        if (unchangedPack && unchangedLaunch && unchangedFabric && unchangedContainer && unchangedInflation) {
          return prev;
        }
      }

      return next;
    });
  }, [
    edit,
    technicalModel,
    canonicalBrandOption,
    technicalPackOptions,
    technicalLaunchOptions,
    technicalContainerOptions,
    technicalInflationOptions,
  ]);

  useEffect(() => {
    const brandAtual = normalizeText(String(form.brand || raft?.brand || ""));
    const modelAtual = normalizeText(String(form.model || raft?.model || ""));
    const isAutoSyncBrand =
      brandAtual.includes("sea safe") ||
      brandAtual.includes("plastimo") ||
      brandAtual.includes("surviva") ||
      brandAtual.includes("rfd") ||
      brandAtual.includes("dsb") ||
      modelAtual.includes("mkiii") ||
      modelAtual.includes("mk iii") ||
      modelAtual.includes("mk3") ||
      modelAtual.includes("mkiv") ||
      modelAtual.includes("mk iv") ||
      modelAtual.includes("mk4") ||
      modelAtual.includes("lr07");
    if (!isAutoSyncBrand || !id) return;
    if (!Object.keys(stockMapByReferencia).length) return;

    const artigos = normalizeArtigos(form.artigos);
    if (!artigos.length) return;

    const nextArtigos = artigos.map((art) => {
      const nomeArtigo = String(art.name || "").trim();
      if (!nomeArtigo) return art;

      const candidate = getArticleLinkCandidateForCurrentRaft(nomeArtigo);
      if (!candidate.stockRefs.length) return art;

      const preferredRef = candidate.stockRefs.find((ref) => stockMapByReferencia[normalizeReference(ref)]);
      if (!preferredRef) return art;

      const preferredStock = stockMapByReferencia[normalizeReference(preferredRef)];
      const currentRefNorm = normalizeReference(art.referencia || "");
      const preferredRefNorm = normalizeReference(preferredRef);
      const legacyRefs = new Set(candidate.legacyRefs.map((ref) => normalizeReference(ref)));
      const stockRefs = new Set(candidate.stockRefs.map((ref) => normalizeReference(ref)));

      const shouldReplaceRef =
        !currentRefNorm ||
        legacyRefs.has(currentRefNorm) ||
        (!stockRefs.has(currentRefNorm) && !stockMapByReferencia[currentRefNorm]);

      let changed = false;
      const next = { ...art };

      if (shouldReplaceRef && currentRefNorm !== preferredRefNorm) {
        next.referencia = preferredRef;
        changed = true;
      }

      if (!String(art.codigoFabricante || "").trim() && preferredStock?.codigoFabricante) {
        next.codigoFabricante = preferredStock.codigoFabricante;
        changed = true;
      }

      return changed ? next : art;
    });

    const changed = nextArtigos.some((art, idx) => (
      String(art.referencia || "") !== String(artigos[idx]?.referencia || "") ||
      String(art.codigoFabricante || "") !== String(artigos[idx]?.codigoFabricante || "")
    ));

    if (!changed) return;

    const desiredSignature = JSON.stringify(
      nextArtigos.map((art) => [art.name || "", art.referencia || "", art.codigoFabricante || ""])
    );

    if (packStockSyncSignatureRef.current === desiredSignature) return;

    let cancelled = false;

    const persist = async () => {
      try {
        const payload: FormState = { ...form, artigos: nextArtigos };
        const response = await fetch(`/api/jangadas/${id}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(buildSavePayload(payload)),
        });

        if (!response.ok || cancelled) return;

        const updated = await response.json().catch(() => null);
        const normalized = updated
          ? normalizeRaftResponse(updated)
          : normalizeRaftResponse(payload);

        packStockSyncSignatureRef.current = desiredSignature;
        setRaft(normalized as FormState);
        setForm(normalized);
        lastSavedSnapshotRef.current = snapshotOf(normalized);
      } catch {
        // Ignorar falhas silenciosamente para não bloquear a ficha
      }
    };

    persist();

    return () => {
      cancelled = true;
    };
  }, [
    id,
    form,
    form.artigos,
    form.brand,
    raft?.brand,
    stockMapByReferencia,
  ]);

  const selectedContainerModel = String(form.containerModel || raft?.containerModel || "").trim();
  const isEurovinilFicha = isEurovinilRaft(String(form.brand || raft?.brand || ""), String(form.model || raft?.model || ""));
  const selectedPackBucket = getPackBucket(String(form.packType || raft?.packType || ""));
  const formArticles = useMemo(() => normalizeArtigos(form.artigos), [form.artigos]);
  type ContentorSuggestionItem = {
    key: string;
    title: string;
    articleName: string;
    references: string[];
    searchTerms: string[];
    notes?: string;
    sourceLabel: string;
    quantity: number;
    stockItem: StockLookupItem | null;
    present: boolean;
    alwaysReplaceOnService: boolean;
  };
  const selectedContainerSpecs = useMemo(() => {
    const containerKey = normalizeContainerModel(form.containerModel || raft?.containerModel);
    const capacityKey = getContainerCapacityKey(form.containerModel || raft?.containerModel, form.capacity || raft?.capacity);
    const packBucket = getPackBucket(String(form.packType || raft?.packType || ""));
    if (!containerKey || !capacityKey || !packBucket) return [] as ContainerDimensionSpec[];
    return MANUAL_CONTAINER_SPECS.filter((spec) => (
      spec.containerKey === containerKey && spec.capacityKey === capacityKey && spec.pack === packBucket
    ));
  }, [form.containerModel, raft?.containerModel, form.capacity, raft?.capacity, form.packType, raft?.packType]);
  const currentCapacity = normalizeCapacityValue(form.capacity || raft?.capacity) || 0;
  const currentPackTechnicalLabel = String(packCalc.packNormalizado || form.packType || raft?.packType || "").trim();
  const currentPackLabel = String(form.packType || raft?.packType || packCalc.packNormalizado || "").trim();
  const currentContainerLabel = String(form.containerModel || raft?.containerModel || "").trim();
  const currentBrandLabel = String(form.brand || raft?.brand || '').trim();
  const currentModelLabel = String(technicalModel?.name || form.model || raft?.model || '').trim();
  const isSeasavaPlusFicha = isSeasavaPlusLikeModel(currentModelLabel);
  const isValiseContainer = normalizeText(currentContainerLabel).includes('valise');
  const isExplicitEurovinilContentor = normalizeText(currentContainerLabel) === 'contentor';
  const packagingSectionTitle = isValiseContainer ? 'Saco / Valise' : 'Contentor';
  const packagingClosureFieldName = isValiseContainer ? 'fecho_valise_ok' : 'cinta_fecho';
  const packagingLabel = isValiseContainer ? 'Valise' : 'Contentor';
  const packagingLabelLower = isValiseContainer ? 'valise' : 'contentor';
  const vacuumBagShouldBeRecommended = isValiseContainer || isVacuumBagTargetBrand(currentBrandLabel);
  const manualVacuumBagReferenceOptions = useMemo(() => {
    const refs = new Set<string>();
    const pushRefs = (raw?: string | null) => {
      splitReferenceCandidates(raw).forEach((entry) => {
        if (entry && entry !== '—') refs.add(entry);
      });
    };

    const technicalItems = [
      ...(technicalModel?.serviceItems || []),
      ...(technicalModel?.spareParts || []),
    ];

    technicalItems.forEach((item) => {
      const haystack = normalizeText(`${item.name || ''} ${item.notes || ''}`);
      const hasVacuumSignal =
        haystack.includes('vacuum bag') ||
        haystack.includes('saco de vacuo') ||
        (haystack.includes('vacuum') && haystack.includes('bag'));
      if (!hasVacuumSignal) return;
      pushRefs(String(item.reference || ''));
    });

    // Reforço explícito do mapeamento de manual para OCEAN SAFETY
    if (normalizeText(currentBrandLabel).includes('ocean safety')) {
      refs.add('OSL0142');
      refs.add('OSL0513');
    }

    return Array.from(refs).sort((a, b) => a.localeCompare(b, 'pt-PT'));
  }, [technicalModel, currentBrandLabel]);
  const vacuumBagRequiredValue = String(inspectionChecklistValues.contentor_saco_vacuo || '').toUpperCase();
  const vacuumBagReferenceValue = String(inspectionChecklistValues.contentor_saco_vacuo_ref || '').trim();
  const hasKnownVacuumBagReference = manualVacuumBagReferenceOptions.includes(vacuumBagReferenceValue);
  const currentInflationSystemLabel = String(form.cylinderSistema || raft?.cylinderSistema || "").trim();
  const contentorClosureBundle = useMemo(() => getContainerClosureMatchBundle({
    brand: String(form.brand || raft?.brand || ''),
    model: technicalModel?.name || String(form.model || raft?.model || ''),
    containerModel: currentContainerLabel,
    capacity: currentCapacity,
    launchType: String(form.launchType || raft?.launchType || ''),
    packType: String(form.packType || raft?.packType || ''),
    maxStowageHeight: String(form.maxStowageHeight || raft?.maxStowageHeight || ''),
  }), [form.brand, raft?.brand, technicalModel?.name, form.model, raft?.model, currentContainerLabel, currentCapacity, form.launchType, raft?.launchType, form.packType, raft?.packType, form.maxStowageHeight, raft?.maxStowageHeight]);
  const contentorPrimaryClosureEntry = useMemo(() => {
    return contentorClosureBundle.exactMatches[0] || contentorClosureBundle.familyMatches[0] || null;
  }, [contentorClosureBundle]);
  const contentorSizeLabel = contentorPrimaryClosureEntry?.size ? `Size ${contentorPrimaryClosureEntry.size}` : '—';
  const contentorManualConfigurationLabel = contentorPrimaryClosureEntry
    ? [
        contentorPrimaryClosureEntry.launchType,
        contentorPrimaryClosureEntry.maxStowedHeightMeters ? `até ${contentorPrimaryClosureEntry.maxStowedHeightMeters} m` : '',
        formatContainerClosureCapacities(contentorPrimaryClosureEntry),
      ].filter(Boolean).join(' · ')
    : '—';
  const contentorManualReferenceLabel = contentorPrimaryClosureEntry?.completePartNumber
    || contentorPrimaryClosureEntry?.strapPartNumber
    || contentorPrimaryClosureEntry?.stockReference
    || '—';
  const contentorClosureStockItem = useMemo(() => {
    if (!contentorPrimaryClosureEntry) return null;

    const referenceCandidates = [
      contentorPrimaryClosureEntry.stockReference,
      contentorPrimaryClosureEntry.completePartNumber,
      contentorPrimaryClosureEntry.upperPartNumber,
      contentorPrimaryClosureEntry.lowerPartNumber,
      contentorPrimaryClosureEntry.strapPartNumber,
      contentorPrimaryClosureEntry.sealPartNumber,
    ]
      .map((value) => normalizeReference(String(value || '')))
      .filter(Boolean);

    for (const reference of referenceCandidates) {
      const stockItem = stockMapByReferencia[reference] || stockMapByCodigoFabricante[reference];
      if (stockItem) return stockItem;
    }

    return null;
  }, [contentorPrimaryClosureEntry, stockMapByReferencia, stockMapByCodigoFabricante]);
  const shouldShowContentorClosureHighlight = !isValiseContainer && (!isEurovinilFicha || isExplicitEurovinilContentor) && Boolean(contentorPrimaryClosureEntry);
  const contentorClosureReferenceSummary = contentorPrimaryClosureEntry
    ? [
        contentorPrimaryClosureEntry.stockReference,
        contentorPrimaryClosureEntry.completePartNumber,
        contentorPrimaryClosureEntry.strapPartNumber,
      ]
        .map((value) => String(value || '').trim())
        .filter(Boolean)
        .filter((value, index, array) => array.indexOf(value) === index)
        .join(' · ')
    : '';
  const painterLengthDisplay = normalizePainterLengthDisplay(String(form.painterLength || raft?.painterLength || '')) || '—';
  const latestEvidencePreview = useMemo(() => {
    if (!evidencias.length) return null;
    return [...evidencias].sort((a, b) => {
      const da = Date.parse(String(a.uploadedAt || '')) || 0;
      const db = Date.parse(String(b.uploadedAt || '')) || 0;
      return db - da;
    })[0] || null;
  }, [evidencias]);
  const contentorStockItems = useMemo(() => Object.values(stockMapByReferencia), [stockMapByReferencia]);
  const contentorSuggestionItems = useMemo<ContentorSuggestionItem[]>(() => {
    const findStockByRefs = (refs: string[]) => {
      for (const ref of refs) {
        const normalizedRef = normalizeReference(ref);
        const direct = stockMapByReferencia[normalizedRef] || stockMapByCodigoFabricante[normalizedRef];
        if (direct) return direct;
      }
      return null;
    };

    const findStockByTokens = (tokens: string[]) => {
      const normalizedTokens = tokens.map((token) => normalizeText(token)).filter(Boolean);
      if (!normalizedTokens.length) return null;

      return contentorStockItems.find((item) => {
        const descricao = normalizeText(item.descricao || '');
        const referencia = normalizeText(item.referencia || '');
        const codigoFabricante = normalizeText(item.codigoFabricante || '');
        return normalizedTokens.some((token) => (
          descricao.includes(token) || referencia.includes(token) || codigoFabricante.includes(token)
        ));
      }) || null;
    };

    const suggestions = new Map<string, ContentorSuggestionItem>();
    const closureStrapQuantity = contentorPrimaryClosureEntry?.strapQuantity || 1;

    const pushSuggestion = (entry: {
      key: string;
      title: string;
      articleName?: string;
      references?: string[];
      searchTerms?: string[];
      notes?: string;
      sourceLabel: string;
      quantity?: number;
      alwaysReplaceOnService?: boolean;
    }) => {
      const references = dedupeOptions(entry.references || []);
      const searchTerms = dedupeOptions(entry.searchTerms || []);
      const stockItem = findStockByRefs(references) || findStockByTokens(searchTerms);
      const articleName = String(entry.articleName || entry.title).trim();
      const dedupeKey = [
        normalizeText(articleName),
        references.map((ref) => normalizeReference(ref)).sort().join('|'),
      ].join('::');

      const existingEntry = Array.from(suggestions.values()).find((candidate) => {
        const candidateKey = [
          normalizeText(candidate.articleName),
          candidate.references.map((ref) => normalizeReference(ref)).sort().join('|'),
        ].join('::');
        return candidateKey === dedupeKey;
      });

      if (existingEntry) {
        suggestions.set(existingEntry.key, {
          ...existingEntry,
          references: dedupeOptions([...existingEntry.references, ...references]),
          searchTerms: dedupeOptions([...existingEntry.searchTerms, ...searchTerms]),
          notes: [existingEntry.notes, entry.notes].filter(Boolean).join(' · ') || existingEntry.notes || entry.notes,
          quantity: Math.max(existingEntry.quantity, Math.max(1, Number(entry.quantity || 1))),
          stockItem: existingEntry.stockItem || stockItem,
          present: existingEntry.present,
          alwaysReplaceOnService: existingEntry.alwaysReplaceOnService || Boolean(entry.alwaysReplaceOnService),
        });
        return;
      }

      const present = formArticles.some((article) => {
        const refNorm = normalizeReference(article.referencia || '');
        const articleNameNorm = normalizeText(article.name || '');
        return (
          (references.length > 0 && references.some((ref) => normalizeReference(ref) === refNorm)) ||
          (!!articleNameNorm && (articleNameNorm.includes(normalizeText(articleName)) || normalizeText(articleName).includes(articleNameNorm)))
        );
      });

      suggestions.set(entry.key, {
        key: entry.key,
        title: entry.title,
        articleName,
        references,
        searchTerms,
        notes: entry.notes,
        sourceLabel: entry.sourceLabel,
        quantity: Math.max(1, Number(entry.quantity || 1)),
        stockItem,
        present,
        alwaysReplaceOnService: Boolean(entry.alwaysReplaceOnService),
      });
    };

    const technicalContainerItems = [...(technicalModel?.serviceItems || []), ...(technicalModel?.spareParts || [])]
      .filter((item) => {
        const haystack = normalizeText(`${item.name} ${item.reference || ''} ${item.notes || ''}`);
        if (isWorkshopToolItem(item.name, item.notes)) return false;
        if (sb4621Applicable && /do not cut|15384002|tape-donotcut/i.test(`${item.name || ''} ${item.reference || ''}`)) return false;
        return /(container|contentor|valise|vacuum|painter|strap|lashing|label|etiqueta|tape|do not cut|closing|bag|plug)/.test(haystack);
      });

    technicalContainerItems.forEach((item, index) => {
      pushSuggestion({
        key: `technical-${index}-${item.reference || item.name}`,
        title: item.name,
        articleName: item.name,
        references: splitReferenceCandidates(item.reference),
        searchTerms: [item.name, item.notes || '', item.reference || ''],
        notes: item.notes,
        sourceLabel: item.category || 'Técnico',
        quantity: 1,
      });
    });

    if (vacuumBagShouldBeRecommended) {
      pushSuggestion({
        key: 'vacuum-bag-service',
        title: 'Saco de vácuo',
        articleName: 'Saco de vácuo',
        references: dedupeOptions([vacuumBagReferenceValue, ...manualVacuumBagReferenceOptions]),
        searchTerms: [
          'saco de vacuo',
          'saco de vácuo',
          'vacuum bag',
          currentBrandLabel,
          currentContainerLabel,
          technicalModel?.name || '',
        ],
        notes: 'Substituição obrigatória em cada serviço para jangadas que usam saco de vácuo.',
        sourceLabel: 'Saco de vácuo · regra de serviço',
        quantity: 1,
        alwaysReplaceOnService: true,
      });
    }

    contentorClosureBundle.exactMatches.forEach((entry: ContainerClosureStrapEntry) => {
      pushSuggestion({
        key: `closure-exact-${entry.key}`,
        title: `Cintas de fecho ${entry.containerLabel}${entry.size ? ` · Size ${entry.size}` : ''}`,
        articleName: entry.description,
        references: [entry.stockReference],
        searchTerms: [entry.description, entry.containerLabel, entry.stockReference, entry.containerFamily, entry.size || '', 'cinta', 'strap', 'closing strap'],
        notes: `Substituição obrigatória em cada inspeção · Qtd. ${entry.strapQuantity} · ${formatContainerClosureCapacities(entry)}${entry.page ? ` · pág. ${entry.page}` : ''}${entry.notes ? ` · ${entry.notes}` : ''}`,
        sourceLabel: 'Cintas de fecho · mapeamento exato',
        quantity: entry.strapQuantity,
        alwaysReplaceOnService: true,
      });
    });

    contentorClosureBundle.familyMatches.forEach((entry: ContainerClosureStrapEntry) => {
      pushSuggestion({
        key: `closure-family-${entry.key}`,
        title: `Cintas de fecho ${entry.containerLabel}${entry.size ? ` · Size ${entry.size}` : ''}`,
        articleName: entry.description,
        references: [entry.stockReference],
        searchTerms: [entry.description, entry.containerLabel, entry.stockReference, entry.containerFamily, entry.size || '', 'cinta', 'strap', 'closing strap'],
        notes: `Correspondência por família · substituição obrigatória em cada inspeção · Qtd. ${entry.strapQuantity} · ${formatContainerClosureCapacities(entry)}${entry.page ? ` · pág. ${entry.page}` : ''}${entry.notes ? ` · ${entry.notes}` : ''}`,
        sourceLabel: 'Cintas de fecho · família do contentor',
        quantity: entry.strapQuantity,
        alwaysReplaceOnService: true,
      });
    });

    if (sb4621Applicable && sb4621LayoutGuide) {
      sb4621LayoutGuide.sheets.forEach((sheet, index) => {
        const refs = Array.from(new Set((sheet.match(/\d{8}/g) || []).filter((ref) => !(isSeasavaPlusFicha && ref === '53800001'))));
        if (isSeasavaPlusFicha && refs.length === 0) {
          return;
        }
        pushSuggestion({
          key: `sb4621-${index}`,
          title: 'Folha multi-etiquetas do contentor',
          articleName: 'Folha Multi-Etiquetas Surviva MK4',
          references: refs.length > 0 ? refs : ['MULTI-LABEL-SM4'],
          searchTerms: ['multi-label', 'folha multi-etiquetas', 'container label', 'etiquetas contentor', sheet],
          notes: sheet,
          sourceLabel: 'SB 46/21',
          quantity: 1,
        });
      });

      pushSuggestion({
        key: 'sb4621-do-not-cut',
        title: 'Etiquetagem / Do Not Cut',
        articleName: 'Fita Do Not Cut (Rolo 50m)',
        references: ['TAPE-DONOTCUT', '15384002'],
        searchTerms: ['do not cut', 'fita do not cut', 'etiqueta contentor'],
        notes: `Fallback operacional quando ainda for necessário material de etiquetagem legacy no fecho do contentor. Qtd. alinhada com ${closureStrapQuantity} cinta${closureStrapQuantity === 1 ? '' : 's'} de fecho.`,
        sourceLabel: 'SB 46/21 / stock',
        quantity: closureStrapQuantity,
      });
    }

    if (isLr97TechnicalFamily) {
      const containerLabelNormalized = normalizeText(currentContainerLabel);
      const usesSmallLashing =
        containerLabelNormalized.includes('4 n') ||
        containerLabelNormalized.includes('6/8 f') ||
        currentCapacity <= 8;

      pushSuggestion({
        key: 'lr97-closing-strap',
        title: 'Closing strap LR97',
        articleName: 'Closing strap complete with hand loop (packed 50)',
        references: ['0.03.03.16.0', '0.03.03.17.0', '0.03.03.18.0'],
        searchTerms: ['closing strap lr97', 'closing straps pp', 'hand loop'],
        notes: 'Família LR97: consumíveis de fecho do contentor conforme catálogo DSB.',
        sourceLabel: 'LR97 / stock',
        quantity: 1,
      });

      pushSuggestion({
        key: 'lr97-lashing',
        title: 'Lashing do contentor LR97',
        articleName: usesSmallLashing ? 'Lashing for container 4N / 6/8 F' : 'Lashing for container 10/12 F and larger',
        references: usesSmallLashing ? ['8.03.03.84.0'] : ['8.03.03.85.0'],
        searchTerms: usesSmallLashing ? ['lashing 4n 6/8 f'] : ['lashing 10/12 f', 'lashing larger'],
        notes: 'Escolha automática baseada na família de contentor configurada na ficha LR97.',
        sourceLabel: 'LR97 / stock',
        quantity: 1,
      });
    }

    if (isEurovinilFicha) {
      const eurovinilRef = currentCapacity > 8 ? '10304232' : '10304222';
      pushSuggestion({
        key: 'eurovinil-closing-strap',
        title: 'Closing straps Eurovinil',
        articleName: currentCapacity > 8 ? 'Closing Straps (10P/12P)' : 'Closing Straps (6P/8P)',
        references: [eurovinilRef],
        searchTerms: ['closing straps eurovinil', 'container closing strap'],
        notes: 'A referência muda com a lotação: 6/8P ou 10/12P.',
        sourceLabel: 'Eurovinil / técnico',
        quantity: 1,
      });
    }

    return Array.from(suggestions.values()).sort((a, b) => {
      const score = (item: typeof a) => {
        let total = 0;
        if (item.present) total += 200;
        if (item.stockItem) total += 100;
        if (item.sourceLabel.includes('SB 46/21')) total += 50;
        if (item.sourceLabel.includes('stock')) total += 25;
        return total;
      };

      return score(b) - score(a) || a.title.localeCompare(b.title, 'pt-PT');
    });
  }, [
    stockMapByReferencia,
    stockMapByCodigoFabricante,
    contentorStockItems,
    formArticles,
    technicalModel,
    sb4621Applicable,
    sb4621LayoutGuide,
    isLr97TechnicalFamily,
    currentContainerLabel,
    currentCapacity,
    contentorClosureBundle,
    isEurovinilFicha,
    vacuumBagShouldBeRecommended,
    manualVacuumBagReferenceOptions,
    vacuumBagReferenceValue,
    currentBrandLabel,
    currentModelLabel,
    isSeasavaPlusFicha,
    contentorPrimaryClosureEntry,
  ]);
  const contentorOperationalItems = useMemo(() => {
    const findSuggestion = (matcher: (item: ContentorSuggestionItem) => boolean) => {
      return contentorSuggestionItems.find(matcher) || null;
    };

    return [
      ...(vacuumBagShouldBeRecommended ? [{
        key: 'contentor_saco_vacuo',
        title: 'Saco de vácuo',
        description: 'Esta jangada usa saco de vácuo e em todos os serviços deve levar saco novo.',
        checklistFieldName: 'contentor_saco_vacuo',
        suggestion: findSuggestion((item) => {
          const haystack = `${item.title} ${item.articleName} ${item.references.join(' ')} ${item.searchTerms.join(' ')}`.toLowerCase();
          return haystack.includes('vacuum') || haystack.includes('vácuo') || haystack.includes('vacuo');
        }),
      }] : []),
      {
        key: packagingClosureFieldName,
        title: isValiseContainer ? 'Fecho da valise' : 'Cinta / fecho do contentor',
        description: isValiseContainer
          ? 'Confirma se o fecho da valise está íntegro e operacional antes do fecho final da revisão.'
          : 'Confirma o elemento de fecho do invólucro. Nas cintas de fecho, cada inspeção deve sair com substituição nova.',
        checklistFieldName: packagingClosureFieldName,
        suggestion: isValiseContainer
          ? null
          : findSuggestion((item) => {
              const haystack = `${item.title} ${item.articleName} ${item.references.join(' ')} ${item.searchTerms.join(' ')}`.toLowerCase();
              return haystack.includes('strap') || haystack.includes('closing') || haystack.includes('fecho') || haystack.includes('tape');
            }),
      },
      {
        key: 'saco_retenida',
        title: 'Saco da retenida',
        description: 'Usa esta decisão para validar o saco da retenida/painter bag e lançar substituição se necessário.',
        checklistFieldName: 'saco_retenida',
        suggestion: findSuggestion((item) => {
          const haystack = `${item.title} ${item.articleName} ${item.references.join(' ')} ${item.searchTerms.join(' ')}`.toLowerCase();
          return haystack.includes('bag') || haystack.includes('painter');
        }),
      },
      {
        key: 'marcas_involucro',
        title: isValiseContainer ? 'Marcas da valise / invólucro' : 'Marcas e etiquetas do invólucro',
        description: isValiseContainer
          ? 'Verifica identificação e marcações obrigatórias da valise.'
          : 'Verifica etiquetagem, folhas multi-label e marcações obrigatórias do contentor.',
        checklistFieldName: 'marcas_involucro',
        suggestion: isValiseContainer
          ? null
          : findSuggestion((item) => {
              const haystack = `${item.title} ${item.articleName} ${item.references.join(' ')} ${item.searchTerms.join(' ')}`.toLowerCase();
              return haystack.includes('label') || haystack.includes('etiquet') || haystack.includes('do not cut');
            }),
      },
      {
        key: 'comprimento_retenida',
        title: 'Comprimento da retenida',
        description: 'Regista a medida confirmada no terreno e fecha a verificação da retenida.',
        checklistFieldName: 'comprimento_retenida',
        suggestion: null,
      },
    ] as const;
  }, [contentorSuggestionItems, isValiseContainer, packagingClosureFieldName, vacuumBagShouldBeRecommended]);
  const contentorOperationalSummary = useMemo(() => {
    const completed = contentorOperationalItems.filter((item) => {
      const value = inspectionChecklistValues[item.checklistFieldName];
      if (typeof value === 'boolean') return value;
      return String(value || '').trim().length > 0;
    }).length;

    return {
      completed,
      total: contentorOperationalItems.length,
      pending: Math.max(0, contentorOperationalItems.length - completed),
    };
  }, [contentorOperationalItems, inspectionChecklistValues]);
  const contentorOperationalCards = useMemo(() => {
    return contentorOperationalItems
      .map((item) => {
        const currentValue = inspectionChecklistValues[item.checklistFieldName];
        const isComplete = typeof currentValue === 'boolean'
          ? currentValue
          : String(currentValue || '').trim().length > 0;
        const stockItem = item.suggestion?.stockItem || null;
        const hasSuggestion = Boolean(item.suggestion);
        const hasStock = Boolean(stockItem);
        const alreadyAssociated = Boolean(item.suggestion?.present);
        const alwaysReplaceOnService = Boolean(item.suggestion?.alwaysReplaceOnService);

        let priority: 'critical' | 'attention' | 'ready' | 'done' = 'attention';
        let priorityLabel = 'Atenção';
        let priorityIcon = '◔';
        let priorityHint = 'Confirmar visualmente este ponto antes de fechar o contentor.';
        let cardClassName = 'border-amber-200 bg-amber-50';
        let accentClassName = 'bg-amber-500';
        let badgeClassName = 'border-amber-200 bg-amber-100 text-amber-800';

        if (isComplete) {
          priority = 'done';
          priorityLabel = 'Pronto';
          priorityIcon = '✓';
          priorityHint = 'Ponto registado e validado na checklist.';
          cardClassName = 'border-emerald-200 bg-emerald-50';
          accentClassName = 'bg-emerald-500';
          badgeClassName = 'border-emerald-200 bg-emerald-100 text-emerald-800';
        } else if (hasSuggestion && !hasStock) {
          priority = 'critical';
          priorityLabel = 'Atenção';
          priorityIcon = '◔';
          priorityHint = alwaysReplaceOnService
            ? 'Substituição obrigatória por serviço, mas ainda sem match de stock; precisa de decisão manual.'
            : 'Não existe match no stock para este item sugerido; precisa de decisão manual.';
          cardClassName = 'border-amber-200 bg-amber-50';
          accentClassName = 'bg-amber-500';
          badgeClassName = 'border-amber-200 bg-amber-100 text-amber-800';
        } else if (hasSuggestion && hasStock) {
          priority = 'ready';
          priorityLabel = alwaysReplaceOnService ? 'Troca obrigatória' : 'Pronto a substituir';
          priorityIcon = '🔧';
          priorityHint = alwaysReplaceOnService
            ? 'Este consumível deve ser renovado em cada serviço e já existe artigo em stock pronto a aplicar.'
            : 'Há artigo em stock pronto para aplicar ao contentor.';
          cardClassName = 'border-blue-200 bg-blue-50';
          accentClassName = 'bg-blue-500';
          badgeClassName = 'border-blue-200 bg-blue-100 text-blue-800';
        }

        return {
          ...item,
          isComplete,
          stockItem,
          hasStock,
          alreadyAssociated,
          alwaysReplaceOnService,
          priority,
          priorityLabel,
          priorityIcon,
          priorityHint,
          cardClassName,
          accentClassName,
          badgeClassName,
        };
      })
      .sort((a, b) => {
        const order = { critical: 0, attention: 1, ready: 2, done: 3 } as const;
        return order[a.priority] - order[b.priority] || a.title.localeCompare(b.title, 'pt-PT');
      });
  }, [contentorOperationalItems, inspectionChecklistValues]);
  const contentorPrioritySummary = useMemo(() => {
    return contentorOperationalCards.reduce(
      (acc, item) => {
        acc[item.priority] += 1;
        return acc;
      },
      { critical: 0, attention: 0, ready: 0, done: 0 }
    );
  }, [contentorOperationalCards]);
  const visibleContentorAttentionCount = contentorPrioritySummary.attention + contentorPrioritySummary.critical;
  const normalizedContentorPriorityFilter = contentorPriorityFilter === 'critical' ? 'attention' : contentorPriorityFilter;
  const filteredContentorOperationalCards = useMemo(() => {
    if (normalizedContentorPriorityFilter === 'all') return contentorOperationalCards;
    return contentorOperationalCards.filter((item) => {
      if (normalizedContentorPriorityFilter === 'attention') {
        return item.priority === 'attention' || item.priority === 'critical';
      }
      return item.priority === normalizedContentorPriorityFilter;
    });
  }, [contentorOperationalCards, normalizedContentorPriorityFilter]);
  const technicalSummaryCards = [
    {
      label: "Marca / Modelo",
      value: `${String(form.brand || raft?.brand || "—").trim() || "—"} / ${String(form.model || raft?.model || "—").trim() || "—"}`,
      tone: "slate",
    },
    {
      label: "Capacidade / Pack",
      value: `${currentCapacity > 0 ? `${formatCapacityValue(currentCapacity)} pessoas` : "—"} · ${currentPackLabel || "—"}`,
      tone: "emerald",
    },
    {
      label: packagingLabel,
      value: currentContainerLabel || "—",
      tone: "blue",
    },
    {
      label: "Sistema insuflação",
      value: currentInflationSystemLabel || "—",
      tone: "violet",
    },
  ] as const;
  const technicalDetailSections = [
    {
      title: "Identificação principal",
      tone: "slate",
      rows: [
        { key: "serial", label: "Nº de série", value: String(form.serial || raft?.serial || "") },
        { key: "brand", label: "Marca", value: String(form.brand || raft?.brand || "") },
        { key: "model", label: "Modelo", value: String(form.model || raft?.model || "") },
        { key: "capacity", label: "Lotação", value: currentCapacity > 0 ? `${formatCapacityValue(currentCapacity)} pessoas` : "" },
        { key: "owner", label: "Proprietário", value: String(form.owner || raft?.ownerDisplay || raft?.owner || "") },
        { key: "shipNameManual", label: "Navio", value: String(form.shipNameManual || raft?.shipNameManual || raft?.navio?.nome || "") },
      ],
    },
    {
      title: "Configuração da jangada",
      tone: "blue",
      rows: [
        { key: "packType", label: "Pack definido", value: currentPackLabel },
        { key: "launchType", label: "Tipo de lançamento", value: String(form.launchType || raft?.launchType || "") },
        { key: "fabricType", label: "Material / tecido", value: String(form.fabricType || raft?.fabricType || "") },
        { key: "containerModel", label: isValiseContainer ? "Modelo da valise" : "Modelo do contentor", value: currentContainerLabel },
        { key: "painterLength", label: "Painter length", value: String(form.painterLength || raft?.painterLength || "") },
        { key: "maxStowageHeight", label: "Altura máxima de estiva", value: String(form.maxStowageHeight || raft?.maxStowageHeight || "") },
      ],
    },
    {
      title: "Cilindro e inflação",
      tone: "emerald",
      rows: [
        { key: "cylinderSerial", label: "Serial do cilindro", value: String(form.cylinderSerial || raft?.cylinderSerial || "") },
        { key: "cylinderSistema", label: "Sistema de insuflação", value: currentInflationSystemLabel },
        { key: "cylinderCo2", label: "CO₂ registado", value: String(form.cylinderCo2 || raft?.cylinderCo2 || "") },
        { key: "cylinderN2", label: "N₂ registado", value: String(form.cylinderN2 || raft?.cylinderN2 || "") },
        { key: "cylinderCabecaDisparoRef", label: "Cabeça de disparo (ref.)", value: String(form.cylinderCabecaDisparoRef || raft?.cylinderCabecaDisparoRef || "") },
        { key: "valvulasAtestar", label: "Válvula de atestar", value: String(form.valvulasAtestar || raft?.valvulasAtestar || "") },
        { key: "valvulasAlivio", label: "Válvula de alívio", value: String(form.valvulasAlivio || raft?.valvulasAlivio || "") },
      ],
    },
    {
      title: "Serviço e inspeção",
      tone: "amber",
      rows: [
        { key: "dataFabrico", label: "Data de fabrico", value: String(form.dataFabrico || raft?.dataFabrico || "") },
        { key: "dataInspecao", label: "Última inspeção", value: String(form.dataInspecao || raft?.dataInspecao || "") },
        { key: "dataProxInspecao", label: "Próxima inspeção", value: String(form.dataProxInspecao || raft?.dataProxInspecao || "") },
        { key: "ultimoCertificadoNumero", label: "Último certificado", value: String(form.ultimoCertificadoNumero || raft?.ultimoCertificadoNumero || certificadoPreferencial?.certificadoNumero || ultimaInspecao?.certificadoNumero || "") },
        { key: "numeroObra", label: "Número de obra", value: String(form.numeroObra || raft?.numeroObra || "") },
        { key: "applicableServiceBulletinsCount", label: "Boletins aplicáveis", value: String(applicableServiceBulletins.length || "") },
      ],
    },
  ] as const;
  const technicalKeyDataEntries = Object.entries(technicalModel?.keyTechnicalData || {}).filter(([, value]) => String(value || "").trim());
  const genericTorqueEntries = Array.isArray(technicalModel?.torques) ? technicalModel.torques.filter((item) => String(item || "").trim() && item !== "—") : [];
  const technicalSpecifications = (technicalModel?.specifications || []).slice().sort((a, b) => {
    const capacityDelta = (a.capacity || 0) - (b.capacity || 0);
    if (capacityDelta !== 0) return capacityDelta;
    return String(a.codRef || "").localeCompare(String(b.codRef || ""), "pt-PT");
  });
  const technicalRows = Object.entries(raft || {})
    .filter(([key]) => key !== "artigos" && key !== "certificadosExtraidos" && key !== "certificadoAtivo")
    .sort(([a], [b]) => a.localeCompare(b, "pt-PT"));
  const groupedTechnicalKeys = new Set<string>(
    technicalDetailSections.flatMap((section) => section.rows.map((row) => row.key))
  );
  const remainingTechnicalRows = technicalRows.filter(([key]) => !groupedTechnicalKeys.has(key));

  // Renderizar resumo do quadro de inspeção
  const renderResumoUltimaInspecao = () => {
    if (!ultimaInspecao && resumoUltimaInspecaoRowsWithCost.length === 0 && resumoSubstituicoesRowsWithCost.length === 0 && resumoTestesEfetuados.length === 0) return (
      <div className="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-600">
        Nenhuma inspeção encontrada para esta jangada.
      </div>
    );
    return (
      <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <div className="mb-4 flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 className="text-lg font-semibold">Resumo da inspeção</h2>
            <p className="text-sm text-gray-600">Visão consolidada da última revisão, sem repetir artigos iguais e com as substituições destacadas.</p>
          </div>
          <span className="rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
            {ultimaInspecao?.certificadoNumero || 'Última revisão'}
          </span>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-2 mb-4 text-sm">
          <div><b>Data:</b> {formatDatePt(ultimaInspecao?.dataInspecao)}</div>
          <div><b>Status:</b> {ultimaInspecao?.status || "—"}</div>
          <div><b>Próxima Inspeção:</b> {formatDatePt(ultimaInspecao?.dataProxInspecao)}</div>
          <div><b>Certificado:</b> {ultimaInspecao?.certificadoNumero || "—"}</div>
          <div><b>Arquivo Origem:</b> {ultimaInspecao?.sourceFile || "—"}</div>
          <div><b>Substituições registadas:</b> {resumoSubstituicoesRowsWithCost.length}</div>
        </div>

        <div className="mb-4 grid grid-cols-1 xl:grid-cols-3 gap-4">
          <div className="rounded-lg border border-violet-100 bg-violet-50 p-3">
            <div className="mb-2 flex items-center justify-between gap-2">
              <h3 className="text-sm font-semibold text-violet-900">Testes efetuados</h3>
              <span className="rounded-full border border-violet-200 bg-white px-2 py-0.5 text-[11px] font-semibold text-violet-700">
                {resumoTestesEfetuados.length} teste{resumoTestesEfetuados.length === 1 ? '' : 's'}
              </span>
            </div>
            {resumoTestesEfetuados.length > 0 ? (
              <div className="space-y-2 text-xs text-violet-950">
                {resumoTestesEfetuados.map((test) => (
                  <div key={`summary-test-${test.key}`} className="rounded border border-violet-100 bg-white px-3 py-2">
                    <div className="flex flex-wrap items-center justify-between gap-2">
                      <span className="font-semibold">{test.label}</span>
                      <span className="rounded-full border border-emerald-200 bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">Efetuado</span>
                    </div>
                    {test.inspectionDate ? <p className="mt-1 text-[11px] text-violet-700">Data: {formatDatePt(test.inspectionDate)}</p> : null}
                    {test.details.length > 0 ? <p className="mt-1 text-[11px] text-gray-600">{test.details.join(' · ')}</p> : null}
                  </div>
                ))}
              </div>
            ) : (
              <div className="rounded-lg border border-dashed border-violet-200 bg-white p-3 text-sm text-violet-700">
                Ainda não há testes marcados como efetuados nesta revisão.
              </div>
            )}
          </div>

          <div className="rounded-lg border border-amber-100 bg-amber-50 p-3">
            <div className="mb-1 flex items-center justify-between gap-2">
              <h3 className="text-sm font-semibold text-amber-900">Custo estimado dos artigos registados</h3>
              <span className="rounded-full border border-amber-200 bg-white px-2 py-0.5 text-[11px] font-semibold text-amber-700">
                {resumoUltimaInspecaoRowsWithCost.length} linha(s)
              </span>
            </div>
            <p className="text-2xl font-bold text-amber-900">{formatCurrencyEur(resumoUltimaInspecaoTotalCost)}</p>
            <p className="mt-1 text-[11px] text-amber-800">Estimativa calculada pelas referências ligadas ao stock atual ({resumoUltimaInspecaoRowsWithCost.filter((row) => row.custoTotal != null).length} com preço).</p>
          </div>

          <div className="rounded-lg border border-emerald-100 bg-emerald-50 p-3">
            <div className="mb-1 flex items-center justify-between gap-2">
              <h3 className="text-sm font-semibold text-emerald-900">Custo estimado das substituições</h3>
              <span className="rounded-full border border-emerald-200 bg-white px-2 py-0.5 text-[11px] font-semibold text-emerald-700">
                {resumoSubstituicoesRowsWithCost.length} linha(s)
              </span>
            </div>
            <p className="text-2xl font-bold text-emerald-900">{formatCurrencyEur(resumoSubstituicoesTotalCost)}</p>
            <p className="mt-1 text-[11px] text-emerald-800">Estimativa das peças/material substituídos na última inspeção ({resumoSubstituicoesRowsWithCost.filter((row) => row.custoTotal != null).length} com preço).</p>
          </div>
        </div>

        <div className="grid grid-cols-1 xl:grid-cols-2 gap-4">
          <div className="rounded-lg border border-blue-100 bg-blue-50 p-3">
            <div className="mb-2 flex items-center justify-between gap-2">
              <h3 className="text-sm font-semibold text-blue-900">Artigos verificados / registados</h3>
              <span className="rounded-full border border-blue-200 bg-white px-2 py-0.5 text-[11px] font-semibold text-blue-700">
                {resumoUltimaInspecaoRowsWithCost.length} linha(s)
              </span>
            </div>
            {resumoUltimaInspecaoRowsWithCost.length > 0 ? (
              <table className="min-w-full text-xs mt-1 border border-blue-200 bg-white">
                <thead>
                  <tr className="bg-blue-100">
                    <th className="p-1 text-left">Artigo</th>
                    <th className="p-1 text-left">Quantidade</th>
                    <th className="p-1 text-left">Validade</th>
                    <th className="p-1 text-left">Referência</th>
                    <th className="p-1 text-left">Custo</th>
                  </tr>
                </thead>
                <tbody>
                  {resumoUltimaInspecaoRowsWithCost.map((art, idx) => (
                    <tr key={`resumo-artigo-${idx}`} className="border-t border-blue-100">
                      <td className="p-1">{art.name || "—"}</td>
                      <td className="p-1">{art.quantidade || "—"}</td>
                      <td className="p-1">{art.validade ? formatMonthYear(art.validade) : "—"}</td>
                      <td className="p-1">
                        {art.referencia || "—"}
                        {art.codigoFabricante ? <div className="text-[10px] text-gray-500">Fab.: {art.codigoFabricante}</div> : null}
                      </td>
                      <td className="p-1">
                        {art.custoTotal != null ? formatCurrencyEur(art.custoTotal) : '—'}
                        {art.custoUnitario != null ? <div className="text-[10px] text-gray-500">{formatCurrencyEur(art.custoUnitario)}/un. {art.fontePreco ? `· ${art.fontePreco}` : ''}</div> : null}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <div className="rounded-lg border border-dashed border-blue-200 bg-white p-3 text-sm text-blue-700">
                Ainda não há artigos registados nesta inspeção.
              </div>
            )}
          </div>

          <div className="rounded-lg border border-emerald-100 bg-emerald-50 p-3">
            <div className="mb-2 flex items-center justify-between gap-2">
              <h3 className="text-sm font-semibold text-emerald-900">Substituições registadas</h3>
              <span className="rounded-full border border-emerald-200 bg-white px-2 py-0.5 text-[11px] font-semibold text-emerald-700">
                {resumoSubstituicoesRowsWithCost.length} linha(s)
              </span>
            </div>
            {resumoSubstituicoesRowsWithCost.length > 0 ? (
              <table className="min-w-full text-xs mt-1 border border-emerald-200 bg-white">
                <thead>
                  <tr className="bg-emerald-100">
                    <th className="p-1 text-left">Item</th>
                    <th className="p-1 text-left">Origem</th>
                    <th className="p-1 text-left">Qtd.</th>
                    <th className="p-1 text-left">Validade</th>
                    <th className="p-1 text-left">Referência</th>
                    <th className="p-1 text-left">Custo</th>
                  </tr>
                </thead>
                <tbody>
                  {resumoSubstituicoesRowsWithCost.map((art, idx) => (
                    <tr key={`resumo-substituicao-${idx}`} className="border-t border-emerald-100">
                      <td className="p-1">
                        {art.name || "—"}
                        {art.notes ? <div className="text-[10px] text-gray-500">{art.notes}</div> : null}
                      </td>
                      <td className="p-1">{art.origem || '—'}</td>
                      <td className="p-1">{art.quantidade || '—'}</td>
                      <td className="p-1">{art.validade ? formatMonthYear(art.validade) : '—'}</td>
                      <td className="p-1">
                        {art.referencia || '—'}
                        {art.codigoFabricante ? <div className="text-[10px] text-gray-500">Fab.: {art.codigoFabricante}</div> : null}
                      </td>
                      <td className="p-1">
                        {art.custoTotal != null ? formatCurrencyEur(art.custoTotal) : '—'}
                        {art.custoUnitario != null ? <div className="text-[10px] text-gray-500">{formatCurrencyEur(art.custoUnitario)}/un. {art.fontePreco ? `· ${art.fontePreco}` : ''}</div> : null}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <div className="rounded-lg border border-dashed border-emerald-200 bg-white p-3 text-sm text-emerald-700">
                Ainda não há substituições com Qtd. subst. registada nesta inspeção.
              </div>
            )}
          </div>
        </div>
      </div>
    );
  };

  const handleChange = (field: string, value: any) => {
    setForm((prev: FormState) => {
      if (!canEditField(field)) return prev;
      const normalizedValue = field === "brand"
        ? normalizeRaftBrandName(value)
        : field === "capacity"
          ? normalizeCapacityValue(value) ?? ""
          : value;
      const next: FormState = { ...prev, [field]: normalizedValue };
      const previousShipProfile: InspectionShipProfile | null = resolveSelectedShip(prev) || raft?.shipDetails || null;
      const nextShipProfile: InspectionShipProfile | null = resolveSelectedShip(next) || raft?.shipDetails || null;

      if (field === "hruAplicavel") {
        const applies = String(normalizedValue || "").trim().toUpperCase() === "SIM";
        if (!applies) {
          next.hruReferencia = "";
          next.hruDataInstalacao = "";
          next.hruValidade = "";
        } else if (!String(next.hruReferencia || "").trim()) {
          next.hruReferencia = HRU_REFERENCE_ARTIGO;
        }
      }

      // Regra operacional HRU: validade = 2 anos após instalação
      if (field === "hruDataInstalacao") {
        next.hruValidade = addYearsToDateInput(String(normalizedValue || ""), 2);
      }

      if (field === "testeWPUnidadePressao") {
        const previousUnit = normalizePressureUnit(prev.testeWPUnidadePressao || raft?.testeWPUnidadePressao || "inh2o");
        const nextUnit = normalizePressureUnit(value);

        if (previousUnit !== nextUnit) {
          const pressureKeys: Array<keyof FormState> = [
            "testeWPCamaraSuperiorInicio",
            "testeWPCamaraSuperiorAberturaValvula",
            "testeWPCamaraSuperiorFechoValvula",
            "testeWPCamaraSuperiorFim",
            "testeWPCamaraInferiorInicio",
            "testeWPCamaraInferiorAberturaValvula",
            "testeWPCamaraInferiorFechoValvula",
            "testeWPCamaraInferiorFim",
            "testeWPCamaraSuperiorQueda",
            "testeWPCamaraInferiorQueda",
            "testePressaoCamaraSuperior",
            "testePressaoCamaraInferior",
          ];

          for (const key of pressureKeys) {
            const currentRaw = String(next[key] || "").trim();
            if (!currentRaw) continue;
            const asMbar = convertPressureToMbar(currentRaw, previousUnit);
            const converted = convertMbarToUnit(asMbar, nextUnit);
            if (converted === null) continue;
            next[key] = formatDecimal(converted, 2);
          }
        }
      }

      // Próximo teste hidráulico automático: +5 anos
      if (field === "cylinderDataTeste") {
        next.cylinderDataProxTeste = addFiveYears(String(normalizedValue || ""));
      }

      if (field === "testeWPHoraInicio") {
        next.testeWPHoraFim = addMinutesToClock(normalizedValue, 60);
      }

      if (field === 'testeWPCamaraSuperiorFechoValvula') {
        next.testeWPCamaraSuperiorInicio = String(normalizedValue || '');
      }

      if (field === 'testeWPCamaraInferiorFechoValvula') {
        next.testeWPCamaraInferiorInicio = String(normalizedValue || '');
      }

      if (field === 'testeWPCamaraSuperiorInicio') {
        next.testeWPCamaraSuperiorFechoValvula = String(normalizedValue || '');
      }

      if (field === 'testeWPCamaraInferiorInicio') {
        next.testeWPCamaraInferiorFechoValvula = String(normalizedValue || '');
      }

      const wpTriggerFields = new Set([
        "testeWPHoraInicio",
        "testeWPTemperaturaInicial",
        "testeWPTemperaturaFinal",
        "testeWPPressaoAtmosfericaInicial",
        "testeWPPressaoAtmosfericaFinal",
        "testeWPUnidadePressao",
        "testeWPCamaraSuperiorInicio",
        "testeWPCamaraSuperiorFechoValvula",
        "testeWPCamaraSuperiorFim",
        "testeWPCamaraInferiorInicio",
        "testeWPCamaraInferiorFechoValvula",
        "testeWPCamaraInferiorFim",
      ]);

      if (wpTriggerFields.has(field)) {
        const derived = buildWpDerivedValues({
          pressureUnit: next.testeWPUnidadePressao,
          launchType: next.launchType || raft?.launchType,
          startTime: next.testeWPHoraInicio,
          tempInitial: next.testeWPTemperaturaInicial,
          tempFinal: next.testeWPTemperaturaFinal,
          baroInitial: next.testeWPPressaoAtmosfericaInicial,
          baroFinal: next.testeWPPressaoAtmosfericaFinal,
          upperStart: next.testeWPCamaraSuperiorInicio,
          upperEnd: next.testeWPCamaraSuperiorFim,
          lowerStart: next.testeWPCamaraInferiorInicio,
          lowerEnd: next.testeWPCamaraInferiorFim,
        });

        next.testeWPHoraFim = derived.endTime || next.testeWPHoraFim || '';
        next.testeWPCamaraSuperiorQueda = derived.upper.dropDisplay || '';
        next.testeWPCamaraInferiorQueda = derived.lower.dropDisplay || '';
      }

      if ((field === 'dataInspecao' || field === 'shipId' || field === 'shipNameManual') && canEditField('dataProxInspecao')) {
        const inspectionBase = String(next.dataInspecao || raft?.dataInspecao || '').trim();
        const previousRecommendedNextInspection = getRecommendedNextInspectionDate(
          String(prev.dataInspecao || raft?.dataInspecao || '').trim(),
          String(prev.brand || raft?.brand || '').trim(),
        );
        const recommendedNextInspection = getRecommendedNextInspectionDate(inspectionBase, String(next.brand || raft?.brand || '').trim());

        if (recommendedNextInspection && shouldAutoUpdateNextInspection(next.dataProxInspecao, previousRecommendedNextInspection)) {
          next.dataProxInspecao = recommendedNextInspection;
        }
      }

      return next;
    });
  };

  const applyRecommendedNextInspection = () => {
    if (!canEditJangadaPage || !canEditField('dataProxInspecao')) return;

    const inspectionBase = String(form.dataInspecao || raft?.dataInspecao || ultimaInspecao?.dataInspecao || '').trim();
    const recommended = getRecommendedNextInspectionDate(inspectionBase, String(form.brand || raft?.brand || '').trim());
    if (!recommended) return;

    startProtectedEditSession({ inspectionMode: false, section: 'geral' });
    setForm((prev) => ({
      ...prev,
      dataProxInspecao: recommended,
    }));
  };

  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    if (!canEditJangadaPage) {
      alert("Sem permissão para editar esta página.");
      return;
    }
    try {
      setSaving(true);
      const response = await fetch(`/api/jangadas/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(buildSavePayload(form))
      });
      if (!response.ok) {
        const details = await response.text().catch(() => "");
        alert(details ? `Não foi possível guardar a ficha da jangada.\n${details}` : "Não foi possível guardar a ficha da jangada.");
        return;
      }

      const updated = await response.json().catch(() => null);
      if (updated) {
        const normalized = normalizeRaftResponse(updated);
        setRaft(normalized);
        setForm(normalized);
        latestFormRef.current = normalized;
        lastSavedSnapshotRef.current = snapshotOf(normalized);

        if (inspectionMode) {
          const inspectionDate = String(normalized.dataInspecao || form.dataInspecao || "").trim();
          const certificateNumber = String(normalized.ultimoCertificadoNumero || form.ultimoCertificadoNumero || `INSP-${id}-${Date.now()}`).trim();
          const dataProxInspecaoSanitized = String(normalized.dataProxInspecao || form.dataProxInspecao || "")
            .trim()
            .replace(/\/+/g, "/")
            .replace(/^\/+|\/+$/g, "");
          const inspectionPayload = {
            certificadoNumero: certificateNumber,
            navioNome: String(normalized.shipNameManual || normalized.shipDetails?.nome || form.shipNameManual || "Sem navio").trim() || "Sem navio",
            navioId: normalized.shipId ? Number(normalized.shipId) : null,
            jangadaId: Number(id),
            jangadaSerial: String(normalized.serial || form.serial || "").trim() || null,
            date: inspectionDate || new Date().toISOString().slice(0, 10),
            dataInspecao: inspectionDate || new Date().toISOString().slice(0, 10),
            dataProxInspecao: dataProxInspecaoSanitized || null,
            status: "Concluída",
            sourceFile: "jangada_inspecao",
          };

          const inspectionResponse = await fetch("/api/inspecoes", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(inspectionPayload),
          });

          if (!inspectionResponse.ok) {
            const details = await inspectionResponse.text().catch(() => "");
            alert(details ? `A ficha foi guardada, mas a inspeção não entrou na lista.\n${details}` : "A ficha foi guardada, mas a inspeção não entrou na lista.");
            return;
          }

          const savedInspection = await inspectionResponse.json().catch(() => null);
          if (savedInspection) {
            setInspecoes((prev) => {
              const next = prev.some((item) => String(item.id) === String(savedInspection.id))
                ? prev.map((item) => String(item.id) === String(savedInspection.id) ? savedInspection : item)
                : [savedInspection, ...prev];
              return next.sort((a, b) => String(b.dataInspecao || "").localeCompare(String(a.dataInspecao || "")));
            });
          }
        }
      }
      persistPausedInspectionDraft(null);
      clearEditSessionProtection();
      setInspectionMode(false);
      setReplacementPicker(null);
      setEdit(false);
      router.refresh();
    } finally {
      setSaving(false);
    }
  };

  const sincronizarArtigoComStockPorReferencia = (artigo: ArtigoJangada, referenciaInput: string): ArtigoJangada => {
    const referenciaNormalizada = normalizeReference(referenciaInput);
    const stock = referenciaNormalizada
      ? stockMapByReferencia[referenciaNormalizada]
        || stockMapByCodigoFabricante[referenciaNormalizada]
        || (referenciaNormalizada === normalizeReference('MK4-0047')
          ? stockMapByReferencia[normalizeReference('30202051')]
          : undefined)
      : undefined;

    if (!stock) {
      return {
        ...artigo,
        referencia: referenciaInput,
      };
    }

    return {
      ...artigo,
      referencia: stock.referencia,
      name: stock.descricao || artigo.name,
      codigoFabricante: stock.codigoFabricante || artigo.codigoFabricante,
    };
  };

  const adicionarArtigoDoStock = (artigoSelecionado: Partial<ArtigoJangada>) => {
    const artigos = [...normalizeArtigos(form.artigos)];
    const refSelecionada = normalizeReference(artigoSelecionado.referencia);
    const nomeSelecionado = normalizeText(String(artigoSelecionado.name || ""));
    const idxExistente = artigos.findIndex((art) => {
      const refAtual = normalizeReference(art.referencia);
      const nomeAtual = normalizeText(String(art.name || ""));
      return (refSelecionada && refAtual === refSelecionada) || (nomeSelecionado && nomeAtual === nomeSelecionado);
    });

    const artigoNormalizado: ArtigoJangada = {
      ...(idxExistente >= 0 ? artigos[idxExistente] : ({} as ArtigoJangada)),
      ...artigoSelecionado,
      name: String(artigoSelecionado.name || "Novo artigo"),
      quantidade: artigoSelecionado.quantidade || "1",
      validade: normalizeMonthYearValue(artigoSelecionado.validade),
    } as ArtigoJangada;

    if (idxExistente >= 0) {
      artigos[idxExistente] = artigoNormalizado;
    } else {
      artigos.push(artigoNormalizado);
    }

    setForm((f) => {
      const next = { ...f, artigos };
      scheduleAutosave(next);
      return next;
    });
  };

  const adicionarSugestaoContentor = (suggestion: {
    articleName: string;
    quantity: number;
    stockItem: StockLookupItem | null;
  }) => {
    if (!suggestion.stockItem) return;

    adicionarArtigoDoStock({
      name: suggestion.articleName || suggestion.stockItem.descricao,
      referencia: suggestion.stockItem.referencia,
      codigoFabricante: suggestion.stockItem.codigoFabricante || undefined,
      quantidade: String(suggestion.quantity || 1),
      validade: normalizeMonthYearValue(String(suggestion.stockItem.validade || '')) || undefined,
    });
  };

  const handleContentorOperationalStatus = (fieldName: string, status: 'ok' | 'pending') => {
    const currentField = checklistFieldMap[fieldName];
    if (!currentField) return;

    if (currentField.type === 'checkbox') {
      handleChecklistFieldChange(fieldName, status === 'ok');
      return;
    }

    if (status === 'pending') {
      handleChecklistFieldChange(fieldName, '');
      return;
    }

    const currentValue = String(inspectionChecklistValues[fieldName] ?? '').trim();
    if (!currentValue) {
      const fallbackValue = fieldName === 'comprimento_retenida'
        ? String(form.painterLength || raft?.painterLength || '').trim() || 'Confirmado'
        : 'Confirmado';
      handleChecklistFieldChange(fieldName, fallbackValue);
    }
  };

  const atualizarArtigoExtra = (index: number, updates: Partial<ArtigoJangada>) => {
    const artigos = [...normalizeArtigos(form.artigos)];
    const current = artigos[index];
    if (!current) return;

    const nextUpdates = updates.referencia !== undefined
      ? sincronizarArtigoComStockPorReferencia(
          {
            ...current,
            ...updates,
          } as ArtigoJangada,
          String(updates.referencia || '')
        )
      : ({ ...current, ...updates } as ArtigoJangada);

    artigos[index] = {
      ...current,
      ...nextUpdates,
    };

    setForm((f) => {
      const next = { ...f, artigos };
      scheduleAutosave(next);
      return next;
    });
  };

  const removerArtigoExtra = (index: number) => {
    const artigos = [...normalizeArtigos(form.artigos)];
    if (index < 0 || index >= artigos.length) return;
    artigos.splice(index, 1);
    setForm((f) => {
      const next = { ...f, artigos };
      scheduleAutosave(next);
      return next;
    });
  };

  const sectionButton = (key: SectionKey, label: string) => (
    <button
      type="button"
      onClick={() => scrollToSection(key)}
      className={`inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium border ${activeSection === key ? "bg-blue-700 text-white border-blue-700" : "bg-white text-gray-700 border-gray-300"}`}
    >
      {label}
      {smartFocusPreferredTarget?.target.section === key ? (
        <span className={`rounded-full px-2 py-0.5 text-[10px] font-semibold ${activeSection === key ? 'bg-white/20 text-white' : 'bg-amber-100 text-amber-800'}`}>
          {rememberedSmartFocusMatch?.target.section === key ? 'Retomar' : 'Agora'}
        </span>
      ) : null}
    </button>
  );

  const coreNavigationSections: Array<{
    key: SectionKey;
    label: string;
    detail: string;
    tone: string;
  }> = [
    {
      key: 'geral' as SectionKey,
      label: 'Dados gerais',
      detail: String(form.packType || raft?.packType || currentPackLabel || 'Pack por validar'),
      tone: 'border-slate-200 bg-white text-slate-900',
    },
    {
      key: 'cilindro' as SectionKey,
      label: 'Cilindros',
      detail: String(form.cylinderSistema || raft?.cylinderSistema || currentInflationSystemLabel || 'Sistema por validar'),
      tone: 'border-emerald-200 bg-emerald-50 text-emerald-900',
    },
    {
      key: 'pack' as SectionKey,
      label: 'Pack obrigatório',
      detail: currentPackLabel || String(form.packType || raft?.packType || 'Sem pack definido'),
      tone: currentPackLabel
        ? 'border-cyan-200 bg-cyan-50 text-cyan-900'
        : 'border-amber-200 bg-amber-50 text-amber-900',
    },
    {
      key: 'contentor' as SectionKey,
      label: 'Contentor',
      detail: currentContainerLabel || packagingLabel,
      tone: currentContainerLabel
        ? 'border-indigo-200 bg-indigo-50 text-indigo-900'
        : 'border-amber-200 bg-amber-50 text-amber-900',
    },
  ].filter((section) => !(isValiseContainer && section.key === 'contentor'));

  const normalizeDirtyValue = (value: unknown): string => {
    if (value === null || value === undefined) return '';
    if (typeof value === 'string') return value.trim();
    if (typeof value === 'number' || typeof value === 'boolean') return String(value);
    try {
      return JSON.stringify(value);
    } catch {
      return String(value);
    }
  };

  const isFieldDirty = (field: keyof FormState, currentValue: unknown = form[field], originalValue: unknown = raft?.[field]) => {
    return normalizeDirtyValue(currentValue) !== normalizeDirtyValue(originalValue);
  };

  const getFieldCardClass = (dirty: boolean) => (
    `rounded-lg border p-3 transition-colors ${dirty ? 'border-amber-300 bg-amber-50 ring-1 ring-amber-200' : 'border-gray-200 bg-gray-50'}`
  );

  const renderFieldLabel = (label: string, dirty = false) => (
    <div className="mb-1 flex items-center justify-between gap-2">
      <p className="text-[11px] uppercase tracking-wide text-gray-500">{label}</p>
      {edit && dirty ? (
        <span className="inline-flex rounded-full border border-amber-300 bg-amber-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-800">
          Alterado
        </span>
      ) : null}
    </div>
  );

  const setValidityForArticle = (articleName: string, rawValue: string, draftKey?: string) => {
    const normalized = normalizeMonthYearValue(rawValue);
    if (!normalized) return;
    atualizarArtigoVerificado(articleName, { validade: normalized });
    if (draftKey) {
      setValidadeDraftByKey((prev) => ({
        ...prev,
        [draftKey]: monthYearDraftFromValue(normalized),
      }));
    }
  };

  const renderField = (label: string, key: keyof FormState, placeholder = "-") => (
    <div className={getFieldCardClass(isFieldDirty(key))}>
      {renderFieldLabel(label, isFieldDirty(key))}
      {edit ? (
        key === "expectedDeliveryDate" ||
        key === "cylinderDataTeste" ||
        key === "cylinderDataProxTeste" ||
        key === "hruDataInstalacao" ||
        key === "hruValidade" ||
        key === "dataInspecao" ||
        key === "dataProxInspecao" ? (
          <input
            type="date"
            className="w-full border rounded px-2 py-1 text-sm"
            value={form[key] ? String(form[key]).slice(0, 10) : ""}
            onChange={(e) => handleChange(String(key), e.target.value)}
            disabled={key === "cylinderDataProxTeste" || key === "hruValidade" || !canEditField(String(key))}
          />
        ) : (
          <input
            className="w-full border rounded px-2 py-1 text-sm"
            value={String(form[key] || "")}
            onChange={(e) => handleChange(String(key), e.target.value)}
            disabled={key === "serial" || !canEditField(String(key))}
          />
        )
      ) : (
        <p className="text-sm text-gray-900">
          {key === "expectedDeliveryDate" && form[key]
            ? formatDatePt(form[key])
            : key === "capacity"
              ? formatCapacityValue(form[key])
              : String(form[key] || placeholder)}
        </p>
      )}
    </div>
  );

  const renderInspectionChecklistField = (field: ChecklistField, renderKey?: string) => {
    const value = inspectionChecklistValues[field.name];
    const key = renderKey || field.name;
    const fieldVisualAids = [
      ...(currentChecklistFieldVisualAids[field.name] || []),
      ...(field.bulletinId ? (bulletinVisualAidsById[field.bulletinId] || []) : []),
    ];
    const packAction = field.packItem ? packChecklistActionMap[field.packItem.checklistName] : null;
    const showPackShortcut = Boolean(field.packItem && packAction && packAction.priority !== 'done');
    const packShortcutTone = packAction?.priority === 'critical'
      ? 'border-red-200 bg-red-50 text-red-800'
      : packAction?.priority === 'attention'
        ? 'border-amber-200 bg-amber-50 text-amber-800'
        : 'border-orange-200 bg-orange-50 text-orange-800';
    const packShortcutLabel = packAction?.priority === 'critical'
      ? 'Substituir no stock'
      : packAction?.priority === 'attention'
        ? 'Rever no pack'
        : 'Associar no stock';
    const packShortcutHint = packAction?.priority === 'critical'
      ? 'Item prioritário: abrir já a linha certa do pack e preparar substituição.'
      : packAction?.priority === 'attention'
        ? 'Item com atenção: abrir a linha do pack para rever validade / stock.'
        : 'Item ainda sem associação real na ficha do pack.';

    if (field.type === "checkbox") {
      return (
        <div key={key} className="rounded border border-gray-200 bg-white p-3 text-sm text-gray-800">
          <label className="flex items-center gap-2">
            <input
              type="checkbox"
              checked={Boolean(value)}
              disabled={!edit}
              onChange={(e) => handleChecklistFieldChange(field.name, e.target.checked)}
            />
            <span>
              {field.label}
              {field.englishLabel ? <span className="block text-[11px] text-gray-500">{field.englishLabel}</span> : null}
            </span>
          </label>
          {showPackShortcut ? (
            <div className={`mt-3 flex items-center justify-between gap-2 rounded-lg border px-2.5 py-2 text-xs ${packShortcutTone}`}>
              <div>
                <p className="font-semibold">Ação ligada ao pack</p>
                <p className="mt-0.5">{packShortcutHint}</p>
              </div>
              <button
                type="button"
                onClick={() => openPackReplacementFromChecklist(field)}
                className="rounded-md border border-current/20 bg-white px-2 py-1 font-medium hover:bg-white/80"
              >
                {packShortcutLabel}
              </button>
            </div>
          ) : null}
          {fieldVisualAids.length > 0 ? (
            <div className="mt-3 rounded-lg border border-sky-100 bg-sky-50 p-2.5">
              <p className="text-[11px] font-semibold uppercase tracking-wide text-sky-800">Apoio do manual para este item</p>
              {renderChecklistVisualAidList(fieldVisualAids, 'compact')}
            </div>
          ) : null}
        </div>
      );
    }

    return (
      <div key={key} className="rounded border border-gray-200 bg-white p-3">
        <p className="text-xs font-medium text-gray-600">{field.label}</p>
        {field.englishLabel ? <p className="text-[11px] text-gray-500 mb-1">{field.englishLabel}</p> : <div className="mb-1" />}
        <input
          type={field.type === "number" ? "number" : field.type === "date" ? "date" : "text"}
          value={String(value ?? "")}
          disabled={!edit}
          onChange={(e) => handleChecklistFieldChange(field.name, e.target.value)}
          className="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 disabled:bg-gray-100"
        />
        {showPackShortcut ? (
          <div className={`mt-3 flex items-center justify-between gap-2 rounded-lg border px-2.5 py-2 text-xs ${packShortcutTone}`}>
            <div>
              <p className="font-semibold">Ação ligada ao pack</p>
              <p className="mt-0.5">{packShortcutHint}</p>
            </div>
            <button
              type="button"
              onClick={() => openPackReplacementFromChecklist(field)}
              className="rounded-md border border-current/20 bg-white px-2 py-1 font-medium hover:bg-white/80"
            >
              {packShortcutLabel}
            </button>
          </div>
        ) : null}
        {fieldVisualAids.length > 0 ? (
          <div className="mt-3 rounded-lg border border-sky-100 bg-sky-50 p-2.5">
            <p className="text-[11px] font-semibold uppercase tracking-wide text-sky-800">Apoio do manual para este item</p>
            {renderChecklistVisualAidList(fieldVisualAids, 'compact')}
          </div>
        ) : null}
      </div>
    );
  };

  const checklistFieldMap = useMemo(() => {
    return inspectionChecklistSections
      .flatMap((section) => section.fields)
      .reduce<Record<string, ChecklistField>>((acc, field) => {
        acc[field.name] = field;
        return acc;
      }, {});
  }, [inspectionChecklistSections]);

  const isChecklistFieldCompleted = (fieldName: string) => {
    const value = inspectionChecklistValues[fieldName];
    if (typeof value === 'boolean') return value;
    if (typeof value === 'number') return true;
    return String(value ?? '').trim().length > 0;
  };

  const renderInspectionModeChecklistGroup = (
    title: string,
    fieldNames: string[],
    description?: string,
    columnsClassName = "grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3"
  ) => {
    if (!inspectionMode) return null;

    const fields = fieldNames
      .map((fieldName) => checklistFieldMap[fieldName])
      .filter((field): field is ChecklistField => Boolean(field));

    if (fields.length === 0) return null;

    return (
      <div className="mt-4 rounded-xl border border-indigo-200 bg-indigo-50 p-4">
        <div className="mb-3">
          <h3 className="text-sm font-semibold text-indigo-900">{title}</h3>
          {description ? <p className="mt-1 text-xs text-indigo-700">{description}</p> : null}
        </div>
        <div className={columnsClassName}>
          {fields.map((field, index) => renderInspectionChecklistField(field, `inspection-mode:${title}:${field.name}:${index}`))}
        </div>
      </div>
    );
  };

  const checklistSectionDestinations: Array<{
    title: string;
    section: SectionKey;
    tabLabel: string;
    description: string;
  }> = [
    {
      title: "Dados Gerais",
      section: "geral",
      tabLabel: "Dados Gerais",
      description: "Identificação, armador, navio, lotação e pack registado.",
    },
    {
      title: "Exterior da Jangada",
      section: "cilindro",
      tabLabel: "Cilindro",
      description: "Estrutura exterior, sistema de insuflação e pontos ligados ao cilindro.",
    },
    {
      title: "Interior da Jangada",
      section: "valvulas",
      tabLabel: "Válvulas",
      description: "Válvulas, cobertura interior, coletores e acessórios internos.",
    },
    {
      title: "Sistema de Insuflação e Válvulas",
      section: "valvulas",
      tabLabel: "Válvulas",
      description: "Conjunto de insuflação, cabeça de disparo, banjos, válvulas e proteção do cilindro.",
    },
    {
      title: "Equipamento Jangada",
      section: "pack",
      tabLabel: "Pack Obrigatório & Artigos",
      description: "Equipamento técnico permanente e conferência dos artigos do pack.",
    },
    {
      title: "Equip. de Emergência",
      section: "pack",
      tabLabel: "Pack Obrigatório & Artigos",
      description: "Consumíveis, pirotecnia, água, rações e validades do pack.",
    },
    {
      title: "Contentor",
      section: "contentor",
      tabLabel: "Contentor",
      description: "Fechos, retenida, imagem técnica e dados do invólucro/contentor.",
    },
    {
      title: "Saco / Valise",
      section: "contentor",
      tabLabel: "Saco / Valise",
      description: "Fechos, retenida, imagem técnica e dados do invólucro/valise.",
    },
    {
      title: "Fecho e Acondicionamento MKIV",
      section: "contentor",
      tabLabel: "Contentor",
      description: "Passos finais de dobragem, acondicionamento, fecho e etiquetagem operacional da MKIV.",
    },
    {
      title: "Boletins de Serviço MKIV",
      section: "geral",
      tabLabel: "Dados Gerais",
      description: "Confirmação operacional dos boletins de serviço aplicáveis à jangada MKIV na estação dos Açores.",
    },
  ];

  const checklistWizardSections = useMemo(() => {
    return inspectionChecklistSections.map((section, index) => {
      const destination = checklistSectionDestinations.find((item) => item.title === section.title) || checklistSectionDestinations[index] || null;
      const completedFields = section.fields.filter((field) => isChecklistFieldCompleted(field.name)).length;

      return {
        ...section,
        destination,
        completedFields,
        totalFields: section.fields.length,
      };
    });
  }, [inspectionChecklistSections, inspectionChecklistValues]);

  const currentChecklistWizardSection = checklistWizardSections[inspectionWizardStep] || null;
  const completedChecklistWizardSections = checklistWizardSections.filter((section) => section.totalFields > 0 && section.completedFields >= section.totalFields).length;
  const checklistTotalFields = checklistWizardSections.reduce((acc, section) => acc + section.totalFields, 0);
  const checklistCompletedFields = checklistWizardSections.reduce((acc, section) => acc + section.completedFields, 0);
  const checklistCompletionPercent = checklistTotalFields > 0
    ? Math.round((checklistCompletedFields / checklistTotalFields) * 100)
    : 0;
  const nextChecklistAction = currentChecklistWizardSection?.destination?.tabLabel
    ? `Validar ${currentChecklistWizardSection.destination.tabLabel} antes de avançar.`
    : currentChecklistWizardSection
      ? `Fechar o passo ${currentChecklistWizardSection.title}.`
      : "Entrar em modo de inspeção para iniciar o wizard.";
  const pausedInspectionSavedAtLabel = pausedInspectionDraftInfo
    ? new Date(pausedInspectionDraftInfo.savedAt).toLocaleString('pt-PT', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      })
    : '';

  const currentChecklistVisualAids = useMemo<ChecklistVisualAid[]>(() => {
    if (!currentChecklistWizardSection) return [];

    const title = currentChecklistWizardSection.title;
    const aids: ChecklistVisualAid[] = [];
    const checklistVisualBrandModel = normalizeText(`${String(form.brand || raft?.brand || '')} ${String(form.model || raft?.model || '')}`);
    const isMkivChecklistVisual =
      checklistVisualBrandModel.includes('surviva') ||
      checklistVisualBrandModel.includes('mkiv') ||
      checklistVisualBrandModel.includes('mk iv') ||
      checklistVisualBrandModel.includes('mk4') ||
      checklistVisualBrandModel.includes('lr07');

    if (isMkivChecklistVisual && title === 'Exterior da Jangada') {
      aids.push({
        kind: 'image',
        id: 'mkiv-top-light',
        title: 'Luz exterior / top light RL5',
        description: 'Referência visual para confirmar a unidade de iluminação exterior e a respetiva proteção durante a ronda exterior.',
        src: '/manual-parts/12870009.jpg',
        alt: 'Imagem do manual da luz exterior RL5 / top light',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto real',
      });
      aids.push({
        kind: 'image',
        id: 'mkiv-signal-table',
        title: 'Quadro de sinais de salvamento',
        description: 'Ajuda visual útil para confirmar o artigo “quadro de sinais” quando o passo exterior/interior está a ser fechado na ronda.',
        src: '/manual-parts/02176011.jpg',
        alt: 'Imagem do manual do rescue signal table',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto real',
      });
    }

    if (isMkivChecklistVisual && title === 'Interior da Jangada') {
      aids.push({
        kind: 'image',
        id: 'mkiv-inside-light',
        title: 'Luz interior / inside light RL5',
        description: 'Imagem de apoio para validar a luz interior e o conjunto bateria/lanterna interna no momento de fechar o passo interior.',
        src: '/manual-parts/12869009.jpg',
        alt: 'Imagem do manual da luz interior RL5 / inside light',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto real',
      });
      aids.push({
        kind: 'note',
        id: 'mkiv-interior-note',
        title: 'Dica operacional do manual',
        description: 'Ao fechar este passo, confirma em conjunto os itens de luz interior, manual de sobrevivência e quadro de sinais — é normalmente o trio que mais escapa quando a ronda vai depressa.',
        sourceLabel: 'Prática alinhada com a checklist MKIV do manual',
        badge: 'Nota',
      });
    }

    if (isMkivChecklistVisual && title === 'Sistema de Insuflação e Válvulas') {
      if (technicalCylinderSpec?.source?.page || technicalCylinderSpec?.cylinder) {
        aids.push({
          kind: 'table',
          id: 'mkiv-cylinder-spec',
          title: 'Tabela técnica do cilindro / inflação',
          description: 'Resumo da linha do manual associada à lotação atual para conferir gases nominais e volume do cilindro.',
          columns: ['Cap.', 'Pack', 'Config.', 'CO₂', 'N₂', 'Volume'],
          rows: [[
            String(technicalCylinderSpec?.capacity || currentCapacity || '—'),
            String(technicalCylinderSpec?.pack || currentPackLabel || '—'),
            String(technicalCylinderSpec?.configuration || form.launchType || raft?.launchType || 'TO'),
            typeof technicalCylinderSpec?.cylinder?.co2 === 'number' ? `${technicalCylinderSpec.cylinder.co2} kg` : '—',
            typeof technicalCylinderSpec?.cylinder?.n2 === 'number' ? `${technicalCylinderSpec.cylinder.n2} kg` : '—',
            typeof technicalCylinderSpec?.cylinder?.volume === 'number' ? `${technicalCylinderSpec.cylinder.volume} L` : '—',
          ]],
          sourceLabel: `Manual ${technicalCylinderSpec?.source?.doc || 'M269-00'} · pág. ${technicalCylinderSpec?.source?.page || '117'}`,
          badge: 'Tabela',
        });
      }

      aids.push(
        {
          kind: 'image',
          id: 'mkiv-protection-pad-check-valve',
          title: 'Protection pad · banjo unions',
          description: 'Peça do sistema Leafield usada como referência visual ao confirmar as uniões de banjo e a respetiva proteção.',
          src: '/manual-parts/50067002.jpg',
          alt: 'Imagem do manual da protection pad das uniões de banjo',
          sourceLabel: 'Manual / parts library MKIV',
          badge: 'Foto real',
        },
        {
          kind: 'image',
          id: 'mkiv-protection-pad-inboard',
          title: 'Protection pad · operating head (inboard)',
          description: 'Pad de proteção do operating head pelo lado interior, útil para confirmar desgaste, montagem e posicionamento do conjunto.',
          src: '/manual-parts/50067003.jpg',
          alt: 'Imagem do manual da protection pad do operating head inboard',
          sourceLabel: 'Manual / parts library MKIV',
          badge: 'Foto real',
        },
        {
          kind: 'image',
          id: 'mkiv-protection-pad-outboard',
          title: 'Protection pad · operating head (outboard)',
          description: 'Pad de proteção do operating head pelo lado exterior, para confirmar integridade e assentamento do conjunto.',
          src: '/manual-parts/50067006.jpg',
          alt: 'Imagem do manual da protection pad do operating head outboard',
          sourceLabel: 'Manual / parts library MKIV',
          badge: 'Foto real',
        }
      );
    }

    if (title === 'Contentor' && selectedContainerSpecs.length > 0) {
      aids.push({
        kind: 'table',
        id: 'container-manual-specs',
        title: 'Tabela do contentor selecionado',
        description: 'Dimensões e peso diretamente do manual para o contentor/lotação/pack ativos nesta ficha.',
        columns: ['Config.', 'Comprimento', 'Diâmetro/Largura', 'Altura', 'Peso', 'Pág.'],
        rows: selectedContainerSpecs.map((spec) => [
          spec.launchType === 'throwover' ? 'TO' : spec.launchType === 'davit' ? 'DL' : 'Flat',
          spec.comprimentoMm ? `${spec.comprimentoMm} mm` : '—',
          spec.diametroMm ? `${spec.diametroMm} mm` : spec.larguraMm ? `${spec.larguraMm} mm` : '—',
          spec.alturaMm ? `${spec.alturaMm} mm` : '—',
          spec.pesoKg ? `${spec.pesoKg} kg` : '—',
          spec.page || '—',
        ]),
        sourceLabel: 'Manual MK IV · pág. 108–113',
        badge: 'Tabela',
      });
    }

    if (isMkivChecklistVisual && title === 'Fecho e Acondicionamento MKIV') {
      aids.push({
        kind: 'note',
        id: 'mkiv-folding-note',
        title: 'Esquema operacional de folding',
        description: 'Usa este passo com o contentor e a retenida já confirmados: primeiro segurar equipamento interior, depois painter/fecho e só no fim concluir etiquetas e marcações de serviço.',
        sourceLabel: 'Sequência operacional adaptada do manual MKIV para a estação dos Açores',
        badge: 'Esquema',
      });
    }

    if (title === 'Boletins de Serviço MKIV' && applicableServiceBulletins.length > 0) {
      aids.push({
        kind: 'table',
        id: 'mkiv-bulletins-summary-table',
        title: 'Resumo dos boletins aplicáveis nesta jangada',
        description: 'Quadro rápido para orientar a conferência documental e operacional antes de marcar cada boletim como aplicado.',
        columns: ['Boletim', 'Âmbito', 'Ação operacional'],
        rows: applicableServiceBulletins.map((bulletin) => [
          String(bulletin.bulletinNumber || bulletin.id),
          String(bulletin.matchedRuleLabel || 'Família aplicável'),
          String(bulletin.shortDescription || bulletin.reason || 'Confirmar embodiment no PDF'),
        ]),
        sourceLabel: 'Boletins aplicáveis calculados na ficha',
        badge: 'Tabela',
      });

      if (sb4621LayoutGuide?.figurePath) {
        aids.push({
          kind: 'image',
          id: 'mkiv-bulletin-sb4621-layout',
          title: `SB 46/21 · ${sb4621LayoutGuide.title}`,
          description: sb4621LayoutGuide.subtitle,
          src: sb4621LayoutGuide.figurePath,
          alt: `Esquema do boletim SB 46/21 para ${sb4621LayoutGuide.title}`,
          sourceLabel: `SB 46/21 Ver.2 · figura pág. ${sb4621LayoutGuide.figurePage || '—'}`,
          badge: 'Esquema',
        });
      }
    }

    return aids;
  }, [
    currentChecklistWizardSection,
    form.brand,
    raft?.brand,
    form.model,
    raft?.model,
    technicalCylinderSpec,
    currentCapacity,
    currentPackLabel,
    form.launchType,
    raft?.launchType,
    selectedContainerSpecs,
    applicableServiceBulletins,
    sb4621LayoutGuide,
  ]);

  const currentChecklistFieldVisualAids = useMemo<Record<string, ChecklistVisualAid[]>>(() => {
    if (!currentChecklistWizardSection) return {};

    const fieldAidMap: Record<string, ChecklistVisualAid[]> = {};
    const pushFieldAid = (fieldName: string, aid: ChecklistVisualAid) => {
      if (!fieldAidMap[fieldName]) fieldAidMap[fieldName] = [];
      fieldAidMap[fieldName].push(aid);
    };

    const checklistVisualBrandModel = normalizeText(`${String(form.brand || raft?.brand || '')} ${String(form.model || raft?.model || '')}`);
    const isMkivChecklistVisual =
      checklistVisualBrandModel.includes('surviva') ||
      checklistVisualBrandModel.includes('mkiv') ||
      checklistVisualBrandModel.includes('mk iv') ||
      checklistVisualBrandModel.includes('mk4') ||
      checklistVisualBrandModel.includes('lr07');
    const isLr97ChecklistVisual = checklistVisualBrandModel.includes('lr97');
    const reliefValveVariant = resolveMkivReliefValveVariant(String(form.valvulasAlivio || raft?.valvulasAlivio || ''));

    if (isMkivChecklistVisual) {
      pushFieldAid('luz_exterior_bateria', {
        kind: 'image',
        id: 'field-mkiv-top-light',
        title: 'Luz exterior RL5',
        description: 'Confirmar corpo, lente e proteção da top light antes de fechar o passo.',
        src: '/manual-parts/12870009.jpg',
        alt: 'Imagem do manual da luz exterior RL5',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto',
      });

      pushFieldAid('quadro_sinais', {
        kind: 'image',
        id: 'field-mkiv-signal-table',
        title: 'Quadro de sinais',
        description: 'Referência rápida para validar o artigo visualmente dentro do pack/manual.',
        src: '/manual-parts/02176011.jpg',
        alt: 'Imagem do manual do quadro de sinais',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto',
      });

      pushFieldAid('manual_instrucoes', {
        kind: 'note',
        id: 'field-mkiv-manual-note',
        title: 'Fecho do trio documental',
        description: 'Ao validar o manual, fecha no mesmo gesto o quadro de sinais e a luz interior — são os três itens que mais costumam ficar pendentes no interior.',
        sourceLabel: 'Sequência operacional MKIV',
        badge: 'Nota',
      });

      pushFieldAid('luz_interior_bateria', {
        kind: 'image',
        id: 'field-mkiv-inside-light',
        title: 'Luz interior RL5',
        description: 'Confirma a unidade interior e o conjunto bateria antes de dar este ponto como fechado.',
        src: '/manual-parts/12869009.jpg',
        alt: 'Imagem do manual da luz interior RL5',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto',
      });

      pushFieldAid('bateria_litio', {
        kind: 'image',
        id: 'field-mkiv-battery-inside-light',
        title: 'Conjunto bateria / luz interior',
        description: 'Usa esta imagem como referência cruzada quando estiveres a validar a bateria ligada à luz interior.',
        src: '/manual-parts/12869009.jpg',
        alt: 'Imagem do manual do conjunto luz interior e bateria',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto',
      });

      const inflationFieldNames = ['valvulas_seguranca', 'valvulas_insuflacao', 'valvulas_atestar_interior', 'cabeca_disparo', 'tubos_alta_pressao'];

      for (const fieldName of inflationFieldNames) {
        pushFieldAid(fieldName, {
          kind: 'image',
          id: `${fieldName}-mkiv-pad-check-valve`,
          title: 'Protection pad · banjo unions',
          description: 'Peça de referência para confirmar a zona das uniões de banjo e respetiva proteção associada a este item.',
          src: '/manual-parts/50067002.jpg',
          alt: 'Imagem do manual da protection pad das uniões de banjo',
          sourceLabel: 'Manual / parts library MKIV',
          badge: 'Foto',
        });
      }

      if (reliefValveVariant === 'a10') {
        pushFieldAid('valvulas_seguranca', {
          kind: 'image',
          id: 'field-mkiv-a10-prv',
          title: 'Leafield PRV A10',
          description: 'Imagem de referência para a válvula de segurança/alívio A10 instalada nesta jangada.',
          src: '/manual-parts/08223009.jpg',
          alt: 'Imagem do manual da válvula de alívio Leafield A10',
          sourceLabel: 'Manual / parts library MKIV',
          badge: 'Foto',
        });

        pushFieldAid('valvulas_seguranca', {
          kind: 'image',
          id: 'field-mkiv-a10-prv-cap',
          title: 'A10 PRV caps',
          description: 'Referência do tampão/cap da válvula A10 para conferência do conjunto e da quantidade aplicada.',
          src: '/manual-parts/06400009.jpg',
          alt: 'Imagem de referência do tampão A10 PRV cap',
          sourceLabel: 'Manual / tabela de artigos MKIV',
          badge: 'Tabela',
        });
      } else if (reliefValveVariant === 'b10') {
        pushFieldAid('valvulas_seguranca', {
          kind: 'image',
          id: 'field-mkiv-b10-prv',
          title: 'Leafield PRV B10',
          description: 'Imagem de referência para a válvula de segurança/alívio B10 instalada nesta jangada.',
          src: '/manual-parts/08554009.jpg',
          alt: 'Imagem do manual da válvula de alívio Leafield B10',
          sourceLabel: 'Manual / parts library MKIV',
          badge: 'Foto',
        });

        pushFieldAid('valvulas_seguranca', {
          kind: 'image',
          id: 'field-mkiv-b10-prv-cap',
          title: 'B10 PRV caps',
          description: 'Referência do tampão/cap da válvula B10 para validar o conjunto montado na jangada.',
          src: '/manual-parts/08557009.jpg',
          alt: 'Imagem de referência do tampão B10 PRV cap',
          sourceLabel: 'Manual / tabela de artigos MKIV',
          badge: 'Tabela',
        });
      } else {
        pushFieldAid('valvulas_seguranca', {
          kind: 'note',
          id: 'field-mkiv-relief-valve-variant-note',
          title: 'Configuração A10 / B10 por confirmar',
          description: 'Seleciona primeiro a referência em “Válvulas de Alívio” para a checklist mostrar as fotos corretas da válvula de segurança e dos respetivos tampões.',
          sourceLabel: 'Checklist dinâmica MKIV',
          badge: 'Nota',
        });
      }

      pushFieldAid('valvulas_atestar_interior', {
        kind: 'table',
        id: 'field-mkiv-inflate-deflate-test-valve-refs',
        title: 'Inflate/deflate valve e test valve',
        description: 'Referências do manual para o conjunto de atestar/deflação e para os componentes associados ao circuito de teste.',
        columns: ['Componente', 'Referência', 'Aplicação'],
        rows: [
          ['Inflate/deflate valve', 'DSB00812180', 'Upper / lower buoyancy e arch tube'],
          ['Inflate/deflate valve cap', 'DSB00810070', 'Upper / lower buoyancy e arch tube'],
          ['GIST inlet chk valve 2.2 mm', '08423009', 'Lower buoyancy · circuito de teste'],
          ['GIST inlet chk valve 2.8 mm', '08424009', 'Upper buoyancy · circuito de teste'],
        ],
        sourceLabel: 'Manual RFD ISO 9650 · lista de peças da inflação',
        badge: 'Tabela',
      });

      pushFieldAid('valvulas_atestar_interior', {
        kind: 'image',
        id: 'field-mkiv-test-valve-lower',
        title: 'Test valve / inlet check valve 2.2 mm',
        description: 'Referência visual do componente GIST 08423009 usado na lower buoyancy, associado ao circuito de teste / atesto.',
        src: '/manual-parts/08423009.jpg',
        alt: 'Imagem do manual do GIST inlet check valve 2.2 mm',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto',
      });

      pushFieldAid('valvulas_atestar_interior', {
        kind: 'image',
        id: 'field-mkiv-test-valve-upper',
        title: 'Test valve / inlet check valve 2.8 mm',
        description: 'Referência visual do componente GIST 08424009 usado na upper buoyancy, associado ao circuito de teste / atesto.',
        src: '/manual-parts/08424009.jpg',
        alt: 'Imagem do manual do GIST inlet check valve 2.8 mm',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto',
      });

      pushFieldAid('valvulas_atestar_interior', {
        kind: 'note',
        id: 'field-mkiv-inflate-deflate-photo-note',
        title: 'Leitura correta deste ponto',
        description: 'Neste item da checklist, lê “válvulas de atestar” como o conjunto inflate/deflate valve + test valve. A parts library disponível mostra os inlet check valves do circuito de teste; a referência direta da inflate/deflate valve aparece na tabela acima.',
        sourceLabel: 'Checklist dinâmica MKIV',
        badge: 'Nota',
      });

      pushFieldAid('cabeca_disparo', {
        kind: 'image',
        id: 'field-mkiv-operating-head-inboard',
        title: 'Protection pad · operating head (inboard)',
        description: 'Referência visual do pad de proteção do operating head pelo lado interior.',
        src: '/manual-parts/50067003.jpg',
        alt: 'Imagem do manual da protection pad do operating head inboard',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto',
      });

      pushFieldAid('cabeca_disparo', {
        kind: 'image',
        id: 'field-mkiv-operating-head-outboard',
        title: 'Protection pad · operating head (outboard)',
        description: 'Referência visual do pad de proteção do operating head pelo lado exterior.',
        src: '/manual-parts/50067006.jpg',
        alt: 'Imagem do manual da protection pad do operating head outboard',
        sourceLabel: 'Manual / parts library MKIV',
        badge: 'Foto',
      });

      if (technicalCylinderSpec?.source?.page || technicalCylinderSpec?.cylinder) {
        pushFieldAid('cilindro_co2', {
          kind: 'table',
          id: 'field-mkiv-cylinder-spec',
          title: 'Linha técnica do cilindro',
          description: 'Resumo da configuração nominal da jangada atual para fechar o registo do cilindro com confiança.',
          columns: ['Cap.', 'Pack', 'Config.', 'CO₂', 'N₂', 'Volume'],
          rows: [[
            String(technicalCylinderSpec?.capacity || currentCapacity || '—'),
            String(technicalCylinderSpec?.pack || currentPackLabel || '—'),
            String(technicalCylinderSpec?.configuration || form.launchType || raft?.launchType || 'TO'),
            typeof technicalCylinderSpec?.cylinder?.co2 === 'number' ? `${technicalCylinderSpec.cylinder.co2} kg` : '—',
            typeof technicalCylinderSpec?.cylinder?.n2 === 'number' ? `${technicalCylinderSpec.cylinder.n2} kg` : '—',
            typeof technicalCylinderSpec?.cylinder?.volume === 'number' ? `${technicalCylinderSpec.cylinder.volume} L` : '—',
          ]],
          sourceLabel: `Manual ${technicalCylinderSpec?.source?.doc || 'M269-00'} · pág. ${technicalCylinderSpec?.source?.page || '117'}`,
          badge: 'Tabela',
        });
      }

      pushFieldAid('mkiv_folding_per_manual', {
        kind: 'note',
        id: 'field-mkiv-folding-sequence',
        title: 'Sequência de folding',
        description: 'Primeiro segurar equipamento interior, depois painter/fecho e só no fim concluir etiquetas e marcações de serviço.',
        sourceLabel: 'Sequência operacional adaptada do manual MKIV',
        badge: 'Esquema',
      });

      pushFieldAid('mkiv_container_closed_without_defects', {
        kind: 'note',
        id: 'field-mkiv-closing-sequence',
        title: 'Fecho final do contentor',
        description: 'Fecha este item apenas depois da retenida, cintas e etiquetas estarem conferidas em conjunto.',
        sourceLabel: 'Fecho operacional MKIV',
        badge: 'Nota',
      });
    }

    if (selectedContainerSpecs.length > 0) {
      const containerFields = [packagingClosureFieldName, 'saco_retenida', 'comprimento_retenida', 'marcas_involucro'];
      for (const fieldName of containerFields) {
        pushFieldAid(fieldName, {
          kind: 'table',
          id: `field-container-specs-${fieldName}`,
          title: isValiseContainer ? 'Dimensões da valise selecionada' : 'Dimensões do contentor selecionado',
          description: isValiseContainer
            ? 'Tabela do manual para confirmar se a valise/pack ativa bate certo com a ficha.'
            : 'Tabela do manual para confirmar se o contentor/pack ativo bate certo com a ficha.',
          columns: ['Config.', 'Comprimento', 'Diâmetro/Largura', 'Altura', 'Peso', 'Pág.'],
          rows: selectedContainerSpecs.map((spec) => [
            spec.launchType === 'throwover' ? 'TO' : spec.launchType === 'davit' ? 'DL' : 'Flat',
            spec.comprimentoMm ? `${spec.comprimentoMm} mm` : '—',
            spec.diametroMm ? `${spec.diametroMm} mm` : spec.larguraMm ? `${spec.larguraMm} mm` : '—',
            spec.alturaMm ? `${spec.alturaMm} mm` : '—',
            spec.pesoKg ? `${spec.pesoKg} kg` : '—',
            spec.page || '—',
          ]),
          sourceLabel: 'Manual MK IV · pág. 108–113',
          badge: 'Tabela',
        });
      }
    }

    if (isLr97ChecklistVisual) {
      pushFieldAid('valvulas_insuflacao', {
        kind: 'note',
        id: 'field-lr97-inflation-valves-note',
        title: 'Família LR97',
        description: 'A LR97 partilha o mesmo princípio de fecho técnico: confirmar válvula, acoplamento e mangueira como trio antes de fechar o ponto.',
        sourceLabel: 'Regra operacional LR97',
        badge: 'Nota',
      });
    }

    return fieldAidMap;
  }, [
    currentChecklistWizardSection,
    form.brand,
    raft?.brand,
    form.model,
    raft?.model,
    technicalCylinderSpec,
    currentCapacity,
    isValiseContainer,
    packagingClosureFieldName,
    currentPackLabel,
    form.valvulasAlivio,
    raft?.valvulasAlivio,
    form.launchType,
    raft?.launchType,
    selectedContainerSpecs,
  ]);

  const bulletinVisualAidsById = useMemo<Record<string, ChecklistVisualAid[]>>(() => {
    const aidsById: Record<string, ChecklistVisualAid[]> = {};

    aidsById['survitec-mkiv-canopy-zip-sliders-12-21'] = [
      {
        kind: 'table',
        id: 'bulletin-12-21-parts',
        title: 'SB 12/21 · peças e consumíveis-chave',
        description: 'Quando existir corrosão num slider metálico, a substituição é total — não parcial.',
        columns: ['Item', 'Referência', 'Uso'],
        rows: [
          ['Resin zip slider', '12750009', 'Substituição de todos os sliders metálicos da jangada'],
          ['Thread 4 kgf', '02426001', 'Costura / reinstalação'],
          ['Cord 525 lbf · 500 mm', '08110009', 'Remate associado à intervenção'],
        ],
        sourceLabel: 'SB 12/21 Ver.1',
        badge: 'Tabela',
      },
      {
        kind: 'note',
        id: 'bulletin-12-21-note',
        title: 'Critério do boletim',
        description: 'Inspecionar em cada revisão os sliders do canopy; se um slider metálico tiver corrosão, trocar todos os sliders metálicos por resina 12750009 na mesma intervenção.',
        sourceLabel: 'SB 12/21 Ver.1',
        badge: 'Nota',
      },
    ];

    aidsById['survitec-mkiv-servicing-optimisation-43-21'] = [
      {
        kind: 'table',
        id: 'bulletin-43-21-actions',
        title: 'SB 43/21 · frentes de ação',
        description: 'Resumo operacional do que deve ser confirmado no servicing MKIV.',
        columns: ['Tema', 'Quando aplicar', 'Ponto-chave'],
        rows: [
          ['Gasket seal 05606009', 'Em cada revisão programada', 'Substituir com o adesivo revisto'],
          ['Pyro valises', 'Na próxima revisão programada', 'Usar 53769001 / 53770001 / 53771001'],
          ['Bellows valise', 'Na próxima revisão programada', '53793001 obrigatória para bellows tipo pump'],
          ['Canopy zip pullers', 'Quando houver dano/corrosão', 'Não misturar metal e resina; aplicar 12750009'],
        ],
        sourceLabel: 'SB 43/21 Ver.3',
        badge: 'Tabela',
      },
      {
        kind: 'note',
        id: 'bulletin-43-21-note',
        title: 'Registo documental',
        description: 'O próprio PDF continua a pedir a anotação “SB 43/21 Ver.2 APPLIED”, apesar da emissão analisada ser Ver.3 Oct/24.',
        sourceLabel: 'SB 43/21 Ver.3',
        badge: 'Nota',
      },
    ];

    aidsById['survitec-multi-label-sheets-46-21'] = [
      {
        kind: 'table',
        id: 'bulletin-46-21-sheets',
        title: 'SB 46/21 · combinação de folhas',
        description: sb4621LayoutGuide?.subtitle || 'Confirmar a folha multi-etiquetas aplicável ao modelo/contentor atual.',
        columns: ['Configuração', 'Folhas', 'Página'],
        rows: [[
          sb4621LayoutGuide?.title || 'Família aplicável',
          (sb4621LayoutGuide?.sheets || ['Ver PDF']).join(' + '),
          sb4621LayoutGuide?.figurePage ? String(sb4621LayoutGuide.figurePage) : '—',
        ]],
        sourceLabel: 'SB 46/21 Ver.2',
        badge: 'Tabela',
      },
      ...(sb4621LayoutGuide?.figurePath ? [{
        kind: 'image' as const,
        id: 'bulletin-46-21-diagram',
        title: `SB 46/21 · ${sb4621LayoutGuide.title}`,
        description: sb4621LayoutGuide.subtitle,
        src: sb4621LayoutGuide.figurePath,
        alt: `Esquema de aplicação do SB 46/21 para ${sb4621LayoutGuide.title}`,
        sourceLabel: `SB 46/21 Ver.2 · figura pág. ${sb4621LayoutGuide.figurePage || '—'}`,
        badge: 'Esquema',
      }] : []),
      {
        kind: 'note',
        id: 'bulletin-46-21-note',
        title: 'Critério do boletim',
        description: 'Este boletim substitui etiquetas soltas e a fita “do not cut” por folhas multi-etiquetas; a escolha final da folha continua ancorada no PDF.',
        sourceLabel: 'SB 46/21 Ver.2',
        badge: 'Nota',
      },
    ];

    aidsById['survitec-spare-parts-consolidation-12-24'] = [
      {
        kind: 'table',
        id: 'bulletin-12-24-summary',
        title: 'SB 12/24 · famílias consolidadas',
        description: 'O stock antigo continua utilizável; a consolidação entra na próxima encomenda/substituição.',
        columns: ['Família', 'Exemplos antigos', 'Regra operacional'],
        rows: [
          ['Comprimidos anti-enjoo', 'DSB00940350 · Z64514 · 01174009 · Z7406', 'Usar referência consolidada na próxima substituição'],
          ['First aid kits', '15199001 · 12865009 · 06484009 · 12874009', 'Aplicar consolidação em encomendas/substituições futuras'],
          ['RL5 / RL6 / RB2', '12869009 · 12870009 · 12872009 · 08461009', 'Migrar para as referências consolidadas quando houver troca'],
        ],
        sourceLabel: 'SB 12/24 Ver.1',
        badge: 'Tabela',
      },
      {
        kind: 'note',
        id: 'bulletin-12-24-note',
        title: 'Importante na oficina',
        description: 'Não é um boletim para retirar material ainda válido em serviço; é uma regra de consolidação para a próxima reposição ou encomenda.',
        sourceLabel: 'SB 12/24 Ver.1',
        badge: 'Nota',
      },
    ];

    aidsById['survitec-rl6-internal-lamp-76-15'] = [
      {
        kind: 'table',
        id: 'bulletin-76-15-materials',
        title: 'SB 76/15 · materiais da proteção RL6',
        description: 'Aplica-se operacionalmente às lotações 4/6/8 quando não existe evidência documental de embodiment.',
        columns: ['Material', 'Referência', 'Função'],
        rows: [
          ['Folha de polietileno 600 × 300 mm', '01999084', 'Criar a proteção sobre a RL6 interna'],
          ['Fita preta', '04834009', 'Fixação da proteção'],
          ['Registo no cartão', 'SB 76/15 Ver.2 APPLIED', 'Evidência documental'],
        ],
        sourceLabel: 'SB 76/15 Ver.2',
        badge: 'Tabela',
      },
      {
        kind: 'note',
        id: 'bulletin-76-15-note',
        title: 'Objetivo do boletim',
        description: 'Evitar que a hauling-in ladder fique presa entre a RL6 interna e o arch tube, impedindo a insuflação completa do arco.',
        sourceLabel: 'SB 76/15 Ver.2',
        badge: 'Nota',
      },
    ];

    aidsById['survitec-mk16-drain-holes-84-16'] = [
      {
        kind: 'table',
        id: 'bulletin-84-16-scope',
        title: 'SB 84/16 · âmbito operacional',
        description: 'Alertar e confirmar embodiment em contentores flat-pack MK16.',
        columns: ['Contentor', 'Famílias proxy', 'Ação'],
        rows: [['MK16 / MK 16', 'SURVIVA MKIV TO · LR07', 'Criar / verificar furos de drenagem']],
        sourceLabel: 'SB 84/16',
        badge: 'Tabela',
      },
      {
        kind: 'note',
        id: 'bulletin-84-16-note',
        title: 'Regra do sistema',
        description: 'Enquanto a ficha não guardar um estado específico de embodiment por contentor, o alerta mantém-se ativo até o boletim ser marcado como aplicado.',
        sourceLabel: 'SB 84/16',
        badge: 'Nota',
      },
    ];

    return aidsById;
  }, [sb4621LayoutGuide]);

  const renderChecklistVisualAidList = (aids: ChecklistVisualAid[], mode: 'compact' | 'regular' = 'regular') => {
    if (!aids.length) return null;

    const isCompact = mode === 'compact';

    return (
      <div className={isCompact ? 'mt-3 space-y-2' : 'mt-3 grid gap-3 lg:grid-cols-2'}>
        {aids.map((aid) => {
          if (aid.kind === 'image') {
            return (
              <button
                key={aid.id}
                type="button"
                onClick={() => setActiveChecklistImageAid(aid)}
                className={`overflow-hidden rounded-xl border text-left transition hover:border-sky-300 hover:shadow-sm ${isCompact ? 'border-sky-100 bg-sky-50' : 'border-slate-200 bg-white'}`}
              >
                <img src={aid.src} alt={aid.alt} className={`w-full object-cover ${isCompact ? 'max-h-40' : 'max-h-52'}`} />
                <div className="p-3">
                  <div className="flex flex-wrap items-center gap-2">
                    <p className="text-sm font-semibold text-slate-900">{aid.title}</p>
                    {aid.badge ? <span className="rounded-full border border-sky-200 bg-sky-100 px-2 py-0.5 text-[10px] font-semibold text-sky-800">{aid.badge}</span> : null}
                    <span className="ml-auto text-[10px] font-semibold uppercase tracking-wide text-sky-700">Clique para ampliar</span>
                  </div>
                  {aid.description ? <p className="mt-1 text-xs text-slate-600">{aid.description}</p> : null}
                  {aid.sourceLabel ? <p className="mt-2 text-[10px] uppercase tracking-wide text-slate-500">{aid.sourceLabel}</p> : null}
                </div>
              </button>
            );
          }

          if (aid.kind === 'table') {
            return (
              <div key={aid.id} className={`rounded-xl border p-3 ${isCompact ? 'border-sky-100 bg-sky-50' : 'border-slate-200 bg-white'}`}>
                <div className="flex flex-wrap items-center gap-2">
                  <p className="text-sm font-semibold text-slate-900">{aid.title}</p>
                  {aid.badge ? <span className="rounded-full border border-sky-200 bg-sky-100 px-2 py-0.5 text-[10px] font-semibold text-sky-800">{aid.badge}</span> : null}
                </div>
                {aid.description ? <p className="mt-1 text-xs text-slate-600">{aid.description}</p> : null}
                <div className="mt-2 overflow-x-auto">
                  <table className="min-w-full text-xs">
                    <thead>
                      <tr className="bg-white/70 text-slate-600">
                        {aid.columns.map((column) => (
                          <th key={`${aid.id}-${column}`} className="px-2 py-1 text-left font-semibold">{column}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {aid.rows.map((row, rowIndex) => (
                        <tr key={`${aid.id}-row-${rowIndex}`} className="border-t border-slate-200/70">
                          {row.map((cell, cellIndex) => (
                            <td key={`${aid.id}-row-${rowIndex}-cell-${cellIndex}`} className="px-2 py-1 text-slate-700">{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {aid.sourceLabel ? <p className="mt-2 text-[10px] uppercase tracking-wide text-slate-500">{aid.sourceLabel}</p> : null}
              </div>
            );
          }

          return (
            <div key={aid.id} className={`rounded-xl border p-3 ${isCompact ? 'border-sky-100 bg-sky-50' : 'border-slate-200 bg-white'}`}>
              <div className="flex flex-wrap items-center gap-2">
                <p className="text-sm font-semibold text-slate-900">{aid.title}</p>
                {aid.badge ? <span className="rounded-full border border-sky-200 bg-sky-100 px-2 py-0.5 text-[10px] font-semibold text-sky-800">{aid.badge}</span> : null}
              </div>
              <p className="mt-1 text-xs text-slate-600">{aid.description}</p>
              {aid.sourceLabel ? <p className="mt-2 text-[10px] uppercase tracking-wide text-slate-500">{aid.sourceLabel}</p> : null}
            </div>
          );
        })}
      </div>
    );
  };

  useEffect(() => {
    if (!inspectionMode) return;
    if (!checklistWizardSections.length) return;
    if (inspectionWizardAutoPositionedRef.current) return;

    const firstIncompleteIndex = checklistWizardSections.findIndex((section) => section.completedFields < section.totalFields);
    setInspectionWizardStep(firstIncompleteIndex >= 0 ? firstIncompleteIndex : 0);
    inspectionWizardAutoPositionedRef.current = true;
  }, [inspectionMode, checklistWizardSections]);

  const renderBrandField = () => {
    const value = String(form.brand || '').trim();
    const dirty = isFieldDirty('brand', form.brand, raft?.brand);

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel('Marca', dirty)}
        {edit && brandFieldOptions.length > 0 ? (
          <select
            className="w-full border rounded px-2 py-1 text-sm bg-white"
            value={value}
            onChange={(e) => handleChange('brand', e.target.value)}
          >
            <option value="">Selecionar marca...</option>
            {brandFieldOptions.map((option) => (
              <option key={option} value={option}>{option}</option>
            ))}
          </select>
        ) : edit ? (
          <input
            className="w-full border rounded px-2 py-1 text-sm"
            value={value}
            onChange={(e) => handleChange('brand', e.target.value)}
          />
        ) : (
          <p className="text-sm text-gray-900">{value || String(raft?.brand || '—')}</p>
        )}
      </div>
    );
  };

  const renderModelField = () => {
    const value = String(form.model || '').trim();
    const dirty = isFieldDirty('model', form.model, raft?.model);

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel('Modelo', dirty)}
        {edit && modelCatalogOptions.length > 0 ? (
          <select
            className="w-full border rounded px-2 py-1 text-sm bg-white"
            value={value}
            onChange={(e) => handleChange('model', e.target.value)}
          >
            <option value="">Selecionar modelo...</option>
            {modelCatalogOptions.map((option) => (
              <option key={option} value={option}>{option}</option>
            ))}
          </select>
        ) : edit ? (
          <input
            className="w-full border rounded px-2 py-1 text-sm"
            value={value}
            onChange={(e) => handleChange('model', e.target.value)}
          />
        ) : (
          <p className="text-sm text-gray-900">{value || String(raft?.model || '—')}</p>
        )}
      </div>
    );
  };

  const renderContainerField = () => (
    <div className={getFieldCardClass(isFieldDirty('containerModel', form.containerModel, raft?.containerModel))}>
      {renderFieldLabel(isEurovinilFicha ? "Configuração (Contentor / Valise)" : "Contentor / Container", isFieldDirty('containerModel', form.containerModel, raft?.containerModel))}
      {edit ? (
        <select
          className="w-full border rounded px-2 py-1 text-sm bg-white"
          value={String(form.containerModel || '')}
          onChange={(e) => handleChange('containerModel', e.target.value)}
        >
          <option value="">Selecionar contentor...</option>
          {(isEurovinilFicha
            ? [...EUROVINIL_CONTAINER_OPTIONS]
            : containerFieldOptions.length > 0
              ? containerFieldOptions
              : [...CONTAINER_MODEL_OPTIONS]
          ).map((option) => (
            <option key={option} value={option}>
              {option === 'CONTENTOR'
                ? 'Contentor'
                : option === 'VALISE'
                  ? 'Valise'
                  : option === 'ABS'
                    ? 'ABS'
                    : option === 'FIBRA DE VIDRO'
                      ? 'Fibra de vidro'
                      : option}
            </option>
          ))}
        </select>
      ) : (
        <p className="text-sm text-gray-900">{selectedContainerModel || "—"}</p>
      )}
    </div>
  );

  const renderLaunchTypeField = () => {
    const value = normalizeLaunchTypeValue(String(form.launchType || raft?.launchType || ''));
    const dirty = isFieldDirty('launchType', form.launchType, raft?.launchType);

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel('Configuração TO / DL', dirty)}
        {edit ? (
          <select
            className="w-full border rounded px-2 py-1 text-sm bg-white"
            value={value}
            onChange={(e) => handleChange("launchType", e.target.value)}
          >
            <option value="">Selecionar configuração...</option>
            {(launchTypeOptions.length > 0 ? launchTypeOptions : ['TO', 'DL']).map((option) => (
              <option key={option} value={option}>{option}</option>
            ))}
          </select>
        ) : (
          <p className="text-sm text-gray-900">{value || "—"}</p>
        )}
      </div>
    );
  };

  const renderHruApplicableField = () => {
    const computedFromData = Boolean(
      String(form.hruReferencia || raft?.hruReferencia || "").trim() ||
      String(form.hruDataInstalacao || raft?.hruDataInstalacao || "").trim() ||
      String(form.hruValidade || raft?.hruValidade || "").trim()
    );

    const value = String(
      form.hruAplicavel || (computedFromData ? "SIM" : "NAO")
    ).toUpperCase();

    const dirty = isFieldDirty("hruAplicavel", form.hruAplicavel, undefined);

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel("HRU aplicável", dirty)}
        {edit ? (
          <select
            className="w-full border rounded px-2 py-1 text-sm bg-white"
            value={value}
            onChange={(e) => handleChange("hruAplicavel", e.target.value)}
          >
            <option value="SIM">Sim</option>
            <option value="NAO">Não</option>
          </select>
        ) : (
          <p className="text-sm text-gray-900">{value === "SIM" ? "Sim" : "Não"}</p>
        )}
      </div>
    );
  };

  const renderFabricTypeField = () => {
    const value = String(form.fabricType || raft?.fabricType || '').trim();
    const dirty = isFieldDirty('fabricType', form.fabricType, raft?.fabricType);

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel('Tipo de Tela', dirty)}
        {edit ? (
          fabricTypeOptions.length > 0 ? (
            <select
              className="w-full border rounded px-2 py-1 text-sm bg-white"
              value={value}
              onChange={(e) => handleChange('fabricType', e.target.value)}
            >
              <option value="">Selecionar tipo de tela...</option>
              {fabricTypeOptions.map((option) => (
                <option key={option} value={option}>{option}</option>
              ))}
            </select>
          ) : (
            <select
              className="w-full border rounded px-2 py-1 text-sm bg-white"
              value={value}
              onChange={(e) => handleChange("fabricType", e.target.value)}
            >
              <option value="">Selecionar tipo de tela...</option>
              <option value="PU">PU (Polyurethane)</option>
              <option value="NR">NR (Natural Rubber)</option>
              <option value="PVC">PVC</option>
            </select>
          )
        ) : (
          <p className="text-sm text-gray-900">{value || "—"}</p>
        )}
      </div>
    );
  };

  const renderPackTypeField = () => {
    const value = String(form.packType || '').trim();
    const dirty = isFieldDirty('packType', form.packType, raft?.packType);

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel('Tipo de Pack', dirty)}
        {edit && packTypeOptions.length > 0 ? (
          <select
            className="w-full border rounded px-2 py-1 text-sm bg-white"
            value={value}
            onChange={(e) => handleChange('packType', e.target.value)}
          >
            <option value="">Selecionar pack...</option>
            {packTypeOptions.map((option) => (
              <option key={option} value={option}>{option}</option>
            ))}
          </select>
        ) : edit ? (
          <input
            className="w-full border rounded px-2 py-1 text-sm"
            value={value}
            onChange={(e) => handleChange('packType', e.target.value)}
          />
        ) : (
          <p className="text-sm text-gray-900">{value || String(raft?.packType || '—')}</p>
        )}
      </div>
    );
  };

  const renderPainterLengthField = () => {
    const value = normalizePainterLengthDisplay(String(form.painterLength || '')).trim();
    const dirty = isFieldDirty('painterLength', form.painterLength, raft?.painterLength);

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel('Comprimento da Retenida', dirty)}
        {edit && painterLengthOptions.length > 0 ? (
          <select
            className="w-full border rounded px-2 py-1 text-sm bg-white"
            value={value}
            onChange={(e) => handleChange('painterLength', e.target.value)}
          >
            <option value="">Selecionar comprimento...</option>
            {painterLengthOptions.map((option) => (
              <option key={option} value={option}>{option}</option>
            ))}
          </select>
        ) : edit ? (
          <input
            className="w-full border rounded px-2 py-1 text-sm"
            value={value}
            onChange={(e) => handleChange('painterLength', e.target.value)}
          />
        ) : (
          <p className="text-sm text-gray-900">{value || normalizePainterLengthDisplay(String(raft?.painterLength || '')) || '—'}</p>
        )}
      </div>
    );
  };

  const renderInflationSystemField = () => {
    const value = String(form.cylinderSistema || raft?.cylinderSistema || '').trim();
    const dirty = isFieldDirty('cylinderSistema', form.cylinderSistema, raft?.cylinderSistema);

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel('Sistema', dirty)}
        {edit ? (
          <select
            className="w-full border rounded px-2 py-1 text-sm bg-white"
            value={value}
            onChange={(e) => handleChange('cylinderSistema', e.target.value)}
          >
            <option value="">Selecionar sistema...</option>
            {inflationSystemOptions.map((option) => (
              <option key={option} value={option}>{option}</option>
            ))}
          </select>
        ) : (
          <p className="text-sm text-gray-900">{value || '—'}</p>
        )}
      </div>
    );
  };

  const renderTechnicalStockQuickSelector = (
    title: string,
    items: Array<{ name: string; reference?: string; notes?: string }>,
    onSelect: (artigo: { name: string; referencia: string; codigoFabricante: string }) => void,
    onAddAccessory?: (artigo: { name: string; referencia: string; codigoFabricante: string }) => void
  ) => {
    if (!edit || items.length === 0) return null;

    return (
      <div className="mt-3 rounded-lg border border-blue-100 bg-blue-50 p-3">
        <p className="text-xs font-semibold uppercase tracking-wide text-blue-700 mb-2">{title}</p>
        <div className="flex flex-wrap gap-2">
          {items.map((item) => {
            const reference = String(item.reference || '').trim();
            if (!reference) return null;
            const stockItem = stockMapByReferencia[normalizeReference(reference)] || stockMapByCodigoFabricante[normalizeReference(reference)];
            const descricao = stockItem?.descricao || item.name;
            const codigoFabricante = stockItem?.codigoFabricante || reference;
            return (
              <div key={`${title}-${reference}`} className="inline-flex rounded border border-blue-200 bg-white overflow-hidden shadow-sm">
                <button
                  type="button"
                  className="px-2 py-1 text-xs text-blue-800 hover:bg-blue-100"
                  onClick={() => onSelect({ name: descricao, referencia: reference, codigoFabricante })}
                  title={item.notes || item.name}
                >
                  {buildStockSelectorLabel({ referencia: reference, descricao, codigoFabricante })}
                </button>
                {onAddAccessory && (
                  <button
                    type="button"
                    className="border-l border-blue-200 px-2 py-1 text-xs text-indigo-700 bg-indigo-50 hover:bg-indigo-100 font-medium"
                    onClick={() => onAddAccessory({ name: descricao, referencia: reference, codigoFabricante })}
                    title={`Adicionar ${reference} como acessório`}
                  >
                    +Aces.
                  </button>
                )}
              </div>
            );
          })}
        </div>
      </div>
    );
  };

  const renderFiringHeadField = () => {
    const value = String(form.cylinderCabecaDisparoRef || raft?.cylinderCabecaDisparoRef || '').trim();
    const dirty = isFieldDirty('cylinderCabecaDisparoRef', form.cylinderCabecaDisparoRef, raft?.cylinderCabecaDisparoRef)
      || isFieldDirty('cylinderCabecaDisparoDescricao', form.cylinderCabecaDisparoDescricao, raft?.cylinderCabecaDisparoDescricao);

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel('Cabeça de Disparo (Ref.)', dirty)}
        {edit ? (
          <select
            className="w-full border rounded px-2 py-1 text-sm bg-white"
            value={value}
            onChange={(e) => {
              const referencia = e.target.value;
              const selected = firingHeadOptions.find((item) => item.referencia === referencia);
              setForm((prev: FormState) => {
                const next: FormState = {
                  ...prev,
                  cylinderCabecaDisparoRef: referencia,
                  cylinderCabecaDisparoDescricao: selected?.descricao || '',
                };
                scheduleAutosave(next);
                return next;
              });
            }}
          >
            <option value="">Selecionar cabeça de disparo...</option>
            {firingHeadOptions.map((option) => (
              <option key={option.referencia} value={option.referencia}>
                {buildStockSelectorLabel({ referencia: option.referencia, descricao: option.descricao, codigoFabricante: option.codigoFabricante })}
              </option>
            ))}
          </select>
        ) : (
          <p className="text-sm text-gray-900">{value || '—'}</p>
        )}
      </div>
    );
  };

  const renderShipField = () => {
    const selectedShip = resolveSelectedShip(form) || resolveSelectedShip(raft);
    const shipName = String(selectedShip?.nome || form.shipNameManual || raft?.shipDetails?.nome || raft?.shipNameManual || "-");
    const dirty = isFieldDirty('shipNameManual', form.shipNameManual, raft?.shipNameManual)
      || isFieldDirty('shipId', form.shipId, raft?.shipId);

    const applyShipSelection = (valueRaw: string) => {
      const selectedId = Number(valueRaw || 0);
      setForm((prev) => {
        const next: FormState = { ...prev };
        const previousShipProfile: InspectionShipProfile | null = resolveSelectedShip(prev) || raft?.shipDetails || null;

        if (!Number.isFinite(selectedId) || selectedId <= 0) {
          next.shipId = "";
          next.shipNameManual = "";
        } else {
          const navio = naviosLookup.find((item) => item.id === selectedId);
          if (!navio) return prev;

          next.shipId = navio.id;
          next.shipNameManual = navio.nome;
          const suggestedOwner = String(navio.proprietario || navio.cliente?.nome || '').trim();
          if (suggestedOwner) next.owner = suggestedOwner;
        }

        if (canEditField('dataProxInspecao')) {
          const inspectionBase = String(next.dataInspecao || raft?.dataInspecao || '').trim();
          const previousRecommendedNextInspection = getRecommendedNextInspectionDate(
            String(prev.dataInspecao || raft?.dataInspecao || '').trim(),
            String(prev.brand || raft?.brand || '').trim(),
          );
          const recommendedNextInspection = getRecommendedNextInspectionDate(inspectionBase, String(next.brand || raft?.brand || '').trim());

          if (recommendedNextInspection && shouldAutoUpdateNextInspection(next.dataProxInspecao, previousRecommendedNextInspection)) {
            next.dataProxInspecao = recommendedNextInspection;
          }
        }

        scheduleAutosave(next);
        return next;
      });
    };

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel('Navio', dirty)}
        {edit && (canEditField('shipId') || canEditField('shipNameManual')) ? (
          <>
            <select
              className="w-full border rounded px-2 py-1 text-sm"
              value={selectedShip?.id ? String(selectedShip.id) : ""}
              onChange={(e) => applyShipSelection(e.target.value)}
            >
              <option value="">Sem navio associado</option>
              {sortedNaviosLookup.map((navio) => (
                <option key={navio.id} value={String(navio.id)}>
                  {`${navio.nome}${navio.matricula ? ` · ${navio.matricula}` : ''}`}
                </option>
              ))}
            </select>
            <p className="mt-1 text-xs text-amber-700">
              O navio desta jangada fica sempre sincronizado com a ficha do navio associado.
            </p>
          </>
        ) : selectedShip?.id ? (
          <Link href={`/navios/${selectedShip.id}`} className="text-sm font-medium text-blue-700 hover:underline">
            {shipName}
          </Link>
        ) : (
          <p className="text-sm text-gray-900">{shipName}</p>
        )}
      </div>
    );
  };

  const renderOwnerField = () => {
    const ownerName = String(form.owner || raft?.ownerDisplay || raft?.owner || "-");
    const ownerClientId = raft?.ownerClientId;
    const dirty = isFieldDirty('owner', form.owner, raft?.owner);

    return (
      <div className={getFieldCardClass(dirty)}>
        {renderFieldLabel('Proprietário', dirty)}
        {edit && canEditField('owner') ? (
          <input
            className="w-full border rounded px-2 py-1 text-sm"
            value={ownerName === "-" ? "" : ownerName}
            onChange={(e) => handleChange("owner", e.target.value)}
          />
        ) : ownerClientId ? (
          <Link href={`/clientes/${ownerClientId}`} className="text-sm font-medium text-blue-700 hover:underline">
            {ownerName}
          </Link>
        ) : (
          <p className="text-sm text-gray-900">{ownerName}</p>
        )}
      </div>
    );
  };

  const formatTechnicalValue = (value: any) => {
    if (value === null || value === undefined || value === "") return "—";
    if (typeof value === "boolean") return value ? "Sim" : "Não";
    if (typeof value === "number") return String(value);
    if (typeof value === "string") {
      const parsed = Date.parse(value);
      if (!Number.isNaN(parsed) && /\d{4}-\d{2}-\d{2}/.test(value)) {
        return formatDatePt(value);
      }
      return value;
    }
    return JSON.stringify(value, null, 2);
  };

  const formArtigos = normalizeArtigos(form.artigos);
  const cabecaDisparoRef = normalizeReference(String(form.cylinderCabecaDisparoRef || raft?.cylinderCabecaDisparoRef || ""));
  const cabecaDisparoStock = cabecaDisparoRef
    ? stockMapByReferencia[cabecaDisparoRef] || stockMapByCodigoFabricante[cabecaDisparoRef]
    : undefined;
  const valvulaAlivioRef = normalizeReference(String(form.valvulasAlivio || raft?.valvulasAlivio || ""));
  const valvulaAlivioStock = valvulaAlivioRef
    ? stockMapByReferencia[valvulaAlivioRef] || stockMapByCodigoFabricante[valvulaAlivioRef]
    : undefined;
  const valvulaAtestarRef = normalizeReference(String(form.valvulasAtestar || raft?.valvulasAtestar || ""));
  const valvulaAtestarStock = valvulaAtestarRef
    ? stockMapByReferencia[valvulaAtestarRef] || stockMapByCodigoFabricante[valvulaAtestarRef]
    : undefined;
  const tuboSuperiorRef = normalizeReference(String(form.cylinderTuboCamaraSuperiorRef || raft?.cylinderTuboCamaraSuperiorRef || ""));
  const tuboSuperiorStock = tuboSuperiorRef
    ? stockMapByReferencia[tuboSuperiorRef] || stockMapByCodigoFabricante[tuboSuperiorRef]
    : undefined;
  const tuboInferiorRef = normalizeReference(String(form.cylinderTuboCamaraInferiorRef || raft?.cylinderTuboCamaraInferiorRef || ""));
  const tuboInferiorStock = tuboInferiorRef
    ? stockMapByReferencia[tuboInferiorRef] || stockMapByCodigoFabricante[tuboInferiorRef]
    : undefined;
  const acessoriosSuperior = parseStockSelectionList(form.cylinderAcessoriosCamaraSuperiorJson ?? raft?.cylinderAcessoriosCamaraSuperiorJson);
  const acessoriosInferior = parseStockSelectionList(form.cylinderAcessoriosCamaraInferiorJson ?? raft?.cylinderAcessoriosCamaraInferiorJson);
  const sistemaSelecionado = normalizeText(String(form.cylinderSistema || raft?.cylinderSistema || ""));
  const marcaAtual = normalizeText(String(form.brand || raft?.brand || ""));
  const modeloAtual = normalizeText(String(form.model || raft?.model || ""));
  const fichaMarcaModelo = `${marcaAtual} ${modeloAtual}`.trim();
  const isMkivFicha =
    fichaMarcaModelo.includes("mkiv") ||
    fichaMarcaModelo.includes("mk iv") ||
    fichaMarcaModelo.includes("lr07");
  const isLr97Ficha = fichaMarcaModelo.includes("lr97");
  const fichaTokens = useMemo(() => {
    return Array.from(
      new Set(
        `${marcaAtual} ${modeloAtual}`
          .split(/[^a-z0-9]+/i)
          .map((token) => normalizeText(token))
          .filter((token) => token.length >= 3)
      )
    );
  }, [marcaAtual, modeloAtual]);

  const itemMatchesFicha = (item: StockLookupItem, family: "mkiv" | "lr97") => {
    const blob = normalizeText(
      `${item.referencia} ${item.codigoFabricante || ""} ${item.descricao || ""} ${item.categoria || ""} ${item.aplicavelModeloJangada || ""}`
    );
    const applicable = normalizeText(String(item.aplicavelModeloJangada || ""));
    const familyTokens = family === "mkiv"
      ? ["mkiv", "mk iv", "surviva", "leafield", "gist"]
      : ["lr97"];
    const tokensToMatch = Array.from(new Set([...fichaTokens, ...familyTokens]));
    const hasApplicable = !!applicable;
    const applicableMatches = !hasApplicable || tokensToMatch.some((token) => applicable.includes(token));
    const blobMatches = tokensToMatch.some((token) => blob.includes(token));

    if (family === "mkiv" && blob.includes("lr97")) return false;
    if (family === "lr97" && blob.includes("mkiv") && !blob.includes("lr97")) return false;
    if (hasApplicable && !applicableMatches) return false;

    return applicableMatches && (blobMatches || getSystemCompatibilityScore(item) > 0);
  };

  const getSystemCompatibilityScore = (item: StockLookupItem) => {
    const blob = `${item.referencia} ${item.codigoFabricante || ""} ${item.descricao || ""} ${item.categoria || ""} ${item.aplicavelModeloJangada || ""}`.toLowerCase();
    if (!sistemaSelecionado) return 0;

    const sistemaMap: Record<string, string[]> = {
      gist: ["gist"],
      leafield: ["leafield", "leaf"],
      tanner: ["tanner", "thanner"],
    };

    let sistemaKey: keyof typeof sistemaMap | null = null;
    if (sistemaSelecionado.includes("gist")) sistemaKey = "gist";
    else if (sistemaSelecionado.includes("leafield") || sistemaSelecionado.includes("leaf")) sistemaKey = "leafield";
    else if (sistemaSelecionado.includes("tanner") || sistemaSelecionado.includes("thanner")) sistemaKey = "tanner";

    if (!sistemaKey) return 0;
    const tokens = sistemaMap[sistemaKey];
    return tokens.some((t) => blob.includes(t)) ? 100 : 0;
  };

  const mkivGistLeafieldSugestoes = useMemo(() => {
    if (!isMkivFicha) return [];
    const candidatos = new Map<string, StockLookupItem>();
    const mkivPartNumbers = new Set(["0855009", "0855109", "0871900", "0878700", "08742009", "08426009"]);
    const keywords = ["gist", "leafield", "hose", "tube", "bayonet", "adapter", "adaptador", "vedante", "anilha", "o-ring", "oring", "operating head"];

    for (const item of Object.values(stockMapByReferencia)) {
      const blob = `${item.referencia} ${item.codigoFabricante || ""} ${item.descricao || ""}`.toLowerCase();
      const byPartNumber = mkivPartNumbers.has((item.codigoFabricante || "").trim()) || mkivPartNumbers.has((item.referencia || "").trim());
      const byKeyword = keywords.some((k) => blob.includes(k));
      if (byPartNumber || (byKeyword && itemMatchesFicha(item, "mkiv"))) {
        candidatos.set(item.referencia, item);
      }
    }

    const ordenados = Array.from(candidatos.values()).sort((a, b) => {
      const byCompat = getSystemCompatibilityScore(b) - getSystemCompatibilityScore(a);
      if (byCompat !== 0) return byCompat;
      return String(a.referencia || "").localeCompare(String(b.referencia || ""), "pt-PT");
    });

    return ordenados.slice(0, 20);
  }, [stockMapByReferencia, sistemaSelecionado, isMkivFicha, fichaTokens]);

  const lr97InflacaoSugestoes = useMemo(() => {
    if (!isLr97Ficha) return [];
    const candidatos = new Map<string, StockLookupItem>();
    const keywords = ["hose", "tubo", "adapter", "adaptador", "seal", "vedante", "anilha", "o-ring", "oring", "bayonet", "union", "inflation", "infla", "valve"];

    for (const item of Object.values(stockMapByReferencia)) {
      const blob = `${item.referencia} ${item.codigoFabricante || ""} ${item.descricao || ""} ${item.categoria || ""} ${item.aplicavelModeloJangada || ""}`.toLowerCase();
      const isLr97 = blob.includes("lr97") || String(item.aplicavelModeloJangada || "").toLowerCase().includes("lr97");
      const isInflacaoPart = keywords.some((k) => blob.includes(k));
      if (isLr97 && isInflacaoPart && itemMatchesFicha(item, "lr97")) {
        candidatos.set(item.referencia, item);
      }
    }

    const ordenados = Array.from(candidatos.values()).sort((a, b) => {
      const byCompat = getSystemCompatibilityScore(b) - getSystemCompatibilityScore(a);
      if (byCompat !== 0) return byCompat;
      return String(a.referencia || "").localeCompare(String(b.referencia || ""), "pt-PT");
    });

    return ordenados.slice(0, 20);
  }, [stockMapByReferencia, sistemaSelecionado, isLr97Ficha, fichaTokens]);

  const mkivValvulasManualList = useMemo(() => {
    const ordemCategoria = new Map<string, number>(
      MKIV_CATEGORIA_ORDEM.map((categoria, index) => [categoria, index])
    );

    return MKIV_VALVULAS_REFERENCIAS.map((entry) => {
      const refKey = normalizeReference(entry.referencia);
      const fromRef = stockMapByReferencia[refKey];
      const fromCodFab = stockMapByCodigoFabricante[refKey];
      const stockMatch = fromRef || fromCodFab;
      return {
        referencia: entry.referencia,
        descricao: stockMatch?.descricao || entry.descricaoManual,
        codigoFabricante: stockMatch?.codigoFabricante || null,
        categoria: entry.categoria,
      };
    }).sort((a, b) => {
      const ordemA = ordemCategoria.get(a.categoria) ?? Number.MAX_SAFE_INTEGER;
      const ordemB = ordemCategoria.get(b.categoria) ?? Number.MAX_SAFE_INTEGER;
      const byCategoria = ordemA - ordemB;
      if (byCategoria !== 0) return byCategoria;
      return a.referencia.localeCompare(b.referencia, "pt-PT");
    });
  }, [stockMapByReferencia, stockMapByCodigoFabricante]);

  const tannerSugestoes = useMemo(() => {
    if (!isMkivFicha && !isLr97Ficha) return [];
    if (!sistemaSelecionado.includes("tanner") && !sistemaSelecionado.includes("thanner")) return [];
    return TANNER_SISTEMA_REFERENCIAS.map((entry) => {
      const refKey = normalizeReference(entry.referencia);
      const fromRef = stockMapByReferencia[refKey];
      const fromCodFab = stockMapByCodigoFabricante[refKey];
      const stockMatch = fromRef || fromCodFab;
      return {
        referencia: entry.referencia,
        descricao: stockMatch?.descricao || entry.descricaoManual,
        codigoFabricante: stockMatch?.codigoFabricante || null,
        categoria: entry.categoria,
      };
    }).sort((a, b) => a.categoria.localeCompare(b.categoria));
  }, [sistemaSelecionado, stockMapByReferencia, stockMapByCodigoFabricante, isMkivFicha, isLr97Ficha]);

  const lr97ComponentesAdicionaisSugestoes = useMemo(() => {
    if (!isLr97Ficha) return [];
    const findMappedStockItem = (entry: typeof LR97_COMPONENTES_ADICIONAIS[number]) => {
      for (const ref of entry.linkedRefs || []) {
        const refKey = normalizeReference(ref);
        const byRef = stockMapByReferencia[refKey];
        if (byRef && itemMatchesFicha(byRef, "lr97")) return byRef;
        const byCode = stockMapByCodigoFabricante[refKey];
        if (byCode && itemMatchesFicha(byCode, "lr97")) return byCode;
      }

      const terms = [entry.descricaoManual, ...(entry.searchTerms || []), ...(entry.linkedRefs || [])]
        .map((value) => normalizeText(value))
        .filter(Boolean);

      if (terms.length === 0) return undefined;

      const candidates = Object.values(stockMapByReferencia).filter((item) => {
        if (!itemMatchesFicha(item, "lr97")) return false;
        const blob = normalizeText(
          `${item.referencia} ${item.codigoFabricante || ""} ${item.descricao || ""} ${item.categoria || ""} ${item.aplicavelModeloJangada || ""}`
        );
        return terms.some((term) => blob.includes(term));
      });

      candidates.sort((a, b) => {
        const compatibilityDelta = getSystemCompatibilityScore(b) - getSystemCompatibilityScore(a);
        if (compatibilityDelta !== 0) return compatibilityDelta;
        return String(a.referencia || "").localeCompare(String(b.referencia || ""), "pt-PT");
      });

      return candidates[0];
    };

    return LR97_COMPONENTES_ADICIONAIS.map((entry) => {
      const stockMatch = findMappedStockItem(entry);
      return {
        referencia: stockMatch?.referencia || entry.referencia,
        descricao: stockMatch?.descricao || entry.descricaoManual,
        codigoFabricante: stockMatch?.codigoFabricante || null,
        categoria: entry.categoria,
        defaultBusca: entry.defaultBusca || entry.linkedRefs?.join(" ") || entry.descricaoManual,
        referenciaManual: entry.referencia,
      };
    }).sort((a, b) => a.categoria.localeCompare(b.categoria));
  }, [stockMapByReferencia, stockMapByCodigoFabricante, isLr97Ficha]);

  const mkivRelevantTorqueSettings = useMemo(() => {
    if (!isMkivFicha) return [] as typeof MKIV_TORQUE_SETTINGS;

    const grupos = new Set<string>(["hpack", "vacuo"]);

    if (cabecaDisparoRef || cabecaDisparoStock || form.cylinderCabecaDisparoDescricao || raft?.cylinderCabecaDisparoDescricao) {
      grupos.add("cabeca-disparo");
      grupos.add("cilindro");
    }

    if (valvulaAlivioRef || valvulaAlivioStock) {
      grupos.add("alivio");
      grupos.add("valvulas");
    }

    if (valvulaAtestarRef || valvulaAtestarStock) {
      grupos.add("reabastecimento");
      grupos.add("valvulas");
    }

    if (tuboSuperiorRef || tuboInferiorRef || tuboSuperiorStock || tuboInferiorStock) {
      grupos.add("mangueira");
      grupos.add("tubo");
      grupos.add("uniao");
    }

    if (acessoriosSuperior.length > 0 || acessoriosInferior.length > 0) {
      grupos.add("acessorios");
      grupos.add("entrada");
      grupos.add("vedacao");
    }

    return MKIV_TORQUE_SETTINGS.filter((item) => item.grupos.some((grupo) => grupos.has(grupo)));
  }, [
    isMkivFicha,
    cabecaDisparoRef,
    cabecaDisparoStock,
    form.cylinderCabecaDisparoDescricao,
    raft?.cylinderCabecaDisparoDescricao,
    valvulaAlivioRef,
    valvulaAlivioStock,
    valvulaAtestarRef,
    valvulaAtestarStock,
    tuboSuperiorRef,
    tuboInferiorRef,
    tuboSuperiorStock,
    tuboInferiorStock,
    acessoriosSuperior,
    acessoriosInferior,
  ]);

  const nextInspectionValue = String(
    form.dataProxInspecao ||
    raft?.dataProxInspecao ||
    certificadoPreferencial?.dataProxInspecao ||
    ultimaInspecao?.dataProxInspecao ||
    ""
  ).trim();
  const nextInspectionDays = daysUntil(nextInspectionValue || null);
  const appliedBulletinsRatio = applicableServiceBulletins.length > 0
    ? Math.round((appliedServiceBulletinsCount / applicableServiceBulletins.length) * 100)
    : 100;
  const selectedShip = resolveSelectedShip(form) || resolveSelectedShip(raft);
  const inspectionCycleLabel = getInspectionCycleLabel(String(form.brand || raft?.brand || '').trim());
  const inspectionDateBase = String(form.dataInspecao || raft?.dataInspecao || ultimaInspecao?.dataInspecao || '').trim();
  const recommendedNextInspection = getRecommendedNextInspectionDate(inspectionDateBase, String(form.brand || raft?.brand || '').trim());
  const nextInspectionMatchesRule = Boolean(nextInspectionValue && recommendedNextInspection && normalizeIsoDate(nextInspectionValue) === normalizeIsoDate(recommendedNextInspection));
  const ownerDisplay = String(form.owner || raft?.ownerDisplay || raft?.owner || "—").trim() || "—";
  const shipDisplay = String(selectedShip?.nome || form.shipNameManual || raft?.shipDetails?.nome || raft?.shipNameManual || "Sem navio").trim() || "Sem navio";
  const raftTitle = `${String(form.brand || raft?.brand || "Jangada").trim() || "Jangada"} ${String(form.model || raft?.model || "").trim()}`.trim();
  const raftStatusTone = typeof nextInspectionDays === "number"
    ? nextInspectionDays < 0
      ? {
          label: `Inspeção atrasada há ${Math.abs(nextInspectionDays)}d`,
          className: "border-rose-200 bg-rose-100 text-rose-700",
        }
      : nextInspectionDays <= 30
        ? {
            label: `Inspeção em ${nextInspectionDays}d`,
            className: "border-amber-200 bg-amber-100 text-amber-700",
          }
        : {
            label: `Inspeção dentro do prazo`,
            className: "border-emerald-200 bg-emerald-100 text-emerald-700",
          }
    : {
        label: "Sem próxima inspeção definida",
        className: "border-slate-200 bg-slate-100 text-slate-700",
      };
  const executiveSummaryCards = [
    {
      label: "Próxima inspeção",
      value: nextInspectionValue ? formatDatePt(nextInspectionValue) : "—",
      hint: nextInspectionValue
        ? nextInspectionMatchesRule && typeof nextInspectionDays === "number"
          ? `${nextInspectionDays < 0 ? `${Math.abs(nextInspectionDays)} dias em atraso` : `Faltam ${nextInspectionDays} dias`} · ${inspectionCycleLabel}`
          : recommendedNextInspection
            ? `Regra esperada: ${formatDatePt(recommendedNextInspection)} · ${inspectionCycleLabel}`
            : inspectionCycleLabel
        : `Sem planeamento registado · ${inspectionCycleLabel}`,
      tone: nextInspectionDays !== null && nextInspectionDays < 0 ? "text-rose-700" : nextInspectionDays !== null && nextInspectionDays <= 30 ? "text-amber-700" : "text-slate-900",
    },
    {
      label: "Boletins aplicados",
      value: `${appliedServiceBulletinsCount}/${applicableServiceBulletins.length}`,
      hint: `${appliedBulletinsRatio}% de cobertura dos boletins aplicáveis`,
      tone: appliedServiceBulletinsCount < applicableServiceBulletins.length ? "text-amber-700" : "text-emerald-700",
    },
    {
      label: "Pack / lotação",
      value: `${currentPackLabel || "—"} · ${currentCapacity > 0 ? `${formatCapacityValue(currentCapacity)} pax` : "—"}`,
      hint: currentContainerLabel || (isValiseContainer ? "Sem valise definida" : "Sem contentor definido"),
      tone: "text-slate-900",
    },
    {
      label: "Obra",
      value: String(form.numeroObra || raft?.numeroObra || "—"),
      hint: String(form.shipNameManual || raft?.shipNameManual || raft?.shipDetails?.nome || "Sem navio associado"),
      tone: "text-slate-900",
    },
  ] as const;
  const certificateDocuments = [
    ...(certificadoPreferencial ? [certificadoPreferencial] : []),
    ...((Array.isArray(raft?.certificadosExtraidos) ? raft?.certificadosExtraidos : []).filter((cert) => String(cert?.id) !== String(certificadoPreferencial?.id ?? ''))),
  ].slice(0, 6);
  const evidenceDocuments = [...evidencias]
    .sort((a, b) => String(b.uploadedAt || '').localeCompare(String(a.uploadedAt || '')))
    .slice(0, 6);
  const resolveManagedValidityForArticle = (articleName: string) => {
    if (!certificateItemHasManagedValidity(articleName)) return '';

    const verificado = obterArtigoVerificado(articleName);
    const stockItem = obterStockItem(articleName);
    const fixedReference = getFixedReferenceForArticleName(articleName);
    const preferredStockReference = getPreferredStockReferenceForArticleName(articleName);
    const referenciaVerificada = String(verificado?.art?.referencia || '').trim();
    const refStock = referenciaVerificada || preferredStockReference || fixedReference || stockItem?.referencia || '';
    const thumbRef = normalizeReference(String(refStock || ''));
    const stockMetaByRef = thumbRef
      ? (stockMapByReferencia[thumbRef] || stockMapByCodigoFabricante[thumbRef])
      : undefined;
    const matchedStockMeta = stockMetaByRef || stockItem;
    const validadeUltima = obterValidadeUltimaInspecao(articleName);
    const validadeCertificado = obterValidadeCertificado(articleName);
    const stockValidity = normalizeMonthYearValue(String(matchedStockMeta?.validade || ''));

    return String(verificado?.art?.validade || validadeCertificado || validadeUltima || stockValidity || '').trim();
  };

  const criticalValidityItems = CRITICAL_ITEMS.map((item) => {
    const matchingMandatoryItems = mandatoryPackChecklistItems.filter((packItem) => {
      const haystack = normalizeText([
        packItem.label,
        packItem.englishLabel,
        packItem.technicalName,
        packItem.checklistName,
        ...(packItem.articleTokens || []),
      ].filter(Boolean).join(' '));

      return item.tokens.some((token) => haystack.includes(normalizeText(token)));
    });

    const rows = matchingMandatoryItems
      .map((packItem) => {
        const articleName = String(packItem.label || packItem.technicalName || '').trim();
        const validity = articleName ? resolveManagedValidityForArticle(articleName) : '';
        const normalizedDate = normalizeDeadlineDate(validity);

        if (!articleName || !validity) return null;

        return {
          articleName,
          rawValue: validity,
          displayValue: normalizeMonthYearValue(validity) ? formatMonthYear(validity) : formatDatePt(validity),
          normalizedDate,
          days: daysUntil(normalizedDate || null),
        };
      })
      .filter((row): row is {
        articleName: string;
        rawValue: string;
        displayValue: string;
        normalizedDate: string;
        days: number | null;
      } => Boolean(row))
      .sort((a, b) => {
        const aDate = Date.parse(a.normalizedDate || a.rawValue || '') || Number.POSITIVE_INFINITY;
        const bDate = Date.parse(b.normalizedDate || b.rawValue || '') || Number.POSITIVE_INFINITY;
        return aDate - bDate;
      });

    const nearest = rows[0];
    if (!nearest) return null;

    return {
      key: item.key,
      label: item.label,
      sourceArticle: nearest.articleName,
      rawValue: nearest.rawValue,
      displayValue: nearest.displayValue,
      normalizedDate: nearest.normalizedDate,
      days: nearest.days,
    };
  }).filter((item): item is {
    key: string;
    label: string;
    sourceArticle: string;
    rawValue: string;
    displayValue: string;
    normalizedDate: string;
    days: number | null;
  } => Boolean(item));
  const dossierDeadlines = [
    {
      key: 'next-inspection',
      label: 'Próxima inspeção',
      value: nextInspectionValue,
      displayValue: nextInspectionValue ? formatDatePt(nextInspectionValue) : '—',
      days: nextInspectionDays,
      description: inspectionCycleLabel,
    },
    {
      key: 'delivery',
      label: 'Entrega prevista',
      value: String(raft?.expectedDeliveryDate || '').trim(),
      displayValue: raft?.expectedDeliveryDate ? formatDatePt(raft.expectedDeliveryDate) : '—',
      days: daysUntil(raft?.expectedDeliveryDate || null),
      description: raft?.statusSetAt ? `Fila atualizada a ${formatDatePt(raft.statusSetAt)}` : 'Sem atualização recente de fila',
    },
    {
      key: 'cylinder-test',
      label: 'Próx. teste do cilindro',
      value: String(form.cylinderDataProxTeste || raft?.cylinderDataProxTeste || '').trim(),
      displayValue: String(form.cylinderDataProxTeste || raft?.cylinderDataProxTeste || '').trim() ? formatDatePt(String(form.cylinderDataProxTeste || raft?.cylinderDataProxTeste || '').trim()) : '—',
      days: daysUntil(String(form.cylinderDataProxTeste || raft?.cylinderDataProxTeste || '').trim() || null),
      description: String(form.cylinderSerial || raft?.cylinderSerial || '').trim() ? `Cilindro ${String(form.cylinderSerial || raft?.cylinderSerial)}` : 'Sem serial do cilindro',
    },
    {
      key: 'hru',
      label: 'Validade HRU',
      value: String(form.hruValidade || raft?.hruValidade || raft?.shipDetails?.hruValidade || '').trim(),
      displayValue: String(form.hruValidade || raft?.hruValidade || raft?.shipDetails?.hruValidade || '').trim() ? formatDatePt(String(form.hruValidade || raft?.hruValidade || raft?.shipDetails?.hruValidade || '').trim()) : '—',
      days: daysUntil(String(form.hruValidade || raft?.hruValidade || raft?.shipDetails?.hruValidade || '').trim() || null),
      description: String(form.hruReferencia || raft?.hruReferencia || raft?.shipDetails?.hruReferencia || '').trim() ? `Ref. ${String(form.hruReferencia || raft?.hruReferencia || raft?.shipDetails?.hruReferencia)}` : 'Sem HRU registado',
    },
    {
      key: 'radar-reflector',
      label: 'Radar reflector',
      value: String(form.radarReflectorValidade || raft?.radarReflectorValidade || raft?.shipDetails?.radarReflectorValidade || '').trim(),
      displayValue: String(form.radarReflectorValidade || raft?.radarReflectorValidade || raft?.shipDetails?.radarReflectorValidade || '').trim() ? formatDatePt(String(form.radarReflectorValidade || raft?.radarReflectorValidade || raft?.shipDetails?.radarReflectorValidade || '').trim()) : '—',
      days: daysUntil(String(form.radarReflectorValidade || raft?.radarReflectorValidade || raft?.shipDetails?.radarReflectorValidade || '').trim() || null),
      description: String(form.radarReflector || raft?.radarReflector || raft?.shipDetails?.radarReflector || '').trim() || 'Sem radar reflector registado',
    },
    ...criticalValidityItems.slice(0, 4).map((item) => ({
      key: `critical-${item.key}`,
      label: item.label,
      value: item.normalizedDate || item.rawValue,
      displayValue: item.displayValue,
      days: item.days,
      description: `Pack obrigatório · ${item.sourceArticle}`,
    })),
  ]
    .filter((item) => item.value || item.description)
    .sort((a, b) => {
      const aRank = a.days === null ? Number.POSITIVE_INFINITY : a.days;
      const bRank = b.days === null ? Number.POSITIVE_INFINITY : b.days;
      return aRank - bRank;
    })
    .slice(0, 6);
  const dossierCounts = {
    overdue: dossierDeadlines.filter((item) => typeof item.days === 'number' && item.days < 0).length,
    dueSoon: dossierDeadlines.filter((item) => typeof item.days === 'number' && item.days >= 0 && item.days <= 30).length,
    evidence: evidencias.length,
    inspections: inspecoesVisiveis.length,
  };
  const missingRequiredPackArticles = packCalc.artigosObrigatorios.filter((artigoObrig) => !obterArtigoVerificado(artigoObrig.nome)).length;
  const isDelivered = Boolean(form.delivered || raft?.delivered || form.deliveredAt || raft?.deliveredAt);
  const deliveredAtValue = String(form.deliveredAt || raft?.deliveredAt || '').trim();
  const serviceStationStatusValue = String(form.serviceStationStatus || raft?.serviceStationStatus || 'aguardar').trim().toLowerCase() as ServiceStationStatus;
  const serviceStationStatusMeta = getServiceStationStatusMeta(serviceStationStatusValue);
  const readyForDeliveryValue = Boolean(form.readyForDelivery ?? raft?.readyForDelivery);
  const deliveryMethodValue = String(form.deliveryMethod || raft?.deliveryMethod || '').trim().toLowerCase() as DeliveryMethod | '';
  const deliveryMethodLabel = deliveryMethodValue && deliveryMethodValue in DELIVERY_METHOD_LABELS
    ? DELIVERY_METHOD_LABELS[deliveryMethodValue as DeliveryMethod]
    : 'Sem método de entrega definido';
  const operationalStateDescription = isDelivered
    ? `Entregue${deliveredAtValue ? ` em ${formatDatePt(deliveredAtValue) || deliveredAtValue}` : ''}.`
    : readyForDeliveryValue
      ? `Marcada como pronta para entrega${deliveryMethodValue ? ` · ${deliveryMethodLabel}` : ''}.`
      : serviceStationStatusMeta.description;
  const smartFocusSignals = useMemo(() => {
    const items: SmartFocusSignal[] = [];

    if (typeof nextInspectionDays === 'number' && nextInspectionDays < 0) {
      items.push({
        key: 'overdue',
        title: 'Inspeção em atraso',
        description: `A jangada está com ${Math.abs(nextInspectionDays)} dia(s) de atraso. Convém fechar a ronda técnica antes que isto continue a crescer de mau humor.`,
        whyUrgent: 'Existe um prazo já vencido com impacto operacional imediato.',
        actionLabel: 'Abrir vencidos',
        target: { blockId: 'section-dossier-docs' },
        severity: 'critical',
        score: 100 + Math.min(30, Math.abs(nextInspectionDays)),
        tone: getSmartFocusTone('critical'),
        sourceLabel: 'prazo vencido',
      });
    } else if (typeof nextInspectionDays === 'number' && nextInspectionDays <= 30) {
      items.push({
        key: 'due-soon',
        title: 'Inspeção a vencer em breve',
        description: `Faltam ${nextInspectionDays} dia(s) para a próxima inspeção; é a janela perfeita para fechar checklist e preparação técnica sem correria olímpica.`,
        whyUrgent: 'O prazo entra na zona curta dos próximos 30 dias.',
        actionLabel: inspectionMode ? 'Ir para checklist' : 'Abrir inspeção',
        target: { section: inspectionMode ? 'checklist' : 'geral' },
        severity: 'high',
        score: 88 - nextInspectionDays,
        tone: getSmartFocusTone('high'),
        sourceLabel: 'janela 30d',
      });
    }

    if (missingRequiredPackArticles > 0) {
      const level: SmartUrgencyLevel = missingRequiredPackArticles >= 3 ? 'critical' : 'high';
      items.push({
        key: 'pack',
        title: 'Pack obrigatório incompleto',
        description: `${missingRequiredPackArticles} artigo(s) obrigatório(s) ainda não têm correspondência real/verificada na ficha.`,
        whyUrgent: 'Faltam obrigatórios no pack, o que impacta diretamente a prontidão técnica.',
        actionLabel: 'Abrir pack',
        target: { section: 'pack' },
        severity: level,
        score: 84 + Math.min(12, missingRequiredPackArticles * 3),
        tone: getSmartFocusTone(level),
        sourceLabel: 'pack obrigatório',
      });
    }

    if (contentorOperationalSummary.pending > 0) {
      const level: SmartUrgencyLevel = contentorOperationalSummary.pending >= 2 ? 'high' : 'medium';
      items.push({
        key: 'contentor',
        title: 'Validar pontos do contentor',
        description: `${contentorOperationalSummary.pending} decisão(ões) operacional(is) do contentor continuam pendentes.`,
        whyUrgent: 'Existem pendências diretas no contentor que bloqueiam o fecho limpo da inspeção.',
        actionLabel: 'Abrir contentor',
        target: { section: 'contentor' },
        severity: level,
        score: 74 + Math.min(10, contentorOperationalSummary.pending * 3),
        tone: getSmartFocusTone(level),
        sourceLabel: 'contentor',
      });
    }

    if (inspectionMode && checklistCompletionPercent < 100) {
      const level: SmartUrgencyLevel = checklistCompletionPercent < 60 ? 'high' : 'medium';
      items.push({
        key: 'checklist',
        title: 'Checklist de inspeção por concluir',
        description: `O wizard está em ${checklistCompletionPercent}% e ainda faltam ${Math.max(0, checklistTotalFields - checklistCompletedFields)} campo(s) por fechar.`,
        whyUrgent: 'A inspeção está aberta e ainda não foi fechada completamente.',
        actionLabel: 'Continuar checklist',
        target: { section: 'checklist' },
        severity: level,
        score: 68 + Math.round((100 - checklistCompletionPercent) / 4),
        tone: getSmartFocusTone(level),
        sourceLabel: 'checklist ativa',
      });
    }

    if (inspectionDateBase && recommendedNextInspection && !nextInspectionMatchesRule) {
      items.push({
        key: 'next-inspection',
        title: 'Alinhar a próxima inspeção com a regra nova',
        description: `Com base em ${inspectionCycleLabel}, a data recomendada passa a ser ${formatDatePt(recommendedNextInspection)}.`,
        whyUrgent: 'A próxima inspeção está desalinhada com a regra operacional calculada para a ficha.',
        actionLabel: 'Aplicar data',
        target: { section: 'geral' },
        severity: 'medium',
        score: 66,
        tone: getSmartFocusTone('medium'),
        sourceLabel: 'regra operacional',
      });
    }

    if (appliedServiceBulletinsCount < applicableServiceBulletins.length) {
      const pendingBulletins = applicableServiceBulletins.length - appliedServiceBulletinsCount;
      const level: SmartUrgencyLevel = pendingBulletins >= 2 ? 'medium' : 'low';
      items.push({
        key: 'bulletins',
        title: 'Existem boletins por validar',
        description: `${pendingBulletins} boletim(ns) aplicável(eis) ainda não estão marcados como aplicados nesta jangada.`,
        whyUrgent: 'Ainda há requisitos técnicos/documentais aplicáveis por confirmar.',
        actionLabel: 'Rever boletins',
        target: { section: 'geral' },
        severity: level,
        score: 54 + pendingBulletins * 4,
        tone: getSmartFocusTone(level),
        sourceLabel: 'boletins',
      });
    }

    if (!selectedShip?.id && !raft?.shipDetails?.id) {
      items.push({
        key: 'ship',
        title: 'Associar navio para fechar a periodicidade',
        description: 'Sem navio associado, a ficha não consegue confirmar automaticamente se a jangada segue o ciclo anual ou o regime de recreio a 3 anos.',
        whyUrgent: 'Sem navio associado, a aplicação perde contexto operacional importante para priorizar corretamente.',
        actionLabel: 'Rever dados gerais',
        target: { section: 'geral' },
        severity: 'low',
        score: 42,
        tone: getSmartFocusTone('low'),
        sourceLabel: 'governança',
      });
    }

    return items.sort(compareSmartFocusSignals);
  }, [
    nextInspectionDays,
    inspectionMode,
    missingRequiredPackArticles,
    contentorOperationalSummary.pending,
    checklistCompletionPercent,
    checklistTotalFields,
    checklistCompletedFields,
    inspectionDateBase,
    recommendedNextInspection,
    nextInspectionMatchesRule,
    inspectionCycleLabel,
    appliedServiceBulletinsCount,
    applicableServiceBulletins.length,
    selectedShip?.id,
    raft?.shipDetails?.id,
  ]);
  const rememberedSmartFocusMatch = useMemo(() => {
    if (!rememberedSmartFocus) return null;
    return smartFocusSignals.find((item) => {
      const sameSection = (rememberedSmartFocus.section || '') === (item.target.section || '');
      const sameBlock = (rememberedSmartFocus.blockId || '') === (item.target.blockId || '');
      return item.key === rememberedSmartFocus.key && sameSection && sameBlock;
    }) || null;
  }, [rememberedSmartFocus, smartFocusSignals]);
  const smartFocusPreferredTarget = rememberedSmartFocusMatch || smartFocusSignals[0] || null;
  const observacoesTexto = String(form.observacoes || raft?.observacoes || '').trim();
  const hasObservacoesDossier = observacoesTexto.length > 0;
  const observacoesPreview = hasObservacoesDossier
    ? `${observacoesTexto.slice(0, 180)}${observacoesTexto.length > 180 ? '…' : ''}`
    : 'Sem observações registadas nesta jangada.';
  const observacoesMetaLabel = hasObservacoesDossier
    ? `${observacoesTexto.length} caractere${observacoesTexto.length === 1 ? '' : 's'}`
    : 'campo disponível';
  const dossierSummaryCards = [
    {
      label: 'Prazos vencidos',
      value: String(dossierCounts.overdue),
      hint: dossierCounts.overdue > 0 ? 'Itens já ultrapassados' : 'Sem atrasos agora',
      tone: dossierCounts.overdue > 0 ? 'text-rose-700' : 'text-emerald-700',
      onClick: () => scrollToDossierBlock('section-dossier-docs'),
      actionLabel: 'Abrir prazos',
      severityScore: dossierCounts.overdue > 0 ? 100 + dossierCounts.overdue : 10,
    },
    {
      label: 'A vencer em 30 dias',
      value: String(dossierCounts.dueSoon),
      hint: 'Inclui inspeção, HRU, cilindro e consumíveis prioritários',
      tone: dossierCounts.dueSoon > 0 ? 'text-amber-700' : 'text-slate-900',
      onClick: () => scrollToDossierBlock('section-dossier-timeline'),
      actionLabel: 'Abrir timeline',
      severityScore: dossierCounts.dueSoon > 0 ? 80 + dossierCounts.dueSoon : 20,
    },
    {
      label: 'Documentos / evidências',
      value: `${certificateDocuments.length + evidenceDocuments.length}`,
      hint: `${certificateDocuments.length} certificados · ${evidenceDocuments.length} evidências`,
      tone: 'text-slate-900',
      onClick: () => scrollToDossierBlock('section-dossier-docs'),
      actionLabel: 'Abrir documentos',
      severityScore: certificateDocuments.length + evidenceDocuments.length === 0 ? 65 : 30,
    },
    {
      label: 'Histórico operacional',
      value: `${inspecoesVisiveis.length}`,
      hint: inspecoesVisiveis.length > 0 ? 'inspeções registadas na ficha' : 'Sem inspeções registadas ainda',
      tone: 'text-slate-900',
      onClick: () => scrollToSection('historico'),
      actionLabel: 'Abrir histórico',
      severityScore: inspecoesVisiveis.length === 0 ? 55 : 25,
    },
  ].sort((a, b) => b.severityScore - a.severityScore);
  const raftHealthScore = clamp(
    100
      - dossierCounts.overdue * 22
      - dossierCounts.dueSoon * 8
      - Math.min(18, missingRequiredPackArticles * 3)
      - (selectedShip?.id || raft?.shipDetails?.id ? 0 : 10)
      - (certificateDocuments.length + evidenceDocuments.length > 0 ? 0 : 8)
      - (appliedServiceBulletinsCount < applicableServiceBulletins.length ? 6 : 0),
    0,
    100
  );
  const raftHealthTone = getPremiumHealthTone(raftHealthScore);
  const raftHealthStrokeOffset = 282.743 - (282.743 * raftHealthScore) / 100;
  const raftHealthBreakdownBase = [
    {
      label: 'Vencidos',
      value: dossierCounts.overdue,
      hint: dossierCounts.overdue > 0 ? 'Há prazos já vencidos no radar.' : 'Sem itens vencidos agora.',
      kind: 'critical',
      onClick: () => scrollToDossierBlock('section-dossier-docs'),
      actionLabel: 'Abrir vencidos',
      severityScore: dossierCounts.overdue > 0 ? 100 + dossierCounts.overdue : 10,
    },
    {
      label: 'Janela 30d',
